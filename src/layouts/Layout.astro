    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Vercel Speed Insights Integration -->
    <script>
      import { injectSpeedInsights } from '@vercel/speed-insights';

      // Initialize Speed Insights (Web Analytics configured via adapter)
      injectSpeedInsights();
    </script>

    <style is:global>
      :root {
        --font-sans: 'Inter', sans-serif;
        --font-display: 'Outfit', sans-serif;
      }
      body {
        font-family: var(--font-sans);
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
      }
      
      /* Logo transition and shrink logic */
      #main-logo-img {
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        transform-origin: top left;
      }
      header.scrolled #main-logo-img {
        height: 4.5rem !important; /* 72px (compact height) */
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1) !important;
      }

      /* Secondary nav transition on scroll */
      #secondary-nav-container {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        max-height: 40px;
        opacity: 1;
        transform: translateY(0);
        overflow: hidden;
      }
      header.hide-secondary:not(:hover) #secondary-nav-container {
        max-height: 0 !important;
        opacity: 0 !important;
        transform: translateY(-10px) !important;
        pointer-events: none !important;
      }
    </style>
  </head>
  <body class="bg-[#fcfdfd] text-slate-900 min-h-screen flex flex-col antialiased selection:bg-blue-500/30 selection:text-blue-900">
    <!-- Sticky Glassmorphism Header -->
    <header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/90 backdrop-blur-md transition-all duration-300">
