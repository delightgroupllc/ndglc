---
import '../styles/global.css';
import { UserButton, SignInButton } from '@clerk/astro/components';
import { Menu, X, ChevronDown, Cpu, Shield, Database, Activity, PhoneCall, ArrowRight, Package, Briefcase, DownloadCloud, LayoutGrid, Search, User, Building2 } from '@lucide/astro';
import { query } from '../lib/db';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Enterprise industrial supplies and digital solutions platform." } = Astro.props;

// Determine if user has dashboard access
const roles = Astro.locals.roles || [];
const hasDashboardAccess = roles.includes('admin') || roles.includes('moderator') || roles.includes('user');

const auth = Astro.locals.auth ? Astro.locals.auth() : null;
const userId = auth?.userId || null;

// Get current page path
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isDTL = currentPath.startsWith('/delighttechnicallighting');
const isDGS = currentPath.startsWith('/delightgreenscapes');

// Determine logo to show
let logoSrc = '/dgllclogosmall.png';
let logoAlt = 'Delight Group Logo';
if (isDTL) {
  logoSrc = '/dtllogo.jpg';
  logoAlt = 'DTL Logo';
} else if (isDGS) {
  logoSrc = '/dgslogo.jpg';
  logoAlt = 'DGS Logo';
}

// Fetch divisions and categories for secondary nav when on DTL/DGS
let secondaryNavCategories: any[] = [];
try {
  const divRes = await query(
    'SELECT id, slug, name FROM divisions WHERE slug IN ($1, $2)',
    ['delighttechnicallighting', 'delightgreenscapes']
  );

  if (divRes.rows.length > 0) {
    for (const div of divRes.rows) {
      // 1) Try to fetch explicit categories configured for the division
      const catRes = await query(
        'SELECT name, slug FROM categories WHERE division_id = $1 ORDER BY display_order ASC LIMIT 6',
        [div.id]
      );

      if (catRes.rows.length > 0) {
        secondaryNavCategories.push(...catRes.rows.map((cat: any) => ({ ...cat, divSlug: div.slug })));
        continue;
      }

      // 2) Fallback: derive top categories from products (categories that actually have products)
      const prodCatRes = await query(
        `SELECT c.name, c.slug, COUNT(p.id) as product_count
         FROM products p
         JOIN categories c ON c.id = p.category_id
         WHERE c.division_id = $1
         GROUP BY c.id
         ORDER BY product_count DESC
         LIMIT 6`,
        [div.id]
      );

      if (prodCatRes.rows.length > 0) {
        secondaryNavCategories.push(...prodCatRes.rows.map((cat: any) => ({ name: cat.name, slug: cat.slug, divSlug: div.slug })));
        continue;
      }

      // 3) No categories or products available: provide helpful suggestions
      const suggestions = [
        { name: 'All Products', slug: `/${div.slug}` },
        { name: 'New Arrivals', slug: `/${div.slug}?sort=new` },
        { name: 'Best Sellers', slug: `/${div.slug}?sort=popular` },
        { name: 'Contact Sales', slug: '/contact' },
      ];
      secondaryNavCategories.push(...suggestions.map(s => ({ ...s, divSlug: div.slug })));
    }
  }
} catch (e) {
  // Secondary nav is optional; log for debugging but keep site working
  console.warn('Secondary nav categories lookup failed:', e?.message || e);
}

const canonicalUrl = new URL(Astro.url.pathname, 'https://www.delightgroupllc.com').href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Delight Group LLC</title>
    
    <!-- Primary SEO Metadata -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Delight Group LLC`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.delightgroupllc.com/dgllclogolarge.png" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | Delight Group LLC`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://www.delightgroupllc.com/dgllclogolarge.png" />
    
    <!-- Google Fonts: Outfit and Inter -->
