---
// AI Scan Modal Component
---

<div id="ai-scan-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden">
    <div class="p-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
      <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        AI Catalog Scanner (Vision Processor)
      </h3>
      <button id="close-ai-modal" class="text-slate-400 hover:text-slate-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <div class="flex-grow overflow-y-auto p-6 flex flex-col gap-6">
      <!-- Settings Panel -->
      <div class="bg-indigo-50 border border-indigo-100 p-4 rounded-xl space-y-4">
        <h4 class="text-xs font-bold text-indigo-800 uppercase tracking-wide">API Configuration</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-slate-700">Provider</label>
            <select id="ai-provider" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:border-indigo-500">
              <option value="google">Google Gemini (Recommended)</option>
              <option value="openai">OpenAI (ChatGPT)</option>
              <option value="anthropic">Anthropic Claude</option>
              <option value="openrouter">OpenRouter</option>
              <option value="deepseek">DeepSeek</option>
              <option value="local">Local LLM (Ollama / LM Studio)</option>
            </select>
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-slate-700" id="ai-api-key-label">API Key</label>
            <input type="password" id="ai-api-key" placeholder="Enter your secret API key..." class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:border-indigo-500" />
          </div>
        </div>
        
        <!-- Advanced Model & Endpoint Overrides -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-indigo-100/50" id="ai-advanced-fields">
          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-slate-700">Model Name (Optional)</label>
            <input type="text" id="ai-model" placeholder="Default model will be used" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:border-indigo-500" />
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-slate-700">Endpoint URL (Optional Override)</label>
            <input type="url" id="ai-endpoint" placeholder="Default endpoint will be used" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:border-indigo-500" />
          </div>
        </div>
        <p class="text-[10px] text-indigo-600 italic">Keys are not saved to the database. They are only used for this session to process the image.</p>
      </div>

      <!-- Upload Zone -->
      <div id="ai-dropzone" class="border-2 border-dashed border-slate-300 rounded-xl p-12 text-center bg-slate-50 hover:bg-slate-100 hover:border-indigo-400 transition-colors cursor-pointer group">
        <input type="file" id="ai-file-input" accept="image/png, image/jpeg, image/webp" class="hidden" />
        <div class="w-16 h-16 mx-auto bg-white rounded-full flex items-center justify-center shadow-sm border border-slate-200 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <h4 class="mt-4 text-sm font-bold text-slate-900">Drag & Drop Catalog Page</h4>
        <p class="text-xs text-slate-500 mt-1">Supports JPG, PNG, WEBP (Max 5MB)</p>
      </div>

      <!-- Preview Image -->
      <div id="ai-image-preview-container" class="hidden flex-col items-center gap-4">
        <img id="ai-image-preview" src="" class="max-h-64 object-contain rounded-lg border border-slate-200 shadow-sm" />
        <button id="ai-scan-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-xl shadow-md transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 2 20 20"/><path d="M8.5 8.5a5 5 0 0 0-3.5 1.5l-3 3a5 5 0 0 0 7 7l3-3a5 5 0 0 0 1.5-3.5"/><path d="M15.5 15.5a5 5 0 0 0 3.5-1.5l3-3a5 5 0 0 0-7-7l-3 3a5 5 0 0 0-1.5 3.5"/></svg>
          Extract Products Data
        </button>
      </div>

      <!-- Loading State -->
      <div id="ai-loading-state" class="hidden flex-col items-center justify-center py-12 gap-4">
        <div class="w-12 h-12 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div>
        <p class="text-sm font-bold text-slate-700 animate-pulse" id="ai-loading-text">Analyzing catalog layout and identifying specifications...</p>
      </div>

      <!-- Results Table -->
      <div id="ai-results-container" class="hidden flex-col gap-4">
        <h4 class="text-sm font-bold text-slate-900 border-b border-slate-200 pb-2">AI Extraction Results</h4>
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
          <table class="w-full text-left text-xs text-slate-600 whitespace-nowrap">
            <thead class="bg-slate-50 text-slate-900 uppercase font-bold">
              <tr>
                <th class="px-4 py-3 border-b">SKU (ID)</th>
                <th class="px-4 py-3 border-b">Name</th>
                <th class="px-4 py-3 border-b">Specs Summary</th>
              </tr>
            </thead>
            <tbody id="ai-results-body" class="divide-y divide-slate-100">
              <!-- JS Populated -->
            </tbody>
          </table>
        </div>
        <button id="ai-import-btn" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-md transition-colors w-full">
          Confirm & Import to Catalog
        </button>
      </div>
      
      <!-- Error Message -->
      <div id="ai-error-msg" class="hidden p-4 rounded-xl bg-red-50 text-red-700 text-sm font-bold border border-red-200"></div>

    </div>
  </div>
</div>

<script>
  let base64Image = '';
  let extractedProducts = [];

  const setupAIModal = () => {
    const modal = document.getElementById('ai-scan-modal');
    const closeBtn = document.getElementById('close-ai-modal');
    const dropzone = document.getElementById('ai-dropzone');
    const fileInput = document.getElementById('ai-file-input') as HTMLInputElement;
    const previewContainer = document.getElementById('ai-image-preview-container');
    const previewImg = document.getElementById('ai-image-preview') as HTMLImageElement;
    const scanBtn = document.getElementById('ai-scan-btn');
    const loadingState = document.getElementById('ai-loading-state');
    const loadingText = document.getElementById('ai-loading-text');
    const resultsContainer = document.getElementById('ai-results-container');
    const resultsBody = document.getElementById('ai-results-body');
    const importBtn = document.getElementById('ai-import-btn');
    const errorMsg = document.getElementById('ai-error-msg');
    
    if (!modal) return;

    const resetModal = () => {
      base64Image = '';
      extractedProducts = [];
      dropzone?.classList.remove('hidden');
      previewContainer?.classList.add('hidden');
      loadingState?.classList.add('hidden');
      resultsContainer?.classList.add('hidden');
      errorMsg?.classList.add('hidden');
      if (fileInput) fileInput.value = '';
    };

    closeBtn?.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    document.addEventListener('open-ai-modal', () => {
      resetModal();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    const handleFile = (file: File) => {
      if (!file.type.startsWith('image/')) {
        alert('Please upload an image file (JPG/PNG/WEBP).');
        return;
      }
      const reader = new FileReader();
      reader.onload = (e) => {
        base64Image = e.target?.result as string;
        previewImg.src = base64Image;
        dropzone?.classList.add('hidden');
        previewContainer?.classList.remove('hidden');
        previewContainer?.classList.add('flex');
      };
      reader.readAsDataURL(file);
    };

    dropzone?.addEventListener('click', () => fileInput?.click());
    
    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-indigo-500', 'bg-indigo-50');
    });
    
    dropzone?.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-indigo-500', 'bg-indigo-50');
    });
    
    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-indigo-500', 'bg-indigo-50');
      if (e.dataTransfer?.files.length) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    fileInput?.addEventListener('change', (e) => {
      if (fileInput.files?.length) {
        handleFile(fileInput.files[0]);
      }
    });

    // Provider elements
    const providerSelect = document.getElementById('ai-provider') as HTMLSelectElement | null;
    const apiKeyInput = document.getElementById('ai-api-key') as HTMLInputElement | null;
    const apiKeyLabel = document.getElementById('ai-api-key-label');
    const modelInput = document.getElementById('ai-model') as HTMLInputElement | null;
    const endpointInput = document.getElementById('ai-endpoint') as HTMLInputElement | null;

    providerSelect?.addEventListener('change', () => {
      const prov = providerSelect.value;
      if (apiKeyInput && apiKeyLabel && modelInput && endpointInput) {
        if (prov === 'local') {
          apiKeyLabel.textContent = 'API Key (Optional)';
          apiKeyInput.placeholder = 'None needed (unless local proxy requires)';
          modelInput.placeholder = 'e.g. llama3.2-vision';
          endpointInput.placeholder = 'e.g. http://localhost:11434/v1/chat/completions';
        } else if (prov === 'openrouter') {
          apiKeyLabel.textContent = 'OpenRouter API Key';
          apiKeyInput.placeholder = 'sk-or-v1-...';
          modelInput.placeholder = 'e.g. google/gemini-2.5-flash';
          endpointInput.placeholder = 'e.g. https://openrouter.ai/api/v1/chat/completions';
        } else if (prov === 'deepseek') {
          apiKeyLabel.textContent = 'DeepSeek API Key';
          apiKeyInput.placeholder = 'sk-...';
          modelInput.placeholder = 'e.g. deepseek-chat';
          endpointInput.placeholder = 'e.g. https://api.deepseek.com/chat/completions';
        } else if (prov === 'google') {
          apiKeyLabel.textContent = 'Gemini API Key';
          apiKeyInput.placeholder = 'Enter your Gemini API key...';
          modelInput.placeholder = 'gemini-1.5-flash';
          endpointInput.placeholder = 'Default URL will be used';
        } else if (prov === 'openai') {
          apiKeyLabel.textContent = 'OpenAI API Key';
          apiKeyInput.placeholder = 'sk-proj-...';
          modelInput.placeholder = 'gpt-4o';
          endpointInput.placeholder = 'Default URL will be used';
        } else if (prov === 'anthropic') {
          apiKeyLabel.textContent = 'Anthropic API Key';
          apiKeyInput.placeholder = 'sk-ant-...';
          modelInput.placeholder = 'claude-3-5-sonnet-20240620';
          endpointInput.placeholder = 'Default URL will be used';
        }
      }
    });

    scanBtn?.addEventListener('click', async () => {
      const provider = providerSelect?.value || 'google';
      const apiKey = apiKeyInput?.value.trim() || '';
      const model = modelInput?.value.trim() || '';
      const endpoint = endpointInput?.value.trim() || '';

      if (!apiKey && provider !== 'local') {
        alert('Please enter your API key to perform the scan.');
        return;
      }

      previewContainer?.classList.add('hidden');
      previewContainer?.classList.remove('flex');
      errorMsg?.classList.add('hidden');
      loadingState?.classList.remove('hidden');
      loadingState?.classList.add('flex');
      
      const states = [
        "Analyzing layout and tabular grids...",
        "Identifying SKUs and component specifications...",
        "Extracting visual certification symbols...",
        "Structuring JSON payload..."
      ];
      let i = 0;
      const t = setInterval(() => {
        if (loadingText) loadingText.textContent = states[i % states.length];
        i++;
      }, 2500);

      try {
        const res = await fetch('/api/products/ai-scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ image: base64Image, provider, apiKey, model, endpoint })
        });
        
        const data = await res.json();
        clearInterval(t);
        loadingState?.classList.add('hidden');
        loadingState?.classList.remove('flex');
        
        if (!res.ok) {
          throw new Error(data.error || 'Failed to process image');
        }

        extractedProducts = data.products;
        if (!extractedProducts || extractedProducts.length === 0) {
          throw new Error('No products could be extracted from the image.');
        }

        if (resultsBody) {
          resultsBody.innerHTML = '';
          extractedProducts.forEach((p: any) => {
            let specsText = '';
            if (p.specifications && Array.isArray(p.specifications)) {
              specsText = p.specifications.map((s: any) => `${s.key}: ${s.value}`).join(' | ');
            }
            resultsBody.innerHTML += `
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 font-semibold text-slate-900">${p.id}</td>
                <td class="px-4 py-3">${p.name}</td>
                <td class="px-4 py-3 max-w-[400px] truncate text-slate-500" title="${specsText}">${specsText}</td>
              </tr>
            `;
          });
        }
        
        resultsContainer?.classList.remove('hidden');
        resultsContainer?.classList.add('flex');

      } catch (err: any) {
        clearInterval(t);
        loadingState?.classList.add('hidden');
        loadingState?.classList.remove('flex');
        previewContainer?.classList.remove('hidden');
        previewContainer?.classList.add('flex');
        
        if (errorMsg) {
          errorMsg.textContent = err.message || 'Error communicating with AI service.';
          errorMsg.classList.remove('hidden');
        }
      }
    });

    importBtn?.addEventListener('click', async () => {
      const originalText = importBtn.textContent;
      importBtn.textContent = 'Importing...';
      importBtn.setAttribute('disabled', 'true');
      
      try {
        // Prepare the array format for our existing Bulk Import API
        const rowsForApi = extractedProducts.map((p: any) => ({
          product_id: p.id,
          name: p.name,
          specifications: p.specifications || []
        }));

        const res = await fetch('/api/products/bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(rowsForApi)
        });

        if (!res.ok) {
          const e = await res.json();
          throw new Error(e.error || 'Bulk insert failed');
        }

        alert('Products successfully imported!');
        window.location.reload();
      } catch(err: any) {
        alert(err.message || 'Import failed.');
        importBtn.textContent = originalText;
        importBtn.removeAttribute('disabled');
      }
    });
  };

  setupAIModal();
  document.addEventListener('astro:page-load', setupAIModal);
</script>
