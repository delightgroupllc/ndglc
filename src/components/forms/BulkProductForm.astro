---
const jsonFormatExample = `[
  {
    "name": "HP-100 High-Pressure Valve",
    "sku": "SKU-DTL-VALVE-001",
    "slug": "hp100-ball-valve",
    "division_slug": "dtl",
    "category_slug": "valves-actuators",
    "description": "Optional desc...",
    "status": "active",
    "featured": false,
    "specifications": [
      { "key": "Pressure", "value": "6,000 PSI" }
    ]
  }
]`;
---
<div id="bulk-modal-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col transform transition-all">
    <div class="p-6 border-b border-slate-200 flex justify-between items-center bg-slate-50 shrink-0">
      <div>
        <h3 class="text-lg font-bold text-slate-900">Mass Product Adder</h3>
        <p class="text-xs text-slate-500 mt-1">Copy and paste rows directly from Excel or Google Sheets.</p>
      </div>
      <button id="close-bulk-modal" class="text-slate-400 hover:text-slate-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    
    <div class="p-6 flex-grow overflow-y-auto">
      <form id="bulk-product-form" class="space-y-6">
        
        <div class="space-y-4">
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Upload Bulk File</label>
          <div class="flex items-center justify-center w-full">
            <label for="bulk-file-upload" class="flex flex-col items-center justify-center w-full h-32 border-2 border-slate-300 border-dashed rounded-lg cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors">
              <div class="flex flex-col items-center justify-center pt-5 pb-6">
                <svg class="w-8 h-8 mb-3 text-slate-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
                </svg>
                <p class="mb-2 text-sm text-slate-500"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                <p class="text-xs text-slate-500">CSV, Excel (XLSX/XLS), or JSON files accepted.</p>
              </div>
              <input id="bulk-file-upload" type="file" class="hidden" accept=".csv, .xlsx, .xls, .json" />
            </label>
          </div>
          <div id="bulk-file-name" class="hidden p-3 bg-indigo-50 border border-indigo-100 rounded-lg text-sm text-indigo-700 font-semibold flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span id="bulk-file-name-text"></span>
          </div>
        </div>

        <div id="bulk-guidelines-flat" class="bg-blue-50 border border-blue-100 rounded-lg p-4 text-sm text-blue-800 space-y-2">
          <p class="font-bold">Intelligent Column Mapping enabled!</p>
          <p class="text-xs">We automatically match columns like "Product Name", "Title", "SKU", "Item Code", "Division", etc.</p>
        </div>

        <div id="bulk-preview-container" class="hidden">
          <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Parsed Preview (<span id="parsed-count">0</span> rows)</h4>
          <div class="overflow-x-auto border border-slate-200 rounded-lg max-h-48">
            <table class="w-full text-left border-collapse text-xs">
              <thead class="bg-slate-50 sticky top-0">
                <tr>
                  <th class="p-2 border-b font-bold text-slate-600">Name</th>
                  <th class="p-2 border-b font-bold text-slate-600">SKU</th>
                  <th class="p-2 border-b font-bold text-slate-600">Slug</th>
                  <th class="p-2 border-b font-bold text-slate-600">Div</th>
                  <th class="p-2 border-b font-bold text-slate-600">Cat</th>
                </tr>
              </thead>
              <tbody id="bulk-preview-body"></tbody>
            </table>
          </div>
        </div>

        <div id="bulk-form-msg" class="hidden p-4 rounded-lg text-sm font-semibold"></div>

        <div class="pt-2 flex gap-4">
          <button type="button" id="cancel-bulk-btn" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 py-3 rounded-xl text-sm font-bold transition-colors">
            Cancel
          </button>
          <button type="submit" id="bulk-submit-btn" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-xl text-sm font-bold transition-colors shadow-sm hidden">
            Confirm & Import
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  import * as XLSX from 'xlsx';

  let parsedProducts: any[] = [];

  const intelligentMapper = (data: any[]) => {
    return data.map((row) => {
      const mapped: any = {};
      const keys = Object.keys(row);
      
      const findValue = (aliases: string[], defaultValue = '') => {
        for (const key of keys) {
          const normalizedKey = key.toLowerCase().replace(/[^a-z0-9]/g, '');
          if (aliases.some(alias => normalizedKey.includes(alias))) {
            return row[key] || defaultValue;
          }
        }
        return defaultValue;
      };

      mapped.name = findValue(['name', 'title', 'product', 'itemname'], '');
      mapped.sku = findValue(['sku', 'code', 'itemcode', 'id', 'productid'], '');
      mapped.slug = findValue(['slug', 'url', 'handle'], '');
      mapped.division_slug = findValue(['division', 'div', 'brand'], 'dtl').toLowerCase();
      mapped.category_slug = findValue(['category', 'cat', 'type'], '');
      mapped.description = findValue(['description', 'desc', 'details', 'summary'], '');
      mapped.status = findValue(['status', 'state', 'active'], 'active').toLowerCase();
      
      let featuredVal = findValue(['featured', 'star', 'highlight'], 'false');
      mapped.featured = String(featuredVal).toLowerCase() === 'true' || String(featuredVal) === '1';

      if (!mapped.slug && mapped.name) {
        mapped.slug = mapped.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      }

      return mapped;
    }).filter((p: any) => p.name && p.sku && p.slug);
  };

  const setupBulkForm = () => {
    const modal = document.getElementById('bulk-modal-backdrop');
    const form = document.getElementById('bulk-product-form') as HTMLFormElement;
    const fileInput = document.getElementById('bulk-file-upload') as HTMLInputElement;
    const fileNameDiv = document.getElementById('bulk-file-name');
    const fileNameText = document.getElementById('bulk-file-name-text');
    const previewContainer = document.getElementById('bulk-preview-container');
    const previewBody = document.getElementById('bulk-preview-body');
    const submitBtn = document.getElementById('bulk-submit-btn');
    const msg = document.getElementById('bulk-form-msg');
    
    if (!modal || !form || !fileInput) return;

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      form.reset();
      parsedProducts = [];
      if (fileNameDiv) fileNameDiv.classList.add('hidden');
      if (previewContainer) previewContainer.classList.add('hidden');
      if (submitBtn) submitBtn.classList.add('hidden');
      if (msg) msg.classList.add('hidden');
    };

    document.getElementById('close-bulk-modal')?.addEventListener('click', closeModal);
    document.getElementById('cancel-bulk-btn')?.addEventListener('click', closeModal);
    
    document.addEventListener('open-bulk-modal', () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    const processFile = async (file: File) => {
      if (fileNameDiv && fileNameText) {
        fileNameDiv.classList.remove('hidden');
        fileNameText.textContent = file.name;
      }

      try {
        if (file.name.endsWith('.json')) {
          const text = await file.text();
          const parsed = JSON.parse(text);
          const list = Array.isArray(parsed) ? parsed : [parsed];
          parsedProducts = intelligentMapper(list);
        } else {
          // Process Excel / CSV using XLSX
          const arrayBuffer = await file.arrayBuffer();
          const workbook = XLSX.read(arrayBuffer, { type: 'array' });
          const firstSheetName = workbook.SheetNames[0];
          const worksheet = workbook.Sheets[firstSheetName];
          const rawData = XLSX.utils.sheet_to_json(worksheet);
          parsedProducts = intelligentMapper(rawData);
        }

        if (parsedProducts.length > 0) {
          if (previewBody) {
            previewBody.innerHTML = parsedProducts.slice(0, 50).map((p: any) => `
              <tr class="border-b border-slate-100 last:border-0">
                <td class="p-2 font-medium truncate max-w-[150px]" title="${p.name}">${p.name}</td>
                <td class="p-2 text-slate-500">${p.sku}</td>
                <td class="p-2 text-slate-500 truncate max-w-[100px]">${p.slug}</td>
                <td class="p-2 text-slate-500">${p.division_slug}</td>
                <td class="p-2 text-slate-500">${p.category_slug}</td>
              </tr>
            `).join('');
            
            if (parsedProducts.length > 50) {
              previewBody.innerHTML += `
                <tr>
                  <td colspan="5" class="p-2 text-center text-xs text-slate-400 italic border-t border-slate-200">
                    + ${parsedProducts.length - 50} more rows mapped successfully.
                  </td>
                </tr>`;
            }
          }
          document.getElementById('parsed-count')!.textContent = parsedProducts.length.toString();
          if (previewContainer) previewContainer.classList.remove('hidden');
          if (submitBtn) submitBtn.classList.remove('hidden');
        } else {
          throw new Error('No valid products found. Ensure files have Name and SKU columns.');
        }
      } catch (e: any) {
        console.error("File Parse Error", e);
        if (previewContainer) previewContainer.classList.add('hidden');
        if (submitBtn) submitBtn.classList.add('hidden');
        if (msg) {
          msg.classList.remove('hidden');
          msg.className = 'p-4 rounded-lg text-sm font-semibold bg-rose-50 text-rose-700 border border-rose-200 block mt-4';
          msg.textContent = `Parse Error: ${e.message}`;
        }
      }
    };

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) processFile(file);
    });

    const newForm = form.cloneNode(true) as HTMLFormElement;
    form.parentNode?.replaceChild(newForm, form);

    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('bulk-submit-btn');
      const msgBox = document.getElementById('bulk-form-msg');
      if (!btn || !msgBox || parsedProducts.length === 0) return;

      btn.setAttribute('disabled', 'true');
      btn.textContent = 'Importing...';
      msgBox.classList.add('hidden');

      try {
        const res = await fetch('/api/products/bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(parsedProducts)
        });

        const result = await res.json();
        
        if (res.ok) {
          msgBox.className = 'p-4 rounded-lg text-sm font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 block';
          msgBox.textContent = `Successfully imported ${result.count} products!`;
          setTimeout(() => window.location.reload(), 1000);
        } else {
          throw new Error(result.error || 'Failed to import products');
        }
      } catch (err: any) {
        msgBox.className = 'p-4 rounded-lg text-sm font-semibold bg-rose-50 text-rose-700 border border-rose-200 block';
        msgBox.textContent = err.message || 'Error during import';
        btn.removeAttribute('disabled');
        btn.textContent = 'Confirm & Import';
      }
    });
  };

  setupBulkForm();
  document.addEventListener('astro:page-load', setupBulkForm);
</script>
