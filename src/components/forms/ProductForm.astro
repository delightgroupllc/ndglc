---
interface Props {
  product?: any; // If provided, acts as an edit form. Otherwise create form.
  categories: any[];
  divisions: any[];
  rooms?: any[];
}
const { product, categories, divisions } = Astro.props;
const rooms = Astro.props.rooms || [];
const isEdit = !!product;

const specs = product?.specifications ? (typeof product.specifications === 'string' ? JSON.parse(product.specifications) : product.specifications) : [];
const images = product?.images_json ? (typeof product.images_json === 'string' ? JSON.parse(product.images_json) : product.images_json) : [];
---

<form id="product-form" class="space-y-4">
  <input type="hidden" id="product-id" name="id" value={product?.id || ''} />

  <div class="space-y-1.5">
    <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Product Name</label>
    <input 
      type="text" 
      name="name" 
      required
      value={product?.name || ''}
      placeholder="e.g. Multi-stage high lift pump"
      class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors"
    />
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="space-y-1.5">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Unique SKU Code</label>
      <input 
        type="text" 
        name="sku" 
        required
        value={product?.sku || ''}
        placeholder="e.g. SKU-DTL-PUMP-003"
        class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors"
      />
    </div>
    <div class="space-y-1.5">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">URL Slug</label>
      <input 
        type="text" 
        name="slug" 
        required
        value={product?.slug || ''}
        placeholder="e.g. multi-stage-pump"
        class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors"
      />
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="space-y-1.5">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Division</label>
      <select name="division_id" required class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:outline-none">
        {divisions.map((d: any) => (
          <option value={d.id} selected={product?.division_id === d.id}>{d.name}</option>
        ))}
      </select>
    </div>
    <div class="space-y-1.5">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Category</label>
      <select name="category_id" required class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:outline-none">
        {categories.map((c: any) => (
          <option value={c.id} selected={product?.category_id === c.id}>{c.name}</option>
        ))}
      </select>
    </div>
    <div class="space-y-1.5 col-span-2">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Ideal Places / Rooms (Select multiple)</label>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 bg-slate-50 border border-slate-200 rounded-lg p-3 max-h-32 overflow-y-auto" id="ideal-rooms-checkboxes-container">
        {rooms.map(r => {
          const activeRooms = product?.ideal_room ? product.ideal_room.split(',').map((s: string) => s.trim()) : [];
          const isSelected = activeRooms.includes(r);
          return (
            <label class="flex items-center gap-2 text-xs text-slate-650 font-bold select-none cursor-pointer">
              <input 
                type="checkbox" 
                name="ideal_room_check" 
                value={r} 
                checked={isSelected}
                class="rounded border-slate-350 text-cyan-600 focus:ring-cyan-500 w-3.5 h-3.5 cursor-pointer" 
              />
              {r}
            </label>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Image Selection Option -->
  <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-4">
    <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block font-sans">Product Images (Max 3)</label>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="product-images-container">
      {[0, 1, 2].map(i => {
        const img = images[i];
        const isPrimary = img ? img.is_primary : (i === 0 && !images.length);
        const url = img ? img.url : '';
        return (
        <div class="space-y-2 border border-slate-200 bg-white p-3 rounded-lg relative">
          <label class="flex items-center gap-1.5 text-[10px] font-bold text-slate-550 uppercase">
            <input type="radio" name="primary_image_index" value={i} checked={isPrimary} class="text-cyan-600 focus:ring-cyan-500 w-3 h-3" />
            Set Primary
          </label>
          <input type="url" class="img-url-input w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-[10px] focus:border-blue-500 focus:outline-none" placeholder="Image URL..." data-index={i} value={url} />
          <div class="text-[9px] text-center text-slate-400 font-bold uppercase">- OR -</div>
          <input type="file" accept="image/*" class="img-file-input w-full text-[10px] text-slate-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-[9px] file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" data-index={i} />
          
          <div class="aspect-square w-full rounded-md bg-slate-50 border border-slate-100 flex items-center justify-center overflow-hidden mt-2 relative">
            <img class={`img-preview max-h-full max-w-full object-contain ${url ? '' : 'hidden'}`} src={url} data-index={i} />
            <div class={`img-placeholder text-[10px] text-slate-400 ${url ? 'hidden' : ''}`} data-index={i}>Empty Slot {i + 1}</div>
          </div>
        </div>
      )})}
    </div>
  </div>

  <div class="space-y-1.5">
    <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Description</label>
    <textarea 
      name="description" 
      rows="3"
      class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-colors"
    >{product?.description || ''}</textarea>
  </div>

  <!-- Dynamic specifications block -->
  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Specifications</label>
      <button type="button" id="add-spec-btn" class="text-xs font-bold text-blue-600 hover:text-blue-700 focus:outline-none">+ Add row</button>
    </div>
    
    <div id="specifications-container" class="space-y-2 max-h-40 overflow-y-auto pr-1">
      {specs.length > 0 ? specs.map((s: any) => (
        <div class="flex gap-2 spec-row">
          <input type="text" name="spec_key" value={s.key} placeholder="Key" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" />
          <input type="text" name="spec_value" value={s.value} placeholder="Value" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" />
          <button type="button" class="remove-spec-btn text-red-500 font-bold px-2">&times;</button>
        </div>
      )) : (
        <div class="flex gap-2 spec-row">
          <input type="text" name="spec_key" placeholder="Key" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" />
          <input type="text" name="spec_value" placeholder="Value" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" />
          <button type="button" class="remove-spec-btn text-red-500 font-bold px-2">&times;</button>
        </div>
      )}
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="space-y-1.5">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Featured</label>
      <select name="featured" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:outline-none">
        <option value="false" selected={!product?.featured}>Standard</option>
        <option value="true" selected={product?.featured}>Featured</option>
      </select>
    </div>
    <div class="space-y-1.5">
      <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Status</label>
      <select name="status" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:outline-none">
        <option value="active" selected={product?.status === 'active'}>Active</option>
        <option value="draft" selected={product?.status === 'draft'}>Draft</option>
        <option value="inactive" selected={product?.status === 'inactive'}>Inactive</option>
      </select>
    </div>
  </div>

  <div id="product-form-msg" class="hidden p-3 rounded-lg text-sm font-semibold"></div>

  <button 
    type="submit"
    id="product-submit-btn"
    class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg text-sm font-bold transition-colors shadow-sm"
  >
    {isEdit ? 'Update Product' : 'Save Product'}
  </button>
</form>

<script>
  const setupForm = () => {
    const form = document.getElementById('product-form') as HTMLFormElement;
    const addSpecBtn = document.getElementById('add-spec-btn');
    const container = document.getElementById('specifications-container');
    const msgBox = document.getElementById('product-form-msg');
    const submitBtn = document.getElementById('product-submit-btn');

    if (!form) return;

    // Remove existing listeners if any
    const newForm = form.cloneNode(true) as HTMLFormElement;
    form.parentNode?.replaceChild(newForm, form);

    const rebindContainer = document.getElementById('specifications-container');
    const rebindAdd = document.getElementById('add-spec-btn');

    rebindContainer?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('remove-spec-btn')) {
        target.closest('.spec-row')?.remove();
      }
    });

    rebindAdd?.addEventListener('click', () => {
      if (!rebindContainer) return;
      const specRow = document.createElement('div');
      specRow.className = 'flex gap-2 spec-row mt-2';
      specRow.innerHTML = `
        <input type="text" name="spec_key" placeholder="Key" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" />
        <input type="text" name="spec_value" placeholder="Value" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" />
        <button type="button" class="remove-spec-btn text-red-500 font-bold px-2">&times;</button>
      `;
      rebindContainer.appendChild(specRow);
    });

    const uploadedBase64s: string[] = ['', '', ''];
    const urlInputs = newForm.querySelectorAll('.img-url-input') as NodeListOf<HTMLInputElement>;
    const fileInputs = newForm.querySelectorAll('.img-file-input') as NodeListOf<HTMLInputElement>;
    const previews = newForm.querySelectorAll('.img-preview') as NodeListOf<HTMLImageElement>;
    const placeholders = newForm.querySelectorAll('.img-placeholder') as NodeListOf<HTMLElement>;

    fileInputs.forEach((fileInput, i) => {
      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (!file) return;

        // Visual progress
        placeholders[i].textContent = 'Optimizing...';
        placeholders[i].classList.remove('hidden');
        previews[i].classList.add('hidden');

        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const max = 1000;
            let width = img.width;
            let height = img.height;
            if (width > max || height > max) {
              if (width > height) {
                height = Math.round((height * max) / width);
                width = max;
              } else {
                width = Math.round((width * max) / height);
                height = max;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            
            // Draw background white in case of transparent PNGs converting to JPEG
            if (ctx) {
              ctx.fillStyle = '#FFFFFF';
              ctx.fillRect(0, 0, width, height);
              ctx.drawImage(img, 0, 0, width, height);
            }
            
            const optimizedBase64 = canvas.toDataURL('image/jpeg', 0.85);
            uploadedBase64s[i] = optimizedBase64;
            previews[i].src = optimizedBase64;
            previews[i].classList.remove('hidden');
            placeholders[i].classList.add('hidden');
            placeholders[i].textContent = `Empty Slot ${i + 1}`;
            urlInputs[i].value = ''; 
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      });
    });

    urlInputs.forEach((urlInput, i) => {
      urlInput.addEventListener('input', () => {
        const val = urlInput.value.trim();
        if (val) {
          previews[i].src = val;
          previews[i].classList.remove('hidden');
          placeholders[i].classList.add('hidden');
          uploadedBase64s[i] = '';
          fileInputs[i].value = ''; // Clear file if URL is used
        } else {
          previews[i].classList.add('hidden');
          placeholders[i].classList.remove('hidden');
        }
      });
    });

    

    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('product-form-msg');
      const btn = document.getElementById('product-submit-btn');
      if (!msg || !btn) return;

      btn.setAttribute('disabled', 'true');
      const originalText = btn.textContent;
      btn.textContent = 'Saving...';

      const formData = new FormData(newForm);
      const data: any = Object.fromEntries(formData.entries());
      
      // Map multiple ideal room checkboxes to joined comma-separated string
      const checkedRooms = Array.from(newForm.querySelectorAll('input[name="ideal_room_check"]:checked'))
        .map(el => (el as HTMLInputElement).value);
      data.ideal_room = checkedRooms.join(', ') || null;

      // Gather images
      const finalImages: {url: string, is_primary: boolean}[] = [];
      const primaryIndex = parseInt(data.primary_image_index || '0');
      for (let i = 0; i < 3; i++) {
        const url = uploadedBase64s[i] || urlInputs[i]?.value.trim();
        if (url) {
          finalImages.push({ url, is_primary: (i === primaryIndex) });
        }
      }
      data.images = finalImages;
      data.image_url = finalImages.find((img: any) => img.is_primary)?.url || finalImages[0]?.url || null;
      
      const keys = formData.getAll('spec_key');
      const vals = formData.getAll('spec_value');
      data.specifications = keys.map((k, i) => ({ key: k, value: vals[i] })).filter(s => s.key);

      const isEdit = !!data.id;
      const url = isEdit ? `/api/products/${data.id}` : '/api/products';
      const method = isEdit ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();
        
        if (res.ok) {
          msg.className = 'p-3 rounded-lg text-sm font-semibold bg-green-50 text-green-700 border border-green-200 block';
          msg.textContent = 'Product saved successfully!';
          if (!isEdit) newForm.reset();
          // Reload page to show new data in table
          setTimeout(() => window.location.reload(), 1000);
        } else {
          throw new Error(result.error || 'Failed to save');
        }
      } catch (err: any) {
        msg.className = 'p-3 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-200 block';
        msg.textContent = err.message || 'Error saving product';
      } finally {
        btn.removeAttribute('disabled');
        btn.textContent = originalText;
      }
    });
  };

  setupForm();
  document.addEventListener('astro:page-load', setupForm);
</script>
