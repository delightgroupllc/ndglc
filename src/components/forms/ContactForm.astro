---
import { query } from '../../lib/db';

let enableDtl = true;
let enableDgs = true;
try {
  const visRes = await query("SELECT key, value FROM settings WHERE key IN ('enable_dtl', 'enable_dgs')");
  visRes.rows.forEach((r: any) => {
    if (r.key === 'enable_dtl') enableDtl = r.value === 'true' || r.value === '1';
    if (r.key === 'enable_dgs') enableDgs = r.value === 'true' || r.value === '1';
  });
} catch (e) {}
---

<div class="bg-white p-6 sm:p-12 text-left space-y-6 rounded-3xl h-full flex flex-col justify-center">
  <div class="space-y-3">
    <span class="text-[10px] font-black tracking-[0.2em] text-[#b45309] uppercase block">
      Start a Conversation
    </span>
    <h3 class="text-3xl sm:text-4xl font-serif text-slate-900 font-medium">Project Inquiry</h3>
    <p class="text-xs sm:text-sm text-slate-500 font-semibold leading-relaxed">
      Share your vision with us. Whether it's a private retreat or a sustainable commercial hub, our team is ready to bring precision to your concept.
    </p>
  </div>

  <form id="contact-form" class="space-y-8 pt-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      <!-- Full Name -->
      <div class="space-y-2 relative border-b border-slate-200 focus-within:border-slate-900 transition-colors pb-1">
        <label for="name" class="block text-[9px] font-black uppercase tracking-[0.15em] text-slate-400">Full Name</label>
        <input type="text" id="name" name="name" required class="w-full bg-transparent outline-none py-1 text-sm font-semibold text-slate-800 placeholder-slate-350" placeholder="e.g. John Doe" />
      </div>
      
      <!-- Email Address -->
      <div class="space-y-2 relative border-b border-slate-200 focus-within:border-slate-900 transition-colors pb-1">
        <label for="email" class="block text-[9px] font-black uppercase tracking-[0.15em] text-slate-400">Email Address</label>
        <input type="email" id="email" name="email" required class="w-full bg-transparent outline-none py-1 text-sm font-semibold text-slate-800 placeholder-slate-350" placeholder="e.g. john@company.ae" />
      </div>
    </div>

    <!-- Project Category -->
    <div class="space-y-2 relative border-b border-slate-200 focus-within:border-slate-900 transition-colors pb-1">
      <label for="division" class="block text-[9px] font-black uppercase tracking-[0.15em] text-slate-400">Project Category</label>
      <div class="relative">
        <select id="division" name="division" class="w-full bg-transparent outline-none py-1 text-sm font-semibold text-slate-800 appearance-none cursor-pointer pr-8">
          <option value="" disabled selected>Select Project Type</option>
          {enableDtl && <option value="Technical Lighting">Technical Lighting</option>}
          {enableDgs && <option value="Greenscapes">Greenscapes</option>}
          <option value="General Corporate">General Corporate Supply</option>
        </select>
        <div class="absolute inset-y-0 right-0 flex items-center pointer-events-none text-slate-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>

    <!-- Describe Your Vision -->
    <div class="space-y-2 relative border-b border-slate-200 focus-within:border-slate-900 transition-colors pb-1">
      <label for="message" class="block text-[9px] font-black uppercase tracking-[0.15em] text-slate-400">Describe your vision</label>
      <textarea id="message" name="message" required rows="2" class="w-full bg-transparent outline-none py-1 text-sm font-semibold text-slate-800 placeholder-slate-355 resize-none" placeholder="Share a brief overview..."></textarea>
    </div>

    <!-- Consent Checkbox -->
    <div class="flex items-start gap-3 pt-2">
      <input type="checkbox" id="consent" name="consent" required class="mt-0.5 w-4 h-4 rounded border-slate-300 text-[#b45309] focus:ring-[#b45309] cursor-pointer" />
      <label for="consent" class="text-[11px] text-slate-500 font-semibold leading-relaxed cursor-pointer select-none">
        I consent to the collection and processing of my personal details as outlined in the <a href="/privacy" target="_blank" class="text-[#b45309] hover:underline font-bold">Privacy Policy</a>.
      </label>
    </div>

    <div id="form-message" class="hidden p-4 rounded-xl text-sm font-semibold"></div>

    <!-- Button -->
    <div class="pt-2">
      <button type="submit" id="submit-btn" class="px-8 py-4 bg-[#111827] hover:bg-slate-900 text-white font-extrabold text-xs uppercase tracking-widest rounded-md flex items-center justify-center gap-3 transition-colors shadow-sm group">
        <span>Send Message</span>
        <svg class="w-4 h-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const msgBox = document.getElementById('form-message');
  const btn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msgBox || !btn) return;

    btn.setAttribute('disabled', 'true');
    btn.innerHTML = '<span class="animate-pulse">Sending...</span>';
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/contacts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        msgBox.className = 'p-4 rounded-lg text-sm font-semibold bg-green-50 text-green-700 border border-green-200 block';
        msgBox.textContent = 'Thank you! Your message has been sent successfully.';
        form.reset();
      } else {
        throw new Error('Failed to send');
      }
    } catch (err) {
      msgBox.className = 'p-4 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-200 block';
      msgBox.textContent = 'Oops! Something went wrong. Please try again.';
    } finally {
      btn.removeAttribute('disabled');
      btn.innerHTML = '<span>Send Message</span><svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>';
    }
  });
</script>
