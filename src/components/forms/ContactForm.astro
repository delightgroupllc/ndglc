---
---

<div class="bg-white/85 backdrop-blur-xl border border-slate-200/60 shadow-2xl shadow-slate-200/5 rounded-2xl p-8 sm:p-10 transition-all duration-300 hover:shadow-slate-250/10 hover:border-slate-300/80">
  <div class="mb-8 text-left space-y-1">
    <h3 class="text-2xl font-bold font-display text-slate-900 leading-tight">Project Inquiry</h3>
    <p class="text-xs text-slate-500 font-medium">Submit your details and our division lead will reach out within 24 hours.</p>
  </div>

  <form id="contact-form" class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="space-y-2 text-left">
        <label for="name" class="block text-[11px] font-black uppercase tracking-wider text-slate-500">Name</label>
        <input type="text" id="name" name="name" required class="w-full bg-slate-50/60 border border-slate-200 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none rounded-xl px-4 py-3.5 text-sm font-semibold text-slate-800 placeholder-slate-405/80" placeholder="Full Name" />
      </div>
      <div class="space-y-2 text-left">
        <label for="email" class="block text-[11px] font-black uppercase tracking-wider text-slate-500">Work Email</label>
        <input type="email" id="email" name="email" required class="w-full bg-slate-50/60 border border-slate-200 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none rounded-xl px-4 py-3.5 text-sm font-semibold text-slate-800 placeholder-slate-405/80" placeholder="email@company.ae" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="space-y-2 text-left">
        <label for="phone" class="block text-[11px] font-black uppercase tracking-wider text-slate-500">Phone Number</label>
        <div class="flex shadow-sm rounded-xl overflow-hidden">
          <select class="bg-slate-50/80 border border-slate-200 border-r-0 rounded-l-xl px-3 py-3.5 text-xs font-bold text-slate-700 focus:border-blue-500 outline-none">
            <option>UAE (+971)</option>
          </select>
          <input type="tel" id="phone" name="phone" required class="w-full bg-slate-50/60 border border-slate-200 rounded-r-xl px-4 py-3.5 text-sm font-semibold text-slate-800 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all placeholder-slate-405/80" placeholder="50 000 0000" />
        </div>
      </div>
      <div class="space-y-2 text-left">
        <label for="division" class="block text-[11px] font-black uppercase tracking-wider text-slate-500">Division</label>
        <div class="relative">
          <select id="division" name="division" class="w-full bg-slate-50/60 border border-slate-200 rounded-xl px-4 py-3.5 text-sm font-semibold text-slate-800 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all appearance-none cursor-pointer">
            <option>Technical Lighting</option>
            <option>Greenscapes</option>
            <option>General Corporate</option>
          </select>
          <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-2 text-left">
      <label for="subject" class="block text-[11px] font-black uppercase tracking-wider text-slate-500">Subject</label>
      <input type="text" id="subject" name="subject" required class="w-full bg-slate-50/60 border border-slate-200 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none rounded-xl px-4 py-3.5 text-sm font-semibold text-slate-800 placeholder-slate-405/80" placeholder="What is this regarding?" />
    </div>

    <div class="space-y-2 text-left">
      <label for="message" class="block text-[11px] font-black uppercase tracking-wider text-slate-500">Message</label>
      <textarea id="message" name="message" required rows="4" class="w-full bg-slate-50/60 border border-slate-200 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none rounded-xl px-4 py-3.5 text-sm font-semibold text-slate-800 placeholder-slate-405/80 resize-none" placeholder="Brief description of your project or inquiry..."></textarea>
    </div>

    <div id="form-message" class="hidden p-4 rounded-xl text-sm font-semibold"></div>

    <button type="submit" id="submit-btn" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-extrabold tracking-wide py-4 px-6 rounded-xl flex items-center justify-center gap-2.5 transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 shadow-sm">
      <span>Send Message</span>
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const msgBox = document.getElementById('form-message');
  const btn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msgBox || !btn) return;

    btn.setAttribute('disabled', 'true');
    btn.innerHTML = '<span class="animate-pulse">Sending...</span>';
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/contacts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        msgBox.className = 'p-4 rounded-lg text-sm font-semibold bg-green-50 text-green-700 border border-green-200 block';
        msgBox.textContent = 'Thank you! Your message has been sent successfully.';
        form.reset();
      } else {
        throw new Error('Failed to send');
      }
    } catch (err) {
      msgBox.className = 'p-4 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-200 block';
      msgBox.textContent = 'Oops! Something went wrong. Please try again.';
    } finally {
      btn.removeAttribute('disabled');
      btn.innerHTML = '<span>Send Message</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>';
    }
  });
</script>
