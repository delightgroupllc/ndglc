---
---

<div id="partner-modal-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-2xl overflow-hidden transform transition-all">
    <div class="p-6 border-b border-slate-200 flex justify-between items-center bg-slate-50">
      <h3 id="partner-modal-title" class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Configure Partner
      </h3>
      <button id="close-partner-modal" class="text-slate-400 hover:text-slate-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    
    <div class="p-6">
      <form id="partner-form" class="space-y-6">
        <input type="hidden" id="partner-id" name="id" value="" />

        <div class="space-y-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Company Name</label>
            <input type="text" id="partner-name" name="name" required placeholder="e.g. Acme Logistics" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2.5 text-sm focus:border-indigo-500 focus:outline-none" />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Logo URL (Image Link)</label>
            <input type="url" id="partner-logo" name="logo_url" required placeholder="https://example.com/logo.png" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2.5 text-sm focus:border-indigo-500 focus:outline-none" />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Website URL (Optional)</label>
            <input type="url" id="partner-website" name="website_url" placeholder="https://example.com" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2.5 text-sm focus:border-indigo-500 focus:outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-200">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Visibility Pages</label>
            <p class="text-[10px] text-slate-500 mb-2">Select where this partner should appear.</p>
            <div class="space-y-2" id="partner-visibility">
              <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer"><input type="checkbox" name="visibility_pages" value="home" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" /> Home Page</label>
              <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer"><input type="checkbox" name="visibility_pages" value="about" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" /> About Us</label>
              <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer"><input type="checkbox" name="visibility_pages" value="dtl-division" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" /> DTL Division</label>
              <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer"><input type="checkbox" name="visibility_pages" value="dgs-division" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" /> DGS Division</label>
            </div>
          </div>
          
          <div class="space-y-4">
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Display Style</label>
              <select id="partner-style" name="display_style" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2.5 text-sm focus:border-indigo-500 focus:outline-none">
                <option value="grid">Grid (Standard blocks)</option>
                <option value="list">List (Vertical stack)</option>
                <option value="scroll">Scroll (Animated Marquee)</option>
              </select>
            </div>
            
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Division</label>
              <select id="partner-division" name="division" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2.5 text-sm focus:border-indigo-500 focus:outline-none">
                <option value="dtl">DTL (Delight Tech Line)</option>
                <option value="dgs">DGS (Delight Greenscapes)</option>
                <option value="both">Both Divisions</option>
              </select>
            </div>
            
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Status</label>
              <select id="partner-status" name="status" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2.5 text-sm focus:border-indigo-500 focus:outline-none">
                <option value="active">Active (Visible)</option>
                <option value="inactive">Inactive (Hidden)</option>
                <option value="archived">Archived</option>
              </select>
            </div>
          </div>
        </div>

        <div id="partner-form-msg" class="hidden p-4 rounded-lg text-sm font-semibold mt-4"></div>

        <div class="pt-6">
          <button 
            type="submit"
            id="partner-submit-btn"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl text-sm font-bold transition-colors shadow-sm"
          >
            Save Partner
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const setupPartnerForm = () => {
    const modal = document.getElementById('partner-modal-backdrop');
    const form = document.getElementById('partner-form') as HTMLFormElement;
    const closeBtn = document.getElementById('close-partner-modal');
    
    if (!modal || !form) return;

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      form.reset();
      (document.getElementById('partner-id') as HTMLInputElement).value = '';
      (document.getElementById('partner-division') as HTMLSelectElement).value = 'dtl';
      document.getElementById('partner-modal-title')!.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Add Partner';
      document.getElementById('partner-submit-btn')!.textContent = 'Save Partner';
      const msg = document.getElementById('partner-form-msg');
      if (msg) msg.classList.add('hidden');
      
      // Reset checkboxes
      document.querySelectorAll('input[name="visibility_pages"]').forEach((cb: any) => cb.checked = false);
    };

    closeBtn?.addEventListener('click', closeModal);

    document.addEventListener('open-partner-modal', ((e: CustomEvent) => {
      const p = e.detail?.partner;
      if (p) {
        document.getElementById('partner-modal-title')!.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Edit Partner';
        document.getElementById('partner-submit-btn')!.textContent = 'Update Partner';
        (document.getElementById('partner-id') as HTMLInputElement).value = p.id;
        (document.getElementById('partner-name') as HTMLInputElement).value = p.name;
        (document.getElementById('partner-logo') as HTMLInputElement).value = p.logo_url;
        (document.getElementById('partner-website') as HTMLInputElement).value = p.website_url || '';
        (document.getElementById('partner-style') as HTMLSelectElement).value = p.display_style;
        (document.getElementById('partner-status') as HTMLSelectElement).value = p.status;
        (document.getElementById('partner-division') as HTMLSelectElement).value = p.division || 'dtl';
        
        // Handle JSON array for visibility_pages
        try {
          const pages = typeof p.visibility_pages === 'string' ? JSON.parse(p.visibility_pages) : p.visibility_pages;
          if (Array.isArray(pages)) {
            document.querySelectorAll('input[name="visibility_pages"]').forEach((cb: any) => {
              cb.checked = pages.includes(cb.value);
            });
          }
        } catch(err){}
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }) as EventListener);

    const newForm = form.cloneNode(true) as HTMLFormElement;
    form.parentNode?.replaceChild(newForm, form);

    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('partner-form-msg');
      const btn = document.getElementById('partner-submit-btn');
      if (!msg || !btn) return;

      btn.setAttribute('disabled', 'true');
      const originalText = btn.textContent;
      btn.textContent = 'Saving...';

      const formData = new FormData(newForm);
      const data: any = Object.fromEntries(formData.entries());
      
      // Get array of checked checkboxes
      data.visibility_pages = formData.getAll('visibility_pages');

      const id = formData.get('id');
      const isEdit = !!id;
      const url = isEdit ? `/api/partners/${id}` : '/api/partners';
      const method = isEdit ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();
        
        if (res.ok) {
          msg.className = 'p-4 rounded-lg text-sm font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 block mt-4';
          msg.textContent = 'Partner saved successfully!';
          setTimeout(() => window.location.reload(), 800);
        } else {
          throw new Error(result.error || 'Failed to process');
        }
      } catch (err: any) {
        msg.className = 'p-4 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-200 block mt-4';
        msg.textContent = err.message || 'Error saving partner';
      } finally {
        btn.removeAttribute('disabled');
        btn.textContent = originalText;
      }
    });
  };

  setupPartnerForm();
  document.addEventListener('astro:page-load', setupPartnerForm);
</script>
