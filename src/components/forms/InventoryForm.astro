---
const { warehouses = [] } = Astro.props;
---

<div id="inventory-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden transform transition-all animate-in fade-in zoom-in-95 duration-200">
    <div class="p-5 border-b border-slate-200 flex justify-between items-center bg-slate-50">
      <div>
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider">Configure Stock Item</h3>
        <p id="inventory-modal-product-name" class="text-xs text-slate-500 font-semibold mt-1 truncate max-w-[300px]"></p>
      </div>
      <button id="close-inventory-modal" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg hover:bg-slate-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    
    <div class="p-6">
      <form id="inventory-form" class="space-y-4">
        <input type="hidden" id="inventory-id" name="inventory_id" />

        <!-- 1. Stock Adjustment Details -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-3.5">
          <div class="flex justify-between items-center text-xs font-bold text-slate-700">
            <span>Current Stock: <span id="inventory-current-stock" class="text-cyan-600 font-black">0</span> units</span>
          </div>

          <div class="space-y-1.5">
            <label class="text-[10px] font-extrabold text-slate-555 uppercase tracking-wider block">Stock Level Adjustment</label>
            <input 
              type="number" 
              name="change_amount" 
              placeholder="e.g. +15 to add, -5 to reduce, 0 for no change"
              class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none font-semibold font-mono" 
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-[10px] font-extrabold text-slate-555 uppercase tracking-wider block">Adjustment Reason</label>
            <select name="reason" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none font-bold text-slate-700">
              <option value="correction">Inventory Correction (Audit)</option>
              <option value="restock">Restock Delivery</option>
              <option value="damage">Damaged / Discarded Goods</option>
              <option value="fulfillment">Order Fulfillment</option>
            </select>
          </div>
        </div>

        <!-- 2. Storehouse Settings -->
        <div class="space-y-3.5">
          <div class="space-y-1.5">
            <label class="text-[10px] font-extrabold text-slate-550 uppercase tracking-wider block">Storehouse Branch</label>
            <select name="warehouse_id" id="inventory-warehouse-id" required class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none font-bold text-slate-700">
              {warehouses.map((wh: any) => (
                <option value={wh.id}>{wh.name} ({wh.code})</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="text-[10px] font-extrabold text-slate-550 uppercase tracking-wider block">Low Stock Alert Threshold</label>
            <input 
              type="number" 
              name="low_stock_threshold" 
              id="inventory-threshold"
              placeholder="e.g. 10"
              class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none font-semibold font-mono text-slate-700" 
            />
          </div>
        </div>

        <div id="inventory-form-msg" class="hidden p-3.5 rounded-xl text-xs font-bold mt-4"></div>

        <div class="pt-4 flex gap-3 border-t border-slate-100">
          <button 
            type="button"
            id="cancel-inventory-btn"
            class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-lg text-xs font-bold transition-colors uppercase tracking-wider"
          >
            Cancel
          </button>
          <button 
            type="submit"
            id="inventory-submit-btn"
            class="flex-1 bg-slate-900 hover:bg-slate-800 text-white py-2.5 rounded-lg text-xs font-bold transition-colors shadow-sm uppercase tracking-wider"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const setupInventoryForm = () => {
    const modal = document.getElementById('inventory-modal-backdrop');
    const form = document.getElementById('inventory-form') as HTMLFormElement;
    const closeBtn = document.getElementById('close-inventory-modal');
    const cancelBtn = document.getElementById('cancel-inventory-btn');
    
    if (!modal || !form) return;

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      form.reset();
      const msg = document.getElementById('inventory-form-msg');
      if (msg) msg.classList.add('hidden');
    };

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    
    // Listen for custom event to open modal
    document.addEventListener('open-inventory-modal', ((e: CustomEvent) => {
      const { inventoryId, productName, stockLevel, warehouseId, threshold } = e.detail || {};
      if (inventoryId) {
        (document.getElementById('inventory-id') as HTMLInputElement).value = inventoryId;
        (document.getElementById('inventory-modal-product-name') as HTMLElement).textContent = productName || 'Unknown Product';
        (document.getElementById('inventory-current-stock') as HTMLElement).textContent = String(stockLevel ?? 0);
        (document.getElementById('inventory-warehouse-id') as HTMLSelectElement).value = warehouseId || '';
        (document.getElementById('inventory-threshold') as HTMLInputElement).value = String(threshold ?? 10);
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }) as EventListener);

    // Form submission logic
    const newForm = form.cloneNode(true) as HTMLFormElement;
    form.parentNode?.replaceChild(newForm, form);

    // Cancel must attach to the cloned node — original is now detached
    newForm.querySelector('#cancel-inventory-btn')?.addEventListener('click', closeModal);

    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('inventory-form-msg');
      const btn = document.getElementById('inventory-submit-btn');
      if (!msg || !btn) return;

      btn.setAttribute('disabled', 'true');
      const originalText = btn.textContent;
      btn.textContent = 'Saving...';

      const formData = new FormData(newForm);
      const data = Object.fromEntries(formData.entries());
      data.change_amount = parseInt(data.change_amount as string) || 0;
      data.low_stock_threshold = parseInt(data.low_stock_threshold as string) || 10;

      try {
        const res = await fetch('/api/inventory', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();
        
        if (res.ok) {
          msg.className = 'p-3 rounded-lg text-xs font-bold bg-green-50 text-green-700 border border-green-200 block mt-4';
          msg.textContent = 'Inventory settings updated successfully!';
          setTimeout(() => window.location.reload(), 800);
        } else {
          throw new Error(result.error || 'Failed to update inventory');
        }
      } catch (err: any) {
        msg.className = 'p-3 rounded-lg text-xs font-bold bg-red-50 text-red-700 border border-red-200 block mt-4';
        msg.textContent = err.message || 'Error saving inventory changes';
      } finally {
        btn.removeAttribute('disabled');
        btn.textContent = originalText;
      }
    });
  };

  setupInventoryForm();
  document.addEventListener('astro:page-load', setupInventoryForm);
</script>
