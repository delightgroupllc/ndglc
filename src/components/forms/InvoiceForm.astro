---
import { query } from '../../lib/db';
interface Props {
  invoice?: any;
}
const { invoice } = Astro.props;

let products: any[] = [];
let categories: any[] = [];
let customers: any[] = [];
let companiesList: any[] = [];
let disclaimers: any[] = [];
let settings: Record<string, string> = {};
try {
  const prodRes = await query(`
    SELECT p.id, p.name, p.sku, p.category_id, pi.url as image_url, d.name as division_name
    FROM products p
    LEFT JOIN product_images pi ON pi.product_id = p.id AND pi.is_primary = TRUE
    LEFT JOIN divisions d ON p.division_id = d.id
    ORDER BY p.name ASC
  `);
  products = prodRes.rows;
  const catRes = await query(`
    SELECT c.id, c.name, d.name as division_name 
    FROM categories c 
    LEFT JOIN divisions d ON c.division_id = d.id 
    ORDER BY c.name ASC
  `);
  categories = catRes.rows;
  console.log('InvoiceForm.astro: Products loaded:', products.length, 'Categories loaded:', categories.length);
  const custRes = await query(`
    SELECT c.*, co.code as company_code 
    FROM customers c 
    LEFT JOIN companies co ON c.company_id = co.id 
    WHERE c.is_deleted = false
    ORDER BY c.name ASC
  `);
  customers = custRes.rows;
  
  const compRes = await query(`
    SELECT co.*, 
      cust.name as default_customer_name,
      cust.email as default_customer_email,
      cust.phone as default_customer_phone,
      cust.company_vat as default_customer_vat,
      cust.billing_address as default_customer_billing,
      cust.shipping_address as default_customer_shipping,
      cust.code as default_customer_code
    FROM companies co
    LEFT JOIN customers cust ON co.default_customer_id = cust.id
    WHERE (co.is_archived = false OR co.is_archived IS NULL) 
      AND (co.is_deleted = false OR co.is_deleted IS NULL)
    ORDER BY co.name ASC
  `);
  companiesList = compRes.rows;
  const legalRes = await query(`SELECT id, identifier, title, content, type, division FROM legal_artifacts WHERE show_in_invoice = TRUE ORDER BY CASE identifier WHEN 'general-terms' THEN 1 WHEN 'Acceptance of order' THEN 2 WHEN 'Illustrations, Description, Dimensions, Weight, Volume:' THEN 3 WHEN 'Designs:' THEN 4 WHEN 'Samples:' THEN 5 WHEN 'Delivery:' THEN 6 WHEN 'Cancellation:' THEN 7 WHEN 'Returns:' THEN 8 WHEN 'payment-terms' THEN 9 WHEN 'Installation :' THEN 10 WHEN 'Workmanship Warranty:' THEN 11 WHEN 'warranty' THEN 12 WHEN 'Liability' THEN 13 WHEN 'Others' THEN 14 WHEN 'Force Majeure:' THEN 15 ELSE 99 END ASC`);
  disclaimers = legalRes.rows;

  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => {
    acc[row.key] = row.value;
    return acc;
  }, {});
} catch(e) {
  console.error('InvoiceForm.astro load error:', e);
}

let signaturesList: any[] = [];
try {
  signaturesList = settings.signatures ? JSON.parse(settings.signatures) : [];
} catch (e) {}
if (signaturesList.length === 0 && settings.signatory_name) {
  signaturesList = [{
    id: 'sig_legacy',
    signatory_name: settings.signatory_name || '',
    signatory_title: settings.signatory_title || ''
  }];
}

const productsJson = JSON.stringify(products);
const categoriesJson = JSON.stringify(categories);
const disclaimersJson = JSON.stringify(disclaimers);
const companiesJson = JSON.stringify(companiesList);
---

<form id="invoice-form" class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start pb-10" novalidate>
  <input type="hidden" id="invoice-id" name="id" value="" />

  <!-- LEFT COLUMN: Config & Details -->
  <div class="xl:col-span-4 space-y-6">
    
    <!-- CARD 1: Customer Information -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
      <h4 class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Customer Information</h4>
      
      <div class="space-y-4">
        {/* Select Company */}
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Select Company</label>
          <select id="invoice-select-company" class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30 font-semibold text-slate-750">
            <option value="">-- All Companies --</option>
            {companiesList.map(comp => (
              <option value={comp.name}>{comp.name} {comp.code ? `(${comp.code})` : ''}</option>
            ))}
          </select>
        </div>

        <!-- Select Customer -->
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Select Customer</label>
          <div class="relative">
            <input type="text" id="invoice-customer-name" name="customer_name" list="customer-datalist"
              placeholder="Type to search by name or code…"
              class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30"
              autocomplete="off" />
            <datalist id="customer-datalist">
              {customers.map(c => (
                <option 
                  value={c.code ? `${c.name} (${c.code})` : c.name} 
                  data-real-name={c.name}
                  data-code={c.code||''} 
                  data-company-code={c.company_code||''} 
                  data-email={c.email||''} 
                  data-phone={c.phone||''} 
                  data-company={c.company_name||''} 
                  data-vat={c.company_vat||''} 
                  data-billing={c.billing_address||''} 
                  data-shipping={c.shipping_address||''}
                >
                  {c.code || ''} - {c.company_name ? `${c.company_name} (${c.company_code || ''})` : 'Individual'}
                </option>
              ))}
            </datalist>
            <p id="new-customer-note" class="hidden mt-1 text-[10px] font-bold text-blue-600">✦ New customer — auto-linked to company on save.</p>
            <p id="new-company-note" class="hidden mt-1 text-[10px] font-bold text-indigo-600">✦ New company — will be registered on save.</p>
          </div>
        </div>
      </div>

      <!-- Hidden System Fields -->
      <input type="hidden" id="inv-full-name" name="full_name_display" />
      <input type="hidden" id="invoice-customer-code" />
      <input type="hidden" id="invoice-company-code" />

      <!-- Expandable Contact Details -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mt-4 space-y-4">
        <h5 class="text-xs font-extrabold text-slate-500 uppercase tracking-widest flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
          Contact & Tax Details
        </h5>
        
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Email Address <span class="text-rose-500">*</span></label>
          <input type="email" id="invoice-customer-email" name="customer_email" placeholder="billing@company.com"
            class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
          <p id="email-error" class="hidden text-[10px] font-semibold text-rose-500">Required.</p>
        </div>
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Phone Number <span class="text-rose-500">*</span></label>
          <input type="tel" id="invoice-customer-phone" name="customer_phone" placeholder="+971 50 000 0000"
            class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
          <p id="phone-error" class="hidden text-[10px] font-semibold text-rose-500">Required.</p>
        </div>
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Company Name <span class="text-rose-500">*</span></label>
          <input type="text" id="invoice-company-name" name="company_name" list="company-datalist" placeholder="e.g. ACME LLC"
            class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" autocomplete="off" />
          <datalist id="company-datalist">
            {companiesList.map(c => <option value={c.name} />)}
          </datalist>
          <p id="company-name-error" class="hidden text-[10px] font-semibold text-rose-500">Required.</p>
        </div>
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">TIN / VAT <span class="text-rose-500">*</span></label>
          <input type="text" id="invoice-company-vat" name="company_vat" placeholder="100xxxxxxxxx003"
            class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30" />
          <p id="company-vat-error" class="hidden text-[10px] font-semibold text-rose-500">Required.</p>
        </div>

        <div class="space-y-1.5 pt-2">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Billing Address <span class="text-rose-500">*</span></label>
          <textarea id="invoice-billing-address" name="billing_address" rows="2"
            placeholder="Street, City, Country"
            class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30 resize-none"></textarea>
          <p id="billing-address-error" class="hidden text-[10px] font-semibold text-rose-500">Billing address is required.</p>
        </div>
        
        <div class="space-y-1.5 pt-2">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Shipping Address <span class="text-rose-500">*</span></label>
            <label class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 cursor-pointer">
              <input type="checkbox" id="shipping-same-as-billing" class="rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 w-3.5 h-3.5" checked />
              Same as Billing
            </label>
          </div>
          <div id="shipping-address-container" class="hidden">
            <textarea id="invoice-shipping-address" name="shipping_address" rows="2"
              placeholder="Street, City, Country"
              class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500/30 resize-none"></textarea>
            <p id="shipping-address-error" class="hidden text-[10px] font-semibold text-rose-500">Shipping address is required.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CARD 2: Metadata -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
      <h4 class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Metadata</h4>
      
      <div class="space-y-4">
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Order Type</label>
          <select name="order_type" id="inv-order-type"
            class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none">
            <option value="standard">INV (Invoice)</option>
            <option value="proforma">PFI - Pro Forma</option>
            <option value="lpo">PO / LPO (Purchase Order)</option>
            <option value="delivery_note">DLN (Delivery Note)</option>
            <option value="tax_invoice">BILL - Commercial Bill</option>
            <option value="quotation">EST - Estimation/Quote</option>
          </select>
        </div>
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Source Division <span class="text-rose-500">*</span></label>
          <select name="source_division" id="inv-source-division"
            class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none">
            <option value="">-- Select Division --</option>
            <option value="DTL">Division DTL</option>
            <option value="DGS">Division DGS</option>
            <option value="both">Both Divisions</option>
          </select>
          <p id="source-division-error" class="hidden text-[10px] font-semibold text-rose-500">Source Division is required.</p>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Issue Date <span class="text-rose-500">*</span></label>
            <input type="date" id="invoice-issue-date" name="issue_date"
              class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none" />
            <p id="issue-date-error" class="hidden text-[10px] font-semibold text-rose-500">Required.</p>
          </div>
          <div class="space-y-1.5" id="due-date-container">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Due Date <span class="text-rose-500">*</span></label>
            <input type="date" id="invoice-due-date" name="due_date"
              class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none" />
            <p id="due-date-error" class="hidden text-[10px] font-semibold text-rose-500">Required.</p>
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Signatory Incharge <span class="text-rose-500">*</span></label>
          <select name="signatory_incharge" id="invoice-signatory-incharge"
            class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none font-semibold text-slate-700">
            <option value="">-- Select Signatory --</option>
            <option value="any" selected>Any (Authorized Signatory Only)</option>
            {signaturesList.map((s: any) => (
              <option value={s.id}>{s.signatory_name} ({s.signatory_title})</option>
            ))}
          </select>
          <p id="signatory-error" class="hidden text-[10px] font-semibold text-rose-500">Required.</p>
        </div>

        <div class="space-y-1.5 pt-2 border-t border-slate-100">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Ref PO / LPO No</label>
          <input type="text" id="invoice-lpo-number" name="lpo_number" placeholder="e.g. PO#00000859"
            class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none" />
        </div>
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Quotation Ref</label>
          <input type="text" id="invoice-quotation-ref" name="quotation_ref" placeholder="e.g. QT-2026-4819"
            class="invoice-field w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none" />
        </div>
      </div>
    </div>

    <!-- CARD 3: Disclaimers & Notes -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
      <h4 class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Notes & Terms</h4>
      
      <div class="space-y-4">
        <details class="group space-y-3">
          <summary class="text-xs font-black text-cyan-800 uppercase tracking-wider flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden p-4 bg-cyan-50/50 hover:bg-cyan-100/50 border border-cyan-100 rounded-xl transition-all shadow-sm">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Disclaimers & Terms (Page 2)
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-600 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          
          <div class="pt-2 pb-2 space-y-4">
            <input type="hidden" id="invoice-payment-terms" name="payment_terms" value="" />
            
            <!-- DTL Terms -->
            <div class="space-y-2" id="dtl-terms-group">
              <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block border-b pb-1 border-slate-100">DTL Terms</span>
              <div class="space-y-2">
                {disclaimers.filter(d => d.division === 'dtl').map((d, idx) => (
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100/50 cursor-pointer transition-all hover:border-slate-300 disclaimer-item">
                    <input type="checkbox" data-identifier={d.identifier} class="disclaimer-toggle-checkbox rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 mt-0.5" />
                    <div>
                      <span class="text-xs font-bold text-slate-800 block">{d.title}</span>
                      <span class="text-[10px] text-slate-500 line-clamp-2 mt-0.5 leading-relaxed">{d.content}</span>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <!-- DGS Terms -->
            <div class="space-y-2" id="dgs-terms-group">
              <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block border-b pb-1 border-slate-100">DGS Terms</span>
              <div class="space-y-2">
                {disclaimers.filter(d => d.division === 'dgs').map((d, idx) => (
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100/50 cursor-pointer transition-all hover:border-slate-300 disclaimer-item">
                    <input type="checkbox" data-identifier={d.identifier} class="disclaimer-toggle-checkbox rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 mt-0.5" />
                    <div>
                      <span class="text-xs font-bold text-slate-800 block">{idx + 1}. {d.title}</span>
                      <span class="text-[10px] text-slate-500 line-clamp-2 mt-0.5 leading-relaxed">{d.content}</span>
                    </div>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </details>

        <div class="space-y-2 pt-2 border-t border-slate-100">
          <label class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Internal Notes</label>
          <textarea name="internal_notes" id="inv-internal-notes" rows="3"
            placeholder="Internal remarks (not shown on printed invoice)…"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 hover:bg-white transition-colors text-slate-900 p-4 text-sm focus:border-cyan-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-500/20 resize-y shadow-sm"></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT COLUMN: Items & Summary -->
  <div class="xl:col-span-8 space-y-6">
    
    <!-- CARD 4: Line Items -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-100">
        <h4 class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Items</h4>
        <div class="flex items-center gap-4">
          <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-600 cursor-pointer">
            <input type="checkbox" id="invoice-show-images" name="show_images" class="rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" />
            Show Product Images
          </label>
          <button type="button" id="add-invoice-item-btn"
            class="inline-flex items-center gap-1.5 text-xs font-bold bg-cyan-50 hover:bg-cyan-100 text-cyan-700 px-3 py-1.5 rounded-lg transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Add Row
          </button>
        </div>
      </div>

      <script type="application/json" id="invoice-form-products-data" set:html={productsJson}></script>
      <script type="application/json" id="invoice-form-categories-data" set:html={categoriesJson}></script>
      <script type="application/json" id="invoice-form-disclaimers-data" set:html={disclaimersJson}></script>
      <script type="application/json" id="invoice-form-companies-data" set:html={companiesJson}></script>

      <div id="invoice-items-container" class="space-y-3 pt-2">
        <!-- Rows injected by JS -->
      </div>

      <p id="items-error" class="hidden text-xs font-semibold text-rose-500 bg-rose-50 border border-rose-200 rounded-lg px-3 py-2 mt-2">
        ⚠ At least one complete line item is required.
      </p>
    </div>

    <!-- CARD 5: Summary & Submission -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      
      <!-- Summary Row -->
      <div class="p-6 bg-slate-50 flex flex-col md:flex-row gap-8 justify-between">
        
        <!-- Payment Status -->
        <div class="space-y-6 flex-1">
          <div class="space-y-1.5 max-w-[200px]">
            <label class="text-xs font-extrabold text-slate-400 uppercase tracking-widest block">Payment Status</label>
            <select name="payment_status" id="invoice-payment-status"
              class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2.5 text-sm focus:border-cyan-500 focus:outline-none font-semibold text-slate-700 shadow-sm">
              <option value="unpaid">Unpaid</option>
              <option value="paid">Paid</option>
              <option value="overdue">Overdue</option>
              <option value="draft">Draft</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>
        </div>

        <!-- Totals -->
        <div class="space-y-3 flex-1 max-w-[300px]">
          <h4 class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Totals</h4>
          <div class="bg-white border border-slate-200 rounded-xl p-5 space-y-3 shadow-sm">
            <div class="flex justify-between text-sm text-slate-600">
              <span>Subtotal</span>
              <span class="font-semibold"><span id="summary-subtotal">0.00</span> <span class="text-slate-400 text-[10px]">EXCL</span></span>
            </div>
            <div class="flex justify-between text-sm text-slate-600">
              <span>Tax / VAT</span>
              <span class="font-semibold text-amber-600">+ <span id="summary-tax">0.00</span></span>
            </div>
            <div class="flex justify-between text-sm text-slate-600 items-center gap-2">
              <div class="flex items-center gap-1.5">
                <span class="font-medium">Discount</span>
                <select id="inv-discount-type" name="discount_type" class="rounded border border-slate-300 bg-slate-50 px-1 py-0.5 text-xs font-semibold focus:outline-none text-slate-700">
                  <option value="fixed">AED</option>
                  <option value="percentage">%</option>
                </select>
              </div>
              <input type="number" id="inv-discount" name="discount_value" min="0" step="0.01" value="0"
                class="w-20 text-right rounded border border-slate-300 bg-white text-slate-900 px-2 py-1 text-sm focus:border-cyan-500 focus:outline-none font-medium" />
            </div>
            <div class="border-t border-slate-200 pt-3 flex justify-between items-center">
              <span class="font-bold text-slate-900">Grand Total</span>
              <span class="text-lg font-extrabold text-cyan-700">AED <span id="summary-total">0.00</span></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Messages -->
      <div id="invoice-form-msg" class="hidden p-4 m-6 rounded-xl text-sm font-semibold"></div>

      <!-- Footer Buttons -->
      <div class="p-5 border-t border-slate-200 flex flex-wrap gap-3 justify-end items-center bg-white">
        <button type="button" id="cancel-invoice-btn"
          class="px-5 py-2.5 rounded-xl text-sm font-bold bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-700 transition-colors">
          Cancel
        </button>
        <button type="button" id="invoice-draft-btn"
          class="px-5 py-2.5 rounded-xl text-sm font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 transition-colors">
          Save as Draft
        </button>
        <button type="submit" id="invoice-submit-btn"
          class="px-6 py-2.5 rounded-xl text-sm font-bold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors shadow-sm">
          Generate Invoice
        </button>
      </div>

    </div>
  </div>
</form>
</div>

<!-- SUCCESS DIALOG MODAL -->
