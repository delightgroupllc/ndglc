---
interface Props {
  src: string;           // iframe src path e.g. "/contact"
  urlLabel?: string;     // friendly URL shown in the browser bar
  iframeId: string;      // unique id for the iframe element
  refreshBtnId: string;  // unique id for refresh button
}

const { src, urlLabel, iframeId, refreshBtnId } = Astro.props;
const displayUrl = urlLabel || `delightgroupllc.com${src}`;
---

<!-- Full-height preview panel with viewport switcher -->
<div id={`${iframeId}-container`} class="flex flex-col h-[calc(100vh-32px)] bg-slate-900 rounded-2xl border border-slate-800 shadow-2xl overflow-hidden">
  
  <!-- Browser chrome top bar -->
  <div class="shrink-0 bg-slate-950 px-3 py-2 border-b border-slate-800 flex items-center gap-2">
    <!-- Traffic lights -->
    <div class="flex items-center gap-1.5 shrink-0">
      <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-green-500/80"></div>
    </div>

    <!-- URL bar -->
    <div class="flex-1 mx-2 bg-slate-800 rounded-md px-3 py-1 flex items-center min-w-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-slate-500 shrink-0 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <span class="text-[10px] text-slate-400 font-mono truncate">{displayUrl}</span>
    </div>

    <!-- Viewport switcher -->
    <div class="flex items-center bg-slate-800 rounded-lg p-0.5 shrink-0">
      <!-- Desktop -->
      <button type="button" class="viewport-btn-preview active px-2 py-1 rounded text-cyan-400 transition-all" data-viewport="desktop" title="Desktop">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
        </svg>
      </button>
      <!-- Tablet -->
      <button type="button" class="viewport-btn-preview px-2 py-1 rounded text-slate-500 hover:text-slate-300 transition-all" data-viewport="tablet" title="Tablet (768px)">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="4" y="2" width="16" height="20" rx="2"/><circle cx="12" cy="18" r="1"/>
        </svg>
      </button>
      <!-- Mobile -->
      <button type="button" class="viewport-btn-preview px-2 py-1 rounded text-slate-500 hover:text-slate-300 transition-all" data-viewport="mobile" title="Mobile (390px)">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="5" y="2" width="14" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Refresh button -->
    <button type="button" id={refreshBtnId} class="shrink-0 text-slate-500 hover:text-white transition-colors p-1 rounded" title="Reload preview">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
    </button>
  </div>

  <!-- Loading indicator -->
  <div id={`${iframeId}-loader`} class="hidden absolute inset-0 bg-slate-900/60 backdrop-blur-sm z-10 items-center justify-center">
    <div class="w-7 h-7 border-3 border-indigo-200 border-t-indigo-500 rounded-full animate-spin"></div>
  </div>

  <!-- Iframe canvas -->
  <div class="flex-1 relative bg-slate-950 flex items-center justify-center overflow-hidden p-0">
    <div id={`${iframeId}-wrapper`} class="w-full h-full relative shadow-2xl transition-all duration-300 ease-in-out">
      <iframe
        id={iframeId}
        src={src}
        class="w-full h-full border-0 bg-white block"
        style="overflow:hidden;"
      ></iframe>
    </div>
  </div>
</div>

<script define:vars={{ iframeId, refreshBtnId }}>
  (() => {
    const wrapper   = document.getElementById(`${iframeId}-wrapper`);
    const frame     = document.getElementById(iframeId);
    const refreshBtn = document.getElementById(refreshBtnId);
    
    // Scope button queries to current container to avoid collision
    const container = document.getElementById(`${iframeId}-container`);
    const vpBtns    = container ? container.querySelectorAll('.viewport-btn-preview') : [];

    // Viewport switcher
    vpBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        vpBtns.forEach(b => {
          b.classList.remove('active', 'text-cyan-400');
          b.classList.add('text-slate-500');
        });
        btn.classList.add('active', 'text-cyan-400');
        btn.classList.remove('text-slate-500');

        const vp = btn.getAttribute('data-viewport');
        if (!wrapper) return;
        if (vp === 'desktop') {
          wrapper.className = 'w-full h-full relative shadow-2xl transition-all duration-300 ease-in-out';
        } else if (vp === 'tablet') {
          wrapper.className = 'w-[768px] h-[95%] relative shadow-2xl transition-all duration-300 ease-in-out border border-slate-700 rounded-lg overflow-hidden';
        } else {
          wrapper.className = 'w-[390px] h-[85%] relative shadow-2xl transition-all duration-300 ease-in-out border border-slate-700 rounded-2xl overflow-hidden';
        }
      });
    });

    // Refresh
    const doRefresh = () => {
      if (!frame) return;
      const base = (frame as HTMLIFrameElement).src.split('?')[0];
      (frame as HTMLIFrameElement).src = `${base}?t=${Date.now()}`;
    };

    refreshBtn?.addEventListener('click', doRefresh);

    // Expose refresh globally so parent page scripts can call it
    (window as any)[`refresh_${iframeId}`] = doRefresh;
  })();
</script>
