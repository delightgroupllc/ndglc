---
import { FileText, Download } from '@lucide/astro';
 
interface DownloadItem {
  title: string;
  category: string;
  size: string;
  url: string;
}
 
interface Props {
  badge: string;
  badgeColor?: 'blue' | 'green';
  titleStart: string;
  titleAccent: string;
  description: string;
  items: DownloadItem[];
}
 
const { badge, badgeColor = 'blue', titleStart, titleAccent, description, items } = Astro.props;
 
const isDtl = badgeColor === 'blue';
const badgeClasses = isDtl 
  ? 'bg-amber-500/10 text-amber-700 border border-amber-500/20' 
  : 'bg-emerald-500/10 text-emerald-700 border border-emerald-500/20';
const titleAccentClasses = isDtl ? 'text-amber-600' : 'text-emerald-700';
const activeBtnHoverClass = isDtl 
  ? 'hover:bg-amber-500 hover:shadow-amber-500/10' 
  : 'hover:bg-emerald-600 hover:shadow-emerald-600/10';
const activeIconHoverClass = isDtl ? 'group-hover:text-amber-500 group-hover:bg-amber-500/5 group-hover:border-amber-500/10' : 'group-hover:text-emerald-650 group-hover:bg-emerald-500/5 group-hover:border-emerald-500/10';
---
 
<div class="bg-white/80 backdrop-blur-xl border border-slate-200/60 shadow-xl shadow-slate-200/5 rounded-2xl p-8 sm:p-10 relative overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-slate-300/10 hover:border-slate-300 hover:-translate-y-1">
  <!-- Top glow overlay -->
  <div class={`absolute top-0 right-0 -mr-16 -mt-16 w-32 h-32 rounded-full opacity-35 blur-2xl ${isDtl ? 'bg-amber-400' : 'bg-emerald-400'}`}></div>
 
  <!-- Header -->
  <div class="mb-8 relative z-10 text-left">
    <span class={`inline-block px-3 py-1 text-[10px] font-black tracking-widest uppercase rounded-full ${badgeClasses} mb-4`}>
      {badge}
    </span>
    <h2 class="text-2xl sm:text-3xl font-extrabold font-display tracking-tight text-slate-900 mb-2 leading-none">
      {titleStart} <span class={titleAccentClasses}>{titleAccent}</span>
    </h2>
    <p class="text-xs sm:text-sm text-slate-500 leading-relaxed max-w-sm font-medium mt-3">
      {description}
    </p>
  </div>
 
  <!-- Items -->
  <div class="space-y-4 relative z-10">
    {items.length === 0 ? (
      <div class="p-6 rounded-xl border border-slate-100 bg-slate-50/50 text-center text-xs text-slate-500 font-semibold">
        No documents available in this section yet.
      </div>
    ) : (
      items.map(item => (
        <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50/50 border border-slate-100 hover:bg-white hover:border-slate-200 hover:shadow-md transition-all duration-300 group">
          <div class="flex items-center gap-4 text-left">
            <div class={`w-10 h-10 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-slate-400 transition-all duration-300 shrink-0 ${activeIconHoverClass}`}>
              <FileText class="w-5 h-5" />
            </div>
            <div>
              <h4 class="text-xs sm:text-sm font-bold text-slate-800 line-clamp-1">{item.title}</h4>
              <div class="flex items-center gap-2 mt-1">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">{item.category}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-200 shrink-0"></span>
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider">{item.size}</span>
              </div>
            </div>
          </div>
          <a 
            href={item.url}
            class={`flex items-center gap-1.5 px-4 py-2 bg-slate-900 text-white rounded-lg text-xs font-bold uppercase tracking-wider transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 shadow-sm shrink-0 ${activeBtnHoverClass}`}
            download
          >
            <Download class="w-3.5 h-3.5" />
            <span>Get File</span>
          </a>
        </div>
      ))
    )}
  </div>
</div>
