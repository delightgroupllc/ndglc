---
interface Props {
  iconType: 'lighting' | 'greenscapes';
  titleStart: string;
  titleAccent: string;
  description: string;
  features: string[];
  link: string;
}

const { iconType, titleStart, titleAccent, description, features, link } = Astro.props;

// Use SVG paths for simplicity
const LightingIcon = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`;
const PlantIcon = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`; // Sparkles for now, or actual plant icon if available

const iconSvg = iconType === 'lighting' ? LightingIcon : PlantIcon;
const iconBg = iconType === 'lighting' ? 'bg-amber-50 text-amber-500' : 'bg-green-50 text-green-500';
---

<div class="bg-white border border-slate-200 rounded-xl p-8 sm:p-10 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full group">
  <div class={`w-12 h-12 rounded-full flex items-center justify-center mb-6 ${iconBg} transform group-hover:scale-110 transition-transform duration-300`}>
    <Fragment set:html={iconSvg} />
  </div>

  <h3 class="text-xl font-bold font-display text-slate-900 mb-4 tracking-tight">
    {titleStart} <span class={iconType === 'lighting' ? 'text-amber-500' : 'text-green-500'}>{titleAccent}</span>
  </h3>

  <p class="text-sm text-slate-500 leading-relaxed mb-8 flex-grow">
    {description}
  </p>

  <ul class="space-y-3 mb-8">
    {features.map(feature => (
      <li class="flex items-start gap-3 text-xs font-bold text-slate-700 uppercase tracking-wider">
        <span class={`mt-0.5 w-1.5 h-1.5 rounded-full flex-shrink-0 ${iconType === 'lighting' ? 'bg-amber-500' : 'bg-green-500'}`}></span>
        {feature}
      </li>
    ))}
  </ul>

  <a href={link} class={`inline-flex items-center text-xs font-bold uppercase tracking-widest ${iconType === 'lighting' ? 'text-amber-500 hover:text-amber-600' : 'text-green-500 hover:text-green-600'} transition-colors group-hover:underline underline-offset-4 decoration-2`}>
    View Division &rarr;
  </a>
</div>
