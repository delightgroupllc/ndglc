---
interface Props {
  class?: string;
}
import 'dirham/css';
const { class: className = '' } = Astro.props;

// Map Tailwind SVG sizing to font sizing
const mappedClass = className
  .replace(/w-5|h-5/g, 'text-xl')
  .replace(/w-4|h-4/g, 'text-base')
  .replace(/w-3\.5|h-3\.5/g, 'text-sm')
  .replace(/w-3|h-3/g, 'text-xs')
  .replace(/w-6|h-6/g, 'text-2xl')
  .replace(/w-7|h-7/g, 'text-3xl');
---
<span class={`dirham-symbol ${mappedClass}`}></span>
