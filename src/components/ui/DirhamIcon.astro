---
interface Props {
  class?: string;
}
import 'dirham/css';
const { class: className = '' } = Astro.props;

// Map Tailwind SVG sizing to font sizing and inline-flex alignment
const mappedClass = className
  .replace(/w-6\s*h-6|h-6\s*w-6|w-6/g, 'text-xl leading-none')
  .replace(/w-5\s*h-5|h-5\s*w-5|w-5/g, 'text-lg leading-none')
  .replace(/w-4\s*h-4|h-4\s*w-4|w-4/g, 'text-sm leading-none')
  .replace(/w-3\.5\s*h-3\.5|h-3\.5\s*w-3\.5/g, 'text-xs leading-none')
  .replace(/w-3\s*h-3|h-3\s*w-3/g, 'text-[11px] leading-none')
  .replace(/w-2\.5\s*h-2\.5|h-2\.5\s*w-2\.5/g, 'text-[10px] leading-none')
  .replace(/w-7\s*h-7|h-7\s*w-7/g, 'text-2xl leading-none');
---
<span class={`dirham-symbol inline-flex items-center justify-center font-normal not-italic select-none align-middle ${mappedClass}`}></span>
