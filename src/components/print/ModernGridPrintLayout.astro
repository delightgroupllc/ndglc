---
interface Props {
  inv: any;
  items: any[];
  settings: Record<string, string>;
  logoColor: string;
  isDGS: boolean;
  companyNameEN: string;
  companyNameAR: string;
  websiteURL: string;
  amountInWords: string;
  totalQty: number;
  documentTitle: string;
  selectedClauses?: any[];
  signatureImage?: string;
  isCustomerDeleted?: boolean;
}
const { inv, items, settings, logoColor, isDGS, companyNameEN, companyNameAR, websiteURL, amountInWords, totalQty, documentTitle, selectedClauses = [], signatureImage, isCustomerDeleted = false } = Astro.props;

// Determine items fit limits
const maxItemsPage1 = inv.order_type === 'delivery_note' ? 9 : 5;
const maxItemsSubsequent = 12;

// Split items list into pages
const pagesOfItems: any[][] = [];
if (items.length <= maxItemsPage1) {
  pagesOfItems.push(items);
} else {
  pagesOfItems.push(items.slice(0, maxItemsPage1));
  let index = maxItemsPage1;
  while (index < items.length) {
    pagesOfItems.push(items.slice(index, index + maxItemsSubsequent));
    index += maxItemsSubsequent;
  }
}

const totalPages = pagesOfItems.length + 1; // +1 for Terms of Sale page

const getClause = (identifier: string, fallback: string): string => {
  const clause = selectedClauses.find((c: any) => c.identifier === identifier);
  return clause ? clause.content : fallback;
};

let activeTerms: string[] = [];
try {
  activeTerms = inv.payment_terms ? JSON.parse(inv.payment_terms) : [];
} catch (e) {
  if (typeof inv.payment_terms === 'string') {
    activeTerms = inv.payment_terms.split(',').map((t: string) => t.trim());
  }
}

const isTermActive = (identifier: string): boolean => {
  if (!inv.payment_terms) return true;
  return activeTerms.includes(identifier);
};
---

<div id="layout-delightgroupllc" class="delightgroupllc-container w-full flex flex-col items-center gap-8">
  {pagesOfItems.map((pageItems, pageIdx) => {
    const isFirstPage = pageIdx === 0;
    const isLastPage = pageIdx === pagesOfItems.length - 1;
    const pageNumber = pageIdx + 1;

    return (
      <div class="print-page bg-white shadow-xl border border-slate-250 p-12 relative print:p-0 print:border-none print:shadow-none mb-8">
        <!-- Faint Brand Watermark Centered Behind Page Content -->
        <div class="delightgroupllc-watermark print-watermark">
          <img src="/dgllclogolarge.png" id="watermark-img" style="width: 100%; height: auto; object-fit: contain; opacity: 0.06;" />
        </div>

        {isFirstPage ? (
          <!-- Header (Full Logo + Address) -->
          <table class="delightgroupllc-header">
            <tr>
              <td class="delightgroupllc-logo-td">
                <div class="delightgroupllc-logo-svg-wrapper print-logo-container">
                  <img src={isDGS ? '/dgslogo.jpg' : '/dtllogo.jpg'} class="h-28 w-auto object-contain" id="print-company-logo" />
                </div>
              </td>
              <td class="delightgroupllc-address-td">
                <div class="delightgroupllc-company-name-ar">{companyNameAR}</div>
                <div class="delightgroupllc-company-name-en">{companyNameEN}</div>
                <span class="delightgroupllc-website" style={`color: ${logoColor}`}>{websiteURL}</span>
                <div style="margin-top: 3px; line-height: 1.35; color: #475569;">
                  <span id="print-company-address-arr">{settings.business_address || settings.company_address || 'Delight Group Building, Al Quoz Industrial Area 3, Dubai, UAE'}</span><br>
                  <span id="print-company-reg-arr-wrapper" class={settings.business_registration ? "" : "hidden"}>Reg: <span id="print-company-reg-arr">{settings.business_registration || ''}</span> | </span>
                  <span id="print-company-permits-arr-wrapper" class={settings.permits_info ? "" : "hidden"}>Permits: <span id="print-company-permits-arr" class="italic">{settings.permits_info || ''}</span> | </span>
                  <span id="print-company-phone-arr-type">{settings.phone_type || 'Tel'}</span>: <span id="print-company-phone-arr">{settings.phone_number || settings.contact_phone || '+971 (4) 555-0100'}</span> | Email: {settings.contact_email || 'sales@delightgroupllc.com'}
                </div>
              </td>
            </tr>
          </table>

          <!-- Document Title -->
          <div class="delightgroupllc-doc-title-section">
            <h1 class="delightgroupllc-doc-title">{documentTitle}</h1>
            <p class="delightgroupllc-trn-label">TRN NO: <span id="print-company-trn-arr">{settings.trn_number || '105441325500003'}</span></p>
          </div>

          <!-- Details Grid Box -->
          <table class="delightgroupllc-grid-table">
            <tr>
              <!-- Customer Details -->
              <td class="delightgroupllc-grid-td">
                <table class="delightgroupllc-field-table">
                  <tr>
                    <td class="delightgroupllc-field-label">Customer Code:</td>
                    <td class="delightgroupllc-field-value">CUS-{inv.customer_phone ? inv.customer_phone.replace(/\D/g, '').slice(-6) : '002334'}</td>
                  </tr>
                  <tr class="print-cust-company">
                    <td class="delightgroupllc-field-label">Customer Name:</td>
                    <td class="delightgroupllc-field-value uppercase">{inv.customer_name}{isCustomerDeleted ? '*' : ''}</td>
                  </tr>
                  <tr class="print-cust-company">
                    <td class="delightgroupllc-field-label">Contact Name:</td>
                    <td class="delightgroupllc-field-value uppercase">{inv.company_name || inv.customer_name}</td>
                  </tr>
                  <tr class="print-cust-address">
                    <td class="delightgroupllc-field-label">Customer Address:</td>
                    <td class="delightgroupllc-field-value uppercase" style="white-space: pre-line;">{inv.billing_address || 'DUBAI, UAE'}</td>
                  </tr>
                  <tr class="print-cust-contact">
                    <td class="delightgroupllc-field-label">Contact Number:</td>
                    <td class="delightgroupllc-field-value">{inv.customer_phone || '—'}</td>
                  </tr>
                  <tr class="print-cust-trn">
                    <td class="delightgroupllc-field-label">TRN Number:</td>
                    <td class="delightgroupllc-field-value font-mono">{inv.company_vat || '—'}</td>
                  </tr>
                </table>
              </td>

              <!-- Order Metadata -->
              <td class="delightgroupllc-grid-td">
                <table class="delightgroupllc-field-table">
                  {inv.order_type === 'delivery_note' ? (
                    <tr>
                      <td class="delightgroupllc-field-label">Delivery Note Number:</td>
                      <td class="delightgroupllc-field-value font-mono">{inv.invoice_number}</td>
                    </tr>
                    <tr class="print-info-date">
                      <td class="delightgroupllc-field-label">Delivery Date:</td>
                      <td class="delightgroupllc-field-value">{new Date(inv.issue_date).toLocaleDateString('en-GB').replace(/\//g, '-')}</td>
                    </tr>
                    <tr class="print-info-status">
                      <td class="delightgroupllc-field-label">Sales Person:</td>
                      <td class="delightgroupllc-field-value">{settings.signatory_name || 'Management'}</td>
                    </tr>
                    <tr class="print-info-due">
                      <td class="delightgroupllc-field-label">Sales Person Contact:</td>
                      <td class="delightgroupllc-field-value">{settings.contact_phone || '—'}</td>
                    </tr>
                    <tr>
                      <td class="delightgroupllc-field-label">LPO Number:</td>
                      <td class="delightgroupllc-field-value font-mono">{inv.lpo_number || '—'}</td>
                    </tr>
                    <tr>
                      <td class="delightgroupllc-field-label">Invoice Reference:</td>
                      <td class="delightgroupllc-field-value font-mono">{inv.invoice_number}</td>
                    </tr>
                  ) : (
                    <tr class="print-info-date">
                      <td class="delightgroupllc-field-label">Invoice Date:</td>
                      <td class="delightgroupllc-field-value">{new Date(inv.issue_date).toLocaleDateString('en-GB').replace(/\//g, '-')}</td>
                    </tr>
                    <tr>
                      <td class="delightgroupllc-field-label">Invoice Number:</td>
                      <td class="delightgroupllc-field-value font-mono">{inv.invoice_number}</td>
                    </tr>
                    <tr class="print-info-status">
                      <td class="delightgroupllc-field-label">Sales Person:</td>
                      <td class="delightgroupllc-field-value">{settings.signatory_name || 'Management'}</td>
                    </tr>
                    <tr class="print-info-status">
                      <td class="delightgroupllc-field-label">Sales Person Contact:</td>
                      <td class="delightgroupllc-field-value">{settings.contact_phone || '—'}</td>
                    </tr>
                    <tr>
                      <td class="delightgroupllc-field-label">LPO Number:</td>
                      <td class="delightgroupllc-field-value font-mono">{inv.lpo_number || '—'}</td>
                    </tr>
                    <tr class="print-info-due">
                      <td class="delightgroupllc-field-label">Quotation Reference:</td>
                      <td class="delightgroupllc-field-value font-mono">{inv.lpo_number || '—'}</td>
                    </tr>
                  )}
                </table>
              </td>
            </tr>
          </table>
        ) : (
          <!-- Compact Continuation Header -->
          <table class="delightgroupllc-header w-full" style="margin-bottom: 20px; border-bottom: 1.5px solid #000000; padding-bottom: 8px;">
            <tr>
              <td>
                <img src={isDGS ? '/dgslogo.jpg' : '/dtllogo.jpg'} class="h-12 w-auto object-contain" />
              </td>
              <td class="text-right" style="vertical-align: middle; font-size: 9pt; font-weight: 700;">
                {documentTitle} - {inv.invoice_number} (Continuation Page {pageNumber} of {totalPages})
              </td>
            </tr>
          </table>
        )}

        <!-- TABLE SECTION -->
        {inv.order_type === 'delivery_note' ? (
          <table class="delightgroupllc-table">
            <thead>
              <tr>
                <th style="width: 7%; text-align: center;">Sl.No</th>
                <th style="width: 15%; text-align: center;" class="print-item-cat-ref">SKU No</th>
                <th style="width: 48%; text-align: left;">Product Description</th>
                <th style="width: 12%; text-align: center;">Warehouse</th>
                <th style="width: 8%; text-align: center;">Units</th>
                <th style="width: 10%; text-align: center;">Quantity</th>
              </tr>
            </thead>
            <tbody>
              {pageItems.map((item, idx) => {
                const globalIdx = pageIdx * maxItemsPage1 + idx + 1;
                return (
                  <tr>
                    <td class="text-center">{globalIdx}</td>
                    <td class="text-center font-mono print-item-cat-ref">{item.catalogue_ref || '—'}</td>
                    <td class="font-bold uppercase">
                      <span class="block">{item.description}</span>
                      {item.tech_spec && <span class="print-item-tech-spec block text-slate-500 font-normal mt-0.5" style="font-size: 7.5pt; text-transform: none;">Specs: {item.tech_spec}</span>}
                    </td>
                    <td class="text-center">DES</td>
                    <td class="text-center">PCS</td>
                    <td class="font-bold text-center">{item.quantity}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        ) : (
          <table class="delightgroupllc-table">
            <thead>
              <tr>
                <th style="width: 5%; text-align: center;">S/No</th>
                <th style="width: 10%; text-align: center;" class="print-item-cat-ref">SKU</th>
                <th style="width: 37%; text-align: left;">Product Description</th>
                <th style="width: 6%; text-align: center;">Units</th>
                <th style="width: 6%; text-align: center;">Qty</th>
                <th style="width: 8%; text-align: right;" class="print-col-price">Unit Price</th>
                <th style="width: 8%; text-align: right;" class="print-col-price">Discounted Unit Price</th>
                <th style="width: 8%; text-align: right;" class="print-col-price">Total Amount</th>
                <th style="width: 5%; text-align: center;" class="print-col-vat">Vat %</th>
                <th style="width: 8%; text-align: right;" class="print-col-vat">Vat Amount</th>
                <th style="width: 10%; text-align: right;" class="print-col-price">Net Amount Incl. VAT</th>
              </tr>
            </thead>
            <tbody>
              {pageItems.map((item, idx) => {
                const globalIdx = isFirstPage ? (idx + 1) : (maxItemsPage1 + (pageIdx - 1) * maxItemsSubsequent + idx + 1);
                const lineTotal = item.quantity * item.unit_price;
                const taxAmt = item.tax_type === 'percentage' ? lineTotal * (item.tax_value / 100) : item.tax_value;
                return (
                  <tr>
                    <td class="text-center">{globalIdx}</td>
                    <td class="text-center font-mono print-item-cat-ref">{item.catalogue_ref || '—'}</td>
                    <td class="font-bold uppercase">
                      <span class="block">{item.description}</span>
                      {item.tech_spec && <span class="print-item-tech-spec block text-slate-500 font-normal mt-0.5" style="font-size: 7.5pt; text-transform: none;">Specs: {item.tech_spec}</span>}
                    </td>
                    <td class="text-center">PCS</td>
                    <td class="text-center">{item.quantity}</td>
                    <td class="text-right font-mono print-col-price">{Number(item.unit_price).toFixed(2)}</td>
                    <td class="text-right font-mono print-col-price">{Number(item.unit_price).toFixed(2)}</td>
                    <td class="text-right font-mono print-col-price">{Number(lineTotal).toFixed(2)}</td>
                    <td class="text-center font-mono print-col-vat">{item.tax_type === 'percentage' ? `${item.tax_value}` : '5'}</td>
                    <td class="text-right font-mono print-col-vat">{Number(taxAmt).toFixed(2)}</td>
                    <td class="text-right font-mono font-bold print-col-price">{Number(lineTotal + taxAmt).toFixed(2)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}

        <!-- FOOTER / SIGNATURES (ON LAST PAGE ONLY) -->
        {isLastPage && (
          inv.order_type === 'delivery_note' ? (
            <div class="delightgroupllc-dn-totals">
              Total Items Quantity &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <span class="font-mono">{totalQty}</span>
            </div>

            <div class="delightgroupllc-dn-fields print-electronic-badge">
              <div class="delightgroupllc-dn-fields-box">
                <span class="text-muted block" style="font-size: 7.5pt; font-weight: 600;">Contact Person:</span>
                <span class="font-bold" style="font-size: 9pt;">{inv.customer_name}</span>
              </div>
              <div class="delightgroupllc-dn-fields-box">
                <span class="text-muted block" style="font-size: 7.5pt; font-weight: 600;">Contact Number:</span>
                <span class="font-bold" style="font-size: 9pt;">{inv.customer_phone || '—'}</span>
              </div>
              <div class="delightgroupllc-dn-fields-box">
                <span class="text-muted block" style="font-size: 7.5pt; font-weight: 600;">Description:</span>
                <span class="font-bold" style="font-size: 9pt;">{inv.internal_notes || '—'}</span>
              </div>
            </div>

            <div class="delightgroupllc-dn-signatures print-signature-section">
              <div class="delightgroupllc-dn-sign-box print-sig-client-col" id="dn-sig-client-block">
                Received By:<br>
                Contact Number:<br>
                Received Date:<br>
                <div class="delightgroupllc-dn-sign-line">Customer Signature</div>
              </div>
              <div class="delightgroupllc-dn-sign-box text-right print-sig-company-col" id="dn-sig-company-block" style="display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end;">
                <div>For {companyNameEN}</div>
                <!-- Dynamic Stamp Space -->
                <div class="print-stamp-box hidden" style="height: 60px;"></div>
                <div class="signature-image-container relative flex justify-center items-end h-12 -mb-3 z-10 w-[70%]">
                  <img class={"signature-image-render h-12 w-auto object-contain " + (signatureImage ? "" : "hidden")} src={signatureImage || ""} />
                </div>
                <div class="delightgroupllc-dn-sign-line" style="width: 70%; text-align: center; margin-top: 0px;">Authorized Signatory (<span id="print-sig-name-arr">{settings.signatory_name || 'Management'}</span>)</div>
              </div>
            </div>

            <p class="delightgroupllc-dn-note print-electronic-badge">NOTE: Customer must check good's condition and quantity at the time of delivery of the material</p>
          ) : (
            <div class="delightgroupllc-inv-bottom-grid">
              <div class="delightgroupllc-inv-words-panel">
                <span class="font-bold text-muted uppercase tracking-wider" style="font-size: 7.5pt; display: block; margin-bottom: 5px;">Amount in words:</span>
                <span class="font-bold" style="font-size: 9.5pt; color: #000000;">{amountInWords}</span>
              </div>
              <div class="delightgroupllc-inv-totals-panel">
                <table class="delightgroupllc-inv-totals-table">
                  <tr class="print-total-subtotal">
                    <td>Total Amount</td>
                    <td>{Number(inv.subtotal).toFixed(2)}</td>
                  </tr>
                  <tr class="print-total-discount">
                    <td>Discount Amount</td>
                    <td>{Number(inv.discount_amount).toFixed(2)}</td>
                  </tr>
                  <tr class="print-total-subtotal">
                    <td>Taxable Amount</td>
                    <td>{Number(Number(inv.subtotal) - Number(inv.discount_amount)).toFixed(2)}</td>
                  </tr>
                  <tr class="print-total-vat">
                    <td>Vat Amount</td>
                    <td>{Number(inv.gst_amount).toFixed(2)}</td>
                  </tr>
                  <tr style="font-weight: 800; font-size: 9.5pt; background-color: #f8fafc;" class="print-total-due">
                    <td style="color: #000000; border-top: 1px solid #000000;">Grand Total</td>
                    <td style={`color: ${logoColor}; border-top: 1px solid #000000;`}>{Number(inv.total_amount).toFixed(2)}</td>
                  </tr>
                </table>
              </div>
            </div>

            <div class="print-bank-block-p1" style="margin-top: 10px; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px; font-size: 7.5pt; background: #f8fafc; page-break-inside: avoid; break-inside: avoid;">
              <strong style={`display: block; border-bottom: 1px solid #e2e8f0; padding-bottom: 3px; margin-bottom: 5px; font-size: 8pt; color: ${logoColor}; text-transform: uppercase;`}>Remittance & Bank Instructions</strong>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px;">
                <div><span class="text-muted">Bank Name:</span> <span id="print-bank-name-p1-arr">{settings.bank_name || 'N/A'}</span></div>
                <div><span class="text-muted">Account Name:</span> <span id="print-bank-acc-name-p1-arr">{settings.account_name || 'N/A'}</span></div>
                <div><span class="text-muted">Account Number:</span> <span class="font-mono font-bold" id="print-bank-acc-p1-arr">{settings.account_number || 'N/A'}</span></div>
                <div><span class="text-muted">Swift Code:</span> <span class="font-mono font-bold" id="print-bank-swift-p1-arr">{settings.swift_code || 'N/A'}</span></div>
                <div style="grid-column: span 2;"><span class="text-muted">IBAN:</span> <span class="font-mono font-bold" style={`color: ${logoColor}`} id="print-bank-iban-p1-arr">{settings.iban_number || 'N/A'}</span></div>
              </div>
            </div>

            <div class="delightgroupllc-inv-signature-section print-signature-section" style="display: flex; justify-content: space-between; align-items: flex-end; gap: 15px; margin-top: 20px;">
              <div class="delightgroupllc-inv-disclaimer-text print-disclaimer-text">
                {(() => {
                  const disclaimerClauses = selectedClauses.filter((clause: any) => clause.identifier === 'disclaimer' || (clause.title && clause.title.toLowerCase().includes('disclaimer')));
                  return disclaimerClauses.length > 0 ? (
                    disclaimerClauses.map((clause: any) => (
                      <div class="mb-1">
                        <strong>{clause.title}:</strong> {clause.content}
                      </div>
                    ))
                  ) : (
                    <div>
                      <strong>Disclaimer:</strong><br/>
                      By submitting payment, the Customer acknowledges and agrees that he/she has read, understood, and accepted the terms of sale. Payment shall constitute full acceptance of these terms without limitation or qualification.
                    </div>
                  );
                })()}
              </div>
              <div class="print-sig-client-col" style="width: 30%; min-width: 140px; margin-bottom: 5px;">
                <div style="border-top: 1.5px solid #000000; margin-top: 50px; padding-top: 4px; font-size: 7.5pt; font-weight: 700; text-align: center; text-transform: uppercase;">
                  Customer Signature
                </div>
              </div>
              <div class="delightgroupllc-inv-sign-stamp-box print-sig-company-col" id="inv-sig-stamp-block" style="width: 35%; min-width: 160px;">
                <div class="delightgroupllc-inv-sign-stamp-header">For {companyNameEN}</div>
                <div class="delightgroupllc-inv-sign-stamp-body flex items-center justify-center" style="height: 60px; position: relative;">
                  <!-- Dynamic Stamp Space -->
                  <div class="print-stamp-box hidden" style="height: 10px;"></div>
                  <img class={"signature-image-render h-12 w-auto object-contain " + (signatureImage ? "" : "hidden")} src={signatureImage || ""} style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);" />
                </div>
                <div class="delightgroupllc-inv-sign-stamp-footer">
                  <div class="delightgroupllc-inv-sign-stamp-footer-cell">signature</div>
                  <div class="delightgroupllc-inv-sign-stamp-footer-cell">date</div>
                </div>
              </div>
            </div>

            <!-- Electronic Signature Badge for Modern Grid -->
            <div class="electronic-doc-badge print-electronic-badge hidden" style="border: 1.5px dashed #000000; padding: 10px; text-align: center; font-size: 8.5pt; color: #000000; font-weight: 700; margin-top: 15px; text-transform: uppercase; page-break-inside: avoid; break-inside: avoid;">
              This is a computer-generated document. No signature or stamp is required.
            </div>
          )
        )}

        <!-- Running Footer / Page Number -->
        <div class="text-center text-muted print-page-footer-num" style="position: absolute; bottom: 30px; left: 0; right: 0; font-size: 8pt; font-weight: 500;">
          Page {pageNumber} of {totalPages}
        </div>
      </div>
    );
  })}

  <!-- TERMS OF SALE PAGE (PAGE Y OF Y) -->
  {inv.order_type !== 'delivery_note' && (
    <div class="print-page bg-white shadow-xl border border-slate-250 p-12 relative print:p-0 print:border-none print:shadow-none mb-8 print-page-2-container">
      <!-- Faint Watermark on Terms Page -->
      <div class="delightgroupllc-watermark print-watermark">
        <img src="/dgllclogolarge.png" id="watermark-img-p2" style="width: 100%; height: auto; object-fit: contain; opacity: 0.06;" />
      </div>

      <!-- Centered Logo on Terms Page -->
      <div class="print-logo-container-p2 text-center" style="margin-bottom: 8px; text-align: center;">
        <img src={isDGS ? '/dgslogo.jpg' : '/dtllogo.jpg'} class="h-24 w-auto object-contain mx-auto" id="print-company-logo-p2" style="margin: 0 auto; display: block;" />
      </div>

      <div class="terms-page">
        <h2 class="terms-title">Terms of Sale</h2>
        <div class="terms-columns">
          {selectedClauses
            .map((clause: any) => {
              const sanitizedIdent = clause.identifier.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase();
              return (
                <div class={`terms-section terms-sec-${sanitizedIdent} ${isTermActive(clause.identifier) ? '' : 'hidden'}`}>
                  <h3 class="terms-section-title">{clause.title}:</h3>
                  <div set:html={clause.content}></div>
                </div>
              );
            })
          }
        </div>

        <!-- Uniform Bottom Row for Bank details and Company Stamp Card -->
        <div class="flex gap-4 mt-4 w-full justify-between items-stretch" style="page-break-inside: avoid; break-inside: avoid;">
          <!-- Bank Details Card -->
          <div class="terms-section print-bank-block-p2 flex-1" style="border: 1px solid #cbd5e1; border-radius: 2px; padding: 6px; background: #f8fafc; font-size: 5.8pt; box-sizing: border-box;">
            <h3 class="terms-section-title" style="margin-bottom: 2px; font-weight: bold; border-bottom: 1px solid #e2e8f0; padding-bottom: 2px;">Delight Bank Details:</h3>
            <p style="font-weight: 700; color: #000000; line-height: 1.35; margin: 0;">
              {companyNameEN}<br>
              Bank Name: <span id="print-bank-name-p2">{settings.bank_name || 'N/A'}</span><br>
              A/C Name: <span id="print-bank-acc-name-p2">{settings.account_name || companyNameEN}</span><br>
              A/C No: <span id="print-bank-acc-p2">{settings.account_number || 'N/A'}</span><br>
              Bank Swift Code: <span id="print-bank-swift-p2">{settings.swift_code || 'N/A'}</span><br>
              IBAN: <span id="print-bank-iban-p2">{settings.iban_number || 'N/A'}</span>
            </p>
          </div>

          <!-- Company Stamp/Details Card -->
          <div class="company-card-tos-wrapper flex-1" style="box-sizing: border-box;">
            <div class="company-card-tos" style="border: 1px solid #cbd5e1; border-radius: 2px; padding: 6px; background: #f8fafc; display: flex; align-items: center; justify-content: space-between; height: 100%; box-sizing: border-box;">
              <div style="display: flex; align-items: center; gap: 8px; text-align: left;">
                <img src={isDGS ? '/dgslogo.jpg' : '/dtllogo.jpg'} class="company-card-tos-logo" style="height: 28px; width: auto; object-fit: contain;" />
                <div>
                  <div style="font-weight: bold; font-size: 7.5pt; color: #0f172a;">For {companyNameEN}</div>
                  <div style="font-size: 5.8pt; color: #475569; line-height: 1.3; margin-top: 1px; max-width: 200px;">
                    <span id="print-company-address-arr-p2">{settings.business_address || settings.company_address || 'Dubai, United Arab Emirates'}</span><br>
                    TRN: <span class="font-mono font-bold" style="color:#0f172a;" id="print-company-trn-arr-p2">{settings.trn_number || '100380541100003'}</span>
                    <span id="print-company-reg-arr-p2-wrapper" class={settings.business_registration ? "" : "hidden"}> | Reg: <span id="print-company-reg-arr-p2">{settings.business_registration || ''}</span></span>
                    <span id="print-company-permits-arr-p2-wrapper" class={settings.permits_info ? "block" : "hidden"} style="font-size: 5pt; margin-top: 1px;">Permits: <span id="print-company-permits-arr-p2" class="italic">{settings.permits_info || ''}</span></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center text-muted print-page-footer-num" style="position: absolute; bottom: 30px; left: 0; right: 0; font-size: 8pt; font-weight: 500;">
        Page {totalPages} of {totalPages}
      </div>
    </div>
  )}
</div>
