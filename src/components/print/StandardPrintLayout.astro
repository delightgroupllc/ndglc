---
interface Props {
  inv: any;
  items: any[];
  settings: Record<string, string>;
  documentTitle: string;
  logoColor: string;
  companyNameEN: string;
}
const { inv, items, settings, documentTitle, logoColor, companyNameEN } = Astro.props;
---

<div id="layout-standard" class="std-container">
  <table class="std-header-table">
    <tr>
      <td class="std-company-info">
        <div class="std-company-title" style={`color: ${logoColor}`}>{companyNameEN}</div>
        <div class="text-muted" style="font-size: 9pt; margin-top: 5px; line-height: 1.4;">
          {settings.business_address || 'Dubai, United Arab Emirates'}<br>
          TRN: <span class="font-mono font-bold" style="color:#0f172a;">{settings.trn_number || '100380541100003'}</span><br>
          Email: {settings.customer_email || 'corporate@delightgroupllc.com'} | Phone: {settings.customer_phone || '+971 4 000 0000'}
        </div>
      </td>
      <td class="std-doc-meta">
        <div class="std-doc-title">{documentTitle}</div>
        <div style="font-size: 10pt; line-height: 1.5;">
          Document No: <span class="font-mono font-bold">{inv.invoice_number}</span><br>
          Issue Date: <span class="font-bold">{inv.issue_date}</span><br>
          {inv.due_date && <span>Due Date: <span class="font-bold">{inv.due_date}</span><br></span>}
          {inv.lpo_number && <span>Ref LPO No: <span class="font-mono font-bold">{inv.lpo_number}</span><br></span>}
          Division: <span class="font-bold">{inv.source_division || 'DTL'}</span>
        </div>
      </td>
    </tr>
  </table>

  <table class="std-details-table">
    <tr>
      <td class="std-details-col">
        <div class="std-section-label">Remit / Bill To</div>
        <div class="font-bold" style="font-size: 11pt; color: #0f172a;">{inv.customer_name}</div>
        {inv.company_name && <div class="font-semibold text-muted" style="font-size: 9.5pt;">{inv.company_name}</div>}
        <div class="text-muted" style="font-size: 9pt; margin-top: 4px; white-space: pre-line;">
          {inv.billing_address || 'N/A'}
        </div>
        {inv.customer_email && <div class="text-muted" style="font-size: 9pt; margin-top: 4px;">Email: {inv.customer_email}</div>}
        {inv.customer_phone && <div class="text-muted" style="font-size: 9pt;">Phone: {inv.customer_phone}</div>}
      </td>
      <td class="std-details-col">
        <div class="std-section-label">Deliver To / Shipping Address</div>
        {inv.shipping_address ? (
          <div class="text-muted" style="font-size: 9pt; white-space: pre-line;">
            {inv.shipping_address}
          </div>
        ) : (
          <div class="text-muted" style="font-size: 9pt; font-style: italic;">Same as Billing Address</div>
        )}
        {inv.company_vat && (
          <div style="margin-top: 10px; font-size: 9pt;">
            <span class="font-bold text-muted uppercase tracking-wider" style="font-size: 7.5pt; display: block;">Client TRN / Tax Reg</span>
            <span class="font-mono font-bold" style="color: #0f172a;">{inv.company_vat}</span>
          </div>
        )}
      </td>
    </tr>
  </table>

  <table class="std-items-table">
    <thead>
      <tr>
        <th style="text-align: left; width: 5%;">#</th>
        <th style="text-align: left; width: 45%;">Item Description / Spec</th>
        <th style="text-align: center; width: 10%;">Qty</th>
        <th style="text-align: right; width: 15%;">Unit Price</th>
        <th style="text-align: right; width: 10%;">VAT</th>
        <th style="text-align: right; width: 15%;">Total (AED)</th>
      </tr>
    </thead>
    <tbody>
      {items.map((item, idx) => {
        const lineTotal = item.quantity * item.unit_price;
        const taxAmt = item.tax_type === 'percentage' ? lineTotal * (item.tax_value / 100) : item.tax_value;
        return (
          <tr>
            <td>{idx + 1}</td>
            <td>
              <span class="font-semibold" style="color: #0f172a;">{item.description}</span>
              {item.catalogue_ref && <span class="text-muted font-mono" style="font-size: 8pt; display: block;">Cat Ref: {item.catalogue_ref}</span>}
              {item.tech_spec && <span class="text-muted" style="font-size: 8pt; display: block; margin-top: 2px;">Specs: {item.tech_spec}</span>}
            </td>
            <td class="text-center">{item.quantity}</td>
            <td class="text-right font-mono">AED {Number(item.unit_price).toFixed(2)}</td>
            <td class="text-right font-mono">{item.tax_type === 'percentage' ? `${item.tax_value}%` : `AED ${item.tax_value}`}</td>
            <td class="text-right font-mono font-bold">AED {Number(lineTotal + taxAmt).toFixed(2)}</td>
          </tr>
        );
      })}
    </tbody>
  </table>

  <div class="std-summary-wrapper">
    <table class="std-summary-table">
      <tr>
        <td class="text-muted">Subtotal (Excl. VAT):</td>
        <td class="text-right font-mono">AED {Number(inv.subtotal).toFixed(2)}</td>
      </tr>
      <tr>
        <td class="text-muted">Total VAT amount:</td>
        <td class="text-right font-mono" style="color: #c2410c;">AED {Number(inv.gst_amount).toFixed(2)}</td>
      </tr>
      {Number(inv.discount_amount) > 0 && (
        <tr>
          <td class="text-muted">Discount:</td>
          <td class="text-right font-mono" style="color: #15803d;">- AED {Number(inv.discount_amount).toFixed(2)}</td>
        </tr>
      )}
      <tr class="std-summary-table grand-total">
        <td>Grand Total:</td>
        <td class="text-right font-mono" style={`color: ${logoColor}`}>AED {Number(inv.total_amount).toFixed(2)}</td>
      </tr>
    </table>
  </div>

  <div class="std-bank-block">
    <div class="std-section-label" style={`color: ${logoColor}; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-bottom: 8px;`}>Remittance & Bank Instructions</div>
    <div class="std-bank-grid">
      <div><span class="font-bold text-muted">Bank Name:</span> <span>{settings.bank_name || 'N/A'}</span></div>
      <div><span class="font-bold text-muted">Account Name:</span> <span>{settings.account_name || 'N/A'}</span></div>
      <div><span class="font-bold text-muted">Account Number:</span> <span class="font-mono">{settings.account_number || 'N/A'}</span></div>
      <div><span class="font-bold text-muted">Swift Code:</span> <span class="font-mono">{settings.swift_code || 'N/A'}</span></div>
      <div style="grid-column: span 2;"><span class="font-bold text-muted">IBAN:</span> <span class="font-mono" style={`color: ${logoColor}`}>{settings.iban_number || 'N/A'}</span></div>
    </div>
  </div>

  <div class="std-signatures-table">
    <table style="width: 100%;">
      <tr>
        <td class="std-signature-col">
          <div class="std-signature-line">Customer Signature & Stamp</div>
        </td>
        <td class="std-signature-col">
          <div style="font-size: 9pt; font-weight: 700; margin-bottom: 25px; color: #475569;">For {companyNameEN}</div>
          <div class="std-signature-line">Authorized Signatory ({settings.signatory_name || 'Management'})</div>
        </td>
      </tr>
    </table>
  </div>
</div>
