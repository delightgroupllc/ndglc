      description: "High-efficiency low-voltage accent lighting and xeriscape specimens designed for local climate resiliency in Abu Dhabi.",
      featured_image: "https://lh3.googleusercontent.com/aida-public/AB6AXuD9rzXaLwkdm6_vzUsundUtnEWJa75zIeMYfwD487NnRtw9Y7vugJNH_uZxouwmGlPwpa5CdhdI61ReIyhgl0HJz38MKHMZRHNV72kS6wclydWPI4z6UhOFYq7lViqiNmNo2W9oJQUzHzHl5K5yvZdHkDhafV4kU7Xj4zfCeO_dalChIKT4Cwdx3zgWEiaux1Cz2XoclQvgHq4rR6MgqCo8fVrlYSVchdIP09aAiWip5zceFnu6i4XWzjKbakEiQSIoo5IxZNsrqoc",
      division: "dgs"
