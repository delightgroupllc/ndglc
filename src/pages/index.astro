// Fallback mock articles
if (articles.length === 0) {
  articles = [
    {
      title: "The Psychology of Light: Circadian Harmony",
      slug: "psychology-of-light",
      summary: "How tuned-spectrum lighting influences mood, productivity, and the biological clock in modern residential architecture.",
      featured_image: "https://lh3.googleusercontent.com/aida-public/AB6AXuA0XeE0sAka_CBFwwD40sz98D0o4Jdn8AQnkCYIw892qrBOzOmpqMyOWzvRA09E-yaDm1rVG-rDXm5nBLMkD2OStlrujTcTCKIId0K9PoXVt3aoSIFsm1Eikdl3AfKTRtPxayirQUeYWuDNEOGX6Or9TbjXzdHHuLXb5GtvRtqDrBNzQhnoGQUWbW9Y3sGzhbd-MnjnEH8Jufo3Ar95cqVYOQ5CznTSsskHmRfrMoKLxDGta6zUpY6faLj6xask2_DBXrt8N8BFAAY",
      division: "dtl"
    },
    {
      title: "Sustainable Biophilia: Living Skin Walls",
      slug: "sustainable-biophilia",
      summary: "The evolution of vertical gardens from aesthetic features to functional air-purification systems for luxury developments.",
      featured_image: "https://lh3.googleusercontent.com/aida-public/AB6AXuBsA92pa18473lfcBjE7BoHkF_gf2wRUG8mqLy62apv9hEGoXv-XqrDJLz2PMyW9FphFEQzx6Rge5TAPP6v1986le2k9EnjCa0A_BmPZN9j2tQcaX0dj1WJB01l5R7Qrk3d-XnGjo6-cxHFfM2Cq8Ce12cKI6dwFed-6DxsFYpnDUZJSk0euYp3A8wbiI8ZGT8hO8rDCU415pfQWRzROWNHR03MEBfUd4t_KAh91VsGYW5gyWj04ycj9aT2gPGaEpnKuAe7fMxmrZw",
