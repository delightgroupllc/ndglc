  brands = ['Legrand', 'SYV', 'Lutron', 'Solux Lighting', 'ZCL', 'Thorn', 'Pelsan', 'HansGreen', 'Cortem Group'];
}
---

<Layout title="Premium Technical Lighting & Greenscapes UAE" description="Delight Group LLC supplies premium architectural lighting and curated landscape plants across Dubai, Abu Dhabi, and the UAE.">
  
  <!-- Hero Section -->
  <section class="relative min-h-[100dvh] flex items-center overflow-hidden bg-[#fcf9f8]">
    <div class="absolute inset-0 z-0">
      <img 
        alt="Modern villa at dusk with warm exterior lighting and lush landscaping" 
        class="w-full h-full object-cover" 
        src="/2screen.png"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
    </div>
    <div class="relative z-10 px-6 sm:px-16 max-w-[1280px] mx-auto w-full">
      <div class="max-w-3xl text-left animate-on-scroll">
        <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl text-white mb-8 leading-[1.1] tracking-tight drop-shadow-lg">Luminous Nature: Harmonizing Light & Life.</h1>
        <p class="font-sans text-lg text-white/95 mb-10 max-w-xl leading-relaxed drop-shadow-md">
          Where technical lighting precision meets organic landscape vitality. We engineer atmospheres that synchronize human circadian rhythms with the vibrant soul of the natural world.
        </p>
        <div class="flex items-center space-x-6">
          <a 
            href="#divisions" 
            class="bg-[#805612] text-white px-10 py-4 text-xs font-black uppercase tracking-widest hover:bg-[#ffddb4] hover:text-[#291800] transition-all duration-300"
          >
            Explore Divisions
          </a>
          <a 
            href="/about" 
            class="flex items-center space-x-2 text-white text-xs font-black uppercase tracking-widest group"
          >
            <span>Our Philosophy</span>
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </div>
    
    <div class="absolute bottom-12 left-6 sm:left-16 flex items-center space-x-12 text-white/80">
      <div class="flex flex-col text-left">
        <span class="font-serif text-2xl text-[#ffddb4] font-semibold">DTL</span>
        <span class="text-[10px] font-black uppercase tracking-widest">Lighting Division</span>
      </div>
      <div class="flex flex-col text-left">
        <span class="font-serif text-2xl text-[#ffddb4] font-semibold">DGS</span>
        <span class="text-[10px] font-black uppercase tracking-widest">Greenscapes Division</span>
      </div>
    </div>
  </section>

  <!-- Division Feature Rows -->
  <section id="divisions" class="w-full">
    <!-- DTL Division Row (Text Left / Image Right) -->
    <div class="flex flex-col lg:flex-row min-h-[600px] bg-[#1a3c34]">
      <div class="flex-1 flex flex-col justify-center px-6 sm:px-16 py-20 text-[#83a69c] text-left animate-on-scroll">
        <div class="max-w-xl mx-auto lg:ml-auto lg:mr-12">
          <span class="text-xs font-black text-[#aacec3] uppercase tracking-[0.3em] mb-4 block">Architectural Precision</span>
          <h2 class="font-serif text-4xl sm:text-5xl text-white mb-6 leading-tight tracking-tight">Technical Lighting</h2>
          <p class="font-sans text-md sm:text-lg mb-10 text-white/90 leading-relaxed">
            Precision-engineered illumination that transforms architectural volumes. We specialize in circadian-aligned systems and museum-grade technical lighting for the world's most demanding environments, ensuring perfect clarity and atmospheric control.
          </p>
          <a 
            href="/delighttechnicallighting" 
            class="inline-block bg-white text-[#01261f] px-10 py-4 text-xs font-black uppercase tracking-widest hover:bg-[#c5eadf] transition-all duration-300"
          >
            Explore DTL Division
          </a>
        </div>
      </div>
      <div class="flex-1 min-h-[400px] lg:min-h-0">
        <img 
          alt="High-end architectural lighting showroom" 
          class="w-full h-full object-cover" 
          src="/3screen.png"
        />
      </div>
    </div>

    <!-- DGS Division Row (Image Left / Text Right) -->
    <div class="flex flex-col lg:flex-row-reverse min-h-[600px] bg-[#fcf9f8]">
      <div class="flex-1 flex flex-col justify-center px-6 sm:px-16 py-20 text-[#1c1b1b] text-left animate-on-scroll">
        <div class="max-w-xl mx-auto lg:mr-auto lg:ml-12">
          <span class="text-xs font-black text-[#805612] uppercase tracking-[0.3em] mb-4 block">Organic Serenity</span>
          <h2 class="font-serif text-4xl sm:text-5xl text-[#01261f] mb-6 leading-tight tracking-tight">Greenscapes</h2>
          <p class="font-sans text-md sm:text-lg mb-10 text-[#414846] leading-relaxed">
            Curated biophilic experiences that breathe life into the built environment. From vertical gardens to exotic landscape ecosystems, we design living architecture that evolves with time, fostering a deep connection between urban dwellers and the natural world.
          </p>
          <a 
            href="/delightgreenscapes" 
            class="inline-block bg-[#01261f] text-white px-10 py-4 text-xs font-black uppercase tracking-widest hover:bg-[#1a3c34] transition-all duration-300"
          >
            Explore DGS Division
          </a>
        </div>
      </div>
      <div class="flex-1 min-h-[400px] lg:min-h-0">
        <img 
          alt="Lush indoor biophilic garden" 
          class="w-full h-full object-cover" 
          src="/1screen.png"
        />
      </div>
    </div>
  </section>

  <!-- Sectors We Serve Section -->
  <section class="py-24 bg-[#f6f3f2] border-y border-slate-200/40">
    <div class="px-6 sm:px-16 max-w-[1280px] mx-auto animate-on-scroll">
      <div class="flex flex-col items-center text-center mb-16">
        <span class="text-xs font-black text-[#805612] uppercase tracking-[0.2em] mb-2">Expertise</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-[#01261f] font-semibold tracking-tight">Sectors We Serve</h2>
        <div class="w-20 h-1 bg-[#fec577] mt-6"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Residential Card -->
        <div class="group relative overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-500 rounded-lg flex flex-col justify-between">
          <div>
            <div class="aspect-[4/5] overflow-hidden">
              <img 
                alt="Luxury villa interior with elegant lighting" 
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" 
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDKzpmZidP2wrFcJyW8Lsfa-46IwJ_ofH6_cLB_g2pCXDeoZUlVQG1Jd2RQbD5iuRp8tyTVQNqpsYqoOkRgMhWPgnjwOxJZVmv7NFQc8yccF63VN3PNzKq2thOWuGHiSFZeoXXabJ5Jd4dhGPoRfiXr-goFkYKHIGxG66Q9dut2QZftzVxda3dLswNO7EAyDezFdJAF8IJoJ6XJcmDsysGNx53GKYiXNeRhTjJWM6lm3Thp1ZS9gAghfzAlunkNFzmiLUppkPgFZw8"
              />
            </div>
            <div class="p-8 text-center">
              <h3 class="font-serif text-xl font-semibold text-[#01261f] mb-3">Residential</h3>
              <p class="text-[#414846] text-xs font-semibold leading-relaxed">Individual Houses, Villas, and private estates tailored for personal wellness.</p>
            </div>
          </div>
          <div class="px-8 pb-8 text-center">
            <a class="inline-block font-sans text-[10px] font-black text-[#805612] uppercase tracking-widest border-b border-transparent hover:border-[#805612] transition-all" href="/portfolio?sector=residential">View Details</a>
          </div>
        </div>

        <!-- Commercial Card -->
        <div class="group relative overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-500 rounded-lg flex flex-col justify-between">
          <div>
            <div class="aspect-[4/5] overflow-hidden">
              <img 
                alt="Modern office space with integrated greenery" 
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" 
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBixLKPHKgXt131Z4yztKrDxoddfna7VJIlNInz9ePdOZblArS_GJJ5tHO1f_StEC0kalUDShHXkgk_DWXfEll4gOPLpGBbh_WNlbztmPLWWxyJl3awnm9yP2Xu_lQJkSYMAXamcp155pvLuwx69Iz_LviErccNSy1CQjYExwtYFfzonuUwqO5KOVvR4M_btDvqYgix9TydUNAN_rE2vqGwZf3rM3P-jBrIUp91q46ZO2FI5LEWEO0zIO0GSK4cldl4RmGIb0Jifr4"
              />
            </div>
            <div class="p-8 text-center">
              <h3 class="font-serif text-xl font-semibold text-[#01261f] mb-3">Commercial</h3>
              <p class="text-[#414846] text-xs font-semibold leading-relaxed">Productive Office Spaces and immersive Retail environments designed for impact.</p>
            </div>
          </div>
          <div class="px-8 pb-8 text-center">
            <a class="inline-block font-sans text-[10px] font-black text-[#805612] uppercase tracking-widest border-b border-transparent hover:border-[#805612] transition-all" href="/portfolio?sector=commercial">View Details</a>
          </div>
        </div>

        <!-- Hospitality Card -->
        <div class="group relative overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-500 rounded-lg flex flex-col justify-between">
          <div>
            <div class="aspect-[4/5] overflow-hidden">
              <img 
                alt="High-end resort pool area at night" 
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" 
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAMx1j_FCvrJtX9CaD6c3KgMaZCisZEmzZpaN_gYZTZ_wjpros1ZrWHeo0eBK7iYZSdi_xQsiD05RavSG2LygkPRuE69C_B1JijZyrXI2D3JvjqzMM2vGFZkx8Cb4UXjnpBwDK1zr0_ArVHEVDY58CqM-c6YUjCCQf_0iDF8cHO_kAI-JoYdXUneS-V__iLArbGxDnCyAOb70B4ur49InnUaRewyD1BgRmBHEyCaw-HL1Qz9iUXrkQC18V_01g-8U3iXu10IU2aHrk"
              />
            </div>
            <div class="p-8 text-center">
              <h3 class="font-serif text-xl font-semibold text-[#01261f] mb-3">Hospitality</h3>
              <p class="text-[#414846] text-xs font-semibold leading-relaxed">Luxury Hotels and Resorts where atmosphere is the defining guest experience.</p>
            </div>
          </div>
          <div class="px-8 pb-8 text-center">
            <a class="inline-block font-sans text-[10px] font-black text-[#805612] uppercase tracking-widest border-b border-transparent hover:border-[#805612] transition-all" href="/portfolio?sector=hospitality">View Details</a>
          </div>
        </div>

        <!-- B2B Trade & Procurement Card -->
        <div class="group relative overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-500 rounded-lg flex flex-col justify-between">
          <div>
            <div class="aspect-[4/5] overflow-hidden">
              <img 
                alt="B2B volume scale shipping and procurement logistics" 
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" 
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuArzukkQe74HgIm92FnG3-sCZ-j0fHmv-kwwSws7u1yiSen96IHxJbd-MJLZX_CaNUzyhJhlmmZEx4cJUqUfYEoazhxeB5qnadct4xwJQxcXOUINJUsjU80-Ltb1PmkqjbcyZ222OFEq-dahQJaTDpLdi10-JkaxPrG69kJObYR8QwIKbaXmhgZGhCKapbZbQYD8wQAy5KetzliYsUP-BhpuS9x61NvpXSON_g_OrH6SKt8Ilc65qD5_osbEEEUuiQxp1-LZl38xXY"
              />
            </div>
            <div class="p-8 text-center">
              <h3 class="font-serif text-xl font-semibold text-[#01261f] mb-3">B2B & Procurement</h3>
              <p class="text-[#414846] text-xs font-semibold leading-relaxed">Volume-scale supply, technical specifications, and strict SLA dispatch tracking.</p>
            </div>
          </div>
          <div class="px-8 pb-8 text-center">
            <a class="inline-block font-sans text-[10px] font-black text-[#805612] uppercase tracking-widest border-b border-transparent hover:border-[#805612] transition-all" href="/contact">Inquire Logistics</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="py-24 bg-[#fcf9f8]">
    <div class="px-6 sm:px-16 max-w-[1280px] mx-auto animate-on-scroll">
      <div class="flex flex-col items-center text-center mb-16">
        <span class="text-xs font-black text-[#805612] uppercase tracking-[0.2em] mb-2">Showcase</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-[#01261f] font-semibold tracking-tight">Featured Projects</h2>
        <p class="text-[#414846] max-w-2xl mx-auto mt-4 text-xs font-semibold leading-relaxed">A curated collection of our most impactful architectural lighting and landscaping collaborations.</p>
        <div class="w-20 h-1 bg-[#fec577] mt-6"></div>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {latestProjects.map((proj, idx) => (
          <div class="group cursor-pointer text-left">
            <div class="aspect-square overflow-hidden mb-6 rounded-lg">
              <img 
                alt={proj.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
                src={proj.featured_image || "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&q=80"}
              />
            </div>
            <h4 class="font-serif text-md font-semibold text-[#01261f] mb-2 group-hover:text-[#805612] transition-colors line-clamp-2">{proj.title}</h4>
            <a class="inline-flex items-center space-x-2 text-[#805612] text-[10px] font-black uppercase tracking-widest border-b border-transparent hover:border-[#805612] transition-all" href={`/portfolio?division=${proj.division || 'dtl'}`}>
              <span>View Project</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- News & Articles Section -->
  <section class="py-24 bg-[#f6f3f2] border-t border-slate-200/40">
    <div class="px-6 sm:px-16 max-w-[1280px] mx-auto animate-on-scroll">
      <div class="text-center mb-16">
        <span class="text-xs font-black text-[#805612] uppercase tracking-[0.2em] mb-4 block">Insights</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-[#01261f] font-semibold tracking-tight mb-4">News & Articles</h2>
        <p class="text-[#414846] max-w-xl mx-auto text-xs font-semibold leading-relaxed">Bridging the gap between technological innovation and ecological stewardship.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {articles.map((article) => (
          <a href={`/news/${article.slug}`} class="group cursor-pointer text-left">
            <div class="aspect-[16/9] overflow-hidden mb-6 border border-[#01261f]/10 rounded-lg bg-white">
              {article.featured_image ? (
                <img 
                  alt={article.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700" 
                  src={article.featured_image}
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-400">News</div>
              )}
            </div>
            <span class="text-[10px] font-black text-[#805612] uppercase tracking-[0.2em] block mb-3">{article.division === 'dgs' ? 'DGS Insight' : 'DTL Insight'}</span>
            <h4 class="font-serif text-lg font-semibold text-[#01261f] mb-4 group-hover:text-[#805612] transition-colors">{article.title}</h4>
            <p class="text-[#414846] mb-6 text-xs font-semibold leading-relaxed line-clamp-2">{article.summary}</p>
            <div class="inline-flex items-center space-x-2 text-[#01261f] text-[10px] font-black uppercase tracking-widest border-b border-[#01261f]/20 pb-1 group-hover:border-[#805612] transition-all">
              <span>Read More</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners Section -->
  <section class="py-16 bg-[#ffffff] border-t border-slate-200/40 overflow-hidden">
    <div class="px-6 sm:px-16 max-w-[1280px] mx-auto text-center mb-10">
      <span class="text-[10px] font-black text-[#83a69c] uppercase tracking-[0.3em]">Trusted by Global Industry Leaders</span>
    </div>
    
    <div class="relative w-full overflow-hidden flex flex-col gap-8">
      <!-- First Row of Partners -->
      <div class="flex space-x-12 animate-marquee-right whitespace-nowrap items-center w-max">
        {[...brands, ...brands].map((brand, i) => (
          <div class="flex items-center justify-center min-w-[160px] h-20 bg-[#fcf9f8] rounded-xl border border-slate-100 shadow-sm px-8">
            <span class="font-serif text-xl font-bold text-[#414846] opacity-70 hover:opacity-100 transition-opacity">{brand}</span>
          </div>
        ))}
      </div>
      
      <!-- Second Row of Partners (Reverse or offset) -->
      <div class="flex space-x-12 animate-marquee-left whitespace-nowrap items-center w-max">
        {[...brands, ...brands].reverse().map((brand, i) => (
          <div class="flex items-center justify-center min-w-[160px] h-20 bg-[#fcf9f8] rounded-xl border border-slate-100 shadow-sm px-8">
            <span class="font-serif text-xl font-bold text-[#414846] opacity-70 hover:opacity-100 transition-opacity">{brand}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-[#ffddb4] animate-on-scroll">
    <div class="px-6 sm:px-16 max-w-[1280px] mx-auto text-center space-y-8">
      <h2 class="font-serif text-4xl sm:text-5xl text-[#291800] leading-tight tracking-tight">Ready to harmonize your space?</h2>
      <p class="font-sans text-md sm:text-lg text-[#633f00] max-w-2xl mx-auto mb-12">
        Whether it's technical lighting precision or organic landscape vitality, let's collaborate to create an environment that breathes with life and light.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center space-y-4 sm:space-y-0 sm:space-x-6">
        <a 
          href="/contact" 
          class="bg-[#01261f] text-white px-12 py-5 text-xs font-black uppercase tracking-widest hover:bg-[#1a3c34] transition-all shadow-lg inline-block"
        >
          Start a Project
        </a>
        <a 
          href="/downloads" 
          class="border border-[#01261f] text-[#01261f] px-12 py-5 text-xs font-black uppercase tracking-widest hover:bg-[#01261f]/5 transition-all inline-block"
        >
          Request Division Catalog
        </a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('opacity-100', 'translate-y-0');
            entry.target.classList.remove('opacity-0', 'translate-y-8');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

      document.querySelectorAll('.animate-on-scroll').forEach((el) => {
        el.classList.add('opacity-0', 'translate-y-8', 'transition-all', 'duration-700', 'ease-out');
        observer.observe(el);
      });
    });
  </script>

</Layout>
