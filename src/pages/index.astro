      division: "dtl"
    },
    {
      id: 'proj-2',
      title: "Luminous Office Plaza",
      client_name: "Emaar Properties PJSC",
      description: "Human-centric circadian track systems and automated clean-air plant partitions for DIFC corporate suites.",
      featured_image: "https://lh3.googleusercontent.com/aida-public/AB6AXuD7nsYOrT4ZujveZ2gaCNLNjtjZaRD2VWcnHtn6VQ894_SPJNlzZJ-aKe7XH-aYOyiDqLxrDKMJtgYGFpo6UkPoP7QMNbZw5nyytRt_hdGf0xT1JGR5Q6e4FVRc8iBBgjniVAsKqtqS27UaZhtSX8myI-dEdebMrfksPbi1O-19l7iUNYWT0LpVG0CIFyfs5LH5F94dZp4uivWHCEapIc694gvs_EEzjq3DWOYIYPwpBF2pbMpT-djVVvdF0RtIibGr2WY0O2NzXvI",
