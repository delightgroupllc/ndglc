---
import Layout from '../layouts/Layout.astro';
import { query } from '../lib/db';
import { Search, ArrowRight, Lightbulb, Flower, ShieldCheck, Heart, Scale, Truck, Sparkles, Building, Globe, Layers, Compass, BookOpen } from '@lucide/astro';

let latestProjects: any[] = [];
let brands: any[] = [];
let articles: any[] = [];
let dbConnected = true;

try {
  // Query featured projects
  const res = await query('SELECT * FROM projects WHERE featured = true LIMIT 4');
  latestProjects = res.rows;

  // Query latest news/articles
  const articlesRes = await query("SELECT * FROM articles WHERE status = 'published' ORDER BY published_at DESC LIMIT 2");
  articles = articlesRes.rows;

  // Query partners from the database
  const partnersRes = await query("SELECT name FROM trusted_partners WHERE status = 'active' ORDER BY name ASC");
  brands = partnersRes.rows.map(r => r.name);
} catch (err: any) {
  dbConnected = false;
}

// Fallback high-fidelity UAE landmark projects mock
if (latestProjects.length === 0) {
  latestProjects = [
    {
      id: 'proj-1',
      title: "Modern Desert Villa",
      client_name: "Lootah Premium Developments",
      description: "Integrated biodynamic facade lighting and custom specimen biophilic fitouts for a luxury private estate in Jumeirah.",
