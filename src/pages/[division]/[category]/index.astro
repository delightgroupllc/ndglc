---
import Layout from '../../../layouts/Layout.astro';
import { query } from '../../../lib/db';
import { ArrowRight, ChevronRight, Search, Settings, AlertTriangle, Cpu, Activity } from '@lucide/astro';

const { division, category } = Astro.params;

const divSlug = division!.toLowerCase();
const catSlug = category!.toLowerCase();

const isDtl = divSlug === 'dtl' || divSlug === 'delighttechnicallighting';
const isDgs = divSlug === 'dgs' || divSlug === 'delightgreenscapes' || divSlug === 'delightscreenscape';

if (!isDtl && !isDgs) {
  return Astro.redirect('/');
}

const dbDivSlug = isDtl ? 'delighttechnicallighting' : 'delightgreenscapes';

let categoryDetails: any = null;
let products: any[] = [];
let dbConnected = true;

try {
  // 1. Get Category Details
  const catRes = await query(
    `SELECT c.*, d.name as division_name 
     FROM categories c 
     JOIN divisions d ON d.id = c.division_id 
     WHERE c.slug = $1 AND d.slug = $2`,
    [catSlug, dbDivSlug]
  );
  categoryDetails = catRes.rows[0];

  if (!categoryDetails) {
    return Astro.redirect(`/${divSlug}`);
  }

  // 2. Get Products in Category
  const prodRes = await query(
    `SELECT p.*, pi.url as image_url
     FROM products p
     LEFT JOIN product_images pi ON pi.product_id = p.id AND pi.is_primary = true
     WHERE p.category_id = $1 AND p.status = 'active'
     ORDER BY p.name ASC`,
    [categoryDetails.id]
  );
  products = prodRes.rows;
} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}
---

<Layout title={categoryDetails.name} description={`${categoryDetails.name} listings under ${categoryDetails.division_name}.`}>
  <!-- Header Banner -->
  <section class="relative overflow-hidden pt-32 pb-12 bg-white border-b border-slate-200">
    <div class={`absolute top-0 right-1/4 -z-10 h-96 w-96 rounded-full blur-[120px] ${
      isDtl ? 'bg-amber-400/20' : 'bg-cyan-400/20'
    }`}></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-1.5 text-xs text-slate-500 font-medium">
          <a href="/" class="hover:text-slate-900 transition-colors">Portal</a>
          <ChevronRight class="h-3 w-3" />
          <a href={`/${divSlug}`} class="hover:text-slate-900 transition-colors">{categoryDetails.division_name}</a>
          <ChevronRight class="h-3 w-3" />
          <span class="text-slate-900 font-bold">{categoryDetails.name}</span>
        </nav>

        <div class="flex items-center gap-3 pt-2">
          <div class={`flex h-8 w-8 items-center justify-center rounded-lg font-bold shadow-md ${
            isDtl ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20'
          }`}>
            {isDtl ? <Activity class="h-4.5 w-4.5" /> : <Cpu class="h-4.5 w-4.5" />}
          </div>
          <span class="text-xs font-semibold text-slate-600 tracking-wider uppercase">
            {categoryDetails.division_name} Products Portfolio
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight text-slate-900 mt-1">
          {categoryDetails.name}
        </h1>
      </div>
    </div>
  </section>

  <!-- Database Connection Banner (Only shown if offline) -->
  {!dbConnected && (
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-8">
      <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400">
            <AlertTriangle class="h-5 w-5" />
          </div>
          <div>
            <h4 class="text-sm font-semibold text-slate-900">PostgreSQL Offline Fallback</h4>
            <p class="text-xs text-slate-600 mt-0.5">The application is running in mock database mode. Connect your PostgreSQL database in the `.env` file to load live production items.</p>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Search and Products Grid -->
  <section class="py-12 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Search and Filter Bar -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200">
        <!-- Search Input -->
        <div class="relative flex-grow max-w-md">
          <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4.5 w-4.5 text-slate-500" />
          <input 
            type="text" 
            id="product-search"
            placeholder={`Filter ${categoryDetails.name.toLowerCase()} by name, SKU...`} 
            class="w-full rounded-lg border border-slate-300 bg-white px-10 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 shadow-sm transition-colors"
          />
        </div>
        
        <!-- Systems count info -->
        <div class="text-xs text-slate-500 font-medium flex items-center gap-1.5 self-center bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          Showing <span id="filtered-count" class="text-slate-900 font-bold">{products.length}</span> systems
        </div>
      </div>

      <!-- Products Grid -->
      {products.length === 0 ? (
        <div class="text-center py-20 border border-dashed border-slate-300 rounded-2xl bg-white shadow-sm">
          <Settings class="h-12 w-12 text-slate-300 mx-auto animate-spin" />
          <h3 class="text-lg font-bold text-slate-900 mt-4 font-display">No Systems Logged</h3>
          <p class="text-xs text-slate-500 max-w-xs mx-auto mt-2">
            There are currently no products seeded or created under this category. Visit the admin dashboard to add new items.
          </p>
        </div>
      ) : (
        <div id="products-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {products.map((p) => (
            <div 
              class="product-card group border border-slate-200 rounded-2xl bg-white overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-slate-300 transition-all duration-300"
              data-name={p.name.toLowerCase()}
              data-sku={p.sku.toLowerCase()}
            >
              <div>
                <!-- Image -->
                <div class="h-56 overflow-hidden bg-slate-50 relative border-b border-slate-100">
                  <img 
                    src={p.image_url || '/noimage.jpg'} 
                    alt={p.name}
                    class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
                  />
                  {p.featured && (
                    <span class="absolute top-4 right-4 rounded-full bg-cyan-50 border border-cyan-200 px-2.5 py-1 text-2xs font-bold uppercase tracking-wider text-cyan-600 shadow-sm">
                      Featured
                    </span>
                  )}
                </div>

                <!-- Product specs detail -->
                <div class="p-6">
                  <span class="text-2xs font-bold text-slate-400 uppercase tracking-widest">{p.sku}</span>
                  <h3 class="text-lg font-bold text-slate-900 mt-1 group-hover:text-blue-600 transition-colors truncate" title={p.name}>
                    {p.name}
                  </h3>
                  <p class="text-xs text-slate-500 mt-2.5 leading-relaxed line-clamp-2">
                    {p.description}
                  </p>
                </div>
              </div>

              <!-- Button footer -->
              <div class="px-6 pb-6 pt-2 mt-auto">
                <a 
                  href={`/${divSlug}/${catSlug}/${p.slug || p.id}`}
                  class="w-full flex items-center justify-center gap-1.5 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-xs font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors"
                >
                  View Specifications
                  <ArrowRight class="h-3.5 w-3.5" />
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Pagination Controls -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white border border-slate-200 rounded-xl p-4 shadow-sm mt-8">
          <div class="flex items-center gap-2 text-xs text-slate-500 font-bold">
            <span>Show</span>
            <select id="pagination-limit" class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-xs font-semibold text-slate-700 focus:outline-none">
              <option value="10" selected>10 products</option>
              <option value="25">25 products</option>
            </select>
            <span>per page</span>
          </div>
          <div class="text-xs text-slate-500 font-semibold">
            Showing <span id="pagination-start" class="text-slate-900 font-bold">1</span> to <span id="pagination-end" class="text-slate-900 font-bold">10</span> of <span id="pagination-total" class="text-slate-900 font-bold">0</span> products
          </div>
          <div class="flex items-center gap-1.5" id="pagination-buttons">
            <!-- Buttons will be dynamically inserted here -->
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Client-Side Instant Filtering & Pagination Script -->
  <script>
    const searchInput = document.getElementById('product-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll('.product-card'));
    const filteredCount = document.getElementById('filtered-count');
    const limitSelect = document.getElementById('pagination-limit') as HTMLSelectElement | null;

    let currentPage = 1;
    let itemsPerPage = 10;

    if (limitSelect) {
      limitSelect.addEventListener('change', () => {
        itemsPerPage = parseInt(limitSelect.value) || 10;
        currentPage = 1;
        updateView(false);
      });
    }

    function updateView(resetPage = false) {
      if (resetPage) {
        currentPage = 1;
      }

      const query = searchInput?.value.toLowerCase().trim() || '';
      
      // Filter
      const matchingCards = cards.filter((card) => {
        const name = card.getAttribute('data-name') || '';
        const sku = card.getAttribute('data-sku') || '';
        const isMatch = name.includes(query) || sku.includes(query);
        
        (card as HTMLElement).classList.add('hidden'); // Hide all first
        return isMatch;
      });

      // Update filtered count indicator
      if (filteredCount) {
        filteredCount.textContent = matchingCards.length.toString();
      }

      // Paginate
      const totalItems = matchingCards.length;
      const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

      if (currentPage > totalPages) {
        currentPage = totalPages;
      }

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = Math.min(startIndex + itemsPerPage, totalItems);

      // Show items in slice
      matchingCards.slice(startIndex, endIndex).forEach(card => {
        (card as HTMLElement).classList.remove('hidden');
      });

      // Update Pagination Stats UI
      const startEl = document.getElementById('pagination-start');
      const endEl = document.getElementById('pagination-end');
      const totalEl = document.getElementById('pagination-total');
      if (startEl) startEl.textContent = String(totalItems === 0 ? 0 : startIndex + 1);
      if (endEl) endEl.textContent = String(endIndex);
      if (totalEl) totalEl.textContent = String(totalItems);

      // Render Buttons
      const buttonsContainer = document.getElementById('pagination-buttons');
      if (buttonsContainer) {
        buttonsContainer.innerHTML = '';

        // Prev Button
        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.disabled = currentPage === 1;
        prevBtn.className = `px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold ${currentPage === 1 ? 'opacity-50 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors'}`;
        prevBtn.innerHTML = '&larr; Prev';
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            updateView(false);
          }
        });
        buttonsContainer.appendChild(prevBtn);

        // Page Numbers
        const maxVisiblePages = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

        if (endPage - startPage + 1 < maxVisiblePages) {
          startPage = Math.max(1, endPage - maxVisiblePages + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          pageBtn.className = `px-3 py-1.5 rounded-lg border text-xs font-semibold ${currentPage === i ? 'bg-cyan-600 border-cyan-600 text-white font-bold' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors'}`;
          pageBtn.textContent = String(i);
          pageBtn.addEventListener('click', () => {
            currentPage = i;
            updateView(false);
          });
          buttonsContainer.appendChild(pageBtn);
        }

        // Next Button
        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.className = `px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold ${currentPage === totalPages ? 'opacity-50 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors'}`;
        nextBtn.innerHTML = 'Next &rarr;';
        nextBtn.addEventListener('click', () => {
          if (currentPage < totalPages) {
            currentPage++;
            updateView(false);
          }
        });
        buttonsContainer.appendChild(nextBtn);
      }
    }

    searchInput?.addEventListener('input', () => updateView(true));
    
    // Initial load
    updateView(true);
  </script>
</Layout>
