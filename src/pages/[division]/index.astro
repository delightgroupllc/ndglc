              {/* Cards 2 & 3: hover image cards */}
              {projects.slice(1, 3).map((proj) => (
                <div class="group relative rounded-2xl overflow-hidden bg-slate-200 min-h-[380px] cursor-pointer shadow-md">
                  {proj.featured_image ? (
                    <img
                      src={proj.featured_image}
                      alt={proj.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      style="min-height: 380px;"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full min-h-[380px] flex items-center justify-center bg-gradient-to-br from-[#00360d] to-[#001705]">
                      <LayoutGrid class="h-16 w-16 text-emerald-800" />
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-3 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300 text-left">
                    <p class="text-[10px] uppercase font-bold tracking-widest text-[#BE854C] mb-1">{proj.client_name || 'Landscape construction'}</p>
                    <p class="text-white font-bold text-base drop-shadow">{proj.title}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="text-right mt-6">
              <a
                href="/projects?division=dgs"
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600 hover:text-[#004712] transition-colors"
              >
                View DGS Project Archive
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </div>
        </section>
      )}

      <!-- 8. Stats Fact Banner -->
      <section class="py-16 bg-[#004712] text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            {factsArr.map(f => (
              <div class="text-center space-y-2">
                <div class="text-4xl md:text-5xl font-black text-[#BE854C]">{f.value}</div>
                <div class="h-0.5 w-8 bg-white/20 mx-auto"></div>
                <p class="text-slate-200 font-medium text-xs uppercase tracking-wider">{f.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 9. Dynamic Clients & Partners scrolling logos -->
      {partners.length > 0 && (
        <section class="py-16 bg-white border-b border-slate-100">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
              <span class="text-xs uppercase tracking-widest text-[#BE854C] font-black">Trusted Partners</span>
              <h2 class="text-xl font-bold text-slate-800 font-display mt-1">Our Clients & Master Builders</h2>
            </div>
            
            <div class="flex flex-wrap items-center justify-center gap-12 opacity-75 hover:opacity-100 transition-opacity duration-300">
              {partners.map(p => (
                <a 
                  href={p.website_url || '#'} 
                  target={p.website_url ? "_blank" : undefined}
                  class="flex items-center justify-center max-h-12 max-w-[150px] grayscale hover:grayscale-0 transition-all duration-300"
                  title={p.name}
                >
                  {p.logo_url ? (
                    <img src={p.logo_url} alt={p.name} class="max-h-10 object-contain" />
                  ) : (
                    <span class="font-extrabold text-sm md:text-base tracking-widest text-slate-600 uppercase">{p.name}</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- 10. Dynamic Press Releases & Events -->
      {articles.length > 0 && (
        <section class="py-20 bg-white border-b border-slate-100">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
              <span class="text-xs uppercase tracking-widest text-[#BE854C] font-black">Latest News</span>
              <h2 class="text-3xl md:text-5xl font-extrabold text-[#004712] font-display">
                Press Releases & Events
              </h2>
              <div class="w-16 h-1 bg-[#BE854C] mx-auto mt-2"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {articles.map((art) => (
                <div class="bg-[#F8F9F8] rounded-2xl border border-slate-200/50 overflow-hidden flex flex-col justify-between hover:shadow-lg transition-all duration-300">
                  <div>
                    <div class="h-48 bg-slate-100 overflow-hidden relative">
                      {art.featured_image ? (
                        <img src={art.featured_image} alt={art.title} class="w-full h-full object-cover hover:scale-103 transition-transform duration-500" />
                      ) : (
                        <div class="w-full h-full bg-gradient-to-br from-emerald-800 to-emerald-950 flex items-center justify-center text-white/30 text-lg">Announcements</div>
                      )}
                      <span class="absolute top-3 left-3 bg-[#BE854C] text-white text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded shadow-sm">
                        {art.type.replace('_', ' ')}
                      </span>
                    </div>
                    <div class="p-6 space-y-3 text-left">
                      <div class="text-[10px] text-slate-500 font-bold uppercase tracking-wider flex items-center gap-1">
                        <Calendar class="h-3.5 w-3.5 text-[#BE854C]" />
                        {art.published_at ? new Date(art.published_at).toLocaleDateString(undefined, {month: 'long', day: 'numeric', year: 'numeric'}) : 'Press'}
                      </div>
                      <h3 class="text-lg font-bold text-[#004712] line-clamp-2 leading-snug font-display">
                        {art.title}
                      </h3>
                      <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                        {art.summary || art.content}
                      </p>
                    </div>
                  </div>
                  <div class="p-6 pt-0 text-left">
                    <a 
                      href={`/news/${art.slug}`} 
                      class="inline-flex items-center gap-1.5 text-xs font-bold text-[#BE854C] hover:text-[#004712] transition-colors"
                    >
                      Read Full Article
                      <ArrowRight class="h-3.5 w-3.5" />
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

    </div>
  )}

</Layout>

