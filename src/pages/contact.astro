---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { Mail, Phone, MapPin, Zap, Globe, Share2, Grid } from '@lucide/astro';
import { query } from '../lib/db';

let address = 'Delight Group Building, Al Quoz Industrial Area 3, Dubai, UAE';
let phone = '+971 (4) 555-0100';
let email = 'info@delightgroupllc.ae';

try {
  const settingsRes = await query(`
    SELECT key, value 
    FROM settings 
    WHERE key IN ('company_address', 'contact_phone', 'contact_email')
  `);
  
  settingsRes.rows.forEach(row => {
    if (row.key === 'company_address') address = row.value;
    if (row.key === 'contact_phone') phone = row.value;
    if (row.key === 'contact_email') email = row.value;
  });
} catch (err: any) {
  console.warn('Failed to load contact settings from DB:', err.message);
}
---

<Layout title="Contact Us" description="Start a conversation with Delight Group LLC">
  <div class="min-h-screen bg-[#f3f4f6] py-16 sm:py-24 relative overflow-hidden">
    <!-- Subtle architectural guidelines background pattern -->
    <div class="absolute inset-0 z-0 opacity-[0.06] pointer-events-none" style="background-image: radial-gradient(#000000 1px, transparent 1px); background-size: 24px 24px;"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Primary Two-Column Grid Card -->
      <div class="bg-white rounded-[32px] overflow-hidden shadow-2xl border border-slate-100 grid grid-cols-1 lg:grid-cols-12 gap-0 mb-16">
        
        <!-- Left Column: Premium Architectural Facade Image with Frosted Overlay -->
        <div class="lg:col-span-5 relative min-h-[380px] lg:min-h-[550px] bg-slate-900 overflow-hidden flex flex-col justify-end p-6 sm:p-10">
          <img 
            src="/about-hero.png" 
            alt="Delight Group Luxury Facade Lighting" 
            class="absolute inset-0 w-full h-full object-cover opacity-85 transition-transform duration-700 hover:scale-105"
          />
          <!-- Gentle dark gradient cover -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-900/20 to-transparent z-0"></div>
        </div>
        
        <!-- Right Column: Minimal Underline Project Form -->
        <div class="lg:col-span-7 bg-white">
          <ContactForm />
        </div>
        
      </div>
      
      <!-- Bottom Detail Cards (Three Column Layout) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Card 1: Headquarters -->
        <div class="bg-white border border-slate-200/60 shadow-xl shadow-slate-100/50 rounded-2xl p-8 text-left flex flex-col justify-between h-full transition-all duration-300 hover:shadow-2xl hover:border-slate-300">
          <div class="space-y-6">
            <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-center text-slate-800 shrink-0">
              <MapPin class="w-4.5 h-4.5" />
            </div>
            
            <div class="space-y-3">
              <h3 class="text-lg font-serif font-medium text-slate-900">Headquarters</h3>
              <div class="w-8 h-[1px] bg-slate-300"></div>
            </div>
            
            <p class="text-xs sm:text-sm font-semibold text-slate-500 leading-relaxed" set:html={address.replace(/,\s*/g, ',<br />')} />
          </div>
          
          <div class="pt-8">
            <a 
              href="https://maps.google.com" 
              target="_blank"
              class="text-[10px] font-black uppercase tracking-widest text-[#b45309] hover:text-amber-800 transition-colors border-b border-[#b45309]/30 hover:border-amber-700 pb-0.5"
            >
              View On Map
            </a>
          </div>
        </div>
        
        <!-- Card 2: Direct Inquiry -->
        <div class="bg-white border border-slate-200/60 shadow-xl shadow-slate-100/50 rounded-2xl p-8 text-left flex flex-col justify-between h-full transition-all duration-300 hover:shadow-2xl hover:border-slate-300">
          <div class="space-y-6">
            <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-center text-slate-800 shrink-0">
              <Mail class="w-4.5 h-4.5" />
            </div>
            
            <div class="space-y-3">
              <h3 class="text-lg font-serif font-medium text-slate-900">Direct Inquiry</h3>
              <div class="w-8 h-[1px] bg-slate-300"></div>
            </div>
            
            <div class="space-y-2 text-xs sm:text-sm font-semibold text-slate-500">
              <p>General: <a href={`mailto:${email}`} class="text-slate-800 hover:text-slate-950 font-bold">{email}</a></p>
              <p>Press: <a href="mailto:media@delightgroupllc.com" class="text-slate-800 hover:text-slate-950 font-bold">media@delightgroupllc.com</a></p>
              <p>Careers: <a href="mailto:careers@delightgroupllc.com" class="text-slate-800 hover:text-slate-950 font-bold">careers@delightgroupllc.com</a></p>
            </div>
          </div>
          
          <div class="pt-8 opacity-0 pointer-events-none select-none">
            <span class="text-[10px] font-black uppercase tracking-widest">Spacer</span>
          </div>
        </div>
        
        <!-- Card 3: Call Us -->
        <div class="bg-white border border-slate-200/60 shadow-xl shadow-slate-100/50 rounded-2xl p-8 text-left flex flex-col justify-between h-full transition-all duration-300 hover:shadow-2xl hover:border-slate-300">
          <div class="space-y-6">
            <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-center text-slate-800 shrink-0">
              <Phone class="w-4.5 h-4.5" />
            </div>
            
            <div class="space-y-3">
              <h3 class="text-lg font-serif font-medium text-slate-900">Call Us</h3>
              <div class="w-8 h-[1px] bg-slate-300"></div>
            </div>
            
            <div class="space-y-2 text-xs sm:text-sm font-semibold text-slate-500">
              <p>Monday – Friday: 09:00 – 18:00 GST</p>
              <a href={`tel:${phone.replace(/[()\s-]/g, '')}`} class="text-slate-800 text-base sm:text-lg font-extrabold hover:text-slate-950 transition-colors block mt-2">
                {phone}
              </a>
            </div>
          </div>
          
          <!-- Social / Utility Button Row (Mockup replication) -->
          <div class="pt-8 flex items-center gap-2">
            <a 
              href="https://delightgroupllc.com" 
              target="_blank"
              class="w-8 h-8 rounded-lg border border-slate-200 hover:border-slate-300 flex items-center justify-center text-slate-500 hover:text-slate-850 hover:bg-slate-50 transition-all"
            >
              <Globe class="w-3.5 h-3.5" />
            </a>
            <button 
              class="w-8 h-8 rounded-lg border border-slate-200 hover:border-slate-300 flex items-center justify-center text-slate-500 hover:text-slate-850 hover:bg-slate-50 transition-all"
            >
              <Share2 class="w-3.5 h-3.5" />
            </button>
            <button 
              class="w-8 h-8 rounded-lg border border-slate-200 hover:border-slate-300 flex items-center justify-center text-slate-500 hover:text-slate-850 hover:bg-slate-50 transition-all"
            >
              <Grid class="w-3.5 h-3.5" />
            </button>
          </div>
        </div>
        
      </div>
      
    </div>
  </div>
</Layout>
