---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { Users2, Search, ToggleLeft, ToggleRight, ShieldAlert, Award, AlertTriangle, Plus, Copy } from '@lucide/astro';

let users: any[] = [];
let customers: any[] = [];
let companies: any[] = [];
let dbConnected = true;

try {
  const res = await query(
    `SELECT u.*, 
       (SELECT ARRAY_TO_STRING(ARRAY_AGG(r.name), ', ') FROM roles r JOIN user_roles ur ON ur.role_id = r.id WHERE ur.user_id = u.id) as roles_list,
       (SELECT ARRAY_TO_STRING(ARRAY_AGG(t.name), ', ') FROM tags t JOIN user_tags ut ON ut.tag_id = t.id WHERE ut.user_id = u.id) as tags_list
     FROM users u
     ORDER BY u.created_at DESC`
  );
  users = res.rows;

  const custRes = await query(`
    SELECT c.*,
      EXISTS(
        SELECT 1 FROM invoices i 
        WHERE i.customer_name = c.name 
           OR i.customer_email = c.email 
           OR i.customer_phone = c.phone
      ) as has_orders
    FROM customers c
    ORDER BY c.created_at DESC
  `);
  customers = custRes.rows;

  const compRes = await query(`
    SELECT c.*, 
      (SELECT COUNT(*) FROM customers cust WHERE cust.company_id = c.id) as customer_count,
      (SELECT JSON_AGG(cust) FROM (SELECT id, name, email, phone, code, billing_address, shipping_address FROM customers WHERE company_id = c.id AND is_deleted = false) cust) as customers_list
    FROM companies c
    ORDER BY c.name ASC
  `);
  companies = compRes.rows;
} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}
---

<DashboardLayout title="User Directory" activeItem="users">

  <!-- Offline Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL is Offline</span>: Telemetry displays simulated Clerk-synced accounts.
      </div>
    </div>
  )}

  <div class="space-y-6 p-6 lg:p-8">
    
    <!-- Info Note -->
    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-4 flex gap-3 text-xs text-cyan-800 font-medium">
      <span class="font-bold">Note:</span> Generating an invoice for a customer or company that does not exist yet will automatically create the record and link them.
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div class="relative flex-grow max-w-md flex gap-2">
        <div class="relative flex-grow">
          <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
          <input 
            type="text" 
            id="admin-search-users"
            placeholder="Filter directory..." 
            class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
          />
        </div>
        <select 
          id="customer-sort-select" 
          class="rounded-lg border border-slate-200 bg-white text-slate-900 px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50 font-medium shrink-0"
        >
          <option value="recent">Sort: Recent</option>
          <option value="name">Sort: Name</option>
          <option value="company">Sort: Company</option>
        </select>
      </div>

      <!-- Segmented Control Tabs & Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 self-start sm:self-auto shrink-0">
        <div class="flex gap-2 bg-slate-100 p-1 rounded-lg border border-slate-200 animate-fade-in">
          <button id="btn-tab-customers" class="px-4 py-1.5 text-xs font-bold text-cyan-700 bg-white rounded-md shadow-xs transition-all focus:outline-none">
            Customer Registry
          </button>
          <button id="btn-tab-companies" class="px-4 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 rounded-md transition-all focus:outline-none">
            Company Registry
          </button>
          <button id="btn-tab-users" class="px-4 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 rounded-md transition-all focus:outline-none">
            Users Directory
          </button>
        </div>

        <!-- Customer registry sub-filters: Active, Archived, Bin -->
        <div id="customer-filter-group" class="flex gap-1 bg-slate-100 p-1 rounded-lg border border-slate-200 animate-fade-in">
          <button id="btn-cust-active" class="px-3 py-1 text-2xs font-bold text-cyan-700 bg-white rounded-md shadow-xs transition-all focus:outline-none">
            Active
          </button>
          <button id="btn-cust-archived" class="px-3 py-1 text-2xs font-bold text-slate-600 hover:text-slate-900 rounded-md transition-all focus:outline-none">
            Archived
          </button>
          <button id="btn-cust-bin" class="px-3 py-1 text-2xs font-bold text-slate-600 hover:text-slate-900 rounded-md transition-all focus:outline-none">
            Bin (Trash)
          </button>
        </div>

        <button id="btn-create-company" class="px-4 py-2 text-xs font-bold text-white bg-violet-600 hover:bg-violet-700 rounded-lg shadow-sm transition-all focus:outline-none flex items-center gap-1.5">
          <Plus class="w-3.5 h-3.5" />
          Create Company
        </button>
        <button id="btn-create-customer" class="px-4 py-2 text-xs font-bold text-white bg-cyan-600 hover:bg-cyan-700 rounded-lg shadow-sm transition-all focus:outline-none flex items-center gap-1.5">
          <Plus class="w-3.5 h-3.5" />
          Create Customer
        </button>
      </div>
    </div>

    <!-- Users Container -->
    <div id="users-container" class="hidden rounded-xl border border-slate-200 bg-white overflow-x-auto shadow-sm">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
            <th class="px-6 py-4 font-semibold">Profile Name</th>
            <th class="px-6 py-4 font-semibold">B2B Mapped Roles</th>
            <th class="px-6 py-4 font-semibold">Active Portal Tags</th>
            <th class="px-6 py-4 font-semibold text-center">Status</th>
            <th class="px-6 py-4 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="admin-users-table">
          {users.map(u => (
            <tr class="admin-user-row border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors" data-name={u.name.toLowerCase()} data-email={u.email.toLowerCase()}>
              <!-- User credentials -->
              <td class="px-6 py-4">
                <div class="font-bold text-slate-900">{u.name}</div>
                <div class="text-2xs text-slate-500 mt-0.5 font-mono">{u.email}</div>
              </td>
              <!-- Roles -->
              <td class="px-6 py-4">
                <span class="rounded bg-cyan-500/10 border border-cyan-500/20 px-2 py-0.5 text-2xs font-semibold text-cyan-600 uppercase">
                  {u.roles_list || 'user'}
                </span>
              </td>
              <!-- Tags -->
              <td class="px-6 py-4">
                {u.tags_list ? (
                  <div class="flex flex-wrap gap-1">
                    {u.tags_list.split(', ').map((tag: string) => (
                      <span class="rounded bg-rose-500/10 border border-rose-500/20 px-1.5 py-0.5 text-2xs font-semibold text-rose-600 uppercase">
                        {tag}
                      </span>
                    ))}
                  </div>
                ) : (
                  <span class="text-2xs text-slate-400 italic">None assigned</span>
                )}
              </td>
              <!-- Status suspension -->
              <td class="px-6 py-4 text-center">
                <span id={`status-${u.id}`} class={`rounded px-1.5 py-0.5 text-2xs font-semibold uppercase transition-colors ${
                  u.is_suspended 
                    ? 'bg-rose-500/10 text-rose-600' 
                    : 'bg-emerald-500/10 text-emerald-600'
                }`}>
                  {u.is_suspended ? 'suspended' : 'active'}
                </span>
              </td>
              <!-- Quick Actions -->
              <td class="px-6 py-4 text-right">
                <button 
                  type="button" 
                  data-user-id={u.id}
                  data-suspended={u.is_suspended ? 'true' : 'false'}
                  class="toggle-suspend-btn inline-flex items-center gap-1 text-2xs font-bold uppercase tracking-wider focus:outline-none transition-colors text-slate-500 hover:text-slate-900"
                >
                  <span class="btn-text">{u.is_suspended ? 'Unsuspend' : 'Suspend'}</span>
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Customers Container -->
    <div id="customers-container" class="rounded-xl border border-slate-200 bg-white overflow-x-auto shadow-sm">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
            <th class="px-6 py-4 font-semibold">Customer Code</th>
            <th class="px-6 py-4 font-semibold">Customer Info</th>
            <th class="px-6 py-4 font-semibold">Company / TIN/VAT</th>
            <th class="px-6 py-4 font-semibold">Billing Address</th>
            <th class="px-6 py-4 font-semibold">Shipping Address</th>
            <th class="px-6 py-4 font-semibold text-center">Status</th>
            <th class="px-6 py-4 font-semibold text-center">Registered</th>
            <th class="px-6 py-4 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="admin-customers-table">
          {customers.map((c, i) => (
            <tr class="admin-customer-row border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors" 
                data-index={i}
                data-id={c.id}
                data-name={c.name}
                data-email={c.email || ''} 
                data-phone={c.phone || ''}
                data-company={c.company_name || ''}
                data-vat={c.company_vat || ''}
                data-billing={c.billing_address || ''}
                data-shipping={c.shipping_address || ''}
                data-code={c.code || ''}
                data-archived={c.is_archived ? 'true' : 'false'}
                data-deleted={c.is_deleted ? 'true' : 'false'}
                data-has-orders={c.has_orders ? 'true' : 'false'}>
              <td class="px-6 py-4 font-mono font-bold text-slate-900">
                {c.code || '—'}
              </td>
              <td class="px-6 py-4">
                <div class="font-bold text-slate-900">{c.name}</div>
                {c.email && <div class="text-2xs text-slate-500 mt-0.5 font-mono">{c.email}</div>}
                {c.phone && <div class="text-2xs text-slate-400 mt-0.5">{c.phone}</div>}
              </td>
              <td class="px-6 py-4">
                <div class="font-semibold text-slate-800">{c.company_name || '—'}</div>
                {c.company_vat && <div class="text-2xs text-slate-500 mt-0.5 font-mono">TIN/VAT: {c.company_vat}</div>}
              </td>
              <td class="px-6 py-4 max-w-xs truncate font-medium text-slate-600" title={c.billing_address}>
                {c.billing_address || <span class="text-slate-400 italic">—</span>}
              </td>
              <td class="px-6 py-4 max-w-xs truncate font-medium text-slate-600" title={c.shipping_address}>
                {c.shipping_address || <span class="text-slate-400 italic">—</span>}
              </td>
              <td class="px-6 py-4 text-center">
                <span id={'customer-status-' + c.id} class={'rounded px-1.5 py-0.5 text-2xs font-semibold uppercase transition-colors ' + (
                  c.is_deleted 
                    ? 'bg-rose-500/10 text-rose-600'
                    : c.is_archived 
                      ? 'bg-amber-500/10 text-amber-600' 
                      : 'bg-emerald-500/10 text-emerald-600'
                )}>
                  {c.is_deleted ? 'bin' : c.is_archived ? 'archived' : 'active'}
                </span>
              </td>
              <td class="px-6 py-4 text-center text-slate-500 text-2xs font-mono">
                {new Date(c.created_at).toLocaleDateString('en-AE')}
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <button 
                    type="button" 
                    class="edit-customer-btn inline-flex items-center gap-1 text-2xs font-bold uppercase tracking-wider text-cyan-600 hover:text-cyan-700 focus:outline-none transition-colors"
                  >
                    Edit
                  </button>
                </div>
              </td>
            </tr>
          ))}
          {customers.length === 0 && (
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-400 italic">No customers found in database.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <!-- Companies Container -->
    <div id="companies-container" class="hidden rounded-xl border border-slate-200 bg-white overflow-x-auto shadow-sm">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
            <th class="px-6 py-4 font-semibold">Company Code</th>
            <th class="px-6 py-4 font-semibold">Company Name</th>
            <th class="px-6 py-4 font-semibold">TIN/VAT Number</th>
            <th class="px-6 py-4 font-semibold">Billing Address</th>
            <th class="px-6 py-4 font-semibold">Shipping Address</th>
            <th class="px-6 py-4 font-semibold text-center">Linked Customers</th>
            <th class="px-6 py-4 font-semibold text-center">Status</th>
            <th class="px-6 py-4 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="admin-companies-table">
          {companies.map((comp) => (
            <tr class="admin-company-row border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors" 
                data-id={comp.id}
                data-name={comp.name}
                data-vat={comp.vat_number || ''}
                data-billing={comp.billing_address || ''}
                data-shipping={comp.shipping_address || ''}
                data-code={comp.code || ''}
                data-default-customer-id={comp.default_customer_id || ''}
                data-customers={JSON.stringify(comp.customers_list || [])}
                data-archived={comp.is_archived ? 'true' : 'false'}
                data-deleted={comp.is_deleted ? 'true' : 'false'}>
              <td class="px-6 py-4 font-mono font-bold text-slate-900">
                {comp.code || '—'}
              </td>
              <td class="px-6 py-4 font-bold text-slate-900">{comp.name}</td>
              <td class="px-6 py-4 font-mono font-medium text-slate-700">
                {comp.vat_number || <span class="text-slate-400 italic">—</span>}
              </td>
              <td class="px-6 py-4 max-w-xs truncate font-medium text-slate-600" title={comp.billing_address ? comp.billing_address.split(' ||| ').join('; ') : ''}>
                {comp.billing_address ? comp.billing_address.split(' ||| ').join('; ') : <span class="text-slate-400 italic">—</span>}
              </td>
              <td class="px-6 py-4 max-w-xs truncate font-medium text-slate-600" title={comp.shipping_address ? comp.shipping_address.split(' ||| ').join('; ') : ''}>
                {comp.shipping_address ? comp.shipping_address.split(' ||| ').join('; ') : <span class="text-slate-400 italic">—</span>}
              </td>
              <td class="px-6 py-4 text-center font-bold text-cyan-600">
                {comp.customer_count || 0}
              </td>
              <td class="px-6 py-4 text-center">
                <span id={'company-status-' + comp.id} class={'rounded px-1.5 py-0.5 text-2xs font-semibold uppercase transition-colors ' + (
                  comp.is_deleted 
                    ? 'bg-rose-500/10 text-rose-600'
                    : comp.is_archived 
                      ? 'bg-amber-500/10 text-amber-600' 
                      : 'bg-emerald-500/10 text-emerald-600'
                )}>
                  {comp.is_deleted ? 'bin' : comp.is_archived ? 'archived' : 'active'}
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <button 
                    type="button" 
                    class="edit-company-btn inline-flex items-center gap-1 text-2xs font-bold uppercase tracking-wider text-violet-600 hover:text-violet-700 focus:outline-none transition-colors"
                  >
                    Edit
                  </button>
                </div>
              </td>
            </tr>
          ))}
          {companies.length === 0 && (
            <tr>
              <td colspan="8" class="px-6 py-8 text-center text-slate-400 italic">No companies found in database.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

  </div>

  <!-- CREATE / EDIT COMPANY MODAL -->
  <div id="edit-company-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 animate-fade-in">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh] overflow-y-auto">
      <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-violet-500"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="company-modal-title-text">Edit Company Details</span>
        </h3>
        <button id="close-company-modal" class="text-slate-400 hover:text-slate-700 rounded-lg p-1 hover:bg-slate-100 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <form id="edit-company-form" class="p-6 space-y-4" onsubmit="return false;">
        <input type="hidden" id="edit-company-id" />
        
        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Company Code</label>
          <input type="text" id="edit-company-code" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-violet-500 focus:outline-none transition-colors" placeholder="e.g. COM-1001 (generated automatically if blank)" />
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Company Name *</label>
          <input type="text" id="edit-company-name" required class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-violet-500 focus:outline-none transition-colors" />
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Company TIN / VAT Number</label>
          <input type="text" id="edit-company-vat" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" />
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Billing Address</label>
          <textarea id="edit-company-billing" rows="2" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors resize-none"></textarea>
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Shipping / Delivery Address</label>
          <textarea id="edit-company-shipping" rows="2" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors resize-none"></textarea>
        </div>

        <div class="space-y-3 border-t border-slate-100 pt-4">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Inline Customers / Contact Persons</label>
          <div id="company-inline-customers-list" class="space-y-2.5"></div>
          <button type="button" id="btn-add-company-customer" class="inline-flex items-center gap-1 text-2xs font-bold text-cyan-600 hover:text-cyan-700 bg-transparent border-0 cursor-pointer">
            <Plus class="w-3.5 h-3.5" /> Add inline customer
          </button>
        </div>

        <div class="flex justify-between items-center pt-4 border-t border-slate-100 mt-6">
          <div class="flex gap-2">
            <button type="button" id="btn-modal-archive-company" class="hidden px-3 py-2 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/50 transition-colors">
              <span id="btn-modal-archive-company-text">Archive</span>
            </button>
            <button type="button" id="btn-modal-delete-company" class="hidden px-3 py-2 rounded-lg text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/50 transition-colors">
              Delete
            </button>
            <button type="button" id="btn-modal-merge-company" class="hidden px-3 py-2 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/50 transition-colors ml-2">
              Merge
            </button>
          </div>
          <div class="flex gap-3">
            <button type="button" id="btn-cancel-company" class="px-4 py-2 rounded-lg text-xs font-bold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
              Cancel
            </button>
            <button type="submit" id="btn-save-company" class="px-4 py-2 rounded-lg text-xs font-bold bg-violet-600 hover:bg-violet-700 text-white transition-colors shadow-sm">
              Save Details
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- CREATE / EDIT CUSTOMER MODAL -->
  <div id="edit-customer-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 animate-fade-in">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh] overflow-y-auto">
      <!-- Header -->
      <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-cyan-500"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="customer-modal-title-text">Edit Customer Details</span>
        </h3>
        <button id="close-customer-modal" class="text-slate-400 hover:text-slate-700 rounded-lg p-1 hover:bg-slate-100 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Body -->
      <form id="edit-customer-form" class="p-6 space-y-4" onsubmit="return false;">
        <input type="hidden" id="edit-customer-id" />
        
        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Customer Code</label>
          <input type="text" id="edit-customer-code" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" placeholder="e.g. CUS-1001 (generated automatically if blank)" />
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Customer Name *</label>
          <input type="text" id="edit-customer-name" required class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Email Address</label>
            <input type="email" id="edit-customer-email" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" />
          </div>
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Phone Number</label>
            <input type="text" id="edit-customer-phone" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Company Name</label>
            <select id="edit-customer-company-select" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors">
              <option value="">No Company</option>
              {companies.map(c => (
                <option value={c.name} data-vat={c.vat_number || ''}>{c.name}</option>
              ))}
              <option value="_CREATE_NEW_">+ Create New Company</option>
            </select>
            <input type="text" id="edit-customer-company-custom" placeholder="New Company Name" class="hidden w-full mt-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" />
            <!-- Keep original input hidden so we can use its ID for API payload easily -->
            <input type="hidden" id="edit-customer-company" />
          </div>
          <div class="space-y-1">
            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Company TIN / VAT Number</label>
            <input type="text" id="edit-customer-vat" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" />
          </div>
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Billing Address</label>
          <textarea id="edit-customer-billing" rows="2" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors resize-none"></textarea>
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Shipping / Delivery Address</label>
          <textarea id="edit-customer-shipping" rows="2" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors resize-none"></textarea>
        </div>

        <!-- Footer -->
        <div class="flex justify-between items-center pt-4 border-t border-slate-100 mt-6">
          <div class="flex gap-2">
            <button type="button" id="btn-modal-archive-customer" class="hidden px-3 py-2 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/50 transition-colors">
              <span id="btn-modal-archive-text">Archive</span>
            </button>
            <button type="button" id="btn-modal-delete-customer" class="hidden px-3 py-2 rounded-lg text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/50 transition-colors">
              Delete
            </button>
            <button type="button" id="btn-modal-merge-customer" class="hidden px-3 py-2 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/50 transition-colors ml-2">
              Merge
            </button>
          </div>
          <div class="flex gap-3">
            <button type="button" id="btn-cancel-customer" class="px-4 py-2 rounded-lg text-xs font-bold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
              Cancel
            </button>
            <button type="submit" id="btn-save-customer" class="px-4 py-2 rounded-lg text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors shadow-sm">
              Save Details
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- CUSTOM CONFIRMATION MODAL -->
  <div id="confirm-dialog-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden items-center justify-center p-4 animate-fade-in">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden flex flex-col p-6 space-y-4">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-amber-50 rounded-lg text-amber-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h3 id="confirm-modal-title" class="text-sm font-black text-slate-900 uppercase tracking-wider">Confirm Action</h3>
      </div>
      <p id="confirm-modal-message" class="text-xs text-slate-600 font-semibold leading-relaxed"></p>
      <div class="flex justify-end gap-3 pt-2">
        <button type="button" id="btn-confirm-cancel" class="px-4 py-2 rounded-lg text-xs font-bold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
          Cancel
        </button>
        <button type="button" id="btn-confirm-proceed" class="px-4 py-2 rounded-lg text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white transition-colors shadow-sm">
          Proceed
        </button>
      </div>
    </div>
  </div>

  <!-- CUSTOM MERGE MODAL -->
  <div id="merge-dialog-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden items-center justify-center p-4 animate-fade-in">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden flex flex-col p-6 space-y-4">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-cyan-50 rounded-lg text-cyan-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        </div>
        <h3 id="merge-modal-title" class="text-sm font-black text-slate-900 uppercase tracking-wider">Merge Entities</h3>
      </div>
      <p id="merge-modal-description" class="text-xs text-slate-600 font-semibold leading-relaxed">
        Enter the code of the primary entity to merge this duplicate into. All invoices and linked records will be updated to point to the primary entity, and this duplicate will be deleted.
      </p>
      
      <div class="space-y-1">
        <label id="merge-modal-label" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Primary Entity Code *</label>
        <input type="text" id="merge-primary-code-input" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-cyan-500 focus:outline-none transition-colors" placeholder="e.g. CUS-1011" />
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button type="button" id="btn-merge-cancel" class="px-4 py-2 rounded-lg text-xs font-bold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
          Cancel
        </button>
        <button type="button" id="btn-merge-proceed" class="px-4 py-2 rounded-lg text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors shadow-sm">
          Merge Entities
        </button>
      </div>
    </div>
  </div>

  <script>
    const showConfirmDialog = (title: string, message: string, confirmText = 'Proceed', isDestructive = true): Promise<boolean> => {
      const backdrop = document.getElementById('confirm-dialog-modal-backdrop');
      const titleEl = document.getElementById('confirm-modal-title');
      const msgEl = document.getElementById('confirm-modal-message');
      const proceedBtn = document.getElementById('btn-confirm-proceed') as HTMLButtonElement | null;
      const cancelBtn = document.getElementById('btn-confirm-cancel');

      if (!backdrop || !titleEl || !msgEl || !proceedBtn || !cancelBtn) {
        return Promise.resolve(false);
      }

      titleEl.textContent = title;
      msgEl.textContent = message;
      proceedBtn.textContent = confirmText;

      if (isDestructive) {
        proceedBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white transition-colors shadow-sm';
      } else {
        proceedBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors shadow-sm';
      }

      backdrop.classList.remove('hidden');
      backdrop.classList.add('flex');

      return new Promise<boolean>((resolve) => {
        const cleanup = (value: boolean) => {
          backdrop.classList.add('hidden');
          backdrop.classList.remove('flex');
          proceedBtn.removeEventListener('click', onProceed);
          cancelBtn.removeEventListener('click', onCancel);
          resolve(value);
        };

        const onProceed = () => cleanup(true);
        const onCancel = () => cleanup(false);

        proceedBtn.addEventListener('click', onProceed);
        cancelBtn.addEventListener('click', onCancel);
      });
    };

    const showMergeDialog = (title: string, description: string, label: string, placeholder: string, codePrefix: string): Promise<string | null> => {
      const backdrop = document.getElementById('merge-dialog-modal-backdrop');
      const titleEl = document.getElementById('merge-modal-title');
      const descEl = document.getElementById('merge-modal-description');
      const labelEl = document.getElementById('merge-modal-label');
      const inputEl = document.getElementById('merge-primary-code-input') as HTMLInputElement | null;
      const proceedBtn = document.getElementById('btn-merge-proceed');
      const cancelBtn = document.getElementById('btn-merge-cancel');

      if (!backdrop || !titleEl || !descEl || !labelEl || !inputEl || !proceedBtn || !cancelBtn) {
        return Promise.resolve(null);
      }

      titleEl.textContent = title;
      descEl.textContent = description;
      labelEl.textContent = label;
      inputEl.placeholder = placeholder;
      inputEl.value = '';

      backdrop.classList.remove('hidden');
      backdrop.classList.add('flex');
      inputEl.focus();

      return new Promise<string | null>((resolve) => {
        const cleanup = (value: string | null) => {
          backdrop.classList.add('hidden');
          backdrop.classList.remove('flex');
          proceedBtn.removeEventListener('click', onProceed);
          cancelBtn.removeEventListener('click', onCancel);
          resolve(value);
        };

        const onProceed = () => {
          const val = inputEl.value.trim().toUpperCase();
          if (!val.startsWith(codePrefix)) {
            alert(`Invalid code. Must start with ${codePrefix}`);
            return;
          }
          cleanup(val);
        };
        const onCancel = () => cleanup(null);

        proceedBtn.addEventListener('click', onProceed);
        cancelBtn.addEventListener('click', onCancel);
      });
    };

    const searchInput = document.getElementById('admin-search-users') as HTMLInputElement | null;
    const userRows = document.querySelectorAll('.admin-user-row');
    const customerRows = document.querySelectorAll('.admin-customer-row');
    const companyRows = document.querySelectorAll('.admin-company-row');

    // Tab buttons & containers
    const btnTabUsers = document.getElementById('btn-tab-users');
    const btnTabCustomers = document.getElementById('btn-tab-customers');
    const btnTabCompanies = document.getElementById('btn-tab-companies');
    const usersContainer = document.getElementById('users-container');
    const customersContainer = document.getElementById('customers-container');
    const companiesContainer = document.getElementById('companies-container');

    // Action buttons
    const btnCreateCompany = document.getElementById('btn-create-company');
    const btnCreateCustomer = document.getElementById('btn-create-customer');

    // Sub-tab buttons
    const btnCustActive = document.getElementById('btn-cust-active');
    const btnCustArchived = document.getElementById('btn-cust-archived');
    const btnCustBin = document.getElementById('btn-cust-bin');

    // Default tabs
    let activeTab: 'users' | 'customers' | 'companies' = 'customers';
    let customerSubTab: 'active' | 'archived' | 'bin' = 'active';

    const filterList = () => {
      const query = searchInput?.value.toLowerCase() || '';
      if (activeTab === 'users') {
        userRows.forEach(row => {
          const name = (row.getAttribute('data-name') || '').toLowerCase();
          const email = (row.getAttribute('data-email') || '').toLowerCase();
          if (name.includes(query) || email.includes(query)) {
            (row as HTMLElement).classList.remove('hidden');
          } else {
            (row as HTMLElement).classList.add('hidden');
          }
        });
      } else if (activeTab === 'companies') {
        companyRows.forEach(row => {
          const name = (row.getAttribute('data-name') || '').toLowerCase();
          const vat = (row.getAttribute('data-vat') || '').toLowerCase();
          const billing = (row.getAttribute('data-billing') || '').toLowerCase();
          const shipping = (row.getAttribute('data-shipping') || '').toLowerCase();
          const isArchived = row.getAttribute('data-archived') === 'true';
          const isDeleted = row.getAttribute('data-deleted') === 'true';

          let matchesSubTab = false;
          if (customerSubTab === 'active') {
            matchesSubTab = !isArchived && !isDeleted;
          } else if (customerSubTab === 'archived') {
            matchesSubTab = isArchived && !isDeleted;
          } else if (customerSubTab === 'bin') {
            matchesSubTab = isDeleted;
          }

          const matchesQuery = !query || name.includes(query) || vat.includes(query) || billing.includes(query) || shipping.includes(query);

          if (matchesSubTab && matchesQuery) {
            (row as HTMLElement).classList.remove('hidden');
          } else {
            (row as HTMLElement).classList.add('hidden');
          }
        });
      } else {
        customerRows.forEach(row => {
          const name = (row.getAttribute('data-name') || '').toLowerCase();
          const email = (row.getAttribute('data-email') || '').toLowerCase();
          const company = (row.getAttribute('data-company') || '').toLowerCase();
          const vat = (row.getAttribute('data-vat') || '').toLowerCase();
          
          const isArchived = row.getAttribute('data-archived') === 'true';
          const isDeleted = row.getAttribute('data-deleted') === 'true';

          let matchesSubTab = false;
          if (customerSubTab === 'active') {
            matchesSubTab = !isArchived && !isDeleted;
          } else if (customerSubTab === 'archived') {
            matchesSubTab = isArchived && !isDeleted;
          } else if (customerSubTab === 'bin') {
            matchesSubTab = isDeleted;
          }

          const matchesQuery = !query || name.includes(query) || email.includes(query) || company.includes(query) || vat.includes(query);

          if (matchesSubTab && matchesQuery) {
            (row as HTMLElement).classList.remove('hidden');
          } else {
            (row as HTMLElement).classList.add('hidden');
          }
        });
      }
    };

    const sortCustomers = () => {
      const sortBy = (document.getElementById('customer-sort-select') as HTMLSelectElement)?.value || 'recent';
      const tbody = document.getElementById('admin-customers-table');
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll('.admin-customer-row'));
      
      rows.sort((a, b) => {
        if (sortBy === 'name') {
          const nameA = (a.getAttribute('data-name') || '').toLowerCase();
          const nameB = (b.getAttribute('data-name') || '').toLowerCase();
          return nameA.localeCompare(nameB);
        } else if (sortBy === 'company') {
          const compA = (a.getAttribute('data-company') || '').toLowerCase() || 'zzzzzz';
          const compB = (b.getAttribute('data-company') || '').toLowerCase() || 'zzzzzz';
          return compA.localeCompare(compB);
        } else {
          const indexA = parseInt(a.getAttribute('data-index') || '0');
          const indexB = parseInt(b.getAttribute('data-index') || '0');
          return indexA - indexB;
        }
      });

      rows.forEach(row => tbody.appendChild(row));
    };

    document.getElementById('customer-sort-select')?.addEventListener('change', sortCustomers);

    const switchTab = (tab: 'users' | 'customers' | 'companies') => {
      activeTab = tab;
      const filterGrp = document.getElementById('customer-filter-group');
      const sortSelect = document.getElementById('customer-sort-select');
      
      const url = new URL(window.location.href);
      url.searchParams.set('tab', tab);
      window.history.replaceState({}, '', url.toString());

      const tabs = [btnTabUsers, btnTabCustomers, btnTabCompanies];
      tabs.forEach(btn => {
        btn?.classList.remove('bg-white', 'text-cyan-700', 'shadow-xs');
        btn?.classList.add('text-slate-600');
      });

      if (tab === 'users') {
        btnTabUsers?.classList.add('bg-white', 'text-cyan-700', 'shadow-xs');
        btnTabUsers?.classList.remove('text-slate-600');

        usersContainer?.classList.remove('hidden');
        customersContainer?.classList.add('hidden');
        companiesContainer?.classList.add('hidden');
        if (filterGrp) filterGrp.style.display = 'none';
        if (sortSelect) sortSelect.style.display = 'none';
        if (btnCreateCompany) btnCreateCompany.style.display = 'none';
        if (btnCreateCustomer) btnCreateCustomer.style.display = 'none';
      } else if (tab === 'companies') {
        btnTabCompanies?.classList.add('bg-white', 'text-cyan-700', 'shadow-xs');
        btnTabCompanies?.classList.remove('text-slate-600');

        companiesContainer?.classList.remove('hidden');
        customersContainer?.classList.add('hidden');
        usersContainer?.classList.add('hidden');
        if (filterGrp) filterGrp.style.display = 'flex';
        if (sortSelect) sortSelect.style.display = 'none';
        if (btnCreateCompany) btnCreateCompany.style.display = 'inline-flex';
        if (btnCreateCustomer) btnCreateCustomer.style.display = 'none';
      } else {
        btnTabCustomers?.classList.add('bg-white', 'text-cyan-700', 'shadow-xs');
        btnTabCustomers?.classList.remove('text-slate-600');

        customersContainer?.classList.remove('hidden');
        usersContainer?.classList.add('hidden');
        companiesContainer?.classList.add('hidden');
        if (filterGrp) filterGrp.style.display = 'flex';
        if (sortSelect) sortSelect.style.display = 'inline-block';
        if (btnCreateCompany) btnCreateCompany.style.display = 'none';
        if (btnCreateCustomer) btnCreateCustomer.style.display = 'inline-flex';
      }
      filterList();
    };

    const switchCustomerSubTab = (subTab: 'active' | 'archived' | 'bin') => {
      customerSubTab = subTab;
      
      const url = new URL(window.location.href);
      url.searchParams.set('subtab', subTab);
      window.history.replaceState({}, '', url.toString());

      const buttons = [btnCustActive, btnCustArchived, btnCustBin];
      buttons.forEach(btn => {
        btn?.classList.remove('bg-white', 'text-cyan-700', 'shadow-xs');
        btn?.classList.add('text-slate-600');
      });

      if (subTab === 'active') {
        btnCustActive?.classList.add('bg-white', 'text-cyan-700', 'shadow-xs');
        btnCustActive?.classList.remove('text-slate-600');
      } else if (subTab === 'archived') {
        btnCustArchived?.classList.add('bg-white', 'text-cyan-700', 'shadow-xs');
        btnCustArchived?.classList.remove('text-slate-600');
      } else if (subTab === 'bin') {
        btnCustBin?.classList.add('bg-white', 'text-cyan-700', 'shadow-xs');
        btnCustBin?.classList.remove('text-slate-600');
      }

      filterList();
    };

    btnTabUsers?.addEventListener('click', () => switchTab('users'));
    btnTabCustomers?.addEventListener('click', () => switchTab('customers'));
    btnTabCompanies?.addEventListener('click', () => switchTab('companies'));

    btnCustActive?.addEventListener('click', () => switchCustomerSubTab('active'));
    btnCustArchived?.addEventListener('click', () => switchCustomerSubTab('archived'));
    btnCustBin?.addEventListener('click', () => switchCustomerSubTab('bin'));

    // Initialize layout to show customers first, or from URL param
    const urlParams = new URLSearchParams(window.location.search);
    const initTab = (urlParams.get('tab') as 'users' | 'customers' | 'companies') || 'customers';
    const initSubTab = (urlParams.get('subtab') as 'active' | 'archived' | 'bin') || 'active';
    switchTab(initTab);
    switchCustomerSubTab(initSubTab);

    searchInput?.addEventListener('input', filterList);

    // Customer edit modal logic
    const editModal = document.getElementById('edit-customer-modal-backdrop');
    const closeBtn = document.getElementById('close-customer-modal');
    const cancelBtn = document.getElementById('btn-cancel-customer');
    const customerForm = document.getElementById('edit-customer-form') as HTMLFormElement;
    const modalTitleText = document.getElementById('customer-modal-title-text');
    const createBtn = document.getElementById('btn-create-customer');

    const openCreateModal = () => {
      if (modalTitleText) modalTitleText.textContent = 'Create New Customer';
      
      const elId = document.getElementById('edit-customer-id') as HTMLInputElement | null;
      const elName = document.getElementById('edit-customer-name') as HTMLInputElement | null;
      const elEmail = document.getElementById('edit-customer-email') as HTMLInputElement | null;
      const elPhone = document.getElementById('edit-customer-phone') as HTMLInputElement | null;
      const elCompany = document.getElementById('edit-customer-company') as HTMLInputElement | null;
      const elVat = document.getElementById('edit-customer-vat') as HTMLInputElement | null;
      const elBilling = document.getElementById('edit-customer-billing') as HTMLTextAreaElement | null;
      const elShipping = document.getElementById('edit-customer-shipping') as HTMLTextAreaElement | null;
      const elCode = document.getElementById('edit-customer-code') as HTMLInputElement | null;

      if (elId) elId.value = '';
      if (elName) elName.value = '';
      if (elEmail) elEmail.value = '';
      if (elPhone) elPhone.value = '';
      if (elCompany) elCompany.value = '';
      if (elVat) elVat.value = '';
      if (elBilling) elBilling.value = '';
      if (elShipping) elShipping.value = '';
      if (elCode) elCode.value = '';

      const elCompanySelect = document.getElementById('edit-customer-company-select') as HTMLSelectElement | null;
      const elCompanyCustom = document.getElementById('edit-customer-company-custom') as HTMLInputElement | null;
      if (elCompanySelect) elCompanySelect.value = '';
      if (elCompanyCustom) {
        elCompanyCustom.value = '';
        elCompanyCustom.classList.add('hidden');
      }

      // Hide actions for new record
      document.getElementById('btn-modal-archive-customer')?.classList.add('hidden');
      document.getElementById('btn-modal-delete-customer')?.classList.add('hidden');
      document.getElementById('btn-modal-merge-customer')?.classList.add('hidden');

      editModal?.classList.remove('hidden');
      editModal?.classList.add('flex');
    };

    const openEditModal = (row: HTMLElement) => {
      if (modalTitleText) modalTitleText.textContent = 'Edit Customer Details';

      const id = row.getAttribute('data-id') || '';
      const name = row.getAttribute('data-name') || '';
      const email = row.getAttribute('data-email') || '';
      const phone = row.getAttribute('data-phone') || '';
      const company = row.getAttribute('data-company') || '';
      const vat = row.getAttribute('data-vat') || '';
      const billing = row.getAttribute('data-billing') || '';
      const shipping = row.getAttribute('data-shipping') || '';
      
      const isArchived = row.getAttribute('data-archived') === 'true';
      const isDeleted = row.getAttribute('data-deleted') === 'true';
      const hasOrders = row.getAttribute('data-has-orders') === 'true';

      const elId = document.getElementById('edit-customer-id') as HTMLInputElement | null;
      const elName = document.getElementById('edit-customer-name') as HTMLInputElement | null;
      const elEmail = document.getElementById('edit-customer-email') as HTMLInputElement | null;
      const elPhone = document.getElementById('edit-customer-phone') as HTMLInputElement | null;
      const elCompany = document.getElementById('edit-customer-company') as HTMLInputElement | null;
      const elVat = document.getElementById('edit-customer-vat') as HTMLInputElement | null;
      const elBilling = document.getElementById('edit-customer-billing') as HTMLTextAreaElement | null;
      const elShipping = document.getElementById('edit-customer-shipping') as HTMLTextAreaElement | null;
      const elCode = document.getElementById('edit-customer-code') as HTMLInputElement | null;

      if (elId) elId.value = id;
      if (elName) elName.value = name;
      if (elEmail) elEmail.value = email;
      if (elPhone) elPhone.value = phone;
      if (elCompany) elCompany.value = company;
      if (elVat) elVat.value = vat;
      if (elBilling) elBilling.value = billing;
      if (elShipping) elShipping.value = shipping;
      if (elCode) elCode.value = row.getAttribute('data-code') || '';

      const elCompanySelect = document.getElementById('edit-customer-company-select') as HTMLSelectElement | null;
      const elCompanyCustom = document.getElementById('edit-customer-company-custom') as HTMLInputElement | null;
      
      if (elCompanySelect && company) {
        // Try to select existing option
        const options = Array.from(elCompanySelect.options);
        const matches = options.some(opt => opt.value === company);
        if (matches) {
          elCompanySelect.value = company;
          if (elCompanyCustom) elCompanyCustom.classList.add('hidden');
        } else {
          // Company doesn't exist in options, it's a custom one
          elCompanySelect.value = '_CREATE_NEW_';
          if (elCompanyCustom) {
            elCompanyCustom.value = company;
            elCompanyCustom.classList.remove('hidden');
          }
        }
      } else if (elCompanySelect) {
        elCompanySelect.value = '';
        if (elCompanyCustom) elCompanyCustom.classList.add('hidden');
      }

      // Show actions for existing record
      const archiveBtn = document.getElementById('btn-modal-archive-customer') as HTMLButtonElement | null;
      const archiveText = document.getElementById('btn-modal-archive-text');
      const deleteBtn = document.getElementById('btn-modal-delete-customer') as HTMLButtonElement | null;

      if (archiveBtn && archiveText && deleteBtn) {
        archiveBtn.setAttribute('data-id', id);
        archiveBtn.setAttribute('data-has-orders', hasOrders.toString());
        
        deleteBtn.setAttribute('data-id', id);
        deleteBtn.setAttribute('data-has-orders', hasOrders.toString());
 
        const mergeBtn = document.getElementById('btn-modal-merge-customer') as HTMLButtonElement | null;
        if (mergeBtn) {
           mergeBtn.setAttribute('data-id', id);
           mergeBtn.classList.remove('hidden');
        }

        if (isDeleted) {
          // In Bin: Show Restore & Delete Permanently
          archiveBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/50 transition-colors';
          archiveBtn.setAttribute('data-action', 'restore');
          archiveText.textContent = 'Restore';
          archiveBtn.classList.remove('hidden');

          deleteBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/50 transition-colors';
          deleteBtn.setAttribute('data-action', 'permanent_delete');
          deleteBtn.textContent = 'Delete Permanently';
          deleteBtn.classList.remove('hidden');
        } else {
          // Not in Bin: Show Archive/Unarchive & Delete
          archiveBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/50 transition-colors';
          archiveBtn.setAttribute('data-action', isArchived ? 'unarchive' : 'archive');
          archiveBtn.setAttribute('data-archived', isArchived.toString());
          archiveText.textContent = isArchived ? 'Unarchive' : 'Archive';
          archiveBtn.classList.remove('hidden');

          deleteBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/50 transition-colors';
          deleteBtn.setAttribute('data-action', 'soft_delete');
          deleteBtn.textContent = 'Delete';
          deleteBtn.classList.remove('hidden');
        }
      }

      editModal?.classList.remove('hidden');
      editModal?.classList.add('flex');
    };

    const closeEditModal = () => {
      editModal?.classList.add('hidden');
      editModal?.classList.remove('flex');
      customerForm?.reset();
      const elCompanyCustom = document.getElementById('edit-customer-company-custom');
      if (elCompanyCustom) elCompanyCustom.classList.add('hidden');
    };

    // Handle company select change
    document.getElementById('edit-customer-company-select')?.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      const customInput = document.getElementById('edit-customer-company-custom') as HTMLInputElement;
      const hiddenInput = document.getElementById('edit-customer-company') as HTMLInputElement;
      const vatInput = document.getElementById('edit-customer-vat') as HTMLInputElement;

      if (select.value === '_CREATE_NEW_') {
        customInput.classList.remove('hidden');
        hiddenInput.value = customInput.value;
        if (vatInput) vatInput.value = ''; // Clear VAT for new company
      } else {
        customInput.classList.add('hidden');
        hiddenInput.value = select.value;
        if (vatInput && select.value) {
          const selectedOption = select.options[select.selectedIndex];
          vatInput.value = selectedOption.getAttribute('data-vat') || '';
        } else if (vatInput) {
          vatInput.value = '';
        }
      }
    });

    // Update hidden input when custom input changes
    document.getElementById('edit-customer-company-custom')?.addEventListener('input', (e) => {
      const hiddenInput = document.getElementById('edit-customer-company') as HTMLInputElement;
      if (hiddenInput) {
        hiddenInput.value = (e.target as HTMLInputElement).value;
      }
    });

    createBtn?.addEventListener('click', openCreateModal);
    closeBtn?.addEventListener('click', closeEditModal);
    cancelBtn?.addEventListener('click', closeEditModal);
    editModal?.addEventListener('click', (e) => { if (e.target === editModal) closeEditModal(); });

    document.querySelectorAll('.edit-customer-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = (e.currentTarget as HTMLButtonElement).closest('.admin-customer-row') as HTMLElement;
        if (row) openEditModal(row);
      });
    });

    // Company edit modal logic
    const companyEditModal = document.getElementById('edit-company-modal-backdrop');
    const companyCloseBtn = document.getElementById('close-company-modal');
    const companyCancelBtn = document.getElementById('btn-cancel-company');
    const companyForm = document.getElementById('edit-company-form') as HTMLFormElement;
    const companyModalTitleText = document.getElementById('company-modal-title-text');
    const companyCreateBtn = document.getElementById('btn-create-company');

    const customersListContainer = document.getElementById('company-inline-customers-list');

    const createCustomerEntryElement = (name = '', email = '', phone = '', code = '', billing = '', shipping = '', isDefault = false) => {
      const container = document.createElement('div');
      container.className = 'relative bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3';
      container.innerHTML = `
        <button type="button" class="remove-cust-btn absolute top-3 right-3 text-slate-400 hover:text-rose-500 font-bold text-lg border-0 bg-transparent cursor-pointer">×</button>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Customer Code</label>
            <input type="text" placeholder="e.g. CUS-1001" class="cust-code-input w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:border-cyan-500" value="${code}" />
          </div>
          <div class="space-y-1">
            <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Customer Name *</label>
            <input type="text" placeholder="Full Name" required class="cust-name-input w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:border-cyan-500" value="${name}" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Email Address</label>
            <input type="email" placeholder="email@address.com" class="cust-email-input w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:border-cyan-500" value="${email}" />
          </div>
          <div class="space-y-1">
            <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Phone Number</label>
            <input type="text" placeholder="Phone" class="cust-phone-input w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:border-cyan-500" value="${phone}" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Billing Address</label>
            <textarea placeholder="Billing address" rows="2" class="cust-billing-input w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:border-cyan-500 resize-none">${billing}</textarea>
          </div>
          <div class="space-y-1">
            <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Shipping Address</label>
            <textarea placeholder="Shipping address" rows="2" class="cust-shipping-input w-full rounded-md border border-slate-250 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:border-cyan-500 resize-none">${shipping}</textarea>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-100">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="company_default_customer" class="cust-default-radio rounded text-cyan-600 focus:ring-0" ${isDefault ? 'checked' : ''} />
            <span class="text-[9px] font-bold text-slate-600 uppercase tracking-wider">Default / Autofill Customer for this Company</span>
          </label>
        </div>
      `;
      container.querySelector('.remove-cust-btn')?.addEventListener('click', () => container.remove());
      return container;
    };


    document.getElementById('btn-add-company-customer')?.addEventListener('click', () => {
      customersListContainer?.appendChild(createCustomerEntryElement('', '', '', '', '', '', customersListContainer.children.length === 0));
    });

    const openCompanyCreateModal = () => {
      if (companyModalTitleText) companyModalTitleText.textContent = 'Create New Company';
      
      const elId = document.getElementById('edit-company-id') as HTMLInputElement | null;
      const elName = document.getElementById('edit-company-name') as HTMLInputElement | null;
      const elVat = document.getElementById('edit-company-vat') as HTMLInputElement | null;
      const elCode = document.getElementById('edit-company-code') as HTMLInputElement | null;

      if (elId) elId.value = '';
      if (elName) elName.value = '';
      if (elVat) elVat.value = '';
      if (elCode) elCode.value = '';

      const elBilling = document.getElementById('edit-company-billing') as HTMLTextAreaElement | null;
      const elShipping = document.getElementById('edit-company-shipping') as HTMLTextAreaElement | null;

      if (elBilling) elBilling.value = '';
      if (elShipping) elShipping.value = '';
      if (customersListContainer) {
        customersListContainer.innerHTML = '';
        customersListContainer.appendChild(createCustomerEntryElement('', '', '', '', '', '', true));
      }

      document.getElementById('btn-modal-archive-company')?.classList.add('hidden');
      document.getElementById('btn-modal-delete-company')?.classList.add('hidden');
      document.getElementById('btn-modal-merge-company')?.classList.add('hidden');

      companyEditModal?.classList.remove('hidden');
      companyEditModal?.classList.add('flex');
    };

    const openCompanyEditModal = (row: HTMLElement) => {
      if (companyModalTitleText) companyModalTitleText.textContent = 'Edit Company Details';

      const id = row.getAttribute('data-id') || '';
      const name = row.getAttribute('data-name') || '';
      const vat = row.getAttribute('data-vat') || '';
      const billing = row.getAttribute('data-billing') || '';
      const shipping = row.getAttribute('data-shipping') || '';
      const code = row.getAttribute('data-code') || '';

      const elId = document.getElementById('edit-company-id') as HTMLInputElement | null;
      const elName = document.getElementById('edit-company-name') as HTMLInputElement | null;
      const elVat = document.getElementById('edit-company-vat') as HTMLInputElement | null;
      const elCode = document.getElementById('edit-company-code') as HTMLInputElement | null;
      const elBilling = document.getElementById('edit-company-billing') as HTMLTextAreaElement | null;
      const elShipping = document.getElementById('edit-company-shipping') as HTMLTextAreaElement | null;

      if (elId) elId.value = id;
      if (elName) elName.value = name;
      if (elVat) elVat.value = vat;
      if (elCode) elCode.value = code;
      if (elBilling) elBilling.value = billing;
      if (elShipping) elShipping.value = shipping;

      const defaultCustomerId = row.getAttribute('data-default-customer-id') || '';
      let customersArr = [];
      try {
        customersArr = JSON.parse(row.getAttribute('data-customers') || '[]');
      } catch (e) {}

      if (customersListContainer) {
        customersListContainer.innerHTML = '';
        if (customersArr.length === 0) {
          customersListContainer.appendChild(createCustomerEntryElement('', '', '', '', '', '', true));
        } else {
          customersArr.forEach((c: any) => {
            const isDefault = c.id === defaultCustomerId;
            customersListContainer.appendChild(createCustomerEntryElement(c.name, c.email, c.phone, c.code || '', c.billing_address || '', c.shipping_address || '', isDefault));
          });
        }
      }

      const isArchived = row.getAttribute('data-archived') === 'true';
      const isDeleted = row.getAttribute('data-deleted') === 'true';

      const archiveBtn = document.getElementById('btn-modal-archive-company') as HTMLButtonElement | null;
      const archiveText = document.getElementById('btn-modal-archive-company-text');
      const deleteBtn = document.getElementById('btn-modal-delete-company') as HTMLButtonElement | null;

      if (archiveBtn && archiveText && deleteBtn) {
        archiveBtn.setAttribute('data-id', id);
        deleteBtn.setAttribute('data-id', id);

        const mergeBtn = document.getElementById('btn-modal-merge-company') as HTMLButtonElement | null;
        if (mergeBtn) {
           mergeBtn.setAttribute('data-id', id);
           mergeBtn.classList.remove('hidden');
        }

        if (isDeleted) {
          // In Bin: Show Restore & Delete Permanently
          archiveBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/50 transition-colors';
          archiveBtn.setAttribute('data-action', 'restore');
          archiveText.textContent = 'Restore';
          archiveBtn.classList.remove('hidden');

          deleteBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/50 transition-colors';
          deleteBtn.setAttribute('data-action', 'permanent_delete');
          deleteBtn.textContent = 'Delete Permanently';
          deleteBtn.classList.remove('hidden');
        } else {
          // Not in Bin: Show Archive/Unarchive & Delete
          archiveBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/50 transition-colors';
          archiveBtn.setAttribute('data-action', isArchived ? 'unarchive' : 'archive');
          archiveBtn.setAttribute('data-archived', isArchived.toString());
          archiveText.textContent = isArchived ? 'Unarchive' : 'Archive';
          archiveBtn.classList.remove('hidden');

          deleteBtn.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/50 transition-colors';
          deleteBtn.setAttribute('data-action', 'soft_delete');
          deleteBtn.textContent = 'Delete';
          deleteBtn.classList.remove('hidden');
        }
      }

      companyEditModal?.classList.remove('hidden');
      companyEditModal?.classList.add('flex');
    };

    const closeCompanyEditModal = () => {
      companyEditModal?.classList.add('hidden');
      companyEditModal?.classList.remove('flex');
      companyForm?.reset();
    };

    companyCreateBtn?.addEventListener('click', openCompanyCreateModal);
    companyCloseBtn?.addEventListener('click', closeCompanyEditModal);
    companyCancelBtn?.addEventListener('click', closeCompanyEditModal);
    companyEditModal?.addEventListener('click', (e) => { if (e.target === companyEditModal) closeCompanyEditModal(); });

    document.querySelectorAll('.edit-company-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = (e.currentTarget as HTMLButtonElement).closest('.admin-company-row') as HTMLElement;
        if (row) openCompanyEditModal(row);
      });
    });

    companyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('btn-save-company') as HTMLButtonElement | null;
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
      }

      const elId = document.getElementById('edit-company-id') as HTMLInputElement | null;
      const elName = document.getElementById('edit-company-name') as HTMLInputElement | null;
      const elVat = document.getElementById('edit-company-vat') as HTMLInputElement | null;
      const elCode = document.getElementById('edit-company-code') as HTMLInputElement | null;

      const id = elId?.value || '';
      const elBilling = document.getElementById('edit-company-billing') as HTMLTextAreaElement | null;
      const elShipping = document.getElementById('edit-company-shipping') as HTMLTextAreaElement | null;
      const customerRows = customersListContainer 
        ? Array.from(customersListContainer.children) 
        : [];
      
      const customersPayload = [];
      let validationFailed = false;

      for (const r of customerRows) {
        const nameVal = (r.querySelector('.cust-name-input') as HTMLInputElement).value.trim();
        if (!nameVal) continue; // Skip empty rows
        
        const codeVal = (r.querySelector('.cust-code-input') as HTMLInputElement).value.trim();
        const emailVal = (r.querySelector('.cust-email-input') as HTMLInputElement).value.trim();
        const phoneVal = (r.querySelector('.cust-phone-input') as HTMLInputElement).value.trim();
        const billingVal = (r.querySelector('.cust-billing-input') as HTMLTextAreaElement).value.trim();
        const shippingVal = (r.querySelector('.cust-shipping-input') as HTMLTextAreaElement).value.trim();
        const isDefault = (r.querySelector('.cust-default-radio') as HTMLInputElement).checked;
        
        if (emailVal) {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(emailVal)) {
            alert(`Invalid email format for customer: ${nameVal}`);
            validationFailed = true;
            break;
          }
        }
        
        if (phoneVal) {
          const phoneRegex = /^\+?[\d\s\-()]{7,25}$/;
          if (!phoneRegex.test(phoneVal)) {
            alert(`Invalid phone number format for customer: ${nameVal}. Allowed: 7-25 characters comprising digits, spaces, hyphens, parentheses, or +`);
            validationFailed = true;
            break;
          }
        }

        customersPayload.push({ 
          code: codeVal || null,
          name: nameVal, 
          email: emailVal || null, 
          phone: phoneVal || null, 
          billing_address: billingVal || null,
          shipping_address: shippingVal || null,
          is_default: isDefault 
        });
      }

      if (validationFailed) {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Details';
        }
        return;
      }

      const payload = {
        name: elName?.value.trim() || '',
        vat_number: elVat?.value.trim() || null,
        billing_address: elBilling?.value.trim() || null,
        shipping_address: elShipping?.value.trim() || null,
        code: elCode?.value.trim() || null,
        customers: customersPayload
      };

      if (!payload.name) {
        alert('Company Name is required');
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Details';
        }
        return;
      }

      try {
        const url = id ? '/api/companies/' + id : '/api/companies';
        const method = id ? 'PUT' : 'POST';
        let res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.status === 409) {
          const err = await res.json();
          const proceed = await showConfirmDialog(
            'Duplicate Warning',
            (err.error || 'A similar company already exists.') + '\n\nDo you want to proceed and save anyway?',
            'Save Anyway',
            false
          );
          if (proceed) {
            payload.bypassDuplicateCheck = true;
            res = await fetch(url, {
              method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
          }
        }

        if (res.ok) {
          window.location.href = window.location.pathname + '?tab=companies';
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'Failed to save company details'));
        }
      } catch (err: any) {
        alert('Error: ' + err.message);
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Details';
        }
      }
    });

    // Archive/Unarchive/Restore Company Trigger
    document.getElementById('btn-modal-archive-company')?.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const companyId = target.getAttribute('data-id') || '';
      const action = target.getAttribute('data-action') || 'archive';
      const isCurrentlyArchived = target.getAttribute('data-archived') === 'true';

      target.disabled = true;
      const textSpan = document.getElementById('btn-modal-archive-company-text');
      const originalText = textSpan ? textSpan.textContent : '';
      if (textSpan) textSpan.textContent = '...';

      try {
        const payloadAction = action === 'restore' ? 'restore' : (isCurrentlyArchived ? 'unarchive' : 'archive');
        const res = await fetch('/api/companies/' + companyId, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: payloadAction })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'Failed to update company status'));
          if (textSpan) textSpan.textContent = originalText;
        }
      } catch (err) {
        alert('Network error while updating company status.');
        if (textSpan) textSpan.textContent = originalText;
      } finally {
        target.disabled = false;
      }
    });

    // Delete / Permanent Delete Company Trigger
    document.getElementById('btn-modal-delete-company')?.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const companyId = target.getAttribute('data-id') || '';
      const action = target.getAttribute('data-action') || 'soft_delete';

      let proceed = false;
      if (action === 'permanent_delete') {
        proceed = await showConfirmDialog(
          'Delete Company Permanently',
          'Are you sure you want to permanently delete this company? This action cannot be undone and will unlink all associated customers.',
          'Delete Permanently',
          true
        );
      } else {
        // Soft delete (move to bin)
        proceed = await showConfirmDialog(
          'Move Company to Bin',
          'Are you sure you want to move this company to the recycle bin?',
          'Move to Bin',
          true
        );
      }
      if (!proceed) return;

      target.disabled = true;

      try {
        if (action === 'permanent_delete') {
          const res = await fetch('/api/companies/' + companyId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'permanent_remove' })
          });

          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json();
            alert('Error: ' + (err.error || 'Failed to delete company'));
          }
        } else {
          // Soft delete
          const res = await fetch('/api/companies/' + companyId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'trash' })
          });

          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json();
            alert('Error: ' + (err.error || 'Failed to move company to bin'));
          }
        }
      } catch (err) {
        alert('Network error while processing deletion.');
      } finally {
        target.disabled = false;
      }
    });

    // Merge Company Trigger
    document.getElementById('btn-modal-merge-company')?.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const companyId = target.getAttribute('data-id') || '';
      if (!companyId) return;

      const targetCode = await showMergeDialog(
        'Merge Companies',
        'Merge this duplicate company into a primary company. All linked customers and invoices will be reassigned to the primary company, and the current duplicate company will be deleted.',
        'Primary Company Code *',
        'e.g. COM-1398',
        'COM-'
      );
      if (!targetCode) return;

      const proceed = await showConfirmDialog(
        'Confirm Company Merge',
        `Are you sure you want to merge this company into ${targetCode}? This will link all customers and invoices to ${targetCode} and delete the current company. This cannot be undone.`,
        'Merge Company',
        false
      );
      if (!proceed) {
        return;
      }

      target.disabled = true;
      try {
        const res = await fetch('/api/merge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            entityType: 'company',
            primaryCode: targetCode,
            duplicateId: companyId
          })
        });

        const result = await res.json();
        if (res.ok) {
          alert(result.message || 'Companies merged successfully!');
          window.location.reload();
        } else {
          alert('Error: ' + (result.error || 'Failed to merge companies'));
        }
      } catch (err: any) {
        alert('Error: ' + err.message);
      } finally {
        target.disabled = false;
      }
    });

    customerForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('btn-save-customer') as HTMLButtonElement | null;
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
      }

      const elId = document.getElementById('edit-customer-id') as HTMLInputElement | null;
      const elCode = document.getElementById('edit-customer-code') as HTMLInputElement | null;
      const elName = document.getElementById('edit-customer-name') as HTMLInputElement | null;
      const elEmail = document.getElementById('edit-customer-email') as HTMLInputElement | null;
      const elPhone = document.getElementById('edit-customer-phone') as HTMLInputElement | null;
      const elCompany = document.getElementById('edit-customer-company') as HTMLInputElement | null;
      const elVat = document.getElementById('edit-customer-vat') as HTMLInputElement | null;
      const elBilling = document.getElementById('edit-customer-billing') as HTMLTextAreaElement | null;
      const elShipping = document.getElementById('edit-customer-shipping') as HTMLTextAreaElement | null;

      const id = elId?.value || '';
      const payload = {
        code: elCode?.value.trim() || null,
        name: elName?.value.trim() || '',
        email: elEmail?.value.trim() || null,
        phone: elPhone?.value.trim() || null,
        company_name: elCompany?.value.trim() || null,
        company_vat: elVat?.value.trim() || null,
        billing_address: elBilling?.value.trim() || null,
        shipping_address: elShipping?.value.trim() || null,
      };

      if (!payload.name) {
        alert('Customer Name is required');
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Details';
        }
        return;
      }

      // Client-side validation
      if (payload.email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(payload.email)) {
          alert('Invalid email format');
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Details';
          }
          return;
        }
      }

      if (payload.phone) {
        const phoneRegex = /^\+?[\d\s\-()]{7,25}$/;
        if (!phoneRegex.test(payload.phone)) {
          alert('Invalid phone number format. Allowed: 7-25 characters comprising digits, spaces, hyphens, parentheses, or +');
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Details';
          }
          return;
        }
      }

      try {
        const url = id ? '/api/customers/' + id : '/api/customers';
        const method = id ? 'PUT' : 'POST';
        let res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.status === 409) {
          const err = await res.json();
          const proceed = await showConfirmDialog(
            'Duplicate Warning',
            (err.error || 'A similar customer already exists.') + '\n\nDo you want to proceed and save anyway?',
            'Save Anyway',
            false
          );
          if (proceed) {
            payload.bypassDuplicateCheck = true;
            res = await fetch(url, {
              method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
          }
        }

        if (res.ok) {
          window.location.href = window.location.pathname + '?tab=customers';
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'Failed to save customer details'));
        }
      } catch (err: any) {
        alert('Error: ' + err.message);
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Details';
        }
      }
    });

    // Archive/Unarchive/Restore Trigger
    document.getElementById('btn-modal-archive-customer')?.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const customerId = target.getAttribute('data-id') || '';
      const action = target.getAttribute('data-action') || 'archive';
      const hasOrders = target.getAttribute('data-has-orders') === 'true';
      const isCurrentlyArchived = target.getAttribute('data-archived') === 'true';

      if (hasOrders) {
        const warnMsg = action === 'restore' 
          ? 'Warning: This customer has orders linked to them. Do you still want to restore them?'
          : 'Warning: This customer has orders linked to them. Modifying their status could affect historical billing. Do you still want to proceed?';
        const proceed = await showConfirmDialog(
          action === 'restore' ? 'Restore Customer' : 'Archive Customer',
          warnMsg,
          action === 'restore' ? 'Restore' : 'Archive',
          false
        );
        if (!proceed) return;
      }

      target.disabled = true;
      const textSpan = document.getElementById('btn-modal-archive-text');
      const originalText = textSpan ? textSpan.textContent : '';
      if (textSpan) textSpan.textContent = '...';

      try {
        const payloadAction = action === 'restore' ? 'restore' : (isCurrentlyArchived ? 'unarchive' : 'archive');
        const res = await fetch('/api/customers/' + customerId, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: payloadAction })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'Failed to update customer status'));
          if (textSpan) textSpan.textContent = originalText;
        }
      } catch (err) {
        alert('Network error while updating customer status.');
        if (textSpan) textSpan.textContent = originalText;
      } finally {
        target.disabled = false;
      }
    });

    // Delete / Permanent Delete Trigger
    document.getElementById('btn-modal-delete-customer')?.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const customerId = target.getAttribute('data-id') || '';
      const action = target.getAttribute('data-action') || 'soft_delete';
      const hasOrders = target.getAttribute('data-has-orders') === 'true';

      let proceed = false;
      if (action === 'permanent_delete') {
        if (hasOrders) {
          proceed = await showConfirmDialog(
            'Delete Customer Permanently',
            'Warning: This customer has orders linked to them. Permanently deleting this customer cannot be undone and will impact billing history. Do you still want to proceed?',
            'Delete Permanently',
            true
          );
        } else {
          proceed = await showConfirmDialog(
            'Delete Customer Permanently',
            'Are you sure you want to permanently delete this customer? This action cannot be undone.',
            'Delete Permanently',
            true
          );
        }
      } else {
        // Soft delete (move to bin)
        if (hasOrders) {
          proceed = await showConfirmDialog(
            'Move Customer to Bin',
            'Warning: This customer has orders linked to them. Deleting them could affect historical billing. Do you still want to proceed?',
            'Move to Bin',
            true
          );
        } else {
          proceed = await showConfirmDialog(
            'Move Customer to Bin',
            'Are you sure you want to move this customer to the recycle bin?',
            'Move to Bin',
            true
          );
        }
      }
      if (!proceed) return;

      target.disabled = true;

      try {
        if (action === 'permanent_delete') {
          const res = await fetch('/api/customers/' + customerId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'permanent_remove' })
          });

          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json();
            alert('Error: ' + (err.error || 'Failed to delete customer'));
          }
        } else {
          // Soft delete (setting is_deleted = true via PUT action)
          const res = await fetch('/api/customers/' + customerId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'trash' })
          });

          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json();
            alert('Error: ' + (err.error || 'Failed to move customer to bin'));
          }
        }
      } catch (err) {
        alert('Network error while processing deletion.');
      } finally {
        target.disabled = false;
      }
    });

    // Merge Customer Trigger
    document.getElementById('btn-modal-merge-customer')?.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const customerId = target.getAttribute('data-id') || '';
      if (!customerId) return;

      const targetCode = await showMergeDialog(
        'Merge Customers',
        'Merge this duplicate customer into a primary customer. All linked invoices will be reassigned to the primary customer, and the current duplicate customer will be deleted.',
        'Primary Customer Code *',
        'e.g. CUS-1011',
        'CUS-'
      );
      if (!targetCode) return;

      const proceed = await showConfirmDialog(
        'Confirm Customer Merge',
        `Are you sure you want to merge this customer into ${targetCode}? This will re-link all invoices to ${targetCode} and delete the current customer. This cannot be undone.`,
        'Merge Customer',
        false
      );
      if (!proceed) {
        return;
      }

      target.disabled = true;
      try {
        const res = await fetch('/api/merge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            entityType: 'customer',
            primaryCode: targetCode,
            duplicateId: customerId
          })
        });

        const result = await res.json();
        if (res.ok) {
          alert(result.message || 'Customers merged successfully!');
          window.location.reload();
        } else {
          alert('Error: ' + (result.error || 'Failed to merge customers'));
        }
      } catch (err: any) {
        alert('Error: ' + err.message);
      } finally {
        target.disabled = false;
      }
    });

    document.querySelectorAll('.toggle-suspend-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const userId = target.getAttribute('data-user-id');
        const textSpan = target.querySelector('.btn-text');
        if (!userId || !textSpan) return;

        target.disabled = true;
        const originalText = textSpan.textContent;
        textSpan.textContent = '...';

        try {
          const res = await fetch('/api/users/' + userId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'suspend' })
          });

          if (res.ok) {
            const data = await res.json();
            const isSuspended = data.is_suspended;
            
            target.setAttribute('data-suspended', isSuspended.toString());
            textSpan.textContent = isSuspended ? 'Unsuspend' : 'Suspend';

            const statusBadge = document.getElementById('status-' + userId);
            if (statusBadge) {
              statusBadge.textContent = isSuspended ? 'suspended' : 'active';
              if (isSuspended) {
                statusBadge.className = 'rounded px-1.5 py-0.5 text-2xs font-semibold uppercase transition-colors bg-rose-500/10 text-rose-600';
              } else {
                statusBadge.className = 'rounded px-1.5 py-0.5 text-2xs font-semibold uppercase transition-colors bg-emerald-500/10 text-emerald-600';
              }
            }
          } else {
            alert('Failed to update user status.');
            textSpan.textContent = originalText;
          }
        } catch (err) {
          alert('Network error while updating user status.');
          textSpan.textContent = originalText;
        } finally {
          target.disabled = false;
        }
      });
    });
  </script>
</DashboardLayout>

