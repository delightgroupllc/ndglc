                  <span class="text-[10px] font-bold text-slate-500 shrink-0 bg-slate-50 border border-slate-200 px-2.5 py-1 rounded-md">
                    {new Date(log.timestamp).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

    </form>
