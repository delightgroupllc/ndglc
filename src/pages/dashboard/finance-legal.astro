            <div class="w-1.5 h-6 bg-slate-700 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <ScrollText class="w-4 h-4 text-slate-400" />
              Finance &amp; Legal Audit Trail &amp; History
            </h2>
          </div>
          <a href="/dashboard/logs" class="text-xs font-bold text-cyan-600 hover:text-cyan-700 flex items-center gap-1 transition-colors">
            View All Audit Logs →
          </a>
        </div>
        <div class="p-6">
          {recentLogs.length === 0 ? (
            <div class="text-center py-6 text-slate-400 text-xs font-medium">
              No configuration changes recorded yet. Future updates will be logged here.
            </div>
          ) : (
            <div class="divide-y divide-slate-100">
              {recentLogs.map((log: any) => (
                <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
