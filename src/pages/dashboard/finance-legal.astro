---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { Settings, Save, Building2, Receipt, PenTool, Plus, Trash2, CheckCircle2 } from '@lucide/astro';

let settings: Record<string, any> = {};
try {
  const res = await query('SELECT key, value FROM settings');
  settings = res.rows.reduce((acc: any, row: any) => {
    acc[row.key] = row.value;
    return acc;
  }, {});
} catch (e) {
  console.error("DB Offline", e);
}

// Parse collections from settings
let banks = [];
try {
  banks = settings.banks ? JSON.parse(settings.banks) : [];
} catch (e) {}
if (banks.length === 0 && (settings.bank_name || settings.account_number)) {
  banks = [{
    id: 'bank_legacy_' + Math.random().toString(36).substr(2, 9),
    bank_name: settings.bank_name || '',
    account_name: settings.account_name || '',
    account_number: settings.account_number || '',
    swift_code: settings.swift_code || '',
    iban_number: settings.iban_number || ''
  }];
}

let signatures = [];
try {
  signatures = settings.signatures ? JSON.parse(settings.signatures) : [];
} catch (e) {}
if (signatures.length === 0 && settings.signatory_name) {
  signatures = [{
    id: 'sig_legacy_' + Math.random().toString(36).substr(2, 9),
    signatory_name: settings.signatory_name || '',
    signatory_title: settings.signatory_title || ''
  }];
}

let addresses = [];
try {
  addresses = settings.addresses ? JSON.parse(settings.addresses) : [];
} catch (e) {}
if (addresses.length === 0 && (settings.business_address || settings.trn_number)) {
  addresses = [{
    id: 'addr_legacy_' + Math.random().toString(36).substr(2, 9),
    business_address: settings.business_address || '',
    trn_number: settings.trn_number || '',
    business_registration: settings.business_registration || '',
    permits_info: settings.permits_info || ''
  }];
}

const default_bank_id = settings.default_bank_id || (banks[0]?.id || '');
const default_signature_id = settings.default_signature_id || (signatures[0]?.id || '');
const default_address_id = settings.default_address_id || (addresses[0]?.id || '');
---

<DashboardLayout title="Finance & Legal | Delight Group LLC" activeItem="finance-legal">
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black font-display text-slate-900 tracking-tight uppercase">Finance & Legal</h1>
        <p class="text-slate-500 mt-1">Manage corporate bank accounts, signatory stamps, and office profiles.</p>
      </div>
      <button 
        type="button"
        id="save-settings-btn"
        class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-6 py-2.5 rounded-xl text-sm font-bold transition-all shadow-sm"
      >
        <Save class="w-4 h-4" />
        Save Configuration
      </button>
    </div>

    <form id="settings-form" class="space-y-8" onsubmit="return false;">
      
      <!-- REMITTANCE DETAILS (BANKS) -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-blue-600 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <Receipt class="w-4 h-4 text-slate-400" />
              Remittance Details & Bank Accounts
            </h2>
          </div>
          <button type="button" id="add-bank-btn" class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition-colors">
            <Plus class="w-3.5 h-3.5" /> Add Bank
          </button>
        </div>
        <div class="p-6">
          <div id="bank-list-container" class="space-y-6">
            <!-- Dynamic Bank Accounts Rendered Here -->
          </div>
        </div>
      </div>

      <!-- AUTHORIZED SIGNATURES -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-purple-600 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <PenTool class="w-4 h-4 text-slate-400" />
              Authorized Signatures (Company Stamp)
            </h2>
          </div>
          <button type="button" id="add-sig-btn" class="inline-flex items-center gap-1 text-xs font-bold text-purple-600 hover:text-purple-700 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-lg transition-colors">
            <Plus class="w-3.5 h-3.5" /> Add Signature
          </button>
        </div>
        <div class="p-6">
          <div id="signature-list-container" class="space-y-6">
            <!-- Dynamic Signatures Rendered Here -->
          </div>
        </div>
      </div>

      <!-- LEGAL & REGULATORY (ADDRESSES) -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-orange-505 bg-orange-500 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <Building2 class="w-4 h-4 text-slate-400" />
              Office Addresses & Regulatory Profiles
            </h2>
          </div>
          <button type="button" id="add-addr-btn" class="inline-flex items-center gap-1 text-xs font-bold text-orange-600 hover:text-orange-700 bg-orange-50 hover:bg-orange-100 px-3 py-1.5 rounded-lg transition-colors">
            <Plus class="w-3.5 h-3.5" /> Add Profile
          </button>
        </div>
        <div class="p-6">
          <div id="address-list-container" class="space-y-6">
            <!-- Dynamic Addresses Rendered Here -->
          </div>
        </div>
      </div>

    </form>
  </div>

  <div id="toast-msg" class="fixed bottom-4 right-4 bg-slate-900 text-white px-6 py-3 rounded-lg shadow-xl transform transition-transform translate-y-20 opacity-0 font-semibold text-sm flex items-center gap-2 z-50">
    <div class="w-2 h-2 rounded-full bg-green-500"></div>
    <span id="toast-text">Settings saved successfully</span>
  </div>
</DashboardLayout>

<!-- Templates for dynamically created elements -->
<template id="bank-template">
  <div class="bank-card p-4 rounded-xl border border-slate-200 bg-slate-50/30 relative space-y-4 transition-all hover:border-slate-300" data-id="">
    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
      <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
        <input type="radio" name="default_bank" class="text-blue-600 focus:ring-0" />
        <span>Set as Default Remittance Account</span>
      </label>
      <button type="button" class="remove-btn text-slate-400 hover:text-red-500 p-1 rounded transition-colors" title="Delete Account">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
      </button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Bank Name</label>
        <input type="text" name="bank_name" placeholder="e.g. Abu Dhabi Islamic Bank" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
      </div>
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Account Name</label>
        <input type="text" name="account_name" placeholder="e.g. Delight Group LLC" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
      </div>
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Account Number</label>
        <input type="text" name="account_number" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
      </div>
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Swift / BIC Code</label>
        <input type="text" name="swift_code" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
      </div>
      <div class="space-y-1 md:col-span-2">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">IBAN Number</label>
        <input type="text" name="iban_number" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
      </div>
    </div>
  </div>
</template>

<template id="sig-template">
  <div class="sig-card p-4 rounded-xl border border-slate-200 bg-slate-50/30 relative space-y-4 transition-all hover:border-slate-300" data-id="">
    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
      <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
        <input type="radio" name="default_signature" class="text-purple-600 focus:ring-0" />
        <span>Set as Default Signatory Stamp</span>
      </label>
      <button type="button" class="remove-btn text-slate-400 hover:text-red-500 p-1 rounded transition-colors" title="Delete Signatory">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
      </button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Signatory Name</label>
        <input type="text" name="signatory_name" placeholder="e.g. Authorized Signatory" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-purple-500 focus:outline-none transition-colors" />
      </div>
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Signatory Title</label>
        <input type="text" name="signatory_title" placeholder="e.g. Managing Partner" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-purple-500 focus:outline-none transition-colors" />
      </div>
    </div>
  </div>
</template>

<template id="addr-template">
  <div class="addr-card p-4 rounded-xl border border-slate-200 bg-slate-50/30 relative space-y-4 transition-all hover:border-slate-300" data-id="">
    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
      <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
        <input type="radio" name="default_address" class="text-orange-500 focus:ring-0" />
        <span>Set as Default Building Address Profile</span>
      </label>
      <button type="button" class="remove-btn text-slate-400 hover:text-red-500 p-1 rounded transition-colors" title="Delete Address">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
      </button>
    </div>
    <div class="space-y-4">
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Official Office / Building Address (UAE Format)</label>
        <textarea name="business_address" rows="3" placeholder="Delight Group Building, Al Quoz Industrial Area 3, Dubai, UAE" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors"></textarea>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">TRN (Tax Registration Number)</label>
          <input type="text" name="trn_number" placeholder="15-digit TRN" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors" />
        </div>
        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Business Registration / License Info</label>
          <input type="text" name="business_registration" placeholder="e.g. License No. 623456" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors" />
        </div>
      </div>
      
      <div class="space-y-1">
        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Permits & Other Information</label>
        <textarea name="permits_info" rows="2" placeholder="e.g. Civil Defense Permit No. 5623, Municipality Approval No. 9012" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors"></textarea>
      </div>
    </div>
  </div>
</template>

<script define:vars={{ initialBanks: banks, initialSignatures: signatures, initialAddresses: addresses, defaultBankId: default_bank_id, defaultSignatureId: default_signature_id, defaultAddressId: default_address_id }}>
  const bankContainer = document.getElementById('bank-list-container');
  const signatureContainer = document.getElementById('signature-list-container');
  const addressContainer = document.getElementById('address-list-container');

  const bankTemplate = document.getElementById('bank-template');
  const sigTemplate = document.getElementById('sig-template');
  const addrTemplate = document.getElementById('addr-template');

  // Helper to generate unique random IDs for new settings items
  const generateId = () => 'item_' + Math.random().toString(36).substr(2, 9);

  // Bank item rendering
  const addBankCard = (data = null) => {
    const clone = bankTemplate.content.cloneNode(true);
    const card = clone.querySelector('.bank-card');
    const id = data?.id || generateId();
    card.setAttribute('data-id', id);

    const bankInput = card.querySelector('[name="bank_name"]');
    const nameInput = card.querySelector('[name="account_name"]');
    const numberInput = card.querySelector('[name="account_number"]');
    const swiftInput = card.querySelector('[name="swift_code"]');
    const ibanInput = card.querySelector('[name="iban_number"]');
    const radio = card.querySelector('input[type="radio"]');

    if (data) {
      bankInput.value = data.bank_name || '';
      nameInput.value = data.account_name || '';
      numberInput.value = data.account_number || '';
      swiftInput.value = data.swift_code || '';
      ibanInput.value = data.iban_number || '';
    }

    radio.value = id;
    if (id === defaultBankId || (!defaultBankId && bankContainer.children.length === 0)) {
      radio.checked = true;
    }

    card.querySelector('.remove-btn').addEventListener('click', () => {
      card.remove();
    });

    bankContainer.appendChild(clone);
  };

  // Signatory item rendering
  const addSignatureCard = (data = null) => {
    const clone = sigTemplate.content.cloneNode(true);
    const card = clone.querySelector('.sig-card');
    const id = data?.id || generateId();
    card.setAttribute('data-id', id);

    const nameInput = card.querySelector('[name="signatory_name"]');
    const titleInput = card.querySelector('[name="signatory_title"]');
    const radio = card.querySelector('input[type="radio"]');

    if (data) {
      nameInput.value = data.signatory_name || '';
      titleInput.value = data.signatory_title || '';
    }

    radio.value = id;
    if (id === defaultSignatureId || (!defaultSignatureId && signatureContainer.children.length === 0)) {
      radio.checked = true;
    }

    card.querySelector('.remove-btn').addEventListener('click', () => {
      card.remove();
    });

    signatureContainer.appendChild(clone);
  };

  // Address item rendering
  const addAddressCard = (data = null) => {
    const clone = addrTemplate.content.cloneNode(true);
    const card = clone.querySelector('.addr-card');
    const id = data?.id || generateId();
    card.setAttribute('data-id', id);

    const addressInput = card.querySelector('[name="business_address"]');
    const trnInput = card.querySelector('[name="trn_number"]');
    const regInput = card.querySelector('[name="business_registration"]');
    const permitInput = card.querySelector('[name="permits_info"]');
    const radio = card.querySelector('input[type="radio"]');

    if (data) {
      addressInput.value = data.business_address || '';
      trnInput.value = data.trn_number || '';
      regInput.value = data.business_registration || '';
      permitInput.value = data.permits_info || '';
    }

    radio.value = id;
    if (id === defaultAddressId || (!defaultAddressId && addressContainer.children.length === 0)) {
      radio.checked = true;
    }

    card.querySelector('.remove-btn').addEventListener('click', () => {
      card.remove();
    });

    addressContainer.appendChild(clone);
  };

  // Initialize Lists
  initialBanks.forEach(b => addBankCard(b));
  initialSignatures.forEach(s => addSignatureCard(s));
  initialAddresses.forEach(a => addAddressCard(a));

  // Add Button Event Listeners
  document.getElementById('add-bank-btn').addEventListener('click', () => addBankCard());
  document.getElementById('add-sig-btn').addEventListener('click', () => addSignatureCard());
  document.getElementById('add-addr-btn').addEventListener('click', () => addAddressCard());

  // Save Event Listener
  const saveBtn = document.getElementById('save-settings-btn');
  const toast = document.getElementById('toast-msg');
  const toastText = document.getElementById('toast-text');

  const showToast = (msg, isError = false) => {
    if (!toast || !toastText) return;
    toastText.textContent = msg;
    toast.querySelector('.w-2')?.classList.toggle('bg-green-505', !isError);
    toast.querySelector('.w-2')?.classList.toggle('bg-green-500', !isError);
    toast.querySelector('.w-2')?.classList.toggle('bg-red-500', isError);
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3000);
  };

  saveBtn?.addEventListener('click', async () => {
    saveBtn.setAttribute('disabled', 'true');
    saveBtn.innerHTML = '<span class="animate-pulse">Saving...</span>';

    // Build lists from UI elements
    const bankCards = document.querySelectorAll('.bank-card');
    const banks = Array.from(bankCards).map(card => {
      return {
        id: card.getAttribute('data-id'),
        bank_name: card.querySelector('[name="bank_name"]').value,
        account_name: card.querySelector('[name="account_name"]').value,
        account_number: card.querySelector('[name="account_number"]').value,
        swift_code: card.querySelector('[name="swift_code"]').value,
        iban_number: card.querySelector('[name="iban_number"]').value,
      };
    });

    const sigCards = document.querySelectorAll('.sig-card');
    const signatures = Array.from(sigCards).map(card => {
      return {
        id: card.getAttribute('data-id'),
        signatory_name: card.querySelector('[name="signatory_name"]').value,
        signatory_title: card.querySelector('[name="signatory_title"]').value,
      };
    });

    const addrCards = document.querySelectorAll('.addr-card');
    const addresses = Array.from(addrCards).map(card => {
      return {
        id: card.getAttribute('data-id'),
        business_address: card.querySelector('[name="business_address"]').value,
        trn_number: card.querySelector('[name="trn_number"]').value,
        business_registration: card.querySelector('[name="business_registration"]').value,
        permits_info: card.querySelector('[name="permits_info"]').value,
      };
    });

    const default_bank_id = document.querySelector('input[name="default_bank"]:checked')?.value || '';
    const default_signature_id = document.querySelector('input[name="default_signature"]:checked')?.value || '';
    const default_address_id = document.querySelector('input[name="default_address"]:checked')?.value || '';

    // Find defaults to store as legacy keys to keep rest of app happy
    const defBank = banks.find(b => b.id === default_bank_id) || banks[0];
    const defSig = signatures.find(s => s.id === default_signature_id) || signatures[0];
    const defAddr = addresses.find(a => a.id === default_address_id) || addresses[0];

    const payload = {
      banks: JSON.stringify(banks),
      signatures: JSON.stringify(signatures),
      addresses: JSON.stringify(addresses),
      default_bank_id,
      default_signature_id,
      default_address_id,
      // Legacy compatibility scalars
      bank_name: defBank?.bank_name || '',
      account_name: defBank?.account_name || '',
      account_number: defBank?.account_number || '',
      swift_code: defBank?.swift_code || '',
      iban_number: defBank?.iban_number || '',
      signatory_name: defSig?.signatory_name || '',
      signatory_title: defSig?.signatory_title || '',
      business_address: defAddr?.business_address || '',
      trn_number: defAddr?.trn_number || '',
      business_registration: defAddr?.business_registration || '',
      permits_info: defAddr?.permits_info || ''
    };

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!res.ok) throw new Error('Failed to save settings');
      showToast('Settings saved successfully');
    } catch (err) {
      showToast(err.message || 'Error saving settings', true);
    } finally {
      saveBtn.removeAttribute('disabled');
      saveBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg> Save Configuration';
    }
  });
</script>
