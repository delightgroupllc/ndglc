---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { Settings, Save, Building2, Receipt, PenTool, Plus, Trash2, CheckCircle2, ScrollText, History } from '@lucide/astro';

let settings: Record<string, any> = {};
try {
  const res = await query('SELECT key, value FROM settings');
  settings = res.rows.reduce((acc: any, row: any) => {
    acc[row.key] = row.value;
    return acc;
  }, {});
} catch (e) {
  console.error("DB Offline", e);
}

// Parse collections from settings
let banks: any[] = [];
try {
  banks = settings.banks ? JSON.parse(settings.banks) : [];
} catch (e) {}
if (banks.length === 0 && (settings.bank_name || settings.account_number)) {
  banks = [{
    id: 'bank_legacy_' + Math.random().toString(36).substr(2, 9),
    bank_name: settings.bank_name || '',
    account_name: settings.account_name || '',
    account_number: settings.account_number || '',
    swift_code: settings.swift_code || '',
    iban_number: settings.iban_number || ''
  }];
}

let signatures: any[] = [];
try {
  signatures = settings.signatures ? JSON.parse(settings.signatures) : [];
} catch (e) {}
if (signatures.length === 0 && settings.signatory_name) {
  signatures = [{
    id: 'sig_legacy_' + Math.random().toString(36).substr(2, 9),
    signatory_name: settings.signatory_name || '',
    signatory_title: settings.signatory_title || '',
    signature_image: settings.signature_image || ''
  }];
}

let addresses: any[] = [];
try {
  addresses = settings.addresses ? JSON.parse(settings.addresses) : [];
} catch (e) {}
if (addresses.length === 0 && (settings.business_address || settings.trn_number)) {
  addresses = [{
    id: 'addr_legacy_' + Math.random().toString(36).substr(2, 9),
    business_address: settings.business_address || '',
    trn_number: settings.trn_number || '',
    business_registration: settings.business_registration || '',
    permits_info: settings.permits_info || '',
    phone_number: settings.phone_number || '',
    phone_type: settings.phone_type || 'Landline'
  }];
}

const default_bank_id = settings.default_bank_id || (banks[0]?.id || '');
const default_signature_id = settings.default_signature_id || (signatures[0]?.id || '');
const default_address_id = settings.default_address_id || (addresses[0]?.id || '');

let recentLogs: any[] = [];
try {
  const logsRes = await query(`
    SELECT al.*, u.name as user_name, u.email as user_email
    FROM audit_logs al
    LEFT JOIN users u ON u.id = al.user_id
    WHERE al.entity_type = 'finance_legal' 
       OR al.action LIKE '%FINANCE%' 
       OR al.details ILIKE '%finance%'
       OR (al.entity_type = 'settings' AND al.entity_id = 'finance_legal_config')
    ORDER BY al.timestamp DESC
    LIMIT 6
  `);
  recentLogs = logsRes.rows;
} catch (e) {
  console.error("Audit logs query error:", e);
}
---

<DashboardLayout title="Finance & Legal | Delight Group LLC" activeItem="finance-legal">
  <div class="max-w-4xl mx-auto space-y-8 pb-12">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black font-display text-slate-900 tracking-tight uppercase">Finance & Legal</h1>
        <p class="text-slate-500 mt-1">Manage corporate bank accounts, signatory stamps, and office profiles.</p>
      </div>
      <button 
        type="button"
        id="save-settings-btn"
        class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-6 py-2.5 rounded-xl text-sm font-bold transition-all shadow-sm cursor-pointer"
      >
        <Save class="w-4 h-4" />
        Save Configuration
      </button>
    </div>

    <form id="settings-form" class="space-y-8" onsubmit="return false;">
      
      <!-- REMITTANCE DETAILS (BANKS) -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-blue-600 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <Receipt class="w-4 h-4 text-slate-400" />
              Remittance Details & Bank Accounts
            </h2>
          </div>
          <button type="button" id="add-bank-btn" class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
            <Plus class="w-3.5 h-3.5" /> Add Bank
          </button>
        </div>
        <div class="p-6">
          <div id="bank-list-container" class="space-y-6">
            {banks.map((b: any) => (
              <div class="bank-card p-4 rounded-xl border border-slate-200 bg-slate-50/30 relative space-y-4 transition-all hover:border-slate-300" data-id={b.id}>
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                  <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
                    <input type="radio" name="default_bank" value={b.id} checked={b.id === default_bank_id} class="text-blue-600 focus:ring-0" />
                    <span>Set as Default Remittance Account</span>
                  </label>
                  <button type="button" class="remove-btn text-slate-400 hover:text-red-500 p-1 rounded transition-colors cursor-pointer" title="Delete Account">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Bank Name</label>
                    <input type="text" name="bank_name" value={b.bank_name || ''} placeholder="e.g. Abu Dhabi Islamic Bank" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
                  </div>
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Account Name</label>
                    <input type="text" name="account_name" value={b.account_name || ''} placeholder="e.g. Delight Group LLC" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
                  </div>
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Account Number</label>
                    <input type="text" name="account_number" value={b.account_number || ''} class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
                  </div>
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Swift / BIC Code</label>
                    <input type="text" name="swift_code" value={b.swift_code || ''} class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
                  </div>
                  <div class="space-y-1 md:col-span-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">IBAN Number</label>
                    <input type="text" name="iban_number" value={b.iban_number || ''} class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- AUTHORIZED SIGNATURES -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-purple-600 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <PenTool class="w-4 h-4 text-slate-400" />
              Authorized Signatures (Company Stamp)
            </h2>
          </div>
          <button type="button" id="add-sig-btn" class="inline-flex items-center gap-1 text-xs font-bold text-purple-600 hover:text-purple-700 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
            <Plus class="w-3.5 h-3.5" /> Add Signature
          </button>
        </div>
        <div class="p-6">
          <div id="signature-list-container" class="space-y-6">
            {signatures.map((s: any) => (
              <div class="sig-card p-4 rounded-xl border border-slate-200 bg-slate-50/30 relative space-y-4 transition-all hover:border-slate-300" data-id={s.id}>
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                  <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
                    <input type="radio" name="default_signature" value={s.id} checked={s.id === default_signature_id} class="text-purple-600 focus:ring-0" />
                    <span>Set as Default Signatory Stamp</span>
                  </label>
                  <button type="button" class="remove-btn text-slate-400 hover:text-red-500 p-1 rounded transition-colors cursor-pointer" title="Delete Signatory">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Signatory Name</label>
                    <input type="text" name="signatory_name" value={s.signatory_name || ''} placeholder="e.g. Authorized Signatory" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-purple-500 focus:outline-none transition-colors" />
                  </div>
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Signatory Title</label>
                    <input type="text" name="signatory_title" value={s.signatory_title || ''} placeholder="e.g. Managing Partner" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-purple-500 focus:outline-none transition-colors" />
                  </div>
                  <div class="space-y-1 md:col-span-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Signature Image (PNG only, &lt; 500kb, 3:1 or 4:1 ratio)</label>
                    <div class="flex items-center gap-4 mt-1.5 flex-wrap">
                      <input type="file" name="signature_image_file" accept="image/png" class="hidden" />
                      <button type="button" class="upload-img-btn bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold py-2 px-3 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                        Upload PNG
                      </button>
                      <input type="hidden" name="signature_image" value={s.signature_image || ''} />
                      <div class={`preview-img-wrapper relative border border-slate-200 rounded-lg p-1 bg-white ${s.signature_image ? '' : 'hidden'}`}>
                        <img class="signature-preview h-10 w-auto object-contain" src={s.signature_image || ''} />
                        <button type="button" class="remove-img-btn absolute -top-1.5 -right-1.5 bg-red-100 hover:bg-red-200 text-red-700 p-0.5 rounded-full border border-red-200 transition-colors cursor-pointer">
                          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                        </button>
                      </div>
                      <span class="upload-status-text text-[10px] text-slate-400 font-medium italic">{s.signature_image ? 'PNG uploaded' : 'No file uploaded'}</span>
                      <button type="button" class="save-sig-card-btn hidden ml-auto bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Save Signature</button>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- COMPANY STAMP -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-teal-600 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <Settings class="w-4 h-4 text-slate-400" />
              Company Stamp (Official Corporate Stamp)
            </h2>
          </div>
        </div>
        <div class="p-6">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Stamp Image (PNG format, &lt; 500kb, transparent background recommended)</label>
            <div class="flex items-center gap-4 mt-2 flex-wrap">
              <input type="file" id="stamp-file-input" accept="image/png" class="hidden" />
              <button type="button" id="stamp-upload-btn" class="bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold py-2 px-3.5 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                Upload Stamp PNG
              </button>
              <input type="hidden" id="company-stamp-value" value={settings.company_stamp || ''} />
              
              <div id="stamp-preview-wrapper" class={`preview-img-wrapper relative border border-slate-200 rounded-lg p-2 bg-white ${settings.company_stamp ? '' : 'hidden'}`}>
                <img id="stamp-preview-img" class="h-16 w-16 object-contain" src={settings.company_stamp || ''} />
                <button type="button" id="stamp-remove-img-btn" class="absolute -top-1.5 -right-1.5 bg-red-100 hover:bg-red-200 text-red-700 p-0.5 rounded-full border border-red-200 transition-colors cursor-pointer">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
              </div>
              <span id="stamp-status-text" class="text-[10px] text-slate-450 font-medium italic">{settings.company_stamp ? 'Stamp uploaded successfully' : 'No corporate stamp uploaded'}</span>
              <button type="button" id="save-stamp-btn" class="hidden ml-auto bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Save Stamp</button>
            </div>
          </div>
        </div>
      </div>

      <!-- LEGAL & REGULATORY (ADDRESSES) -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-orange-500 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <Building2 class="w-4 h-4 text-slate-400" />
              Office Addresses & Regulatory Profiles
            </h2>
          </div>
          <button type="button" id="add-addr-btn" class="inline-flex items-center gap-1 text-xs font-bold text-orange-600 hover:text-orange-700 bg-orange-50 hover:bg-orange-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
            <Plus class="w-3.5 h-3.5" /> Add Profile
          </button>
        </div>
        <div class="p-6">
          <div id="address-list-container" class="space-y-6">
            {addresses.map((a: any) => (
              <div class="addr-card p-4 rounded-xl border border-slate-200 bg-slate-50/30 relative space-y-4 transition-all hover:border-slate-300" data-id={a.id}>
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                  <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
                    <input type="radio" name="default_address" value={a.id} checked={a.id === default_address_id} class="text-orange-500 focus:ring-0" />
                    <span>Set as Default Building Address Profile</span>
                  </label>
                  <button type="button" class="remove-btn text-slate-400 hover:text-red-500 p-1 rounded transition-colors cursor-pointer" title="Delete Address">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </div>
                <div class="space-y-4">
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Official Office / Building Address (UAE Format)</label>
                    <textarea name="business_address" rows="3" placeholder="Delight Group Building, Al Quoz Industrial Area 3, Dubai, UAE" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors">{a.business_address || ''}</textarea>
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1">
                      <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">TRN (Tax Registration Number)</label>
                      <input type="text" name="trn_number" value={a.trn_number || ''} placeholder="15-digit TRN" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors" />
                    </div>
                    <div class="space-y-1">
                      <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Business Registration / License Info</label>
                      <input type="text" name="business_registration" value={a.business_registration || ''} placeholder="e.g. License No. 623456" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors" />
                    </div>
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1">
                      <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Phone Number</label>
                      <input type="text" name="phone_number" value={a.phone_number || ''} placeholder="e.g. +971 4 123 4567" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors" />
                    </div>
                    <div class="space-y-1">
                      <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Phone Type</label>
                      <select name="phone_type" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors">
                        <option value="Landline" selected={a.phone_type === 'Landline'}>Landline</option>
                        <option value="Telephone" selected={a.phone_type === 'Telephone'}>Telephone</option>
                        <option value="Mobile" selected={a.phone_type === 'Mobile'}>Mobile</option>
                      </select>
                    </div>
                  </div>
                  
                  <div class="space-y-1">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Permits & Other Information</label>
                    <textarea name="permits_info" rows="2" placeholder="e.g. Civil Defense Permit No. 5623, Municipality Approval No. 9012" class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-orange-500 focus:outline-none transition-colors">{a.permits_info || ''}</textarea>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- MULTI-DIVISION & COMBINED BILLING POLICY -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-6 bg-purple-600 rounded-full"></div>
            <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <Building2 class="w-4 h-4 text-slate-400" />
              Multi-Division &amp; Group Billing Operations
            </h2>
          </div>
        </div>
        <div class="p-6 space-y-4">
          <div class="flex items-start justify-between gap-6 p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition-colors">
            <div class="space-y-1">
              <label for="toggle-both-divisions" class="text-sm font-bold text-slate-900 cursor-pointer flex items-center gap-2">
                <span>Allow "Both Divisions" (Combined Master Group Invoicing)</span>
                <span id="both-divisions-status-badge" class={`text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider ${settings.enable_both_divisions === 'true' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600'}`}>
                  {settings.enable_both_divisions === 'true' ? 'Enabled' : 'Disabled (Default)'}
                </span>
              </label>
              <p class="text-xs text-slate-500 leading-relaxed max-w-2xl">
                When <strong>disabled</strong>, all order creators are restricted to single-division orders (Delight Technical Lighting - DTL or Delight Greenscapes - DGS). When <strong>enabled</strong>, staff can select "Both Divisions" to generate combined group invoices with Master Delight Group LLC branding.
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" id="toggle-both-divisions" name="enable_both_divisions" class="sr-only peer" checked={settings.enable_both_divisions === 'true'} />
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
            </label>
