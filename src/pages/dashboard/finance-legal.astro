  <script is:inline>
    function setupFinanceLegal() {
      const bankContainer = document.getElementById('bank-list-container');
      const signatureContainer = document.getElementById('signature-list-container');
      const addressContainer = document.getElementById('address-list-container');

      const bankTemplate = document.getElementById('bank-template');
      const sigTemplate = document.getElementById('sig-template');
      const addrTemplate = document.getElementById('addr-template');

      const generateId = () => 'item_' + Math.random().toString(36).substr(2, 9);

      // Event delegation for card remove buttons
      document.getElementById('settings-form')?.addEventListener('click', (e) => {
        const removeBtn = e.target.closest('.remove-btn');
        if (removeBtn) {
          const card = removeBtn.closest('.bank-card, .sig-card, .addr-card');
          if (card) card.remove();
        }

        const uploadBtn = e.target.closest('.upload-img-btn');
        if (uploadBtn) {
          const sigCard = uploadBtn.closest('.sig-card');
          const fileInput = sigCard?.querySelector('input[name="signature_image_file"]');
          fileInput?.click();
        }

        const removeImgBtn = e.target.closest('.remove-img-btn');
        if (removeImgBtn) {
          const sigCard = removeImgBtn.closest('.sig-card');
          if (sigCard) {
            const hiddenInput = sigCard.querySelector('input[name="signature_image"]');
            const previewImg = sigCard.querySelector('.signature-preview');
            const previewWrapper = sigCard.querySelector('.preview-img-wrapper');
            const statusText = sigCard.querySelector('.upload-status-text');
            const saveBtn = sigCard.querySelector('.save-sig-card-btn');
            if (hiddenInput) hiddenInput.value = '';
            if (previewImg) previewImg.src = '';
            if (previewWrapper) previewWrapper.classList.add('hidden');
            if (statusText) statusText.textContent = 'No file uploaded';
            if (saveBtn) saveBtn.classList.add('hidden');
          }
        }

        const saveSigBtn = e.target.closest('.save-sig-card-btn');
        if (saveSigBtn) {
          document.getElementById('save-settings-btn')?.click();
        }
      });

      // Handle signature file changes via delegation
      document.getElementById('signature-list-container')?.addEventListener('change', (e) => {
        const fileInput = e.target;
        if (fileInput && fileInput.name === 'signature_image_file') {
          const file = fileInput.files[0];
          if (!file) return;
          const sigCard = fileInput.closest('.sig-card');
          const statusText = sigCard?.querySelector('.upload-status-text');
          const hiddenInput = sigCard?.querySelector('input[name="signature_image"]');
          const previewImg = sigCard?.querySelector('.signature-preview');
          const previewWrapper = sigCard?.querySelector('.preview-img-wrapper');
          const saveSigBtn = sigCard?.querySelector('.save-sig-card-btn');

          if (file.type !== 'image/png') {
            alert('Error: Only PNG images are accepted.');
            fileInput.value = '';
            return;
          }
          if (file.size > 500 * 1024) {
            alert('Error: File size must be under 500KB.');
            fileInput.value = '';
            return;
          }

          if (statusText) statusText.textContent = 'Processing image...';
          const reader = new FileReader();
          reader.onload = (evt) => {
            const base64 = evt.target?.result;
            if (hiddenInput) hiddenInput.value = base64;
            if (previewImg) previewImg.src = base64;
            if (previewWrapper) previewWrapper.classList.remove('hidden');
            if (statusText) statusText.textContent = 'PNG uploaded';
            if (saveSigBtn) saveSigBtn.classList.remove('hidden');
          };
          reader.readAsDataURL(file);
        }
      });

      // Add New Cards
      document.getElementById('add-bank-btn')?.addEventListener('click', () => {
        if (!bankTemplate || !bankContainer) return;
        const clone = bankTemplate.content.cloneNode(true);
        const card = clone.querySelector('.bank-card');
        const id = generateId();
        card.setAttribute('data-id', id);
        card.querySelector('input[type="radio"]').value = id;
        if (bankContainer.children.length === 0) {
          card.querySelector('input[type="radio"]').checked = true;
        }
        bankContainer.appendChild(clone);
      });

      document.getElementById('add-sig-btn')?.addEventListener('click', () => {
        if (!sigTemplate || !signatureContainer) return;
        const clone = sigTemplate.content.cloneNode(true);
        const card = clone.querySelector('.sig-card');
        const id = generateId();
        card.setAttribute('data-id', id);
        card.querySelector('input[type="radio"]').value = id;
        if (signatureContainer.children.length === 0) {
          card.querySelector('input[type="radio"]').checked = true;
        }
        signatureContainer.appendChild(clone);
      });

      document.getElementById('add-addr-btn')?.addEventListener('click', () => {
        if (!addrTemplate || !addressContainer) return;
        const clone = addrTemplate.content.cloneNode(true);
        const card = clone.querySelector('.addr-card');
        const id = generateId();
        card.setAttribute('data-id', id);
        card.querySelector('input[type="radio"]').value = id;
        if (addressContainer.children.length === 0) {
          card.querySelector('input[type="radio"]').checked = true;
        }
        addressContainer.appendChild(clone);
      });

      // Corporate Stamp Uploader
      const stampUploadBtn = document.getElementById('stamp-upload-btn');
      const stampFileInput = document.getElementById('stamp-file-input');
      const stampHiddenInput = document.getElementById('company-stamp-value');
      const stampPreviewWrapper = document.getElementById('stamp-preview-wrapper');
      const stampPreviewImg = document.getElementById('stamp-preview-img');
      const stampRemoveBtn = document.getElementById('stamp-remove-img-btn');
      const stampStatusText = document.getElementById('stamp-status-text');
      const saveStampBtn = document.getElementById('save-stamp-btn');

      stampUploadBtn?.addEventListener('click', () => stampFileInput?.click());

      const updateStampPreview = (base64) => {
        if (base64) {
          if (stampHiddenInput) stampHiddenInput.value = base64;
          if (stampPreviewImg) stampPreviewImg.src = base64;
          stampPreviewWrapper?.classList.remove('hidden');
          if (stampStatusText) stampStatusText.textContent = 'Stamp uploaded successfully';
        } else {
          if (stampHiddenInput) stampHiddenInput.value = '';
          if (stampPreviewImg) stampPreviewImg.src = '';
          stampPreviewWrapper?.classList.add('hidden');
          if (stampStatusText) stampStatusText.textContent = 'No corporate stamp uploaded';
        }
        if (saveStampBtn) saveStampBtn.classList.remove('hidden');
      };

      saveStampBtn?.addEventListener('click', () => {
        document.getElementById('save-settings-btn')?.click();
      });

      stampFileInput?.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        if (file.type !== 'image/png') {
          alert('Error: Stamp must be a PNG image.');
          stampFileInput.value = '';
          return;
        }
        if (file.size > 500 * 1024) {
          alert('Error: Stamp file size must be under 500KB.');
          stampFileInput.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onload = (event) => updateStampPreview(event.target?.result);
        reader.readAsDataURL(file);
      });

      stampRemoveBtn?.addEventListener('click', () => {
        if (stampFileInput) stampFileInput.value = '';
        updateStampPreview(null);
      });

      // Multi-Division Toggle Dynamic Badge
      const bothDivToggle = document.getElementById('toggle-both-divisions');
      const bothDivBadge = document.getElementById('both-divisions-status-badge');
      bothDivToggle?.addEventListener('change', () => {
        if (bothDivBadge) {
          if (bothDivToggle.checked) {
            bothDivBadge.textContent = 'Enabled';
            bothDivBadge.className = 'text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider bg-emerald-100 text-emerald-700';
          } else {
            bothDivBadge.textContent = 'Disabled (Default)';
            bothDivBadge.className = 'text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider bg-slate-200 text-slate-600';
          }
        }
      });

      // Save Event Listener
      const saveBtn = document.getElementById('save-settings-btn');
      const toast = document.getElementById('toast-msg');
      const toastText = document.getElementById('toast-text');

      const showToast = (msg, isError = false) => {
        if (!toast || !toastText) return;
        toastText.textContent = msg;
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3000);
      };

      saveBtn?.addEventListener('click', async () => {
        saveBtn.setAttribute('disabled', 'true');
        saveBtn.innerHTML = '<span class="animate-pulse">Saving...</span>';

        const bankCards = document.querySelectorAll('.bank-card');
        const banksList = Array.from(bankCards).map(card => ({
          id: card.getAttribute('data-id'),
          bank_name: card.querySelector('[name="bank_name"]')?.value || '',
          account_name: card.querySelector('[name="account_name"]')?.value || '',
          account_number: card.querySelector('[name="account_number"]')?.value || '',
          swift_code: card.querySelector('[name="swift_code"]')?.value || '',
          iban_number: card.querySelector('[name="iban_number"]')?.value || '',
        }));

        const sigCards = document.querySelectorAll('.sig-card');
        const signaturesList = Array.from(sigCards).map(card => ({
          id: card.getAttribute('data-id'),
          signatory_name: card.querySelector('[name="signatory_name"]')?.value || '',
          signatory_title: card.querySelector('[name="signatory_title"]')?.value || '',
          signature_image: card.querySelector('[name="signature_image"]')?.value || '',
        }));

        const addrCards = document.querySelectorAll('.addr-card');
        const addressesList = Array.from(addrCards).map(card => ({
          id: card.getAttribute('data-id'),
          business_address: card.querySelector('[name="business_address"]')?.value || '',
          trn_number: card.querySelector('[name="trn_number"]')?.value || '',
          business_registration: card.querySelector('[name="business_registration"]')?.value || '',
          permits_info: card.querySelector('[name="permits_info"]')?.value || '',
          phone_number: card.querySelector('[name="phone_number"]')?.value || '',
          phone_type: card.querySelector('[name="phone_type"]')?.value || 'Landline',
        }));

        const defBankId = document.querySelector('input[name="default_bank"]:checked')?.value || (banksList[0]?.id || '');
        const defSigId = document.querySelector('input[name="default_signature"]:checked')?.value || (signaturesList[0]?.id || '');
        const defAddrId = document.querySelector('input[name="default_address"]:checked')?.value || (addressesList[0]?.id || '');

        const defBank = banksList.find(b => b.id === defBankId) || banksList[0];
        const defSig = signaturesList.find(s => s.id === defSigId) || signaturesList[0];
        const defAddr = addressesList.find(a => a.id === defAddrId) || addressesList[0];

        const companyStampVal = document.getElementById('company-stamp-value')?.value || '';
        const enableBothDivsVal = document.getElementById('toggle-both-divisions')?.checked ? 'true' : 'false';

        const payload = {
          banks: JSON.stringify(banksList),
          signatures: JSON.stringify(signaturesList),
          addresses: JSON.stringify(addressesList),
          default_bank_id: defBankId,
          company_stamp: companyStampVal,
          default_signature_id: defSigId,
          default_address_id: defAddrId,
          enable_both_divisions: enableBothDivsVal,
          bank_name: defBank?.bank_name || '',
          account_name: defBank?.account_name || '',
          account_number: defBank?.account_number || '',
          swift_code: defBank?.swift_code || '',
          iban_number: defBank?.iban_number || '',
          signatory_name: defSig?.signatory_name || '',
          signatory_title: defSig?.signatory_title || '',
          business_address: defAddr?.business_address || '',
          trn_number: defAddr?.trn_number || '',
          business_registration: defAddr?.business_registration || '',
          permits_info: defAddr?.permits_info || '',
          phone_number: defAddr?.phone_number || '',
          phone_type: defAddr?.phone_type || 'Landline',
          contact_phone: defAddr?.phone_number || ''
        };

        try {
          const res = await fetch('/api/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('Failed to save settings');
          showToast('Settings saved successfully');
        } catch (err) {
          showToast(err.message || 'Error saving settings', true);
        } finally {
          saveBtn.removeAttribute('disabled');
          saveBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg> Save Configuration';
        }
      });
    }

    setupFinanceLegal();
    document.addEventListener('astro:page-load', setupFinanceLegal);
  </script>
</DashboardLayout>
