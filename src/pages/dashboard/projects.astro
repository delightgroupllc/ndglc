---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ProjectForm from '../../components/forms/ProjectForm.astro';
import { query } from '../../lib/db';
import { FolderGit2, PlusCircle, Search, AlertTriangle, Trash, Edit } from 'lucide-astro';

let projects: any[] = [];
let dbConnected = true;

try {
  const res = await query('SELECT * FROM projects ORDER BY featured DESC, created_at DESC');
  projects = res.rows;
} catch (err: any) {
  console.warn('Database offline, running mock projects manager:', err.message);
  dbConnected = false;

  projects = [
    { id: 'p1', title: 'Grand Hotel Facade Lighting', client_name: 'Hilton Group', description: 'Full exterior dynamic lighting setup.', completion_date: '2025-11-20', division: 'dtl', status: 'active', featured_image: '' },
    { id: 'p2', title: 'City Square Greenscapes', client_name: 'Dubai Municipality', description: 'Urban irrigation and landscape automation.', completion_date: '2026-02-15', division: 'dgs', status: 'active', featured_image: '' },
    { id: 'p3', title: 'Marina Promenade Automation', client_name: 'Emaar', description: 'Smart pathways and environmental control systems.', completion_date: '2024-09-10', division: 'dgs', status: 'archived', featured_image: '' }
  ];
}
---

<DashboardLayout title="Portfolio Management" activeItem="portfolio">

  <ProjectForm />

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL is Offline</span>: Telemetry displays simulated projects catalog.
      </div>
    </div>
  )}

  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div class="relative flex-grow max-w-md">
        <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
        <input 
          type="text" 
          id="admin-search-projects"
          placeholder="Filter projects..." 
          class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
        />
      </div>
      <button 
        type="button" 
        onclick="document.dispatchEvent(new CustomEvent('open-project-modal', { detail: { project: null } }))"
        class="inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
      >
        <PlusCircle class="h-4 w-4" />
        Add Project
      </button>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
              <th class="px-6 py-4 font-semibold">Project Title</th>
              <th class="px-6 py-4 font-semibold">Client Name</th>
              <th class="px-6 py-4 font-semibold">Division</th>
              <th class="px-6 py-4 font-semibold">Completion Date</th>
              <th class="px-6 py-4 font-semibold text-center">Featured</th>
              <th class="px-6 py-4 font-semibold text-center">Status</th>
              <th class="px-6 py-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="admin-projects-table">
            {projects.map(p => {
              return (
                <tr class="admin-project-row border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors" data-name={p.title.toLowerCase()}>
                  <td class="px-6 py-4 font-bold text-slate-900 truncate max-w-[200px]" title={p.title}>{p.title}</td>
                  <td class="px-6 py-4 text-slate-600">{p.client_name}</td>
                  <td class="px-6 py-4">
                    <span class="rounded bg-slate-100 border border-slate-200 px-2 py-0.5 text-2xs font-bold text-slate-600 uppercase tracking-widest">
                      {p.division}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-500">{p.completion_date ? new Date(p.completion_date).toLocaleDateString() : 'N/A'}</td>
                  <td class="px-6 py-4 text-center">
                    {p.featured ? (
                      <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-2xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        ⭐ Featured
                      </span>
                    ) : (
                      <span class="text-slate-300 text-xs">—</span>
                    )}
                  </td>
                  <td class="px-6 py-4 text-center">
                    <span class={`rounded px-2 py-0.5 text-2xs font-bold uppercase tracking-wider ${
                      p.status === 'active' ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' :
                      'bg-slate-100 text-slate-600 border border-slate-200'
                    }`}>
                      {p.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-3">
                      <button 
                        class="edit-btn text-cyan-600 hover:text-cyan-800 focus:outline-none transition-colors"
                        data-project={JSON.stringify(p)}
                        title="Edit Project"
                      >
                        <Edit class="h-4 w-4" />
                      </button>
                      <button 
                        class="delete-btn text-rose-500 hover:text-rose-700 focus:outline-none transition-colors"
                        data-id={p.id}
                        title="Delete Project"
                      >
                        <Trash class="h-4 w-4" />
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('admin-search-projects') as HTMLInputElement | null;
    const rows = document.querySelectorAll('.admin-project-row');

    searchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        if (name.includes(query)) {
          (row as HTMLElement).classList.remove('hidden');
        } else {
          (row as HTMLElement).classList.add('hidden');
        }
      });
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const p = JSON.parse((e.currentTarget as HTMLElement).getAttribute('data-project') || '{}');
        document.dispatchEvent(new CustomEvent('open-project-modal', { detail: { project: p } }));
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('Are you sure you want to delete this project?')) return;
        
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        const target = e.currentTarget as HTMLButtonElement;
        target.disabled = true;

        try {
          const res = await fetch(`/api/projects/${id}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete project');
          }
        } catch (err) {
          alert('Error deleting project');
        } finally {
          target.disabled = false;
        }
      });
    });
  </script>
</DashboardLayout>
