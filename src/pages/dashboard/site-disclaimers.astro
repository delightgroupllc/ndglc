---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PreviewPanel from '../../components/ui/PreviewPanel.astro';
import { query } from '../../lib/db';
import { BookOpen, Edit, PlusCircle, X } from '@lucide/astro';

let artifacts: any[] = [];
try {
  const res = await query('SELECT * FROM legal_artifacts ORDER BY type DESC, identifier ASC');
  artifacts = res.rows;
} catch (e) {
  console.error("DB Offline", e);
}

function getCategory(identifier: string, division: string | null): 'page1' | 'tos_dtl' | 'tos_dgs' | 'website' {
  const id = (identifier || '').toLowerCase().trim();
  if (
    id.includes('privacy-policy') || 
    id.includes('cookie-policy') || 
    id.includes('terms-of-use') || 
    id.includes('terms-and-conditions')
  ) {
    return 'website';
  }
  if (
    id === 'disclaimer' || 
    id === 'payment-terms-30d' || 
    id === 'warranty-liability' || 
    id === 'delivery-terms' ||
    id === 'delivery-note-disclaimer'
  ) {
    return 'page1';
  }
  if (division === 'dgs') {
    return 'tos_dgs';
  }
  return 'tos_dtl';
}
---

<DashboardLayout title="Site Disclaimers | Delight Group LLC" activeItem="site-disclaimers">
  <div class="h-screen flex overflow-hidden">
    <!-- Editor Column -->
    <div class="w-2/5 shrink-0 flex flex-col border-r border-slate-200 bg-slate-50 overflow-y-auto">
      <div class="sticky top-0 z-10 bg-white border-b border-slate-100 px-5 py-3 flex items-center justify-between shrink-0">
        <div>
          <h1 class="text-sm font-black text-slate-900 tracking-tight">Legal Artifacts</h1>
          <p class="text-[10px] text-slate-400 font-medium">Manage public disclaimers and order clauses.</p>
        </div>
        <button type="button"
          onclick="document.dispatchEvent(new CustomEvent('open-artifact-modal', { detail: { artifact: null } }))"
          class="inline-flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-all">
          <PlusCircle class="w-3.5 h-3.5" /> New
        </button>
      </div>
      <div class="p-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black font-display text-slate-900 tracking-tight uppercase">Legal Artifacts</h1>
        <p class="text-slate-500 mt-1">Manage public disclaimers and order clauses.</p>
      </div>
      <button 
        type="button"
        onclick="document.dispatchEvent(new CustomEvent('open-artifact-modal', { detail: { artifact: null } }))"
        class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-xl text-sm font-bold transition-all shadow-sm"
      >
        <PlusCircle class="w-4 h-4" />
        New Artifact
      </button>
    </div>

    <div class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-b border-slate-200 pb-3">
      <div class="relative flex-grow max-w-xs">
        <input 
          type="text" 
          id="disclaimer-search"
          placeholder="Search disclaimers..." 
          class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-3 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-blue-500/50"
        />
      </div>
      <div class="flex items-center gap-2">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Sort By</label>
        <select id="sort-selector" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500/20">
          <option value="atoz">A to Z</option>
          <option value="ztoa">Z to A</option>
          <option value="latest">Latest Updated</option>
        </select>
      </div>
    </div>

    <!-- Category Tabs Navigation -->
    <div class="flex border-b border-slate-200 mt-6 gap-6">
      <button 
        type="button"
        onclick="setActiveTab('page1')"
        id="tab-page1"
        class="tab-btn pb-3 px-1 text-sm font-bold border-b-2 border-blue-600 text-blue-600 transition-all focus:outline-none"
      >
        Page 1 (Invoice Disclaimers)
      </button>
      <button 
        type="button"
        onclick="setActiveTab('tos_dtl')"
        id="tab-tos_dtl"
        class="tab-btn pb-3 px-1 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-all focus:outline-none"
      >
        DTL Terms of Sale (TOS)
      </button>
      <button 
        type="button"
        onclick="setActiveTab('tos_dgs')"
        id="tab-tos_dgs"
        class="tab-btn pb-3 px-1 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-all focus:outline-none"
      >
        DGS Terms of Sale (TOS)
      </button>
      <button 
        type="button"
        onclick="setActiveTab('website')"
        id="tab-website"
        class="tab-btn pb-3 px-1 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-all focus:outline-none"
      >
        Website Disclaimers
      </button>
    </div>

    <div id="artifacts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      {artifacts.map((artifact) => (
        <div class="artifact-card bg-white rounded-xl border border-slate-200 p-6 flex flex-col justify-between hover:shadow-md transition-shadow group" data-title={artifact.title} data-updated={new Date(artifact.updated_at || artifact.created_at || Date.now()).getTime()} data-category={getCategory(artifact.identifier, artifact.division)} data-division={artifact.division || ''}>
          <div class="space-y-4">
            <span class="inline-block px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 text-[10px] font-black uppercase tracking-wider">
              {artifact.type === 'both' ? 'Public & Order Clause' : artifact.type === 'public' ? 'Public Artifact' : 'Order Clause'}
              {artifact.division ? ` • ${artifact.division.toUpperCase()}` : ''}
            </span>
            <div>
              <h3 class="text-sm font-black text-slate-900 uppercase tracking-wide">{artifact.title}</h3>
              <p class="text-slate-500 text-sm mt-2 line-clamp-2">{artifact.content}</p>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="flex flex-col">
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Identifier</span>
              <code class="text-xs font-bold text-slate-700 mt-0.5">{artifact.identifier}</code>
            </div>
            <button 
              type="button"
              onclick={`document.dispatchEvent(new CustomEvent('open-artifact-modal', { detail: { artifact: ${JSON.stringify(artifact)} } }))`}
              class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
            >
              <Edit class="w-4 h-4" />
            </button>
          </div>
        </div>
      ))}
    </div>
      </div>
    </div><!-- /editor -->

    <!-- Preview Column -->
    <div class="flex-1 overflow-hidden p-3">
      <PreviewPanel src="/terms" iframeId="disclaimer-preview-iframe" refreshBtnId="btn-refresh-disclaimer-preview" />
    </div>

  </div>
  <div id="artifact-modal-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-2xl overflow-hidden transform transition-all">
      <div class="p-6 border-b border-slate-200 flex justify-between items-center bg-slate-50">
        <h3 id="modal-title" class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <BookOpen class="w-5 h-5 text-blue-600" />
          <span>Edit Artifact</span>
        </h3>
        <button id="close-modal" class="text-slate-400 hover:text-slate-600 transition-colors">
          <X class="w-5 h-5" />
        </button>
      </div>
      
      <div class="p-6">
        <form id="artifact-form" class="space-y-6">
          <input type="hidden" id="artifact-id" name="id" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Title</label>
              <input type="text" id="artifact-title" name="title" required class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-900 focus:bg-white focus:border-blue-500 focus:outline-none transition-colors" />
            </div>
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Division</label>
              <select id="artifact-division" name="division" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-700 focus:bg-white focus:border-blue-500 focus:outline-none transition-colors">
                <option value="">Universal / None</option>
                <option value="dtl">Delight Technical Lighting (DTL)</option>
                <option value="dgs">Delight Greenscapes (DGS)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-1.5 flex flex-col justify-end">
              <label class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Visibility / Type</label>
              <div class="flex items-center gap-6 h-[42px] px-1">
                <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="artifact-type-public" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                  Public Pages
                </label>
                <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="artifact-type-order" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                  Order Clause
                </label>
              </div>
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Identifier (Used in Code)</label>
            <input type="text" id="artifact-identifier" name="identifier" required class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-900 focus:bg-white focus:border-blue-500 focus:outline-none transition-colors font-mono" />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Content</label>
            <textarea id="artifact-content" name="content" required rows="6" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-900 focus:bg-white focus:border-blue-500 focus:outline-none transition-colors"></textarea>
          </div>

          <div id="form-msg" class="hidden p-3 rounded-lg text-sm font-semibold"></div>

          <div class="pt-2 flex justify-between gap-4">
            <button type="button" id="delete-btn" class="hidden items-center gap-2 text-red-600 hover:bg-red-50 px-4 py-2.5 rounded-xl text-sm font-bold transition-colors">
              Delete
            </button>
            <div class="flex gap-4 ml-auto">
              <button type="button" id="cancel-btn" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-2.5 rounded-xl text-sm font-bold transition-colors">
                Cancel
              </button>
              <button type="submit" id="submit-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-2.5 rounded-xl text-sm font-bold transition-colors shadow-sm">
                Save Changes
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const modal = document.getElementById('artifact-modal-backdrop');
  const form = document.getElementById('artifact-form') as HTMLFormElement;
  const msg = document.getElementById('form-msg');
  
  const closeModal = () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    form?.reset();
    if (msg) msg.classList.add('hidden');
  };

  document.getElementById('close-modal')?.addEventListener('click', closeModal);
  document.getElementById('cancel-btn')?.addEventListener('click', closeModal);

  document.addEventListener('open-artifact-modal', ((e: CustomEvent) => {
    const art = e.detail?.artifact;
    const titleEl = document.getElementById('modal-title');
    const deleteBtn = document.getElementById('delete-btn');
    
    if (art) {
      if (titleEl) titleEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg> Edit Artifact';
      (document.getElementById('artifact-id') as HTMLInputElement).value = art.id;
      (document.getElementById('artifact-title') as HTMLInputElement).value = art.title;
      
      const isPublic = art.type === 'public' || art.type === 'both';
      const isOrder = art.type === 'order_clause' || art.type === 'both';
      (document.getElementById('artifact-type-public') as HTMLInputElement).checked = isPublic;
      (document.getElementById('artifact-type-order') as HTMLInputElement).checked = isOrder;

      (document.getElementById('artifact-identifier') as HTMLInputElement).value = art.identifier;
      (document.getElementById('artifact-content') as HTMLTextAreaElement).value = art.content;
      (document.getElementById('artifact-division') as HTMLSelectElement).value = art.division || '';
      deleteBtn?.classList.remove('hidden');
      deleteBtn?.classList.add('flex');
    } else {
      if (titleEl) titleEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M12 5v14"/><path d="M5 12h14"/></svg> New Artifact';
      (document.getElementById('artifact-type-public') as HTMLInputElement).checked = true;
      (document.getElementById('artifact-type-order') as HTMLInputElement).checked = false;
      (document.getElementById('artifact-division') as HTMLSelectElement).value = '';
      deleteBtn?.classList.add('hidden');
      deleteBtn?.classList.remove('flex');
    }
    
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }) as EventListener);

  document.getElementById('delete-btn')?.addEventListener('click', async () => {
    if (!confirm('Are you sure you want to delete this artifact?')) return;
    const id = (document.getElementById('artifact-id') as HTMLInputElement).value;
    try {
      const res = await fetch(`/api/legal/${id}`, { method: 'DELETE' });
      if (res.ok) window.location.reload();
      else throw new Error('Failed to delete');
    } catch (e: any) {
      alert(e.message);
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    if (!btn || !msg) return;

    btn.setAttribute('disabled', 'true');
    btn.textContent = 'Saving...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const id = data.id as string;
    const isEdit = !!id;

    const isPublic = (document.getElementById('artifact-type-public') as HTMLInputElement).checked;
    const isOrder = (document.getElementById('artifact-type-order') as HTMLInputElement).checked;
    let typeVal = 'public';
    if (isPublic && isOrder) typeVal = 'both';
    else if (isPublic) typeVal = 'public';
    else if (isOrder) typeVal = 'order_clause';
    
    try {
      const res = await fetch(isEdit ? `/api/legal/${id}` : '/api/legal', {
        method: isEdit ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: data.title,
          type: typeVal,
          identifier: data.identifier,
          content: data.content,
          division: data.division || null
        })
      });

      const result = await res.json();
      if (!res.ok) throw new Error(result.error || 'Failed to save');

      msg.className = 'p-3 rounded-lg text-sm font-semibold bg-green-50 text-green-700 border border-green-200 block';
      msg.textContent = 'Artifact saved successfully!';
      setTimeout(() => window.location.reload(), 800);
    } catch (err: any) {
      msg.className = 'p-3 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-200 block';
      msg.textContent = err.message || 'Error saving artifact';
      btn.removeAttribute('disabled');
      btn.textContent = 'Save Changes';
    }
  });

  // Client-side Sorting logic
  const sortSelector = document.getElementById('sort-selector') as HTMLSelectElement;
  const grid = document.getElementById('artifacts-grid');

  const sortCards = () => {
    if (!grid || !sortSelector) return;
    const cards = Array.from(grid.querySelectorAll('.artifact-card'));
    const val = sortSelector.value;

    cards.sort((a, b) => {
      if (val === 'atoz') {
        const titleA = a.getAttribute('data-title') || '';
        const titleB = b.getAttribute('data-title') || '';
        return titleA.localeCompare(titleB);
      } else if (val === 'ztoa') {
        const titleA = a.getAttribute('data-title') || '';
        const titleB = b.getAttribute('data-title') || '';
        return titleB.localeCompare(titleA);
      } else {
        // latest updated
        const timeA = parseInt(a.getAttribute('data-updated') || '0');
        const timeB = parseInt(b.getAttribute('data-updated') || '0');
        return timeB - timeA;
      }
    });

    // Re-append in sorted order
    cards.forEach(card => grid.appendChild(card));
  };

  sortSelector?.addEventListener('change', sortCards);

  // Client-side Search and Tab Switcher
  const tabButtons = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.artifact-card');
  const searchInput = document.getElementById('disclaimer-search') as HTMLInputElement | null;

  let currentTab = 'page1';

  const filterAndSortCards = () => {
    const query = searchInput?.value.toLowerCase() || '';
    cards.forEach(card => {
      const cat = card.getAttribute('data-category');
      const title = (card.getAttribute('data-title') || '').toLowerCase();
      const description = (card.querySelector('p')?.textContent || '').toLowerCase();
      const identifier = (card.querySelector('code')?.textContent || '').toLowerCase();

      const matchesTab = cat === currentTab;
      const matchesQuery = title.includes(query) || description.includes(query) || identifier.includes(query);

      if (matchesTab && matchesQuery) {
        card.classList.remove('hidden');
        card.classList.add('flex');
      } else {
        card.classList.remove('flex');
        card.classList.add('hidden');
      }
    });
  };

  (window as any).setActiveTab = (tabId: string) => {
    currentTab = tabId;
    // Update tab button styles
    tabButtons.forEach(btn => {
      if (btn.id === `tab-${tabId}`) {
        btn.classList.add('border-blue-600', 'text-blue-600', 'font-bold');
        btn.classList.remove('border-transparent', 'text-slate-500', 'font-semibold');
      } else {
        btn.classList.remove('border-blue-600', 'text-blue-600', 'font-bold');
        btn.classList.add('border-transparent', 'text-slate-500', 'font-semibold');
      }
    });

    filterAndSortCards();
  };

  searchInput?.addEventListener('input', filterAndSortCards);

  // Set initial state
  (window as any).setActiveTab('page1');
</script>
</DashboardLayout>
