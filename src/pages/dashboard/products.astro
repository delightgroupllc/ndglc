---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { Package, Search, PlusCircle, Trash, ExternalLink, Settings, AlertTriangle, Eye, ToggleLeft, Tag, CheckSquare, List, LayoutGrid } from 'lucide-astro';

let products: any[] = [];
let categories: any[] = [];
let divisions: any[] = [];
let rooms: any[] = [];
let dbConnected = true;
import ProductForm from '../../components/forms/ProductForm.astro';
import BulkProductForm from '../../components/forms/BulkProductForm.astro';
import AIScanModal from '../../components/forms/AIScanModal.astro';

try {
  const prodRes = await query(
    `SELECT p.*, c.name as category_name, c.slug as category_slug, d.name as division_name, d.slug as division_slug,
       (SELECT url FROM product_images WHERE product_id = p.id AND is_primary = true LIMIT 1) as image_url
     FROM products p
     JOIN categories c ON c.id = p.category_id
     JOIN divisions d ON d.id = p.division_id
     ORDER BY p.created_at DESC`
  );
  products = prodRes.rows;

  const catRes = await query('SELECT * FROM categories ORDER BY name ASC');
  categories = catRes.rows;

  const divRes = await query('SELECT * FROM divisions ORDER BY name ASC');
  divisions = divRes.rows;
  // Load configurable rooms from settings
  try {
    const sres = await query('SELECT value FROM settings WHERE key = $1', ['rooms']);
    if (sres.rows.length > 0) {
      try {
        const parsed = JSON.parse(sres.rows[0].value);
        // parsed can be array of strings or array of {name, iconUrl}
        rooms = Array.isArray(parsed) ? parsed : [];
      } catch {
        rooms = [];
      }
    }
  } catch (e) {
    console.warn('Unable to load rooms setting:', e?.message || e);
  }
} catch (err: any) {
  console.warn('Database offline, running mock products and select lists:', err.message);
  dbConnected = false;

  categories = [
    { id: 'cat-1', name: 'Valves & Actuators', slug: 'valves-actuators' },
    { id: 'cat-2', name: 'Industrial Pumps', slug: 'industrial-pumps' },
    { id: 'cat-3', name: 'Cloud Infrastructure', slug: 'cloud-infrastructure' },
    { id: 'cat-4', name: 'Cyber Security', slug: 'cyber-security' }
  ];

  divisions = [
    { id: 'div-1', name: 'Division DTL', slug: 'dtl' },
    { id: 'div-2', name: 'Division DGS', slug: 'dgs' }
  ];

  rooms = ['Outdoor','Living room','Dining room','Kitchen','Bedroom','Bathroom'];

  products = [
    { id: 'p1', name: 'HP-100 High-Pressure Stainless Ball Valve', sku: 'SKU-DTL-VALVE-001', slug: 'hp100-ball-valve', category_id: 'cat-1', division_id: 'div-1', category_name: 'Valves & Actuators', category_slug: 'valves-actuators', division_name: 'Division DTL', division_slug: 'dtl', status: 'active', featured: true, created_at: new Date().toISOString() },
    { id: 'p2', name: 'CPX-500 Heavy-Duty Centrifugal Pump', sku: 'SKU-DTL-PUMP-002', slug: 'cpx500-centrifugal-pump', category_id: 'cat-2', division_id: 'div-1', category_name: 'Industrial Pumps', category_slug: 'industrial-pumps', division_name: 'Division DTL', division_slug: 'dtl', status: 'active', featured: false, created_at: new Date().toISOString() },
    { id: 'p3', name: 'Vortex Cloud-Native Backup Storage Suite', sku: 'SKU-DGS-CLOUD-001', slug: 'vortex-cloud-backup', category_id: 'cat-3', division_id: 'div-2', category_name: 'Cloud Infrastructure', category_slug: 'cloud-infrastructure', division_name: 'Division DGS', division_slug: 'dgs', status: 'active', featured: true, created_at: new Date().toISOString() },
    { id: 'p4', name: 'IronWall Industrial Firewall Appliance v4', sku: 'SKU-DGS-SEC-002', slug: 'ironwall-firewall-v4', category_id: 'cat-4', division_id: 'div-2', category_name: 'Cyber Security', category_slug: 'cyber-security', division_name: 'Division DGS', division_slug: 'dgs', status: 'active', featured: true, created_at: new Date().toISOString() }
  ];
}
---

<DashboardLayout title="Products Catalog" activeItem="products">

  <div class="space-y-6 max-w-7xl mx-auto">

    <!-- Header Bar & Advanced Filters -->
    <div class="flex flex-col gap-4 border-b border-slate-200 pb-5">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2 shrink-0">
          <Package class="h-5 w-5 text-cyan-600" />
          Products Catalog
        </h2>
        <div class="flex gap-2 flex-wrap shrink-0">
          <!-- Mass rename trigger -->
          <button
            type="button"
            id="mass-rename-btn"
            class="hidden inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <Tag class="h-4 w-4" />
            Rename Selected (<span id="selected-count">0</span>)
          </button>
          <button
            type="button"
            onclick="document.dispatchEvent(new CustomEvent('open-ai-modal'))"
            class="inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            AI Scan
          </button>
          <button
            type="button"
            onclick="document.dispatchEvent(new CustomEvent('open-bulk-modal'))"
            class="inline-flex items-center justify-center gap-2 bg-slate-700 hover:bg-slate-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <PlusCircle class="h-4 w-4" />
            Bulk Add
          </button>
          <button
            type="button"
            id="open-product-modal-btn"
            class="inline-flex items-center justify-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <PlusCircle class="h-4 w-4" />
            Add Product
          </button>
        </div>
      </div>

      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 bg-slate-50 border border-slate-200 rounded-xl p-3">
        <div class="flex flex-wrap items-center gap-2 flex-grow">
          <div class="relative flex-grow max-w-xs">
            <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" />
            <input
              type="text"
              id="admin-search-products"
              placeholder="Search by SKU, name, spec..."
              class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
            />
          </div>
          <select id="filter-product-division" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
            <option value="">All Divisions</option>
            {divisions.map(d => <option value={d.id}>{d.name}</option>)}
          </select>
          <select id="filter-product-category" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
            <option value="">All Categories</option>
            {categories.map(c => <option value={c.id}>{c.name}</option>)}
          </select>
          <select id="filter-product-status" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
            <option value="">All Statuses</option>
            <option value="active">Active</option>
            <option value="draft">Draft</option>
            <option value="inactive">Inactive</option>
          </select>
          <select id="sort-products" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
            <option value="newest">Newest Added</option>
            <option value="oldest">Oldest Added</option>
            <option value="name-asc">Name: A to Z</option>
            <option value="name-desc">Name: Z to A</option>
            <option value="sku-asc">SKU: A to Z</option>
          </select>
        </div>

        <div class="flex items-center gap-1 border border-slate-200 bg-white rounded-lg p-0.5 self-end md:self-auto">
          <button type="button" id="view-mode-table" class="view-mode-btn p-1.5 rounded bg-cyan-50 text-cyan-600 transition-colors" title="Table List View">
            <List class="h-4 w-4" />
          </button>
          <button type="button" id="view-mode-grid" class="view-mode-btn p-1.5 rounded text-slate-400 hover:text-slate-600 transition-colors" title="Card Grid View">
            <LayoutGrid class="h-4 w-4" />
          </button>
        </div>
      </div>
    </div>

    <!-- View 1: Products Table -->
    <div id="products-table-view" class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
              <th class="px-4 py-4 font-semibold w-8">
                <input type="checkbox" id="select-all-products" class="rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" title="Select all" />
              </th>
              <th class="px-4 py-4 font-semibold">SKU / Product</th>
              <th class="px-4 py-4 font-semibold">Division</th>
              <th class="px-4 py-4 font-semibold">Category</th>
              <th class="px-4 py-4 font-semibold text-center">Status</th>
              <th class="px-4 py-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="admin-products-table">
            {products.map(p => (
              <tr
                class="admin-product-row border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors"
                data-id={p.id}
                data-name={p.name}
                data-sku={p.sku}
                data-slug={p.slug}
                data-category={p.category_id}
                data-division={p.division_id}
                data-desc={p.description || ''}
                data-ideal-room={p.ideal_room || ''}
                data-status={p.status}
                data-featured={p.featured ? 'true' : 'false'}
                data-specs={typeof p.specifications === 'string' ? p.specifications : JSON.stringify(p.specifications || [])}
                data-image={p.image_url || ''}
              >
                <td class="px-4 py-3">
                  <input type="checkbox" class="product-row-check rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" data-id={p.id} data-name={p.name} />
                </td>
                <td class="px-4 py-3">
                  <div class="font-bold text-slate-900 truncate max-w-[220px]" title={p.name}>{p.name}</div>
                  <div class="text-2xs text-slate-500 mt-0.5 font-mono">{p.sku}</div>
                </td>
                <td class="px-4 py-3 text-slate-600 font-semibold">{p.division_name}</td>
                <td class="px-4 py-3 text-slate-500">{p.category_name}</td>
                <td class="px-4 py-3 text-center">
                  <span class={`rounded px-1.5 py-0.5 text-2xs font-semibold uppercase ${
                    p.status === 'active'
                      ? 'bg-emerald-500/10 text-emerald-600'
                      : p.status === 'draft' ? 'bg-slate-100 text-slate-600' : 'bg-rose-500/10 text-rose-600'
                  }`}>
                    {p.status}
                  </span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button type="button" class="edit-btn text-blue-500 hover:text-blue-600 font-semibold transition-colors">Edit</button>
                    <button type="button" class="delete-btn text-red-500 hover:text-red-600 font-semibold transition-colors">Delete</button>
                    <a href={`/${p.division_slug || 'dtl'}/${p.category_slug || ''}/${p.slug}?preview=true`} target="_blank" class="text-slate-400 hover:text-cyan-500 transition-colors" title="View">
                      <Eye class="h-4 w-4" />
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- View 2: Products Card Grid -->
    <div id="products-grid-view" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {products.map(p => (
        <div
          class="admin-product-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col relative group"
          data-id={p.id}
          data-name={p.name}
          data-sku={p.sku}
          data-slug={p.slug}
          data-category={p.category_id}
          data-division={p.division_id}
          data-ideal-room={p.ideal_room || ''}
          data-desc={p.description || ''}
          data-status={p.status}
          data-featured={p.featured ? 'true' : 'false'}
          data-specs={typeof p.specifications === 'string' ? p.specifications : JSON.stringify(p.specifications || [])}
          data-image={p.image_url || ''}
        >
          <!-- Card Checkbox -->
          <div class="absolute top-3 left-3 z-10 bg-white/90 border border-slate-200 rounded p-1 shadow-sm opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
            <input type="checkbox" class="product-row-check rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" data-id={p.id} data-name={p.name} />
          </div>

          <!-- Featured Badge -->
          {p.featured && (
            <div class="absolute top-3 right-3 z-10 bg-amber-500 text-white text-[9px] font-bold px-2 py-0.5 rounded-full shadow-sm">
              Featured
            </div>
          )}

          <!-- Card Image Thumbnail -->
          <div class="aspect-video w-full bg-slate-100 flex items-center justify-center border-b border-slate-100 overflow-hidden relative">
            <img src={p.image_url || '/noimage.jpg'} alt={p.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>

          <!-- Card Content -->
          <div class="p-4 flex-grow flex flex-col justify-between space-y-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[9px] font-bold bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded">
                  {p.division_name}
                </span>
                <span class="text-[9px] font-semibold text-slate-500">
                  {p.category_name}
                </span>
              </div>
              <h4 class="font-bold text-slate-900 text-xs line-clamp-2" title={p.name}>{p.name}</h4>
              <p class="text-[10px] font-mono text-slate-400">{p.sku}</p>
            </div>

            <div class="flex items-center justify-between border-t border-slate-100 pt-3">
              <span class={`rounded px-1.5 py-0.5 text-[10px] font-bold uppercase ${
                p.status === 'active'
                  ? 'bg-emerald-500/10 text-emerald-600'
                  : p.status === 'draft' ? 'bg-slate-100 text-slate-600' : 'bg-rose-500/10 text-rose-600'
              }`}>
                {p.status}
              </span>

              <div class="flex items-center gap-2">
                <button type="button" class="edit-btn text-blue-500 hover:text-blue-600 font-semibold text-xs transition-colors">Edit</button>
                <button type="button" class="delete-btn text-red-500 hover:text-red-600 font-semibold text-xs transition-colors">Delete</button>
                 <a href={`/${p.division_slug || 'dtl'}/${p.category_slug || ''}/${p.slug}?preview=true`} target="_blank" class="text-slate-400 hover:text-cyan-500 transition-colors" title="View">
                  <Eye class="h-4 w-4" />
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ===== Product Add/Edit Modal ===== -->
  <div id="product-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl max-h-[92vh] flex flex-col overflow-hidden">
      <div class="p-5 border-b border-slate-200 bg-slate-50 flex justify-between items-center shrink-0">
        <h3 id="product-modal-title" class="text-base font-bold text-slate-900 flex items-center gap-2">
          <PlusCircle class="h-5 w-5 text-cyan-500" />
          Add New Product
        </h3>
        <button id="close-product-modal" class="text-slate-400 hover:text-slate-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="overflow-y-auto p-6">
        {/* ProductForm expects an array of room names (strings) */}
        <ProductForm categories={categories} divisions={divisions} rooms={rooms.map(r => typeof r === 'string' ? r : (r.name || ''))} />
      </div>
    </div>
  </div>

  <!-- ===== Mass Rename Modal (Products) ===== -->
  <div id="mass-rename-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-xl overflow-hidden">
      <div class="p-5 border-b border-slate-200 bg-amber-50 flex justify-between items-center">
        <h3 class="text-base font-bold text-amber-900 flex items-center gap-2">
          <Tag class="h-5 w-5 text-amber-600" />
          Mass Rename Products
        </h3>
        <button id="close-mass-rename-modal" class="text-slate-400 hover:text-slate-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <p class="text-xs text-slate-600 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
          The following products will be renamed. Edits apply a <strong>Find & Replace</strong> across all selected product names.
        </p>
        <div id="mass-rename-product-list" class="space-y-2 max-h-40 overflow-y-auto pr-1 text-xs text-slate-700 font-medium"></div>
        <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-100">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Find (text to replace)</label>
            <input type="text" id="mass-rename-find" placeholder="e.g. HP-100" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-amber-500" />
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Replace with</label>
            <input type="text" id="mass-rename-replace" placeholder="e.g. HP-200" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-amber-500" />
          </div>
        </div>
        <p class="text-[10px] text-slate-500 italic">Leave "Replace with" blank to simply remove the found text.</p>
        <div id="mass-rename-msg" class="hidden p-3 rounded-lg text-sm font-semibold"></div>
        <button
          id="mass-rename-confirm-btn"
          class="w-full bg-amber-500 hover:bg-amber-600 text-white py-3 rounded-xl text-sm font-bold transition-colors shadow-sm"
        >
          Apply Rename to Selected Products
        </button>
      </div>
    </div>
  </div>

  <BulkProductForm />
  <AIScanModal />

  <script>
    // ============================================================
    // PRODUCT MODAL OPEN/CLOSE
    // ============================================================
    const productModal = document.getElementById('product-modal-backdrop');
    const closeProductModal = document.getElementById('close-product-modal');
    const openProductModalBtn = document.getElementById('open-product-modal-btn');
    const productModalTitle = document.getElementById('product-modal-title');

    const openModal = (editMode = false) => {
      if (!productModal) return;
      productModal.classList.remove('hidden');
      productModal.classList.add('flex');
    };

    const closeModal = () => {
      if (!productModal) return;
      productModal.classList.add('hidden');
      productModal.classList.remove('flex');
    };

    openProductModalBtn?.addEventListener('click', () => {
      // Reset form to "add" state
      (document.getElementById('product-id') as HTMLInputElement).value = '';
      document.querySelectorAll('input[name="ideal_room_check"]').forEach((checkbox) => {
        (checkbox as HTMLInputElement).checked = false;
      });
      if (productModalTitle) productModalTitle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-500"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg> Add New Product';
      (document.getElementById('product-submit-btn') as HTMLButtonElement).textContent = 'Save Product';
      openModal();
    });

    closeProductModal?.addEventListener('click', closeModal);

    // Close on backdrop click
    productModal?.addEventListener('click', (e) => {
      if (e.target === productModal) closeModal();
    });

    // ============================================================
    // SEARCH, SORT, FILTER & VIEWS
    // ============================================================
    const searchInput = document.getElementById('admin-search-products') as HTMLInputElement | null;
    const divFilterSelect = document.getElementById('filter-product-division') as HTMLSelectElement | null;
    const catFilterSelect = document.getElementById('filter-product-category') as HTMLSelectElement | null;
    const statusFilterSelect = document.getElementById('filter-product-status') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('sort-products') as HTMLSelectElement | null;

    const tableBody = document.getElementById('admin-products-table');
    const gridView = document.getElementById('products-grid-view');

    function filterAndSortProducts() {
      const q = searchInput?.value.toLowerCase().trim() || '';
      const divFilter = divFilterSelect?.value || '';
      const catFilter = catFilterSelect?.value || '';
      const statusFilter = statusFilterSelect?.value || '';
      const sortVal = sortSelect?.value || 'newest';

      // Filter Rows
      const rows = Array.from(document.querySelectorAll('.admin-product-row'));
      rows.forEach(row => {
        const name = row.getAttribute('data-name')?.toLowerCase() || '';
        const sku = row.getAttribute('data-sku')?.toLowerCase() || '';
        const desc = row.getAttribute('data-desc')?.toLowerCase() || '';
        const rowDiv = row.getAttribute('data-division') || '';
        const rowCat = row.getAttribute('data-category') || '';
        const rowStatus = row.getAttribute('data-status') || '';

        const matchesSearch = !q || name.includes(q) || sku.includes(q) || desc.includes(q);
        const matchesDiv = !divFilter || rowDiv === divFilter;
        const matchesCat = !catFilter || rowCat === catFilter;
        const matchesStatus = !statusFilter || rowStatus === statusFilter;

        if (matchesSearch && matchesDiv && matchesCat && matchesStatus) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });

      // Filter Cards
      const cards = Array.from(document.querySelectorAll('.admin-product-card'));
      cards.forEach(card => {
        const name = card.getAttribute('data-name')?.toLowerCase() || '';
        const sku = card.getAttribute('data-sku')?.toLowerCase() || '';
        const desc = card.getAttribute('data-desc')?.toLowerCase() || '';
        const cardDiv = card.getAttribute('data-division') || '';
        const cardCat = card.getAttribute('data-category') || '';
        const cardStatus = card.getAttribute('data-status') || '';

        const matchesSearch = !q || name.includes(q) || sku.includes(q) || desc.includes(q);
        const matchesDiv = !divFilter || cardDiv === divFilter;
        const matchesCat = !catFilter || cardCat === catFilter;
        const matchesStatus = !statusFilter || cardStatus === statusFilter;

        if (matchesSearch && matchesDiv && matchesCat && matchesStatus) {
          (card as HTMLElement).classList.remove('hidden');
        } else {
          (card as HTMLElement).classList.add('hidden');
        }
      });

      // Sort table rows
      const sortedRows = rows.sort((a, b) => {
        const nameA = a.getAttribute('data-name')?.toLowerCase() || '';
        const nameB = b.getAttribute('data-name')?.toLowerCase() || '';
        const skuA = a.getAttribute('data-sku')?.toLowerCase() || '';
        const skuB = b.getAttribute('data-sku')?.toLowerCase() || '';
        const idA = a.getAttribute('data-id') || '';
        const idB = b.getAttribute('data-id') || '';

        if (sortVal === 'name-asc') return nameA.localeCompare(nameB);
        if (sortVal === 'name-desc') return nameB.localeCompare(nameA);
        if (sortVal === 'sku-asc') return skuA.localeCompare(skuB);
        if (sortVal === 'newest') return idB.localeCompare(idA);
        if (sortVal === 'oldest') return idA.localeCompare(idB);
        return 0;
      });
      sortedRows.forEach(r => tableBody?.appendChild(r));

      // Sort grid cards
      const sortedCards = cards.sort((a, b) => {
        const nameA = a.getAttribute('data-name')?.toLowerCase() || '';
        const nameB = b.getAttribute('data-name')?.toLowerCase() || '';
        const skuA = a.getAttribute('data-sku')?.toLowerCase() || '';
        const skuB = b.getAttribute('data-sku')?.toLowerCase() || '';
        const idA = a.getAttribute('data-id') || '';
        const idB = b.getAttribute('data-id') || '';

        if (sortVal === 'name-asc') return nameA.localeCompare(nameB);
        if (sortVal === 'name-desc') return nameB.localeCompare(nameA);
        if (sortVal === 'sku-asc') return skuA.localeCompare(skuB);
        if (sortVal === 'newest') return idB.localeCompare(idA);
        if (sortVal === 'oldest') return idA.localeCompare(idB);
        return 0;
      });
      sortedCards.forEach(c => gridView?.appendChild(c));
    }

    searchInput?.addEventListener('input', filterAndSortProducts);
    divFilterSelect?.addEventListener('change', filterAndSortProducts);
    catFilterSelect?.addEventListener('change', filterAndSortProducts);
    statusFilterSelect?.addEventListener('change', filterAndSortProducts);
    sortSelect?.addEventListener('change', filterAndSortProducts);

    // View Switcher logic
    const tableBtn = document.getElementById('view-mode-table');
    const gridBtn = document.getElementById('view-mode-grid');
    const tableViewContainer = document.getElementById('products-table-view');
    const gridViewContainer = document.getElementById('products-grid-view');

    tableBtn?.addEventListener('click', () => {
      tableBtn.classList.add('bg-cyan-50', 'text-cyan-600');
      tableBtn.classList.remove('text-slate-400', 'hover:text-slate-600');
      gridBtn?.classList.remove('bg-cyan-50', 'text-cyan-600');
      gridBtn?.classList.add('text-slate-400', 'hover:text-slate-600');

      tableViewContainer?.classList.remove('hidden');
      gridViewContainer?.classList.add('hidden');
      localStorage.setItem('products-view-mode', 'table');
    });

    gridBtn?.addEventListener('click', () => {
      gridBtn.classList.add('bg-cyan-50', 'text-cyan-600');
      gridBtn.classList.remove('text-slate-400', 'hover:text-slate-600');
      tableBtn?.classList.remove('bg-cyan-50', 'text-cyan-600');
      tableBtn?.classList.add('text-slate-400', 'hover:text-slate-600');

      gridViewContainer?.classList.remove('hidden');
      tableViewContainer?.classList.add('hidden');
      localStorage.setItem('products-view-mode', 'grid');
    });

    // Restore saved view mode
    const savedView = localStorage.getItem('products-view-mode') || 'table';
    if (savedView === 'grid') {
      gridBtn?.click();
    } else {
      tableBtn?.click();
    }

    // ============================================================
    // MASS SELECTOR
    // ============================================================
    const selectAll = document.getElementById('select-all-products') as HTMLInputElement;
    const massRenameBtn = document.getElementById('mass-rename-btn');
    const selectedCountEl = document.getElementById('selected-count');
    let selectedIds: string[] = [];
    let selectedNames: { id: string; name: string }[] = [];

    const updateSelectionUI = () => {
      const checks = document.querySelectorAll('.product-row-check:checked');
      const uniqueChecks = new Map();
      checks.forEach(c => {
        const id = c.getAttribute('data-id');
        if (id && !uniqueChecks.has(id)) {
          uniqueChecks.set(id, c);
        }
      });

      selectedIds = Array.from(uniqueChecks.keys());
      selectedNames = Array.from(uniqueChecks.values()).map(c => ({ id: c.getAttribute('data-id') || '', name: c.getAttribute('data-name') || '' }));

      if (selectedCountEl) selectedCountEl.textContent = String(selectedIds.length);
      if (massRenameBtn) {
        if (selectedIds.length > 0) {
          massRenameBtn.classList.remove('hidden');
          massRenameBtn.classList.add('inline-flex');
        } else {
          massRenameBtn.classList.add('hidden');
          massRenameBtn.classList.remove('inline-flex');
        }
      }
    };

    selectAll?.addEventListener('change', () => {
      document.querySelectorAll('.product-row-check').forEach((cb: any) => {
        cb.checked = selectAll.checked;
      });
      updateSelectionUI();
    });

    // Sync card and table row checkbox clicks
    document.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target && target.classList.contains('product-row-check')) {
        const id = target.getAttribute('data-id');
        const checked = target.checked;
        document.querySelectorAll(`.product-row-check[data-id="${id}"]`).forEach((cb: any) => {
          cb.checked = checked;
        });
        updateSelectionUI();
      }
    });

    // ============================================================
    // MASS RENAME MODAL
    // ============================================================
    const massRenameModal = document.getElementById('mass-rename-modal');
    const closeMassRenameModal = document.getElementById('close-mass-rename-modal');
    const massRenameProductList = document.getElementById('mass-rename-product-list');
    const massRenameFindInput = document.getElementById('mass-rename-find') as HTMLInputElement;
    const massRenameReplaceInput = document.getElementById('mass-rename-replace') as HTMLInputElement;
    const massRenameConfirmBtn = document.getElementById('mass-rename-confirm-btn');
    const massRenameMsg = document.getElementById('mass-rename-msg');

    massRenameBtn?.addEventListener('click', () => {
      if (!massRenameModal || !massRenameProductList) return;
      massRenameProductList.innerHTML = selectedNames.map(s =>
        `<div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span>
          <span>${s.name}</span>
        </div>`
      ).join('');
      massRenameFindInput.value = '';
      massRenameReplaceInput.value = '';
      if (massRenameMsg) massRenameMsg.classList.add('hidden');
      massRenameModal.classList.remove('hidden');
      massRenameModal.classList.add('flex');
    });

    closeMassRenameModal?.addEventListener('click', () => {
      massRenameModal?.classList.add('hidden');
      massRenameModal?.classList.remove('flex');
    });

    massRenameModal?.addEventListener('click', (e) => {
      if (e.target === massRenameModal) {
        massRenameModal.classList.add('hidden');
        massRenameModal.classList.remove('flex');
      }
    });

    massRenameConfirmBtn?.addEventListener('click', async () => {
      const findText = massRenameFindInput.value;
      const replaceText = massRenameReplaceInput.value;
      if (!findText) {
        alert('Please enter text to find.');
        return;
      }

      const originalText = massRenameConfirmBtn.textContent;
      massRenameConfirmBtn.textContent = 'Renaming...';
      massRenameConfirmBtn.setAttribute('disabled', 'true');

      let successCount = 0;
      let failCount = 0;

      for (const item of selectedNames) {
        const newName = item.name.split(findText).join(replaceText);
        if (newName === item.name) continue; // No change

        // Get the row data to build the full update payload
        const row = document.querySelector(`[data-id="${item.id}"]`) as HTMLElement | null;
        if (!row) continue;

        const payload: any = {
          name: newName,
          sku: row.getAttribute('data-sku') || '',
          slug: row.getAttribute('data-slug') || '',
          category_id: row.getAttribute('data-category') || '',
          division_id: row.getAttribute('data-division') || '',
          description: row.getAttribute('data-desc') || '',
          status: row.getAttribute('data-status') || 'active',
          featured: row.getAttribute('data-featured') || 'false',
          specifications: JSON.parse(row.getAttribute('data-specs') || '[]'),
          image_url: row.getAttribute('data-image') || null
        };

        try {
          const res = await fetch(`/api/products/${item.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (res.ok) successCount++;
          else failCount++;
        } catch (err) {
          failCount++;
        }
      }

      massRenameConfirmBtn.removeAttribute('disabled');
      massRenameConfirmBtn.textContent = originalText || 'Apply Rename';

      if (massRenameMsg) {
        massRenameMsg.classList.remove('hidden');
        if (failCount === 0) {
          massRenameMsg.className = 'p-3 rounded-lg text-sm font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
          massRenameMsg.textContent = `Successfully renamed ${successCount} product(s). Reloading...`;
          setTimeout(() => window.location.reload(), 1200);
        } else {
          massRenameMsg.className = 'p-3 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-200';
          massRenameMsg.textContent = `${successCount} renamed, ${failCount} failed.`;
        }
      }
    });

    // ============================================================
    // EDIT PRODUCT (opens modal)
    // ============================================================
    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = (e.target as HTMLElement).closest('tr') as HTMLElement | null;
        if (!row) return;

        const id = row.getAttribute('data-id');
        const name = row.getAttribute('data-name');
        const sku = row.getAttribute('data-sku');
        const slug = row.getAttribute('data-slug');
        const category_id = row.getAttribute('data-category');
        const division_id = row.getAttribute('data-division');
        const description = row.getAttribute('data-desc');
        const status = row.getAttribute('data-status');
        const featured = row.getAttribute('data-featured');
        const specs = row.getAttribute('data-specs');
        const imageUrl = row.getAttribute('data-image');

        (document.getElementById('product-id') as HTMLInputElement).value = id || '';
        (document.querySelector('input[name="name"]') as HTMLInputElement).value = name || '';
        (document.querySelector('input[name="sku"]') as HTMLInputElement).value = sku || '';
        (document.querySelector('input[name="slug"]') as HTMLInputElement).value = slug || '';
        (document.querySelector('select[name="category_id"]') as HTMLSelectElement).value = category_id || '';
        (document.querySelector('select[name="division_id"]') as HTMLSelectElement).value = division_id || '';
        (document.querySelector('textarea[name="description"]') as HTMLTextAreaElement).value = description || '';
        (document.querySelector('select[name="status"]') as HTMLSelectElement).value = status || 'active';
        (document.querySelector('select[name="featured"]') as HTMLSelectElement).value = featured || 'false';
        const idealRooms = (row.getAttribute('data-ideal-room') || '').split(',').map((s: string) => s.trim());
        document.querySelectorAll('input[name="ideal_room_check"]').forEach((checkbox) => {
          (checkbox as HTMLInputElement).checked = idealRooms.includes((checkbox as HTMLInputElement).value);
        });

        const imgUrlInput = document.getElementById('product-image-url') as HTMLInputElement | null;
        const imgPreview = document.getElementById('product-image-preview') as HTMLImageElement | null;
        if (imgUrlInput) imgUrlInput.value = imageUrl || '';
        if (imgPreview && imageUrl) imgPreview.src = imageUrl;

        const specsContainer = document.getElementById('specifications-container');
        if (specsContainer) {
          specsContainer.innerHTML = '';
          try {
            const parsedSpecs = JSON.parse(specs || '[]');
            if (parsedSpecs.length === 0) {
              specsContainer.innerHTML = `<div class="flex gap-2 spec-row"><input type="text" name="spec_key" placeholder="Key" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" /><input type="text" name="spec_value" placeholder="Value" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" /><button type="button" class="remove-spec-btn text-red-500 font-bold px-2">&times;</button></div>`;
            } else {
              parsedSpecs.forEach((s: any) => {
                specsContainer.innerHTML += `<div class="flex gap-2 spec-row mt-2"><input type="text" name="spec_key" value="${s.key}" placeholder="Key" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" /><input type="text" name="spec_value" value="${s.value}" placeholder="Value" class="w-1/2 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900" /><button type="button" class="remove-spec-btn text-red-500 font-bold px-2">&times;</button></div>`;
              });
            }
          } catch(e) {}
        }

        if (productModalTitle) productModalTitle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit Product';
        (document.getElementById('product-submit-btn') as HTMLButtonElement).textContent = 'Update Product';
        openModal(true);
      });
    });

    // ============================================================
    // DELETE PRODUCT
    // ============================================================
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('Are you sure you want to delete this product?')) return;
        const row = (e.target as HTMLElement).closest('tr');
        const id = row?.getAttribute('data-id');
        if (!id) return;

        try {
          const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
          if (res.ok) {
            row?.remove();
          } else {
            alert('Failed to delete product.');
          }
        } catch (err) {
          alert('Error deleting product.');
        }
      });
    });
  </script>
</DashboardLayout>
