---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DownloadForm from '../../components/forms/DownloadForm.astro';
import { query } from '../../lib/db';
import { DownloadCloud, PlusCircle, Search, Save, AlertTriangle, ShieldCheck, Trash, Edit } from '@lucide/astro';

let googleDriveLink = "";
let downloadsSetup: any = null;
let downloads: any[] = [];
let dbConnected = true;

try {
  const res = await query('SELECT * FROM downloads ORDER BY created_at DESC');
  downloads = res.rows;

  const setupRes = await query("SELECT value FROM settings WHERE key = 'downloads_setup'");
  if (setupRes.rows.length > 0) {
    try {
      downloadsSetup = JSON.parse(setupRes.rows[0].value);
      googleDriveLink = downloadsSetup.googleDriveLink || "";
    } catch {}
  }
} catch (err: any) {
  console.warn('Database offline, running mock downloads manager:', err.message);
  dbConnected = false;

  downloads = [
    { id: 'd1', title: 'NDGLC Division DTL - Main Valve & Fittings Catalog 2026', url: '#', type: 'catalog', division: 'dtl', file_size: '19 MB', status: 'active' },
    { id: 'd2', title: 'HP-100 High-Pressure Stainless Ball Valve Specification Sheet', url: '#', type: 'datasheet', division: 'dtl', file_size: '3 MB', status: 'active' },
    { id: 'd3', title: 'Vortex Backup Cloud Telemetry Sync Broadsheet', url: '#', type: 'datasheet', division: 'dgs', file_size: '1.2 MB', status: 'hidden' },
    { id: 'd4', title: 'NDGLC Group - B2B VIP Procurement & Pricing Guide', url: '#', type: 'pdf', division: 'dtl', file_size: '4.5 MB', status: 'archived' }
  ];
}
---

<DashboardLayout title="Downloads Hub" activeItem="downloads">

  <DownloadForm categories={[]} />

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL is Offline</span>: Telemetry displays simulated downloads catalog.
      </div>
    </div>
  )}

  <div class="space-y-6 p-6 lg:p-8">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div class="relative flex-grow max-w-md">
        <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
        <input 
          type="text" 
          id="admin-search-downloads"
          placeholder="Filter catalog attachments..." 
          class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
        />
      </div>
      <div id="downloads-setup-data" data-setup={JSON.stringify(downloadsSetup || {})} class="hidden"></div>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="btn-configure-drive"
          class="inline-flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          Configure Drive Link
        </button>
        {googleDriveLink && (
          <a 
            href={googleDriveLink} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-750 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <DownloadCloud class="h-4 w-4" />
            Open Google Drive
          </a>
        )}
        <button 
          type="button" 
          onclick="document.dispatchEvent(new CustomEvent('open-download-modal', { detail: { download: null } }))"
          class="inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
        >
          <PlusCircle class="h-4 w-4" />
          Register Resource
        </button>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
            <th class="px-6 py-4 font-semibold">Attachment Title</th>
            <th class="px-6 py-4 font-semibold">Division</th>
            <th class="px-6 py-4 font-semibold text-center">Type & Size</th>
            <th class="px-6 py-4 font-semibold text-center">Status</th>
            <th class="px-6 py-4 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="admin-downloads-table">
          {downloads.map(d => {
            return (
              <tr class="admin-download-row border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors" data-name={d.title.toLowerCase()}>
                <td class="px-6 py-4 font-bold text-slate-900 truncate max-w-[300px]" title={d.title}>{d.title}</td>
                <td class="px-6 py-4">
                  <span class="rounded bg-slate-100 border border-slate-200 px-2 py-0.5 text-2xs font-bold text-slate-600 uppercase tracking-widest">
                    {d.division}
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <div class="flex items-center justify-center gap-2">
                    <span class="rounded bg-slate-100 border border-slate-200 px-2 py-0.5 text-2xs font-semibold text-slate-600 uppercase">
                      {d.type}
                    </span>
                    <span class="text-2xs font-bold text-slate-400">{d.file_size}</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class={`rounded px-2 py-0.5 text-2xs font-bold uppercase tracking-wider ${
                    d.status === 'active' ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' :
                    d.status === 'hidden' ? 'bg-amber-50 text-amber-600 border border-amber-200' :
                    'bg-rose-50 text-rose-600 border border-rose-200'
                  }`}>
                    {d.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-3">
                    <button 
                      class="edit-btn text-cyan-600 hover:text-cyan-800 focus:outline-none transition-colors"
                      data-download={JSON.stringify(d)}
                      title="Edit Resource"
                    >
                      <Edit class="h-4 w-4" />
                    </button>
                    <button 
                      class="delete-btn text-rose-500 hover:text-rose-700 focus:outline-none transition-colors"
                      data-id={d.id}
                      title="Delete Resource"
                    >
                      <Trash class="h-4 w-4" />
                    </button>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <!-- CONFIGURE GOOGLE DRIVE LINK MODAL -->
  <div id="drive-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 animate-fade-in">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden flex flex-col">
      <!-- Header -->
      <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-blue-500"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          Configure Google Drive Link
        </h3>
        <button id="close-drive-modal" class="text-slate-400 hover:text-slate-700 rounded-lg p-1 hover:bg-slate-100 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <!-- Body -->
      <form id="drive-link-form" class="p-6 space-y-4" onsubmit="return false;">
        <div class="space-y-1">
          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Google Drive Folder Link</label>
          <input 
            type="url" 
            id="drive-link-input" 
            placeholder="https://drive.google.com/..." 
            class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-none transition-colors" 
            value={googleDriveLink}
          />
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" id="btn-cancel-drive" class="px-4 py-2 rounded-lg text-xs font-bold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
            Cancel
          </button>
          <button type="submit" id="btn-save-drive" class="px-4 py-2 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-750 text-white transition-colors shadow-sm">
            Save Link
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('admin-search-downloads') as HTMLInputElement | null;
    const rows = document.querySelectorAll('.admin-download-row');

    searchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        if (name.includes(query)) {
          (row as HTMLElement).classList.remove('hidden');
        } else {
          (row as HTMLElement).classList.add('hidden');
        }
      });
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const d = JSON.parse((e.currentTarget as HTMLElement).getAttribute('data-download') || '{}');
        document.dispatchEvent(new CustomEvent('open-download-modal', { detail: { download: d } }));
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('Are you sure you want to delete this resource?')) return;
        
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        const target = e.currentTarget as HTMLButtonElement;
        target.disabled = true;

        try {
          const res = await fetch(`/api/downloads/${id}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete resource');
          }
        } catch (err) {
          alert('Error deleting resource');
        } finally {
          target.disabled = false;
        }
      });
    });

    // Google Drive Link Settings logic
    const driveModal = document.getElementById('drive-modal-backdrop');
    const btnConfigureDrive = document.getElementById('btn-configure-drive');
    const closeDriveModal = document.getElementById('close-drive-modal');
    const btnCancelDrive = document.getElementById('btn-cancel-drive');
    const driveForm = document.getElementById('drive-link-form') as HTMLFormElement | null;
    const driveInput = document.getElementById('drive-link-input') as HTMLInputElement | null;
    const btnSaveDrive = document.getElementById('btn-save-drive') as HTMLButtonElement | null;

    btnConfigureDrive?.addEventListener('click', () => {
      driveModal?.classList.remove('hidden');
      driveModal?.classList.add('flex');
    });

    const closeDrive = () => {
      driveModal?.classList.add('hidden');
      driveModal?.classList.remove('flex');
    };

    closeDriveModal?.addEventListener('click', closeDrive);
    btnCancelDrive?.addEventListener('click', closeDrive);
    driveModal?.addEventListener('click', (e) => { if (e.target === driveModal) closeDrive(); });

    driveForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btnSaveDrive || !driveInput) return;

      btnSaveDrive.disabled = true;
      btnSaveDrive.textContent = 'Saving...';

      try {
        const dataEl = document.getElementById('downloads-setup-data');
        const currentSetup = JSON.parse(dataEl?.getAttribute('data-setup') || '{}');
        currentSetup.googleDriveLink = driveInput.value.trim();

        const res = await fetch('/api/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            downloads_setup: JSON.stringify(currentSetup)
          })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to save Google Drive Link');
          btnSaveDrive.disabled = false;
          btnSaveDrive.textContent = 'Save Link';
        }
      } catch (err) {
        alert('Error saving Google Drive Link');
        btnSaveDrive.disabled = false;
        btnSaveDrive.textContent = 'Save Link';
      }
    });
  </script>
</DashboardLayout>
