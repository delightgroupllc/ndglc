---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PreviewPanel from '../../components/ui/PreviewPanel.astro';
import { query } from '../../lib/db';

let aboutSetup: any = {
  header: { title: '', description: '', subtitle: '', logoUrl: '' },
  definition: { title: '', description1: '', description2: '' },
  division_dtl: { title: '', desc: '' },
  division_dgs: { title: '', desc: '' },
  vision: { title: '', content: '' },
  mission: { title: '', content: '' },
  values: {
    v1: { title: '', desc: '' },
    v2: { title: '', desc: '' },
    v3: { title: '', desc: '' },
    v4: { title: '', desc: '' }
  },
  testimonials: {
    t1: { quote: '', author: '', company: '' },
    t2: { quote: '', author: '', company: '' },
    t3: { quote: '', author: '', company: '' }
  },
  leadership: { title: '', subtitle: '', description1: '', description2: '', authorTitle: '', authorCompany: '', imageUrl: '' }
};

try {
  const res = await query("SELECT value FROM settings WHERE key = 'about_setup'");
  if (res.rows.length > 0) {
    aboutSetup = { ...aboutSetup, ...JSON.parse(res.rows[0].value) };
  }
} catch (err: any) {
  console.warn('DB offline or settings missing:', err?.message || err);
}
---

<DashboardLayout title="About Us Setup" activeItem="about-setup">
  <div class="h-screen flex overflow-hidden">
    <!-- Editor Column -->
    <div class="w-[520px] shrink-0 flex flex-col border-r border-slate-200 bg-white overflow-y-auto">
      <div class="sticky top-0 z-10 bg-white border-b border-slate-100 px-5 py-3 flex items-center justify-between shrink-0">
        <div>
          <h1 class="text-sm font-black text-slate-900 tracking-tight">About Us Setup</h1>
          <p class="text-[10px] text-slate-400 font-medium">History, values, testimonials, leadership.</p>
        </div>
        <div class="flex items-center gap-2">
          <div id="save-msg" class="hidden text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 rounded-md px-2 py-1"></div>
          <button id="save-about" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-1.5 rounded-lg text-xs font-bold transition-all">Save</button>
        </div>
      </div>

    <form id="about-form" class="p-4 space-y-4 flex-1">
      <!-- HEADER -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
          <div class="w-1.5 h-6 bg-indigo-600 rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Page Header</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="text-xs font-medium text-slate-600">Supertitle</label>
            <input name="header_subtitle" value={aboutSetup.header?.subtitle || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-indigo-400" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-600">Main Title</label>
            <input name="header_title" value={aboutSetup.header?.title || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-indigo-400" />
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Short Description</label>
            <textarea name="header_description" rows="2" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-indigo-400">{aboutSetup.header?.description || ''}</textarea>
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Large Logo URL</label>
            <input name="header_logoUrl" value={aboutSetup.header?.logoUrl || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-indigo-400" />
          </div>
        </div>
      </div>

      <!-- REDEFINING SUPPLY DEFINITION -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
          <div class="w-1.5 h-6 bg-teal-500 rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Philosophy & Description</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Philosophy Title / Quote</label>
            <input name="def_title" value={aboutSetup.definition?.title || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-400" />
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Paragraph 1</label>
            <textarea name="def_desc1" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-400">{aboutSetup.definition?.description1 || ''}</textarea>
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Paragraph 2</label>
            <textarea name="def_desc2" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-400">{aboutSetup.definition?.description2 || ''}</textarea>
          </div>
        </div>
      </div>

      <!-- SPECIALIST DIVISIONS OVERVIEW -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
          <div class="w-1.5 h-6 bg-amber-500 rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Divisions Overview (About Page)</h2>
        </div>
        <div class="p-6 space-y-6">
          <div>
            <h3 class="text-xs font-black text-slate-800 uppercase tracking-wide mb-2">Technical Lighting (DTL) text</h3>
            <div class="space-y-4">
              <div>
                <label class="text-xs font-medium text-slate-600">Title</label>
                <input name="div_dtl_title" value={aboutSetup.division_dtl?.title || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400" />
              </div>
              <div>
                <label class="text-xs font-medium text-slate-600">Description</label>
                <textarea name="div_dtl_desc" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400">{aboutSetup.division_dtl?.desc || ''}</textarea>
              </div>
            </div>
          </div>
          <div class="border-t border-slate-100 pt-6">
            <h3 class="text-xs font-black text-slate-800 uppercase tracking-wide mb-2">Greenscapes (DGS) text</h3>
            <div class="space-y-4">
              <div>
                <label class="text-xs font-medium text-slate-600">Title</label>
                <input name="div_dgs_title" value={aboutSetup.division_dgs?.title || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400" />
              </div>
              <div>
                <label class="text-xs font-medium text-slate-600">Description</label>
                <textarea name="div_dgs_desc" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-amber-400">{aboutSetup.division_dgs?.desc || ''}</textarea>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- VISION & MISSION -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
          <div class="w-1.5 h-6 bg-cyan-600 rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Vision & Mission</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="text-xs font-medium text-slate-600">Vision Title</label>
            <input name="vision_title" value={aboutSetup.vision?.title || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400" />
            <label class="text-xs font-medium text-slate-600 mt-3 block">Vision Content</label>
            <textarea name="vision_content" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400">{aboutSetup.vision?.content || ''}</textarea>
          </div>
          <div>
            <label class="text-xs font-medium text-slate-600">Mission Title</label>
            <input name="mission_title" value={aboutSetup.mission?.title || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400" />
            <label class="text-xs font-medium text-slate-600 mt-3 block">Mission Content</label>
            <textarea name="mission_content" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-cyan-400">{aboutSetup.mission?.content || ''}</textarea>
          </div>
        </div>
      </div>

      <!-- CORE VALUES -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
          <div class="w-1.5 h-6 bg-purple-600 rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Core Operating Principles (Values)</h2>
        </div>
        <div class="p-6 space-y-6">
          {Object.entries(aboutSetup.values).map(([key, val]: [string, any]) => (
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label class="text-xs font-medium text-slate-600">Value Title</label>
                <input name={`val_${key}_title`} value={val.title} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-purple-400" />
              </div>
              <div class="md:col-span-2">
                <label class="text-xs font-medium text-slate-600">Value Description</label>
                <input name={`val_${key}_desc`} value={val.desc} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-purple-400" />
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TESTIMONIALS -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
          <div class="w-1.5 h-6 bg-pink-500 rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Client Testimonials</h2>
        </div>
        <div class="p-6 space-y-6">
          {Object.entries(aboutSetup.testimonials).map(([key, test]: [string, any]) => (
            <div class="border-b border-slate-100 pb-6 last:border-b-0 last:pb-0">
              <h3 class="text-xs font-black text-slate-800 uppercase tracking-wide mb-3">Testimonial {key.toUpperCase()}</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2">
                  <label class="text-xs font-medium text-slate-600">Quote Text</label>
                  <textarea name={`test_${key}_quote`} rows="2" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-pink-400">{test.quote}</textarea>
                </div>
                <div>
                  <label class="text-xs font-medium text-slate-600">Author</label>
                  <input name={`test_${key}_author`} value={test.author} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-pink-400" />
                </div>
                <div>
                  <label class="text-xs font-medium text-slate-600">Company & Location</label>
                  <input name={`test_${key}_company`} value={test.company} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-pink-400" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- LEADERSHIP MESSAGE -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
          <div class="w-1.5 h-6 bg-rose-600 rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Leadership Message</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="text-xs font-medium text-slate-600">Section Title</label>
            <input name="lead_title" value={aboutSetup.leadership?.title || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-rose-450" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-600">Leader Quote / Statement</label>
            <input name="lead_subtitle" value={aboutSetup.leadership?.subtitle || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-rose-450" />
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Description Paragraph 1</label>
            <textarea name="lead_desc1" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-rose-450">{aboutSetup.leadership?.description1 || ''}</textarea>
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Description Paragraph 2</label>
            <textarea name="lead_desc2" rows="3" class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-rose-450">{aboutSetup.leadership?.description2 || ''}</textarea>
          </div>
          <div>
            <label class="text-xs font-medium text-slate-600">Author Title</label>
            <input name="lead_authorTitle" value={aboutSetup.leadership?.authorTitle || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-rose-450" />
          </div>
          <div>
            <label class="text-xs font-medium text-slate-600">Author Company</label>
            <input name="lead_authorCompany" value={aboutSetup.leadership?.authorCompany || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-rose-450" />
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-medium text-slate-600">Image URL</label>
            <input name="lead_imageUrl" value={aboutSetup.leadership?.imageUrl || ''} class="w-full mt-1 rounded-md border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-rose-450" />
          </div>
        </div>
      </div>
    </form>
    </div><!-- /editor -->

    <!-- Preview Column -->
    <div class="flex-1 overflow-hidden p-3">
      <PreviewPanel src="/about" iframeId="about-preview-iframe" refreshBtnId="btn-refresh-about-preview" />
    </div>

  </div>

  <script>
    const form = document.getElementById('about-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-about');
    const saveMsg = document.getElementById('save-msg');

    const readForm = () => {
      const data = new FormData(form);
      return {
        header: {
          subtitle: data.get('header_subtitle') || '',
          title: data.get('header_title') || '',
          description: data.get('header_description') || '',
          logoUrl: data.get('header_logoUrl') || ''
        },
        definition: {
          title: data.get('def_title') || '',
          description1: data.get('def_desc1') || '',
          description2: data.get('def_desc2') || ''
        },
        division_dtl: {
          title: data.get('div_dtl_title') || '',
          desc: data.get('div_dtl_desc') || ''
        },
        division_dgs: {
          title: data.get('div_dgs_title') || '',
          desc: data.get('div_dgs_desc') || ''
        },
        vision: {
          title: data.get('vision_title') || '',
          content: data.get('vision_content') || ''
        },
        mission: {
          title: data.get('mission_title') || '',
          content: data.get('mission_content') || ''
        },
        values: {
          v1: { title: data.get('val_v1_title') || '', desc: data.get('val_v1_desc') || '' },
          v2: { title: data.get('val_v2_title') || '', desc: data.get('val_v2_desc') || '' },
          v3: { title: data.get('val_v3_title') || '', desc: data.get('val_v3_desc') || '' },
          v4: { title: data.get('val_v4_title') || '', desc: data.get('val_v4_desc') || '' }
        },
        testimonials: {
          t1: { quote: data.get('test_t1_quote') || '', author: data.get('test_t1_author') || '', company: data.get('test_t1_company') || '' },
          t2: { quote: data.get('test_t2_quote') || '', author: data.get('test_t2_author') || '', company: data.get('test_t2_company') || '' },
          t3: { quote: data.get('test_t3_quote') || '', author: data.get('test_t3_author') || '', company: data.get('test_t3_company') || '' }
        },
        leadership: {
          title: data.get('lead_title') || '',
          subtitle: data.get('lead_subtitle') || '',
          description1: data.get('lead_desc1') || '',
          description2: data.get('lead_desc2') || '',
          authorTitle: data.get('lead_authorTitle') || '',
          authorCompany: data.get('lead_authorCompany') || '',
          imageUrl: data.get('lead_imageUrl') || ''
        }
      };
    };

    saveBtn?.addEventListener('click', async () => {
      saveBtn.setAttribute('disabled', 'true');
      saveBtn.textContent = 'Saving…';
      try {
        const payload = { about_setup: JSON.stringify(readForm()) };
        const res = await fetch('/api/settings', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('Failed to save settings');
        saveMsg!.classList.remove('hidden');
        saveMsg!.textContent = '✓ Saved';
        (window as any)['refresh_about-preview-iframe']?.();
        setTimeout(() => { saveMsg!.classList.add('hidden'); }, 2500);
      } catch (err: any) {
        alert(err?.message || 'Error saving settings');
      } finally {
        saveBtn.removeAttribute('disabled');
        saveBtn.textContent = 'Save';
      }
    });

  </script>
</DashboardLayout>
