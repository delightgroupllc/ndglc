---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PreviewPanel from '../../components/ui/PreviewPanel.astro';
import PageHeroForm from '../../components/forms/PageHeroForm.astro';
import { query } from '../../lib/db';

let homeSetup: any = {
  hero: { title: '', subtitle: '', imageUrl: '', ctaText: '', ctaUrl: '', images: [], imageEffect: 'fade', imageFilter: 'none', imageInterval: 5000 },
  dtl_banner: { title: '', subtitle: '', description: '', imageUrl: '', ctaText: '', ctaUrl: '' },
  dgs_banner: { title: '', subtitle: '', description: '', imageUrl: '', ctaText: '', ctaUrl: '' },
  sectors: {
    residential: { title: '', desc: '', imageUrl: '', link: '' },
    commercial:  { title: '', desc: '', imageUrl: '', link: '' },
    hospitality: { title: '', desc: '', imageUrl: '', link: '' },
    procurement: { title: '', desc: '', imageUrl: '', link: '' }
  },
  cta: { title: '', description: '', btn1Text: '', btn1Url: '', btn2Text: '', btn2Url: '' }
};

try {
  const res = await query("SELECT value FROM settings WHERE key = 'home_setup'");
  if (res.rows.length > 0) {
    const saved = JSON.parse(res.rows[0].value);
    homeSetup = { ...homeSetup, ...saved, hero: { ...homeSetup.hero, ...(saved.hero || {}) } };
  }
} catch (err: any) {
  console.warn('DB offline or settings missing:', err?.message || err);
}
---

<DashboardLayout title="Home Page Setup" activeItem="home-setup">
  <div class="h-screen flex overflow-hidden">

    <!-- ── Editor Column ──────────────────────────────────── -->
    <div class="w-2/5 shrink-0 flex flex-col border-r border-slate-200 bg-white overflow-y-auto">
      <!-- Sticky header -->
      <div class="sticky top-0 z-10 bg-white border-b border-slate-100 px-5 py-3 flex items-center justify-between shrink-0">
        <div>
          <h1 class="text-sm font-black text-slate-900 tracking-tight">Home Setup</h1>
          <p class="text-[10px] text-slate-400 font-medium">Hero banners, divisions, sectors.</p>
        </div>
        <div class="flex items-center gap-2">
          <div id="save-msg" class="hidden text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 rounded-md px-2 py-1"></div>
          <button id="save-home" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-1.5 rounded-lg text-xs font-bold transition-all">Save</button>
        </div>
      </div>

      <!-- Form body -->
      <form id="home-form" class="p-4 space-y-4 flex-1">

        <!-- HERO FIELDS -->
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
            <div class="w-1.5 h-5 bg-indigo-600 rounded-full"></div>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Hero Section</h2>
          </div>
          <div class="p-4">
            <PageHeroForm hero={homeSetup.hero} ringColorClass="focus:ring-indigo-400" />
          </div>
        </div>

        <!-- HERO SLIDESHOW IMAGES -->
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
            <div class="w-1.5 h-5 bg-violet-600 rounded-full"></div>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Hero Slideshow Images</h2>
          </div>
          <div class="p-4 space-y-3">
            <p class="text-[11px] text-slate-500">Add multiple images for an animated hero background. Leave empty to use the single image above.</p>
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-[11px] font-semibold text-slate-600">Image URLs</label>
                <button type="button" id="add-hero-img"
                  class="text-[10px] font-bold text-violet-700 bg-violet-50 border border-violet-200 hover:bg-violet-100 px-2.5 py-1 rounded-md transition">+ Add</button>
              </div>
              <div id="hero-images-container" class="space-y-1.5" data-images={JSON.stringify(homeSetup.hero?.images || [])}></div>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <div>
                <label class="text-[10px] font-semibold text-slate-500">Effect</label>
                <select name="hero_imageEffect" class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-violet-400">
                  <option value="fade"  selected={!homeSetup.hero?.imageEffect || homeSetup.hero?.imageEffect==='fade'}>Fade</option>
                  <option value="slide" selected={homeSetup.hero?.imageEffect==='slide'}>Slide</option>
                  <option value="zoom"  selected={homeSetup.hero?.imageEffect==='zoom'}>Zoom</option>
                </select>
              </div>
              <div>
                <label class="text-[10px] font-semibold text-slate-500">Filter</label>
                <select name="hero_imageFilter" class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-violet-400">
                  <option value="none"      selected={!homeSetup.hero?.imageFilter || homeSetup.hero?.imageFilter==='none'}>Color</option>
                  <option value="grayscale" selected={homeSetup.hero?.imageFilter==='grayscale'}>Grayscale</option>
                  <option value="sepia"     selected={homeSetup.hero?.imageFilter==='sepia'}>Sepia</option>
                </select>
              </div>
              <div>
                <label class="text-[10px] font-semibold text-slate-500">Interval (s)</label>
                <input type="number" name="hero_imageInterval" min="2" max="20" step="0.5"
                  value={Math.round((homeSetup.hero?.imageInterval || 5000) / 1000)}
                  class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-violet-400" />
              </div>
            </div>
          </div>
        </div>

        <!-- DTL BANNER -->
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
            <div class="w-1.5 h-5 bg-amber-500 rounded-full"></div>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">DTL Division Banner</h2>
          </div>
          <div class="p-4 grid grid-cols-2 gap-2">
            <div><label class="text-[10px] font-semibold text-slate-500">Title</label><input name="dtl_title" value={homeSetup.dtl_banner?.title || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-amber-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">Subtitle</label><input name="dtl_subtitle" value={homeSetup.dtl_banner?.subtitle || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-amber-400" /></div>
            <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Description</label><textarea name="dtl_description" rows="2" class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-amber-400">{homeSetup.dtl_banner?.description || ''}</textarea></div>
            <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Image URL</label><input name="dtl_imageUrl" value={homeSetup.dtl_banner?.imageUrl || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-amber-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">CTA Text</label><input name="dtl_ctaText" value={homeSetup.dtl_banner?.ctaText || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-amber-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">CTA URL</label><input name="dtl_ctaUrl" value={homeSetup.dtl_banner?.ctaUrl || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-amber-400" /></div>
          </div>
        </div>

        <!-- DGS BANNER -->
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
            <div class="w-1.5 h-5 bg-emerald-600 rounded-full"></div>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">DGS Division Banner</h2>
          </div>
          <div class="p-4 grid grid-cols-2 gap-2">
            <div><label class="text-[10px] font-semibold text-slate-500">Title</label><input name="dgs_title" value={homeSetup.dgs_banner?.title || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">Subtitle</label><input name="dgs_subtitle" value={homeSetup.dgs_banner?.subtitle || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-400" /></div>
            <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Description</label><textarea name="dgs_description" rows="2" class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-400">{homeSetup.dgs_banner?.description || ''}</textarea></div>
            <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Image URL</label><input name="dgs_imageUrl" value={homeSetup.dgs_banner?.imageUrl || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">CTA Text</label><input name="dgs_ctaText" value={homeSetup.dgs_banner?.ctaText || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">CTA URL</label><input name="dgs_ctaUrl" value={homeSetup.dgs_banner?.ctaUrl || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-400" /></div>
          </div>
        </div>

        <!-- SECTORS -->
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
            <div class="w-1.5 h-5 bg-rose-500 rounded-full"></div>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Sectors We Serve</h2>
          </div>
          <div class="p-4 space-y-4">
            {Object.entries(homeSetup.sectors).map(([key, sector]: [string, any]) => (
              <div class="border-b border-slate-100 pb-4 last:border-b-0 last:pb-0">
                <h3 class="text-[10px] font-black text-slate-700 uppercase tracking-wide mb-2">{key}</h3>
                <div class="grid grid-cols-2 gap-2">
                  <div><label class="text-[10px] font-semibold text-slate-500">Title</label><input name={`sector_${key}_title`} value={sector.title} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-rose-300" /></div>
                  <div><label class="text-[10px] font-semibold text-slate-500">Link</label><input name={`sector_${key}_link`} value={sector.link} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-rose-300" /></div>
                  <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Image URL</label><input name={`sector_${key}_imageUrl`} value={sector.imageUrl} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-rose-300" /></div>
                  <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Description</label><textarea name={`sector_${key}_desc`} rows="2" class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-rose-300">{sector.desc}</textarea></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA BANNER -->
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
            <div class="w-1.5 h-5 bg-teal-500 rounded-full"></div>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">CTA Banner</h2>
          </div>
          <div class="p-4 grid grid-cols-2 gap-2">
            <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Title</label><input name="cta_title" value={homeSetup.cta?.title || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400" /></div>
            <div class="col-span-2"><label class="text-[10px] font-semibold text-slate-500">Description</label><textarea name="cta_description" rows="2" class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400">{homeSetup.cta?.description || ''}</textarea></div>
            <div><label class="text-[10px] font-semibold text-slate-500">Btn 1 Text</label><input name="cta_btn1Text" value={homeSetup.cta?.btn1Text || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">Btn 1 URL</label><input name="cta_btn1Url" value={homeSetup.cta?.btn1Url || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">Btn 2 Text</label><input name="cta_btn2Text" value={homeSetup.cta?.btn2Text || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400" /></div>
            <div><label class="text-[10px] font-semibold text-slate-500">Btn 2 URL</label><input name="cta_btn2Url" value={homeSetup.cta?.btn2Url || ''} class="w-full mt-0.5 rounded-md border border-slate-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400" /></div>
          </div>
        </div>

      </form>
    </div><!-- /editor column -->

    <!-- ── Preview Column ─────────────────────────────────── -->
    <div class="flex-1 overflow-hidden p-3">
      <PreviewPanel src="/" urlLabel="delightgroupllc.com" iframeId="home-preview-iframe" refreshBtnId="btn-refresh-home-preview" />
    </div>

  </div>

  <script>
    const form    = document.getElementById('home-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-home') as HTMLButtonElement;
    const saveMsg = document.getElementById('save-msg') as HTMLElement;

    // ── Hero image list ─────────────────────────────────────
    const heroContainer = document.getElementById('hero-images-container') as HTMLElement;
    let heroImages: string[] = [];
    try { heroImages = JSON.parse(heroContainer.getAttribute('data-images') || '[]'); } catch {}

    const syncHeroImages = () => {
      const inputs = heroContainer.querySelectorAll('.hero-img-input') as NodeListOf<HTMLInputElement>;
      heroImages = Array.from(inputs).map(i => i.value);
    };

    const renderHeroImages = () => {
      heroContainer.innerHTML = '';
      if (heroImages.length === 0) {
        heroContainer.innerHTML = `<p class="text-[10px] text-slate-400 italic">No slideshow images — single hero image used.</p>`;
        return;
      }
      heroImages.forEach((url, idx) => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-1.5';
        row.innerHTML = `
          <span class="text-[10px] text-slate-400 w-4 text-center">${idx+1}</span>
          <input type="text" class="flex-grow rounded-md border border-slate-200 px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-violet-400 hero-img-input"
            value="${url.replace(/"/g,'&quot;')}" placeholder="https://…/photo.jpg" />
          <button type="button" class="w-6 h-6 flex items-center justify-center text-slate-300 hover:text-red-500 rounded transition del-hero-img" data-idx="${idx}">×</button>
        `;
        heroContainer.appendChild(row);
      });
      heroContainer.querySelectorAll('.del-hero-img').forEach(btn => {
        btn.addEventListener('click', e => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-idx') || '0');
          syncHeroImages(); heroImages.splice(idx, 1); renderHeroImages();
        });
      });
    };

    document.getElementById('add-hero-img')?.addEventListener('click', () => { syncHeroImages(); heroImages.push(''); renderHeroImages(); });
    renderHeroImages();

    // ── Read form ───────────────────────────────────────────
    const readForm = () => {
      const data = new FormData(form);
      syncHeroImages();
      return {
        hero: {
          title: data.get('hero_title') || '',
          subtitle: data.get('hero_subtitle') || '',
          imageUrl: data.get('hero_imageUrl') || '',
          ctaText: data.get('hero_ctaText') || '',
          ctaUrl: data.get('hero_ctaUrl') || '',
          images: heroImages.map(u => u.trim()).filter(Boolean),
          imageEffect: data.get('hero_imageEffect') || 'fade',
          imageFilter: data.get('hero_imageFilter') || 'none',
          imageInterval: Math.round(parseFloat(data.get('hero_imageInterval') as string || '5') * 1000)
        },
        dtl_banner: {
          title: data.get('dtl_title') || '', subtitle: data.get('dtl_subtitle') || '',
          description: data.get('dtl_description') || '', imageUrl: data.get('dtl_imageUrl') || '',
          ctaText: data.get('dtl_ctaText') || '', ctaUrl: data.get('dtl_ctaUrl') || ''
        },
        dgs_banner: {
          title: data.get('dgs_title') || '', subtitle: data.get('dgs_subtitle') || '',
          description: data.get('dgs_description') || '', imageUrl: data.get('dgs_imageUrl') || '',
          ctaText: data.get('dgs_ctaText') || '', ctaUrl: data.get('dgs_ctaUrl') || ''
        },
        sectors: {
          residential: { title: data.get('sector_residential_title')||'', link: data.get('sector_residential_link')||'', desc: data.get('sector_residential_desc')||'', imageUrl: data.get('sector_residential_imageUrl')||'' },
          commercial:  { title: data.get('sector_commercial_title') ||'', link: data.get('sector_commercial_link') ||'', desc: data.get('sector_commercial_desc') ||'', imageUrl: data.get('sector_commercial_imageUrl') ||'' },
          hospitality: { title: data.get('sector_hospitality_title')||'', link: data.get('sector_hospitality_link')||'', desc: data.get('sector_hospitality_desc')||'', imageUrl: data.get('sector_hospitality_imageUrl')||'' },
          procurement: { title: data.get('sector_procurement_title')||'', link: data.get('sector_procurement_link')||'', desc: data.get('sector_procurement_desc')||'', imageUrl: data.get('sector_procurement_imageUrl')||'' }
        },
        cta: {
          title: data.get('cta_title')||'', description: data.get('cta_description')||'',
          btn1Text: data.get('cta_btn1Text')||'', btn1Url: data.get('cta_btn1Url')||'',
          btn2Text: data.get('cta_btn2Text')||'', btn2Url: data.get('cta_btn2Url')||''
        }
      };
    };

    // ── Save ────────────────────────────────────────────────
    saveBtn.addEventListener('click', async () => {
      saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
      try {
        const res = await fetch('/api/settings', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ home_setup: JSON.stringify(readForm()) })
        });
        if (!res.ok) throw new Error('Failed to save');
        saveMsg.classList.remove('hidden'); saveMsg.textContent = '✓ Saved';
        (window as any)['refresh_home-preview-iframe']?.();
        setTimeout(() => saveMsg.classList.add('hidden'), 2500);
      } catch (err: any) { alert(err?.message || 'Error'); }
      finally { saveBtn.disabled = false; saveBtn.textContent = 'Save'; }
    });
  </script>
</DashboardLayout>
