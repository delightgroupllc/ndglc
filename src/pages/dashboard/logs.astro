  <script is:inline>
    function initLogsDashboard() {
      const searchInput = document.getElementById('admin-search-logs');
      const filterDivision = document.getElementById('filter-division');
      const filterDatePreset = document.getElementById('filter-date-preset');
      const filterDateStart = document.getElementById('filter-date-start');
      const filterDateEnd = document.getElementById('filter-date-end');
      const filterAction = document.getElementById('filter-action');
      const filterModule = document.getElementById('filter-module');
      const filterUser = document.getElementById('filter-user');
      const filterAnomalousOnly = document.getElementById('filter-anomalous-only');
      const btnReset = document.getElementById('btn-reset-filters');
      const countVisible = document.getElementById('count-visible');
      const noLogsFound = document.getElementById('no-logs-found');
      const kpiAnomaliesBtn = document.getElementById('kpi-anomalies-btn');
      const btnFilterAnomalies = document.getElementById('btn-filter-anomalies');
      const alertCenter = document.getElementById('anomalous-alert-center');
      const rows = document.querySelectorAll('.admin-log-row');

      // Modal elements
      const snapshotModal = document.getElementById('snapshot-modal');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnCloseModalBottom = document.getElementById('btn-close-modal-bottom');
      const btnRecreateOrder = document.getElementById('btn-recreate-order');

      let currentActiveSnapshot = null;

      // Date Preset Handler
      function applyDatePreset(preset) {
        const now = new Date();
        const fmt = (d) => d.toISOString().split('T')[0];

        if (preset === 'today') {
          if (filterDateStart) filterDateStart.value = fmt(now);
          if (filterDateEnd) filterDateEnd.value = fmt(now);
        } else if (preset === 'yesterday') {
          const yest = new Date(now);
          yest.setDate(yest.getDate() - 1);
          if (filterDateStart) filterDateStart.value = fmt(yest);
          if (filterDateEnd) filterDateEnd.value = fmt(yest);
        } else if (preset === '7d') {
          const d7 = new Date(now);
          d7.setDate(d7.getDate() - 7);
          if (filterDateStart) filterDateStart.value = fmt(d7);
          if (filterDateEnd) filterDateEnd.value = fmt(now);
        } else if (preset === '30d') {
          const d30 = new Date(now);
          d30.setDate(d30.getDate() - 30);
          if (filterDateStart) filterDateStart.value = fmt(d30);
          if (filterDateEnd) filterDateEnd.value = fmt(now);
        } else if (preset === 'this_month') {
          const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
          if (filterDateStart) filterDateStart.value = fmt(firstDay);
          if (filterDateEnd) filterDateEnd.value = fmt(now);
        } else if (preset === 'all') {
          if (filterDateStart) filterDateStart.value = '';
          if (filterDateEnd) filterDateEnd.value = '';
        }
      }

      filterDatePreset?.addEventListener('change', () => {
        applyDatePreset(filterDatePreset.value);
        applyFilters();
      });

      filterDateStart?.addEventListener('change', () => {
        if (filterDatePreset && filterDatePreset.value !== 'custom') {
          filterDatePreset.value = 'custom';
        }
        applyFilters();
      });

      filterDateEnd?.addEventListener('change', () => {
        if (filterDatePreset && filterDatePreset.value !== 'custom') {
          filterDatePreset.value = 'custom';
        }
        applyFilters();
      });

      // Pagination elements
      const startEl = document.getElementById('logs-pagination-start');
      const endEl = document.getElementById('logs-pagination-end');
      const totalEl = document.getElementById('logs-pagination-total');
      const paginationButtons = document.getElementById('logs-pagination-buttons');
      const limitBtns = document.querySelectorAll('.logs-limit-btn');

      let currentPage = 1;
      let itemsPerPage = 15;

      limitBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          limitBtns.forEach(b => {
            b.className = 'logs-limit-btn px-3 py-1.5 text-xs font-semibold transition-colors bg-white text-slate-600 hover:bg-slate-50 border-l border-slate-200';
          });
          btn.className = 'logs-limit-btn px-3 py-1.5 text-xs font-black transition-colors bg-cyan-600 text-white';
          itemsPerPage = parseInt(btn.getAttribute('data-limit') || '15', 10);
          currentPage = 1;
          applyFilters(true);
        });
      });

      function renderPaginationButtons(totalPages, shouldScroll = false) {
        if (!paginationButtons) return;
        paginationButtons.innerHTML = '';

        if (totalPages <= 1) return;

        // First button
        const firstBtn = document.createElement('button');
        firstBtn.type = 'button';
        firstBtn.disabled = currentPage === 1;
        firstBtn.className = `px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${
          currentPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer'
        }`;
        firstBtn.innerHTML = '&laquo;';
        firstBtn.title = 'First Page';
        firstBtn.addEventListener('click', () => {
          if (currentPage > 1) { 
            currentPage = 1; 
            applyFilters(false, true); 
          }
        });
        paginationButtons.appendChild(firstBtn);

        // Prev button
        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.disabled = currentPage === 1;
        prevBtn.className = `px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${
          currentPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer'
        }`;
        prevBtn.innerHTML = '&lsaquo; Prev';
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) { 
            currentPage--; 
            applyFilters(false, true); 
          }
        });
        paginationButtons.appendChild(prevBtn);

        // Numbered buttons
        const maxVisiblePages = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
        if (endPage - startPage + 1 < maxVisiblePages) {
          startPage = Math.max(1, endPage - maxVisiblePages + 1);
        }

        if (startPage > 1) {
          const dot = document.createElement('span');
          dot.className = 'px-1.5 text-xs font-bold text-slate-400 select-none';
          dot.textContent = '...';
          paginationButtons.appendChild(dot);
        }

        for (let i = startPage; i <= endPage; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          pageBtn.className = `px-3 py-1.5 rounded-lg border text-xs font-bold transition-colors cursor-pointer ${
            currentPage === i
              ? 'bg-cyan-600 border-cyan-600 text-white shadow-xs'
              : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'
          }`;
          pageBtn.textContent = String(i);
          pageBtn.addEventListener('click', () => {
            currentPage = i;
            applyFilters(false, true);
          });
          paginationButtons.appendChild(pageBtn);
        }

        if (endPage < totalPages) {
          const dot = document.createElement('span');
          dot.className = 'px-1.5 text-xs font-bold text-slate-400 select-none';
          dot.textContent = '...';
          paginationButtons.appendChild(dot);
        }

        // Next button
        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.className = `px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${
          currentPage === totalPages ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer'
        }`;
        nextBtn.innerHTML = 'Next &rsaquo;';
        nextBtn.addEventListener('click', () => {
          if (currentPage < totalPages) { 
            currentPage++; 
            applyFilters(false, true); 
          }
        });
        paginationButtons.appendChild(nextBtn);

        // Last button
        const lastBtn = document.createElement('button');
        lastBtn.type = 'button';
        lastBtn.disabled = currentPage === totalPages;
        lastBtn.className = `px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${
          currentPage === totalPages ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer'
        }`;
        lastBtn.innerHTML = '&raquo;';
        lastBtn.title = 'Last Page';
        lastBtn.addEventListener('click', () => {
          if (currentPage < totalPages) { 
            currentPage = totalPages; 
            applyFilters(false, true); 
          }
        });
        paginationButtons.appendChild(lastBtn);
      }

      function applyFilters(resetPage = true, shouldScroll = false) {
        if (resetPage) currentPage = 1;

        const queryVal = searchInput?.value.toLowerCase().trim() || '';
        const divisionVal = filterDivision?.value.toLowerCase().trim() || '';
        const actionVal = filterAction?.value.toLowerCase().trim() || '';
        const moduleVal = filterModule?.value.toLowerCase().trim() || '';
        const userVal = filterUser?.value.toLowerCase().trim() || '';
        const anomalousOnly = filterAnomalousOnly?.value === 'anomalous';

        const startVal = filterDateStart?.value ? new Date(filterDateStart.value + 'T00:00:00') : null;
        const endVal = filterDateEnd?.value ? new Date(filterDateEnd.value + 'T23:59:59') : null;

        const matchingRows = [];

        rows.forEach(row => {
          const rowAction = row.getAttribute('data-action') || '';
          const rowDetails = row.getAttribute('data-details') || '';
          const rowUser = row.getAttribute('data-user') || '';
          const rowModule = row.getAttribute('data-module') || '';
          const rowDivision = row.getAttribute('data-division') || '';
          const rowAnomalous = row.getAttribute('data-anomalous') === 'true';
          const rowTimestamp = new Date(row.getAttribute('data-timestamp') || 0);

          const matchesSearch = !queryVal || rowAction.includes(queryVal) || rowDetails.includes(queryVal) || rowUser.includes(queryVal);
          const matchesDivision = !divisionVal || rowDivision === divisionVal;
          const matchesAction = !actionVal || rowAction === actionVal;
          const matchesModule = !moduleVal || rowModule === moduleVal;
          const matchesUser = !userVal || rowUser === userVal;
          const matchesAnomalous = !anomalousOnly || rowAnomalous;

          let matchesDate = true;
          if (startVal && rowTimestamp < startVal) matchesDate = false;
          if (endVal && rowTimestamp > endVal) matchesDate = false;

          if (matchesSearch && matchesDivision && matchesAction && matchesModule && matchesUser && matchesDate && matchesAnomalous) {
            matchingRows.push(row);
          }
          row.classList.add('hidden');
        });

        const totalMatching = matchingRows.length;
        const totalPages = Math.ceil(totalMatching / itemsPerPage) || 1;
        if (currentPage > totalPages) currentPage = totalPages;

        const startIndex = totalMatching === 0 ? 0 : (currentPage - 1) * itemsPerPage;
        const endIndex = Math.min(startIndex + itemsPerPage, totalMatching);

        for (let i = startIndex; i < endIndex; i++) {
          if (matchingRows[i]) {
            matchingRows[i].classList.remove('hidden');
          }
        }

        if (countVisible) countVisible.textContent = String(totalMatching);
        if (startEl) startEl.textContent = totalMatching === 0 ? '0' : String(startIndex + 1);
        if (endEl) endEl.textContent = String(endIndex);
        if (totalEl) totalEl.textContent = String(totalMatching);

        if (noLogsFound) {
          if (totalMatching === 0) noLogsFound.classList.remove('hidden');
          else noLogsFound.classList.add('hidden');
        }

        renderPaginationButtons(totalPages);

        if (shouldScroll) {
          document.getElementById('admin-logs-table')?.scrollIntoView({ behavior: 'smooth' });
        }
      }

      searchInput?.addEventListener('input', () => applyFilters(true));
      filterDivision?.addEventListener('change', () => applyFilters(true));
      filterAction?.addEventListener('change', () => applyFilters(true));
      filterModule?.addEventListener('change', () => applyFilters(true));
      filterUser?.addEventListener('change', () => applyFilters(true));
      filterAnomalousOnly?.addEventListener('change', () => applyFilters(true));

      // Jump to Alert Center or filter
      kpiAnomaliesBtn?.addEventListener('click', () => {
        alertCenter?.scrollIntoView({ behavior: 'smooth' });
      });

      btnFilterAnomalies?.addEventListener('click', () => {
        if (filterAnomalousOnly) filterAnomalousOnly.value = 'anomalous';
        applyFilters();
        document.getElementById('admin-logs-table')?.scrollIntoView({ behavior: 'smooth' });
      });

      // Interactive Security Alert Category Tabs & Pagination
      const alertTabs = document.querySelectorAll('.alert-tab-btn');
      const alertCards = document.querySelectorAll('.alert-card');
      const noAlertsInTab = document.getElementById('no-alerts-in-tab');

      let currentAlertPage = 1;
      let alertsPerPage = 6;
      let currentAlertTab = 'all';

      const alertStartEl = document.getElementById('alerts-pagination-start');
      const alertEndEl = document.getElementById('alerts-pagination-end');
      const alertTotalEl = document.getElementById('alerts-pagination-total');
      const alertPaginationButtons = document.getElementById('alerts-pagination-buttons');
      const alertLimitBtns = document.querySelectorAll('.alerts-limit-btn');

      alertLimitBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          alertLimitBtns.forEach(b => {
            b.className = 'alerts-limit-btn px-2.5 py-1 text-xs font-semibold transition-colors bg-slate-800 text-slate-300 hover:bg-slate-750 border-l border-slate-700';
          });
          btn.className = 'alerts-limit-btn px-2.5 py-1 text-xs font-black transition-colors bg-cyan-600 text-white';
          alertsPerPage = parseInt(btn.getAttribute('data-limit') || '6', 10);
          currentAlertPage = 1;
          renderAlertsPagination();
        });
      });

      function renderAlertPaginationButtons(totalPages) {
        if (!alertPaginationButtons) return;
        alertPaginationButtons.innerHTML = '';
        if (totalPages <= 1) return;

        // Prev Button
        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.disabled = currentAlertPage === 1;
        prevBtn.className = `px-2.5 py-1 rounded-lg border border-slate-700 text-xs font-bold ${
          currentAlertPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-850 text-slate-500' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 cursor-pointer'
        }`;
        prevBtn.innerHTML = '&lsaquo; Prev';
        prevBtn.addEventListener('click', () => {
          if (currentAlertPage > 1) {
            currentAlertPage--;
            renderAlertsPagination();
          }
        });
        alertPaginationButtons.appendChild(prevBtn);

        // Page Number Buttons
        for (let i = 1; i <= totalPages; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          pageBtn.className = `px-3 py-1 rounded-lg border text-xs font-bold transition-colors cursor-pointer ${
            currentAlertPage === i
              ? 'bg-cyan-600 border-cyan-500 text-white'
              : 'bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700'
          }`;
          pageBtn.textContent = String(i);
          pageBtn.addEventListener('click', () => {
            currentAlertPage = i;
            renderAlertsPagination();
          });
          alertPaginationButtons.appendChild(pageBtn);
        }

        // Next Button
        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.disabled = currentAlertPage === totalPages;
        nextBtn.className = `px-2.5 py-1 rounded-lg border border-slate-700 text-xs font-bold ${
          currentAlertPage === totalPages ? 'opacity-40 cursor-not-allowed bg-slate-850 text-slate-500' : 'bg-slate-800 text-slate-200 hover:bg-slate-700 cursor-pointer'
        }`;
        nextBtn.innerHTML = 'Next &rsaquo;';
        nextBtn.addEventListener('click', () => {
          if (currentAlertPage < totalPages) {
            currentAlertPage++;
            renderAlertsPagination();
          }
        });
        alertPaginationButtons.appendChild(nextBtn);
      }

      function renderAlertsPagination() {
        const matchingAlerts = [];
        alertCards.forEach(card => {
          const cardType = card.getAttribute('data-alert-type');
          if (currentAlertTab === 'all' || cardType === currentAlertTab) {
            matchingAlerts.push(card);
          }
          card.classList.add('hidden');
        });

        const totalAlerts = matchingAlerts.length;
        const totalAlertPages = Math.ceil(totalAlerts / alertsPerPage) || 1;
        if (currentAlertPage > totalAlertPages) currentAlertPage = totalAlertPages;

        const startIndex = totalAlerts === 0 ? 0 : (currentAlertPage - 1) * alertsPerPage;
        const endIndex = Math.min(startIndex + alertsPerPage, totalAlerts);

        for (let i = startIndex; i < endIndex; i++) {
          if (matchingAlerts[i]) matchingAlerts[i].classList.remove('hidden');
        }

        if (alertStartEl) alertStartEl.textContent = totalAlerts === 0 ? '0' : String(startIndex + 1);
        if (alertEndEl) alertEndEl.textContent = String(endIndex);
        if (alertTotalEl) alertTotalEl.textContent = String(totalAlerts);

        if (noAlertsInTab) {
          if (totalAlerts === 0) noAlertsInTab.classList.remove('hidden');
          else noAlertsInTab.classList.add('hidden');
        }

        renderAlertPaginationButtons(totalAlertPages);
      }

      alertTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          alertTabs.forEach(t => {
            t.className = 'alert-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white';
          });
          tab.className = 'alert-tab-btn active inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-cyan-600 text-white shadow-sm';

          currentAlertTab = tab.getAttribute('data-target-tab') || 'all';
          currentAlertPage = 1;
          renderAlertsPagination();
        });
      });

      renderAlertsPagination();

      // Filter table when clicking "Filter this event" on an alert card
      document.querySelectorAll('.btn-inspect-alert-log').forEach(btn => {
        btn.addEventListener('click', () => {
          const user = btn.getAttribute('data-user') || '';
          const action = btn.getAttribute('data-action') || '';
          if (searchInput) searchInput.value = user || action;
          applyFilters();
          document.getElementById('admin-logs-table')?.scrollIntoView({ behavior: 'smooth' });
        });
      });

      btnReset?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        if (filterDivision) filterDivision.value = '';
        if (filterDatePreset) filterDatePreset.value = 'all';
        if (filterDateStart) filterDateStart.value = '';
        if (filterDateEnd) filterDateEnd.value = '';
        if (filterAction) filterAction.value = '';
        if (filterModule) filterModule.value = '';
        if (filterUser) filterUser.value = '';
        if (filterAnomalousOnly) filterAnomalousOnly.value = 'all';
        applyFilters();
      });

      applyFilters();
    }

    initLogsDashboard();
    document.addEventListener('astro:page-load', initLogsDashboard);
  </script>

  <!-- Global Direct Verification & Recovery Handlers -->
  <script is:inline define:vars={{ initialSnapshots: snapshotsMap }}>
    window.__AUDIT_SNAPSHOTS = initialSnapshots || {};
    window.__currentActiveSnapshot = null;

    window.openSnapshotModalForLog = function(btn) {
      try {
        const logId = btn.getAttribute('data-log-id') || '';
        if (!logId) return;

        let snapshots = window.__AUDIT_SNAPSHOTS || {};
        if (Object.keys(snapshots).length === 0) {
          const dataEl = document.getElementById('audit-snapshots-data');
          if (dataEl && dataEl.textContent) {
            try {
              snapshots = JSON.parse(dataEl.textContent);
              window.__AUDIT_SNAPSHOTS = snapshots;
            } catch (e) {}
          }
        }

        const snapshot = snapshots[logId] || snapshots[Number(logId)] || snapshots[String(logId)];
        if (!snapshot) {
          console.warn('Snapshot not found for logId:', logId);
          alert('No snapshot recorded for this audit entry.');
          return;
        }
        window.__currentActiveSnapshot = snapshot;

        const action = btn.getAttribute('data-action') || 'AUDIT_EVENT';
        const operator = btn.getAttribute('data-operator') || 'System';
        const timestamp = new Date(btn.getAttribute('data-timestamp') || Date.now()).toLocaleString();

        const elDocNum = document.getElementById('modal-doc-number');
        const elDivBadge = document.getElementById('modal-division-badge');
        const elStatusBadge = document.getElementById('modal-status-badge');
        const elMetaInfo = document.getElementById('modal-meta-info');

        if (elDocNum) elDocNum.textContent = snapshot.invoice_number || 'Document';
        if (elDivBadge) elDivBadge.textContent = (snapshot.source_division || 'DTL').toUpperCase();
        if (elStatusBadge) elStatusBadge.textContent = (snapshot.payment_status || 'unpaid').toUpperCase();
        if (elMetaInfo) elMetaInfo.textContent = `Action: ${action} by ${operator} on ${timestamp}`;

        const elCustName = document.getElementById('modal-customer-name');
        const elCustComp = document.getElementById('modal-customer-company');
        const elCustPhone = document.getElementById('modal-customer-phone');
        const elCustTrn = document.getElementById('modal-customer-trn');

        if (elCustName) elCustName.textContent = snapshot.customer_name || '—';
        if (elCustComp) elCustComp.textContent = snapshot.company_name || 'No company';
        if (elCustPhone) elCustPhone.textContent = snapshot.customer_phone || snapshot.customer_email || '—';
        if (elCustTrn) elCustTrn.textContent = snapshot.trn_number ? `TRN: ${snapshot.trn_number}` : 'TRN: None';

        const elOrderType = document.getElementById('modal-order-type');
        const elLpo = document.getElementById('modal-lpo');
        const elIssueDate = document.getElementById('modal-issue-date');
        const elTerms = document.getElementById('modal-payment-terms');
        const elNotes = document.getElementById('modal-notes');

        if (elOrderType) elOrderType.textContent = (snapshot.order_type || 'standard').replace('_', ' ');
        if (elLpo) elLpo.textContent = snapshot.lpo_number ? `LPO: ${snapshot.lpo_number}` : 'LPO: —';
        if (elIssueDate) elIssueDate.textContent = snapshot.issue_date ? new Date(snapshot.issue_date).toLocaleDateString() : '—';

        let termsDisplay = snapshot.payment_terms || 'Standard';
        if (typeof termsDisplay === 'string' && (termsDisplay.trim().startsWith('[') || termsDisplay.trim().startsWith('{'))) {
          try {
            const parsedTerms = JSON.parse(termsDisplay);
            if (Array.isArray(parsedTerms)) {
              termsDisplay = parsedTerms.map(t => typeof t === 'string' ? t.replace(/[:"']/g, '').trim() : String(t)).filter(Boolean).join(' • ');
            }
          } catch (e) {}
        }
        if (elTerms) elTerms.textContent = `Terms: ${termsDisplay}`;
        if (elNotes) elNotes.textContent = snapshot.notes || snapshot.internal_notes || 'No special notes recorded on this snapshot.';

        // Line Items
        const tbody = document.getElementById('modal-items-tbody');
        if (tbody) {
          tbody.innerHTML = '';
          const items = snapshot.items || [];
          if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-3 text-center text-slate-400 italic">No line items recorded</td></tr>';
          } else {
            items.forEach(item => {
              const tr = document.createElement('tr');
              tr.className = 'hover:bg-slate-50/50';
              tr.innerHTML = `
                <td class="px-4 py-2.5">
                  <div class="font-bold text-slate-900">${item.description || 'Item'}</div>
                  ${item.catalogue_ref ? `<div class="text-[10px] font-mono text-slate-400">Ref: ${item.catalogue_ref}</div>` : ''}
                </td>
                <td class="px-4 py-2.5 text-center font-mono font-bold">${item.quantity || 1}</td>
                <td class="px-4 py-2.5 text-right font-mono">AED ${(Number(item.unit_price) || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                <td class="px-4 py-2.5 text-right font-mono text-slate-500">AED ${(Number(item.tax_amount) || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                <td class="px-4 py-2.5 text-right font-mono font-bold text-slate-900">AED ${(Number(item.total_price) || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
              `;
              tbody.appendChild(tr);
            });
          }
        }

        // Totals
        const currency = snapshot.currency || 'AED';
        const elSub = document.getElementById('modal-subtotal');
        const elVat = document.getElementById('modal-vat');
        const elDisc = document.getElementById('modal-discount');
        const elTot = document.getElementById('modal-total');

        if (elSub) elSub.textContent = `${currency} ${(Number(snapshot.subtotal) || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}`;
        if (elVat) elVat.textContent = `${currency} ${(Number(snapshot.tax_amount) || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}`;
        if (elDisc) elDisc.textContent = `${currency} ${(Number(snapshot.discount_amount) || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}`;
        if (elTot) elTot.textContent = `${currency} ${(Number(snapshot.total_amount) || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}`;

        const modal = document.getElementById('snapshot-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      } catch (err) {
        console.error('Error opening snapshot modal:', err);
      }
    };

    window.closeSnapshotModal = function() {
      const modal = document.getElementById('snapshot-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
      window.__currentActiveSnapshot = null;
      const btnActive = document.getElementById('btn-restore-active');
      const btnBin = document.getElementById('btn-restore-bin');
      if (btnActive) {
        btnActive.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg> Restore to Orders`;
        btnActive.disabled = false;
      }
      if (btnBin) {
        btnBin.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg> Restore to Bin`;
        btnBin.disabled = false;
      }
    };

    window.restoreActiveSnapshotToDb = async function(targetLocation = 'active') {
      const snapshot = window.__currentActiveSnapshot;
      if (!snapshot) return;
      
      const btnActive = document.getElementById('btn-restore-active');
      const btnBin = document.getElementById('btn-restore-bin');
      const targetBtn = targetLocation === 'bin' ? btnBin : btnActive;
      if (!targetBtn) return;

      const origActiveText = btnActive ? btnActive.innerHTML : '';
      const origBinText = btnBin ? btnBin.innerHTML : '';

      if (btnActive) btnActive.disabled = true;
      if (btnBin) btnBin.disabled = true;

      targetBtn.innerHTML = `<span class="animate-spin inline-block mr-1">↻</span> Restoring to ${targetLocation === 'bin' ? 'Bin' : 'Orders'}...`;

      try {
        const res = await fetch('/api/invoices/restore-snapshot', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ snapshot, targetLocation })
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || 'Failed to restore document');

        targetBtn.className = 'flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 bg-emerald-700 text-white font-bold px-3.5 py-2 rounded-xl text-xs transition-colors shadow-sm';
        targetBtn.innerHTML = `✓ Restored as ${result.invoice.invoice_number}!`;
        
        setTimeout(() => {
          if (targetLocation === 'bin') {
            window.location.href = '/dashboard/invoices?tab=bin';
          } else {
            window.location.href = `/dashboard/invoices/${result.invoice.id}`;
          }
        }, 600);
      } catch (err) {
        alert('❌ Restoration failed: ' + (err.message || 'Unknown error'));
        if (btnActive) {
          btnActive.innerHTML = origActiveText;
          btnActive.disabled = false;
        }
        if (btnBin) {
          btnBin.innerHTML = origBinText;
          btnBin.disabled = false;
        }
      }
    };

    window.openActiveSnapshotInEditor = function() {
      const snapshot = window.__currentActiveSnapshot;
      if (!snapshot) return;
      try {
        sessionStorage.setItem('restore_invoice_draft', JSON.stringify(snapshot));
        window.location.href = '/dashboard/invoices/create?from_audit=1';
      } catch (e) {
        window.location.href = '/dashboard/invoices/create';
      }
    };
  </script>
</DashboardLayout>
