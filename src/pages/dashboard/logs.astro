            id="btn-recreate-order"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 bg-cyan-700 hover:bg-cyan-800 text-white font-bold px-3.5 py-2 rounded-xl text-xs transition-colors shadow-sm cursor-pointer"
