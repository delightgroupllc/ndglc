            <input 
              type="text" 
              id="admin-search-logs"
              placeholder="Search invoice number, customer, actions..." 
              class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 pl-9 pr-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50 font-bold"
            />
