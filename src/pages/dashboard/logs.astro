                        ))}
                      </div>
                    ) : (
                      <span class="text-3xs text-slate-400 italic">None</span>
                    )}
                  </td>

                  <!-- Timestamp -->
                  <td class="px-4 py-3.5 text-right text-slate-500 font-mono text-2xs whitespace-nowrap">
                    {new Date(log.timestamp).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                  </td>

                  <!-- Snapshot Verification Button -->
                  <td class="px-4 py-3.5 text-center whitespace-nowrap">
                    {hasSnapshot ? (
                      <button 
                        type="button" 
                        class="btn-verify-snapshot inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-cyan-50 hover:bg-cyan-100 text-cyan-700 border border-cyan-200 transition-colors shadow-2xs cursor-pointer"
                        data-log-id={log.id}
                        data-action={log.action}
                        data-details={log.details}
                        data-timestamp={log.timestamp}
                        data-operator={log.user_name || log.user_email || 'System'}
                        onclick="window.openSnapshotModalForLog && window.openSnapshotModalForLog(this)"
                      >
                        <Receipt class="w-3.5 h-3.5 text-cyan-600" />
                        <span>Verify Order</span>
                      </button>
                    ) : (
                      <span class="text-3xs text-slate-350 italic font-mono">—</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div id="no-logs-found" class="hidden py-12 text-center text-slate-400 text-xs font-semibold">
        No audit log records match the selected filters.
      </div>

      <!-- Pagination Controls Footer -->
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 bg-slate-50/90 border-t border-slate-200 p-4">
        <!-- Items per page selector (15, 25, 50, 100) -->
        <div class="flex items-center gap-2 text-xs text-slate-500 font-bold">
          <span>Show</span>
          <div class="flex items-center rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs" id="logs-pagination-limit-btns">
            <button type="button" class="logs-limit-btn px-3 py-1.5 text-xs font-black transition-colors bg-cyan-600 text-white" data-limit="15">15</button>
            <button type="button" class="logs-limit-btn px-3 py-1.5 text-xs font-semibold transition-colors bg-white text-slate-600 hover:bg-slate-50 border-l border-slate-200" data-limit="25">25</button>
            <button type="button" class="logs-limit-btn px-3 py-1.5 text-xs font-semibold transition-colors bg-white text-slate-600 hover:bg-slate-50 border-l border-slate-200" data-limit="50">50</button>
            <button type="button" class="logs-limit-btn px-3 py-1.5 text-xs font-semibold transition-colors bg-white text-slate-600 hover:bg-slate-50 border-l border-slate-200" data-limit="100">100</button>
          </div>
          <span>logs per page</span>
        </div>

        <!-- Showing X to Y of Z logs -->
        <div class="text-xs text-slate-500 font-medium">
          Showing <span id="logs-pagination-start" class="text-slate-900 font-black">0</span> to <span id="logs-pagination-end" class="text-slate-900 font-black">0</span> of <span id="logs-pagination-total" class="text-slate-900 font-black">0</span> records
        </div>

        <!-- Pagination page navigation buttons -->
        <div class="flex items-center gap-1.5" id="logs-pagination-buttons">
          <!-- Buttons injected dynamically -->
        </div>
      </div>
    </div>
  </div>

  <!-- POINT-IN-TIME ORDER SNAPSHOT VERIFICATION MODAL -->
  <div id="snapshot-modal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden transition-opacity" onclick="if (event.target === this) window.closeSnapshotModal && window.closeSnapshotModal()">
    <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[90vh]">
      
      <!-- Modal Header -->
      <div class="px-6 py-4.5 bg-slate-900 text-white flex items-center justify-between">
