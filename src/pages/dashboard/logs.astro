              <th class="px-4 py-4 font-semibold text-center whitespace-nowrap w-40">Verification</th>
            </tr>
          </thead>
          <tbody id="admin-logs-table">
            {auditLogs.map(log => {
              const divLower = log.division.toLowerCase();
              const isAnomalous = anomalousLogIds.has(log.id);
              const hasSnapshot = Boolean(log.snapshot);
              const isInvoiceLog = log.entity_type === 'invoices' || (log.action && log.action.startsWith('INVOICE_'));

              let badgeColor = 'bg-slate-100 text-slate-700 border-slate-200';
              if (log.division === 'DTL') badgeColor = 'bg-blue-50 text-blue-700 border-blue-200';
              else if (log.division === 'DGS') badgeColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';
              else if (log.division === 'BOTH') badgeColor = 'bg-purple-50 text-purple-700 border-purple-200';
              else if (log.division === 'FINANCE') badgeColor = 'bg-amber-50 text-amber-700 border-amber-200';

              return (
                <tr 
                  class={`admin-log-row border-b border-slate-100 hover:bg-slate-50/50 text-xs transition-colors ${isAnomalous ? 'bg-rose-50/30' : ''}`}
                  data-action={log.action.toLowerCase()} 
                  data-details={(log.details || '').toLowerCase()} 
                  data-user={(log.user_email || 'system@delightgroupllc.com').toLowerCase()}
                  data-module={(log.entity_type || 'other').toLowerCase()}
                  data-division={divLower}
                  data-anomalous={isAnomalous ? 'true' : 'false'}
                  data-timestamp={new Date(log.timestamp).toISOString()}
                >
                  <!-- Division Badge -->
                  <td class="px-4 py-3.5 whitespace-nowrap">
                    <div class="flex items-center gap-1.5">
                      <span class={`inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-[10px] font-black uppercase tracking-wider ${badgeColor}`}>
                        {log.division}
                      </span>
                      {isAnomalous && (
                        <span class="inline-flex items-center gap-0.5 rounded bg-rose-100 text-rose-700 border border-rose-200 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider" title="Flagged Anomalous Activity">
                          <AlertTriangle class="w-2.5 h-2.5" /> Flagged
                        </span>
                      )}
                    </div>
                  </td>

                  <!-- Action Token -->
                  <td class="px-4 py-3.5 whitespace-nowrap">
                    <span class="rounded bg-slate-100 border border-slate-200 px-2 py-0.5 text-2xs font-mono font-bold text-cyan-700 uppercase">
                      {log.action}
                    </span>
                  </td>

                  <!-- Details & Target Entity -->
                  <td class="px-4 py-3.5">
                    <div class="font-bold text-slate-900 max-w-lg break-words line-clamp-2" title={log.details}>{log.details}</div>
                    <div class="text-3xs text-slate-400 mt-0.5 uppercase font-mono tracking-wider">Target: {log.entity_type} {log.entity_id ? `(${log.entity_id})` : ''}</div>
                  </td>

                  <!-- Operator Session -->
                  <td class="px-4 py-3.5 whitespace-nowrap">
                    <div class="font-bold text-slate-800 leading-tight">{log.user_name || 'System Auto'}</div>
                    <div class="text-3xs text-slate-400 mt-0.5 font-mono">{log.user_email || ''}</div>
                  </td>

                  <!-- Roles -->
                  <td class="px-4 py-3.5 whitespace-nowrap">
                    {log.roles_list ? (
                      <div class="flex flex-wrap gap-1">
                        {log.roles_list.split(', ').map((role: string) => (
                          <span class="rounded bg-cyan-500/10 border border-cyan-500/20 px-1.5 py-0.5 text-3xs font-extrabold text-cyan-600 uppercase font-mono">
                            {role}
