          <label class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider block">Operator Email / Account</label>
          <select id="filter-user" class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50 font-bold text-slate-700">
            <option value="">All Operators</option>
            {uniqueUsers.map(usr => (
              <option value={usr.toLowerCase()}>{usr}</option>
            ))}
          </select>
        </div>

        <div class="space-y-1">
          <label class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider block">Alert Filter</label>
          <select id="filter-anomalous-only" class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50 font-bold text-slate-700">
            <option value="all">All Logs (Normal & Flagged)</option>
            <option value="anomalous">Flagged Anomalies Only ({anomalousAlerts.length})</option>
          </select>
