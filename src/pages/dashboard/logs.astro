---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { ScrollText, Search, AlertTriangle, ShieldCheck, Activity, Users, Eye, Sparkles, Filter, Calendar, Building2, Layers, RefreshCw, AlertCircle, ChevronDown, Receipt, Printer, Copy, Check, X, ShieldAlert, Trash2 } from '@lucide/astro';

let rawAuditLogs: any[] = [];
let dbConnected = true;

try {
  // Query logs and fetch roles list & invoice division dynamically
  const res = await query(
    `SELECT al.*, 
       u.name as user_name, 
       u.email as user_email,
       inv.source_division,
       (SELECT ARRAY_TO_STRING(ARRAY_AGG(r.name), ', ') 
        FROM roles r 
        JOIN user_roles ur ON ur.role_id = r.id 
        WHERE ur.user_id = al.user_id) as roles_list
     FROM audit_logs al
     LEFT JOIN users u ON u.id = al.user_id
     LEFT JOIN invoices inv ON (al.entity_type = 'invoices' AND (al.entity_id = inv.id::text OR al.entity_id = inv.invoice_number))
     ORDER BY al.timestamp DESC
     LIMIT 1000`
  );
  rawAuditLogs = res.rows;
} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}

// Compute normalized division for each log
const auditLogs = rawAuditLogs.map(l => {
  let div = 'SYSTEM';
  if (l.source_division) {
    const sd = String(l.source_division).toUpperCase();
    if (sd === 'DTL') div = 'DTL';
    else if (sd === 'DGS') div = 'DGS';
    else if (sd === 'BOTH') div = 'BOTH';
  } else {
    const text = ((l.details || '') + ' ' + (l.entity_type || '')).toLowerCase();
    if (text.includes('dtl') || text.includes('lighting')) div = 'DTL';
    else if (text.includes('dgs') || text.includes('greenscape')) div = 'DGS';
    else if (text.includes('both')) div = 'BOTH';
    else if (l.entity_type === 'finance_legal') div = 'FINANCE';
  }
  return { ...l, division: div };
});

// Analytics calculations
const totalLogs = auditLogs.length;

// Division counts
const divisionCounts = {
  DTL: auditLogs.filter(l => l.division === 'DTL').length,
  DGS: auditLogs.filter(l => l.division === 'DGS').length,
  BOTH: auditLogs.filter(l => l.division === 'BOTH').length,
  FINANCE: auditLogs.filter(l => l.division === 'FINANCE').length,
  SYSTEM: auditLogs.filter(l => l.division === 'SYSTEM').length,
};

// Operators count & activity distribution
const operatorsMap = new Map<string, { name: string; email: string; count: number }>();
auditLogs.forEach(l => {
  const email = l.user_email || 'system@delightgroupllc.com';
  const name = l.user_name || 'System Auto';
  const current = operatorsMap.get(email) || { name, email, count: 0 };
  current.count += 1;
  operatorsMap.set(email, current);
});
const topOperators = Array.from(operatorsMap.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);

// Module allocation distribution
const modulesMap = new Map<string, number>();
auditLogs.forEach(l => {
  const mod = l.entity_type || 'other';
  modulesMap.set(mod, (modulesMap.get(mod) || 0) + 1);
});
const moduleStats = Array.from(modulesMap.entries())
  .sort((a, b) => b[1] - a[1]);

// Anomalous Activity Alert Calculation
const anomalousAlerts: any[] = [];
const rapidAccessLogs: { [key: string]: number } = {};

auditLogs.forEach((log) => {
  const isSecurityToggle = ['PERMISSION_TOGGLE', 'PERMISSION_OVERRIDE_ADD', 'PERMISSION_OVERRIDE_DELETE'].includes(log.action);
  const userRoles = (log.roles_list || '').split(', ').map((r: string) => r.trim());
  const isNonAdminSecurityAction = isSecurityToggle && !userRoles.includes('admin');

  const detailsLower = (log.details || '').toLowerCase();
  const hasFailureKeywords = detailsLower.includes('failed') || detailsLower.includes('unauthorized') || detailsLower.includes('denied');

  // Check rapid updates (less than 5s apart by same user)
  const timeSec = new Date(log.timestamp).getTime();
  const userKey = log.user_email || 'system';
  const previousTime = rapidAccessLogs[userKey];
  let isRapidAction = false;
  if (previousTime && Math.abs(timeSec - previousTime) < 5000) {
    isRapidAction = true;
  }
  rapidAccessLogs[userKey] = timeSec;

  if (isNonAdminSecurityAction) {
    anomalousAlerts.push({
      type: 'critical',
      title: 'Unauthorized Security Alteration',
      desc: `${log.user_name || 'User'} (${log.user_email || 'unknown'}) attempted to toggle access rules without Admin status.`,
      logId: log.id,
      details: log.details,
      timestamp: log.timestamp,
      action: log.action,
      operator: log.user_name || 'Operator',
      operatorEmail: log.user_email || 'system@delightgroupllc.com',
      roles: log.roles_list || 'Staff'
    });
  } else if (hasFailureKeywords) {
    anomalousAlerts.push({
      type: 'warning',
      title: 'Action Access Failure Triggered',
      desc: `Log details flagged authentication/access warnings: "${log.details}"`,
      logId: log.id,
      details: log.details,
      timestamp: log.timestamp,
      action: log.action,
      operator: log.user_name || 'Operator',
      operatorEmail: log.user_email || 'system@delightgroupllc.com',
      roles: log.roles_list || 'Staff'
    });
  } else if (isRapidAction) {
    anomalousAlerts.push({
      type: 'info',
      title: 'High-frequency Operator Activity',
      desc: `Operator (${log.user_name || log.user_email || 'Operator'}) executed rapid batch modifications within 5 seconds.`,
      logId: log.id,
      details: log.details,
      timestamp: log.timestamp,
      action: log.action,
      operator: log.user_name || 'Operator',
      operatorEmail: log.user_email || 'system@delightgroupllc.com',
      roles: log.roles_list || 'Staff'
    });
  }
});

const alertCounts = {
  all: anomalousAlerts.length,
  critical: anomalousAlerts.filter(a => a.type === 'critical').length,
  warning: anomalousAlerts.filter(a => a.type === 'warning').length,
  info: anomalousAlerts.filter(a => a.type === 'info').length,
};

const anomalousLogIds = new Set(anomalousAlerts.map(a => a.logId));

// Unique Actions & Target Modules for filter lists
const uniqueActions = Array.from(new Set(auditLogs.map(l => l.action))).sort();
const uniqueModules = Array.from(new Set(auditLogs.map(l => l.entity_type))).sort();
const uniqueUsers = Array.from(new Set(auditLogs.map(l => l.user_email || 'system@delightgroupllc.com'))).sort();

// Safe Snapshots map for client-side hydration without HTML escaping issues
const snapshotsMap: Record<string, any> = {};
auditLogs.forEach(l => {
  if (l.snapshot) {
    snapshotsMap[l.id] = typeof l.snapshot === 'string' ? JSON.parse(l.snapshot) : l.snapshot;
  }
});
---

<DashboardLayout title="Security Audit Analytics" activeItem="logs">
  <!-- Hidden Snapshot Payloads Store -->
  <script id="audit-snapshots-data" type="application/json" set:html={JSON.stringify(snapshotsMap)}></script>

  <style is:inline>
    .logs-table-scroll {
      scrollbar-width: thin;
      scrollbar-color: #0891b2 #f1f5f9;
    }
    .logs-table-scroll::-webkit-scrollbar {
      height: 9px;
      width: 9px;
    }
    .logs-table-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 6px;
    }
    .logs-table-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 6px;
      border: 2px solid #f1f5f9;
    }
    .logs-table-scroll::-webkit-scrollbar-thumb:hover {
      background: #0891b2;
    }
  </style>

  <div class="space-y-8 p-4 sm:p-6 lg:p-8 w-full max-w-[1720px] mx-auto pb-16">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Interactive Security & Audit Analytics
        </h1>
        <p class="text-slate-500 text-sm mt-2 font-medium">Verify system telemetry, inspect immutable point-in-time order snapshots, query operator actions, and spot anomalous access attempts.</p>
      </div>
      <button 
        type="button" 
        id="btn-reset-filters" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors shadow-2xs self-start sm:self-auto cursor-pointer"
      >
        <RefreshCw class="w-3.5 h-3.5" /> Reset Filters
      </button>
    </div>

    <!-- Offline DB Notification -->
    {!dbConnected && (
      <div class="rounded-2xl border border-amber-500/20 bg-amber-500/5 p-4 text-xs text-amber-700 font-semibold shadow-sm">
        <span class="font-extrabold uppercase block">PostgreSQL Connection Offline</span>
        No data available. Please restore database connectivity.
      </div>
    )}

    <!-- STATS COUNTERS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Counter 1: Total -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs flex items-center gap-3.5">
        <div class="p-2.5 bg-cyan-50 rounded-xl text-cyan-600 shrink-0">
          <Activity class="h-5 w-5" />
        </div>
        <div>
          <span class="text-2xs font-extrabold text-slate-450 uppercase tracking-wider block">Total Audits</span>
          <span class="text-xl font-black text-slate-900 block" id="kpi-total-logs">{totalLogs}</span>
        </div>
      </div>

      <!-- Counter 2: DTL -->
      <div class="bg-white rounded-2xl border border-blue-100 p-4 shadow-xs flex items-center gap-3.5">
        <div class="p-2.5 bg-blue-50 rounded-xl text-blue-600 shrink-0">
          <Building2 class="h-5 w-5" />
        </div>
        <div>
          <span class="text-2xs font-extrabold text-blue-600 uppercase tracking-wider block">DTL Division</span>
          <span class="text-xl font-black text-slate-900 block" id="kpi-dtl-logs">{divisionCounts.DTL}</span>
        </div>
      </div>

      <!-- Counter 3: DGS -->
      <div class="bg-white rounded-2xl border border-emerald-100 p-4 shadow-xs flex items-center gap-3.5">
        <div class="p-2.5 bg-emerald-50 rounded-xl text-emerald-600 shrink-0">
          <Building2 class="h-5 w-5" />
        </div>
        <div>
          <span class="text-2xs font-extrabold text-emerald-600 uppercase tracking-wider block">DGS Division</span>
          <span class="text-xl font-black text-slate-900 block" id="kpi-dgs-logs">{divisionCounts.DGS}</span>
        </div>
      </div>

      <!-- Counter 4: Both / Finance -->
      <div class="bg-white rounded-2xl border border-purple-100 p-4 shadow-xs flex items-center gap-3.5">
        <div class="p-2.5 bg-purple-50 rounded-xl text-purple-600 shrink-0">
          <Layers class="h-5 w-5" />
        </div>
        <div>
          <span class="text-2xs font-extrabold text-purple-600 uppercase tracking-wider block">Both / Finance</span>
          <span class="text-xl font-black text-slate-900 block" id="kpi-both-logs">{divisionCounts.BOTH + divisionCounts.FINANCE}</span>
        </div>
      </div>

      <!-- Counter 5: Anomalies (Clickable to jump to Alert Center) -->
      <button 
        type="button" 
        id="kpi-anomalies-btn"
        class="bg-white rounded-2xl border border-rose-200 hover:border-rose-300 hover:bg-rose-50/40 p-4 shadow-xs flex items-center gap-3.5 transition-all text-left cursor-pointer group"
        title="Click to view Anomalous Activity Alerts"
      >
        <div class="p-2.5 bg-rose-50 group-hover:bg-rose-100 rounded-xl text-rose-600 shrink-0 transition-colors">
          <AlertTriangle class="h-5 w-5 animate-pulse" />
        </div>
        <div class="flex-1">
          <div class="flex items-center justify-between">
            <span class="text-2xs font-extrabold text-rose-600 uppercase tracking-wider block">Anomalous Alerts</span>
            <span class="text-[9px] font-black uppercase text-rose-500 bg-rose-100 px-1.5 py-0.5 rounded">View</span>
          </div>
          <span class="text-xl font-black text-rose-600 block">{anomalousAlerts.length} Flagged</span>
        </div>
      </button>
    </div>

    <!-- ANOMALOUS ACTIVITY ALERT & THREAT MANAGEMENT CENTER -->
    <div id="anomalous-alert-center" class="bg-slate-900 text-white rounded-3xl p-6 lg:p-7 shadow-xl border border-slate-800 space-y-6">
      
      <!-- Card Header -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-800 pb-5">
        <div class="flex items-start gap-3.5">
          <div class="p-3 bg-rose-500/20 text-rose-400 rounded-2xl border border-rose-500/30 shrink-0 mt-0.5">
            <ShieldAlert class="w-6 h-6" />
          </div>
          <div>
            <div class="flex items-center gap-2.5 flex-wrap">
              <h2 class="text-base font-black uppercase tracking-wider text-white">Security Alerts & Threat Management Center</h2>
              <span class="px-2.5 py-0.5 text-xs font-black uppercase rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/30">
                {anomalousAlerts.length} Flagged Telemetry Events
              </span>
            </div>
            <p class="text-xs text-slate-400 font-medium mt-1">Real-time heuristics detect unauthorized privilege escalation, access denials, and burst velocity anomalies.</p>
          </div>
        </div>

        <!-- Header Actions -->
        <div class="flex items-center gap-2.5 flex-wrap">
          <button 
            type="button" 
            id="btn-filter-anomalies" 
            class="inline-flex items-center gap-1.5 text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white px-4 py-2 rounded-xl transition-all shadow-md cursor-pointer"
          >
            <Filter class="w-3.5 h-3.5" /> Filter Log Table ({anomalousAlerts.length})
          </button>
        </div>
      </div>

      <!-- Interactive Alert Category Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 border-b border-slate-800/80">
        <button 
          type="button" 
          class="alert-tab-btn active inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-cyan-600 text-white shadow-sm"
          data-target-tab="all"
        >
          <span>All Security Alerts</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] font-black bg-white/20">{alertCounts.all}</span>
        </button>

        <button 
          type="button" 
          class="alert-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white"
          data-target-tab="critical"
        >
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          <span>Critical Access & Rules</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] font-black bg-rose-500/20 text-rose-300 border border-rose-500/30">{alertCounts.critical}</span>
        </button>

        <button 
          type="button" 
          class="alert-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white"
          data-target-tab="warning"
        >
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span>Access Denials & Failures</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] font-black bg-amber-500/20 text-amber-300 border border-amber-500/30">{alertCounts.warning}</span>
        </button>

        <button 
          type="button" 
          class="alert-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white"
          data-target-tab="info"
        >
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span>Velocity & Batch Spikes</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] font-black bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">{alertCounts.info}</span>
        </button>
      </div>

      <!-- Alerts Grid Container -->
      <div id="alerts-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4.5 pt-1">
        {anomalousAlerts.map((alert, idx) => {
          let badgeBorder = 'border-rose-500/30 bg-rose-950/40 text-rose-300';
          let borderHighlight = 'border-slate-800 hover:border-rose-500/50';
          if (alert.type === 'warning') {
            badgeBorder = 'border-amber-500/30 bg-amber-950/40 text-amber-300';
            borderHighlight = 'border-slate-800 hover:border-amber-500/50';
          } else if (alert.type === 'info') {
            badgeBorder = 'border-cyan-500/30 bg-cyan-950/40 text-cyan-300';
            borderHighlight = 'border-slate-800 hover:border-cyan-500/50';
          }

          return (
            <div 
              class={`alert-card bg-slate-800/80 rounded-2xl p-5 border ${borderHighlight} flex flex-col justify-between space-y-4 transition-all shadow-sm group`}
              data-alert-type={alert.type}
            >
              <div class="space-y-2.5">
                <!-- Header badge & Timestamp -->
                <div class="flex items-center justify-between gap-2">
                  <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider border ${badgeBorder}`}>
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    {alert.title}
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">
                    {new Date(alert.timestamp).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}
                  </span>
                </div>

                <!-- Event Details & Vector -->
                <div>
                  <h4 class="text-xs font-bold text-slate-100 leading-snug break-words">{alert.details}</h4>
                  <p class="text-[11px] text-slate-400 mt-1 leading-relaxed">{alert.desc}</p>
                </div>

                <!-- Operator Attribution Box -->
                <div class="bg-slate-900/90 rounded-xl p-3 border border-slate-800 space-y-1">
                  <div class="flex items-center justify-between text-[10px]">
                    <span class="text-slate-400 uppercase font-extrabold tracking-wider">Operator:</span>
                    <span class="font-bold text-slate-200">{alert.operator}</span>
                  </div>
                  <div class="flex items-center justify-between text-[10px] font-mono text-slate-400">
                    <span>Email:</span>
                    <span class="text-slate-300 truncate max-w-[180px]" title={alert.operatorEmail}>{alert.operatorEmail}</span>
                  </div>
                  <div class="flex items-center justify-between text-[10px]">
                    <span class="text-slate-400 uppercase font-extrabold tracking-wider">Roles:</span>
                    <span class="font-mono text-cyan-400 text-[10px] font-bold truncate max-w-[180px]">{alert.roles}</span>
                  </div>
                </div>
              </div>

              <!-- Card Action Footer -->
              <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono text-slate-500 uppercase">Log #{alert.logId}</span>
                <button 
                  type="button" 
                  class="btn-inspect-alert-log inline-flex items-center gap-1 text-[11px] font-bold text-cyan-400 hover:text-cyan-300 transition-colors cursor-pointer"
                  data-log-id={alert.logId}
                  data-action={alert.action}
                  data-user={alert.operatorEmail}
                >
                  <span>Filter this event</span> →
                </button>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty Tab Fallback -->
      <div id="no-alerts-in-tab" class="hidden py-10 text-center text-slate-400 text-xs font-semibold">
        No security alerts found in this category.
      </div>

      <!-- Security Alerts Dedicated Pagination Footer -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-slate-800/80 text-slate-400 text-xs">
        <div class="flex items-center gap-2">
          <span>Show</span>
          <div class="flex items-center rounded-xl border border-slate-700 bg-slate-800 overflow-hidden" id="alerts-pagination-limit-btns">
            <button type="button" class="alerts-limit-btn px-2.5 py-1 text-xs font-black transition-colors bg-cyan-600 text-white" data-limit="6">6</button>
            <button type="button" class="alerts-limit-btn px-2.5 py-1 text-xs font-semibold transition-colors bg-slate-800 text-slate-300 hover:bg-slate-750 border-l border-slate-700" data-limit="12">12</button>
            <button type="button" class="alerts-limit-btn px-2.5 py-1 text-xs font-semibold transition-colors bg-slate-800 text-slate-300 hover:bg-slate-750 border-l border-slate-700" data-limit="24">24</button>
          </div>
          <span>alerts per page</span>
        </div>

        <div>
          Showing <span id="alerts-pagination-start" class="text-white font-bold">0</span> to <span id="alerts-pagination-end" class="text-white font-bold">0</span> of <span id="alerts-pagination-total" class="text-white font-bold">{anomalousAlerts.length}</span> alerts
        </div>

        <div class="flex items-center gap-1" id="alerts-pagination-buttons">
          <!-- Dynamically injected alert pagination buttons -->
        </div>
      </div>
    </div>

    <!-- FILTER TOOLBAR WITH DATE SELECTOR & DIVISION FILTER -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2">
          <Filter class="h-4.5 w-4.5 text-slate-500" />
          <h3 class="text-xs font-black text-slate-850 uppercase tracking-wider">Multi-Dimension Audit Filters</h3>
        </div>
        
        <!-- Live Matching Counter Badge -->
        <div id="filter-matching-badge" class="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1 rounded-lg self-start sm:self-auto">
          Showing <span id="count-visible" class="text-cyan-700 font-black">{totalLogs}</span> of {totalLogs} records
        </div>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3.5">
        
        <!-- 1. DIVISION SELECTOR -->
        <div class="space-y-1">
          <label class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider block flex items-center gap-1">
            <Building2 class="w-3 h-3 text-cyan-600" />
            Division
          </label>
          <select id="filter-division" class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50 font-bold text-slate-700">
            <option value="">All Divisions</option>
            <option value="dtl">DTL (Technical Lighting)</option>
            <option value="dgs">DGS (Greenscapes)</option>
            <option value="both">Both (Combined Group)</option>
            <option value="finance">Finance & Legal</option>
            <option value="system">System / Operations</option>
          </select>
        </div>

        <!-- 2. DATE PRESET SELECTOR -->
        <div class="space-y-1">
