---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { query } from '../../../lib/db';
import { FileSpreadsheet, PlusCircle, Search, Save, AlertTriangle, Printer, CheckCircle, Clock } from '@lucide/astro';
import DateRangePicker from '../../../components/ui/DateRangePicker.astro';
import DirhamIcon from '../../../components/ui/DirhamIcon.astro';

const user = Astro.locals.user;
const roles = Astro.locals.roles || [];
const permissions = Astro.locals.permissions || [];
const isAdmin = roles.includes('admin') || roles.includes('moderator') || permissions.includes('invoices.manage');

let invoices: any[] = [];
let dbConnected = true;
let settings: Record<string, string> = {};
let legalArtifacts: any[] = [];
let products: any[] = [];

try {
  const queryStr = isAdmin
    ? 'SELECT i.*, (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list, COALESCE((SELECT is_deleted FROM customers WHERE name = i.customer_name LIMIT 1), TRUE) as is_customer_deleted, (SELECT code FROM customers WHERE name = i.customer_name LIMIT 1) as customer_code, (SELECT code FROM companies WHERE name = i.company_name LIMIT 1) as company_code FROM invoices i ORDER BY i.created_at DESC'
    : 'SELECT i.*, (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list, COALESCE((SELECT is_deleted FROM customers WHERE name = i.customer_name LIMIT 1), TRUE) as is_customer_deleted, (SELECT code FROM customers WHERE name = i.customer_name LIMIT 1) as customer_code, (SELECT code FROM companies WHERE name = i.company_name LIMIT 1) as company_code FROM invoices i WHERE i.customer_email = $1 ORDER BY i.created_at DESC';
  const queryParams = isAdmin ? [] : [user?.email || ''];
  const res = await query(queryStr, queryParams);
  invoices = res.rows;

  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => { acc[row.key] = row.value; return acc; }, {});

  const legalRes = await query('SELECT * FROM legal_artifacts ORDER BY type DESC, identifier ASC');
  legalArtifacts = legalRes.rows;

  const prodRes = await query(`
    SELECT p.id, pi.url as image_url
    FROM products p
    LEFT JOIN product_images pi ON pi.product_id = p.id AND pi.is_primary = TRUE
  `);
  products = prodRes.rows;
} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}

// Pre-calculate procurement stages and button matrix configs to avoid JSX compiler parser issues with "<"
invoices = invoices.map(inv => {
  const isPaid = inv.payment_status === 'paid';
  const isConfirmed = inv.payment_status === 'paid' || inv.payment_status === 'confirmed';
  const type = inv.order_type || 'tax_invoice';

  let stage = 6;
  if (isPaid) {
    stage = 7;
  } else if (type === 'inquiry') {
    stage = 1;
  } else if (type === 'quotation') {
    stage = 2;
  } else if (type === 'proforma') {
    stage = 3;
  } else if (type === 'lpo') {
    stage = 4;
  } else if (type === 'delivery_note' || type === 'sample_order') {
    stage = 5;
  } else if (type === 'tax_invoice') {
    stage = 6;
  }

  const showAudit = stage >= 4;
  const showUpdate = stage <= 3 || (stage === 4 && !isConfirmed);
  const showConfirm = (stage === 2 || stage === 3 || stage === 4) && !isConfirmed;
  const showBill = stage === 6;
  const showCancelOrder = stage === 4 || stage === 5 || stage === 6;

  const isDraftOrUnconfirmed = stage <= 3 || (stage === 4 && !isConfirmed);
  let deleteLabel = 'DELETE';
  let deleteBtnClass = "delete-btn px-2 py-1.5 border border-rose-100 bg-rose-50 hover:bg-rose-100 text-[9px] font-black text-rose-700 rounded transition-colors uppercase tracking-wider";
  
  if (inv.is_deleted) {
    deleteLabel = 'RESTORE';
    deleteBtnClass = "delete-btn px-2 py-1.5 border border-emerald-100 bg-emerald-50 hover:bg-emerald-100 text-[9px] font-black text-emerald-700 rounded transition-colors uppercase tracking-wider";
  } else if (inv.is_archived) {
    deleteLabel = 'UNARCHIVE';
    deleteBtnClass = "delete-btn px-2 py-1.5 border border-amber-100 bg-amber-50 hover:bg-amber-100 text-[9px] font-black text-amber-700 rounded transition-colors uppercase tracking-wider";
  } else if (!isDraftOrUnconfirmed) {
    deleteLabel = 'ARCHIVE';
    deleteBtnClass = "delete-btn px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-bold text-slate-600 rounded transition-colors uppercase tracking-wider";
  }
  const showDeleteAction = true;
  const showArchiveAction = !isDraftOrUnconfirmed;

  return {
    ...inv,
    isPaid,
    isConfirmed,
    stage,
    showAudit,
    showUpdate,
    showConfirm,
    showBill,
    showCancelOrder,
    showDeleteAction,
    showArchiveAction,
    deleteLabel,
    deleteBtnClass
  };
});
---

<DashboardLayout title="Billing & Invoices" activeItem="invoices">

  <style is:global></style>

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL Connection Offline</span>: Invoicing runs in simulated mock registry mode.
      </div>
    </div>
  )}

  <div class="space-y-6 p-6 lg:p-8">
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 border-b border-slate-200 pb-4">
      <!-- Search + Filters -->
      <div class="flex flex-wrap items-center gap-2 flex-grow">
          <div class="relative flex-grow max-w-xs">
            <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" />
            <input 
              type="text" 
              id="admin-search-invoices"
              placeholder="Search by client or INV#..." 
              class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
            />
          </div>
          <select id="filter-invoice-status" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
            <option value="">All Statuses</option>
            <option value="paid">Paid</option>
            <option value="unpaid">Unpaid</option>
            <option value="overdue">Overdue</option>
            <option value="draft">Draft</option>
            <option value="cancelled">Cancelled</option>
            <option value="archived">Archived</option>
            <option value="deleted">Deleted</option>
          </select>
          <select id="filter-invoice-division" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
            <option value="">All Divisions</option>
            <option value="DTL">Division DTL</option>
            <option value="DGS">Division DGS</option>
          </select>
          <select id="sort-invoices" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
            <option value="newest">Newest Issued</option>
            <option value="oldest">Oldest Issued</option>
            <option value="amount-desc">Total: High to Low</option>
            <option value="amount-asc">Total: Low to High</option>
          </select>
          <!-- Date Range Picker (dropdown, inline with other filters) -->
          <DateRangePicker id="invoices-date-picker" />
      </div>
      <div class="flex gap-2 shrink-0">
        <button 
          type="button" 
          id="billing-workflow-help-btn"
          class="inline-flex items-center justify-center gap-2 bg-slate-55 border border-slate-200 hover:bg-slate-100 text-slate-700 px-4 py-2.5 rounded-lg text-xs font-bold transition-colors shadow-3xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Billing Workflow
        </button>
        <!-- Sub-filters: Active, Archived, Bin -->
        <div id="invoice-filter-group" class="flex gap-1 bg-slate-100 p-1 rounded-lg border border-slate-200 animate-fade-in shrink-0 hidden sm:flex">
          <button id="btn-inv-active" class="px-3 py-1 text-xs font-bold text-cyan-700 bg-white rounded-md shadow-xs transition-all focus:outline-none">
            Active
          </button>
          <button id="btn-inv-archived" class="px-3 py-1 text-xs font-bold text-slate-600 hover:text-slate-900 rounded-md transition-all focus:outline-none">
            Archived
          </button>
          <button id="btn-inv-bin" class="px-3 py-1 text-xs font-bold text-slate-600 hover:text-slate-900 rounded-md transition-all focus:outline-none">
            Bin (Trash)
          </button>
        </div>

        {isAdmin && (
          <a 
            href="/dashboard/invoices/create"
            class="inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm shrink-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
            Create Order
          </a>
        )}
      </div>
    </div>


    <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-widest font-black">
                <th class="px-6 py-4">Reference</th>
                <th class="px-6 py-4">Client Details</th>
                <th class="px-6 py-4 text-center">Valuation</th>
                <th class="px-6 py-4 text-center">Status</th>
                <th class="px-6 py-4 text-right pr-12">Operations</th>
              </tr>
            </thead>
            <tbody id="admin-invoices-table">
              {invoices.map(inv => (
                <tr class="admin-invoice-row border-b border-slate-100 hover:bg-slate-50/50 text-xs transition-colors" 
                  data-id={inv.id} 
                  data-name={inv.customer_name} 
                  data-email={inv.customer_email || ''} 
                  data-phone={inv.customer_phone || ''} 
                  data-issue={inv.issue_date} 
                  data-due={inv.due_date || ''} 
                  data-status={inv.payment_status} 
                  data-items={JSON.stringify(inv.items_list || [])} 
                  data-num={inv.invoice_number}
                  data-div={inv.source_division || ''}
                  data-amount={inv.total_amount}
                  data-date={inv.issue_date}
                  data-archived={inv.is_archived ? 'true' : 'false'}
                  data-deleted={inv.is_deleted ? 'true' : 'false'}
                >
                  <td class="px-6 py-5">
                    <div class="font-extrabold text-slate-900 text-sm tracking-tight">{inv.invoice_number}</div>
                    <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
                      <span class="inline-block px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-500 text-[9px] font-black uppercase tracking-wider">
                        {inv.order_type === 'sample_order' ? 'Sample Order' :
                         inv.order_type === 'proforma' ? 'Pro Forma' : 
                         inv.order_type === 'lpo' ? 'LPO' : 
                         inv.order_type === 'delivery_note' ? 'Delivery Note' : 
                         inv.order_type === 'tax_invoice' ? 'Commercial Bill' :
                         inv.order_type === 'standard' ? 'Invoice' :
                         inv.order_type === 'quotation' ? 'Estimation' :
                         inv.order_type === 'inquiry' ? 'Inquiry' : 'Invoice'}
                      </span>
                      <span class="text-[9px] font-extrabold text-slate-400 uppercase tracking-widest">{inv.source_division || 'DTL'}</span>
                      {inv.invoice_number && inv.invoice_number.toUpperCase().includes('DUP') && (
                        <span class="inline-block px-1.5 py-0.5 rounded border border-rose-500 bg-rose-50 text-rose-500 text-[9px] font-black uppercase tracking-wider shadow-3xs">
                          DUPLICATE
                        </span>
                      )}
                      {Boolean(inv.invoice_number?.toUpperCase().includes('REC') || inv.internal_notes?.includes('[AUDIT RECOVERY]')) && (
                        <span class="inline-block px-1.5 py-0.5 rounded border border-amber-300 bg-amber-50 text-amber-800 text-[9px] font-black uppercase tracking-wider shadow-3xs">
                          RESTORED FROM AUDIT
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <div class="font-black text-slate-800 uppercase tracking-wide flex flex-wrap items-center gap-1">
                      {inv.customer_name}
                      {inv.customer_code && <span class="text-[10px] text-slate-500 font-bold">(ID: {inv.customer_code})</span>}
                      {inv.company_code && <span class="text-[10px] text-slate-500 font-bold">(ID: {inv.company_code})</span>}
                      {inv.is_customer_deleted && (
                        <span 
                          class="relative group cursor-help"
                          title="This customer account has been deleted"
                        >
                          <span class="text-rose-500 font-black text-xs ml-0.5">*</span>
                          <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 hidden group-hover:flex items-center gap-1 bg-rose-700 text-white text-[9px] font-bold px-2 py-1 rounded shadow-lg whitespace-nowrap z-50 pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                            Customer account deleted
                          </span>
                        </span>
                      )}
                    </div>
                    <div class="text-[10px] font-extrabold text-slate-400 mt-1 uppercase tracking-wider">
                      Issued: {inv.issue_date ? new Date(inv.issue_date).toLocaleDateString('en-AE', { day: 'numeric', month: 'short', year: 'numeric' }) : ''}
                      {inv.created_at && (
                        <> • Created: {new Date(inv.created_at).toLocaleString('en-AE', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</>
                      )}
                    </div>
                  </td>
                  <td class="px-6 py-5 text-center">
                    <div class="font-black text-slate-800 text-[13px] tracking-tight flex items-center justify-center gap-1">
                      <DirhamIcon class="w-[1em] h-[1em]" /> 
                      {Number(inv.total_amount).toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </div>
                    <div class="text-[9px] font-bold text-slate-400 mt-1 uppercase tracking-widest">Total Valuation</div>
                  </td>
                  <td class="px-6 py-5 text-center">
                    <span class={`inline-block border rounded px-3 py-1 text-[9px] font-black uppercase tracking-widest shadow-2xs ${inv.isPaid ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-200 bg-white text-slate-500'}`}>
                      {inv.payment_status === 'paid' ? 'CONFIRMED' : inv.payment_status.toUpperCase()}
                    </span>
                  </td>
                  <td class="px-6 py-5 text-right pr-6">
                    <div class="flex justify-end">
                      {isAdmin ? (
                        <div class="grid grid-cols-3 gap-1.5 w-64">
                          {/* VIEW button - always visible */}
                          <a href={`/dashboard/invoices/${inv.id}`} class="inline-flex items-center justify-center px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs">
                            View
                          </a>
                          
                          {/* AUDIT button - from Stage 4 onwards */}
                          {inv.showAudit ? (
                            <button type="button" class="audit-invoice-btn px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs" data-num={inv.invoice_number} data-status={inv.payment_status} data-date={inv.issue_date}>
                              Audit
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">N/A</div>
                          )}

                          {/* PRINT button - always visible */}
                          <a href={`/dashboard/invoices/print/${inv.id}`} class="inline-flex items-center justify-center px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs">
                            Print
                          </a>

                          {/* UPDATE button - unconfirmed draft stage only */}
                          {inv.showUpdate ? (
                            <button type="button" class="update-invoice-btn px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs" data-invoice={JSON.stringify(inv)}>
                              Update
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">Locked</div>
                          )}

                          {/* BILL button - Stage 6 only */}
                          {inv.showBill ? (
                            <button type="button" class="bill-invoice-btn px-2 py-1.5 border border-emerald-100 bg-emerald-50 hover:bg-emerald-100/70 text-[9px] font-black text-emerald-700 rounded transition-colors uppercase tracking-wider" data-id={inv.id}>
                              Bill
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">N/A</div>
                          )}

                          {/* CONFIRM button - Stage 2, 3, 4 only */}
                          {inv.showConfirm ? (
                            <button type="button" class="confirm-payment-btn px-2 py-1.5 border border-blue-100 bg-blue-50 hover:bg-blue-100/70 text-[9px] font-black text-blue-700 rounded transition-colors uppercase tracking-wider" data-id={inv.id}>
                              Confirm
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">Approved</div>
                          )}

                          {/* CANCEL ORDER button - Stages 4, 5, 6 only */}
                          {inv.showCancelOrder ? (
                            <button type="button" class="cancel-invoice-btn px-2 py-1.5 border border-amber-100 bg-amber-50 hover:bg-amber-100 text-[9px] font-black text-amber-700 rounded transition-colors uppercase tracking-wider col-span-3" data-num={inv.invoice_number} data-id={inv.id}>
                              Cancel Order
                            </button>
                          ) : null}

                          {/* DUPLICATE button - always visible */}
                          <button type="button" class="duplicate-row-btn px-2 py-1.5 border border-violet-100 bg-violet-50 hover:bg-violet-100 text-[9px] font-black text-violet-700 rounded transition-colors uppercase tracking-wider col-span-1" data-id={inv.id}>
                            Duplicate
                          </button>

                          {/* ARCHIVE/UNARCHIVE button */}
                          {inv.showArchiveAction && !inv.is_deleted && (
                            <button 
                              type="button" 
                              class={`archive-btn px-2 py-1.5 border text-[9px] font-black rounded transition-colors uppercase tracking-wider col-span-1 ${
                                inv.is_archived 
                                  ? "border-amber-100 bg-amber-50 hover:bg-amber-100 text-amber-700" 
                                  : "border-slate-200 bg-white hover:bg-slate-50 text-slate-600"
                              }`} 
                              data-id={inv.id} 
                              data-action={inv.is_archived ? 'UNARCHIVE' : 'ARCHIVE'}
                            >
                              {inv.is_archived ? 'UNARCHIVE' : 'ARCHIVE'}
                            </button>
                          )}

                          {/* DELETE button */}
                          {inv.showDeleteAction && !inv.is_deleted && (
                            <button 
                              type="button" 
                              class="delete-btn px-2 py-1.5 border border-rose-100 bg-rose-50 hover:bg-rose-100 text-[9px] font-black text-rose-700 rounded transition-colors uppercase tracking-wider col-span-1"
                              data-id={inv.id} 
                              data-action="DELETE"
                            >
                              DELETE
                            </button>
                          )}

                          {/* RESTORE/PERM_DELETE button (only for items in trash) */}
                          {inv.is_deleted && (
                            <>
                              <button 
                                type="button" 
                                class="delete-btn px-2 py-1.5 border border-emerald-100 bg-emerald-50 hover:bg-emerald-100 text-[9px] font-black text-emerald-700 rounded transition-colors uppercase tracking-wider col-span-1"
                                data-id={inv.id} 
                                data-action="RESTORE"
                              >
                                RESTORE
                              </button>
                              <button 
                                type="button" 
                                class="perm-delete-btn px-2 py-1.5 border border-rose-600 bg-rose-600 hover:bg-rose-700 text-[9px] font-black text-white rounded transition-colors uppercase tracking-wider col-span-1 shadow-sm"
                                data-id={inv.id} 
                                data-num={inv.invoice_number}
                              >
                                PERM DEL
                              </button>
                            </>
                          )}
                        </div>
                      ) : (
                        <div class="flex gap-2 justify-end w-44">
                          <a href={`/dashboard/invoices/${inv.id}`} class="inline-flex items-center justify-center px-4 py-2 border border-slate-200 bg-white hover:bg-slate-50 text-[10px] font-black text-slate-650 rounded-lg transition-colors uppercase tracking-wider shadow-3xs flex-1 text-center">
                            View Details
                          </a>
                          <a href={`/dashboard/invoices/print/${inv.id}`} class="inline-flex items-center justify-center px-4 py-2 border border-slate-200 bg-white hover:bg-slate-50 text-[10px] font-black text-slate-650 rounded-lg transition-colors uppercase tracking-wider shadow-3xs flex-1 text-center">
                            Print
                          </a>
                        </div>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- No matching invoices / empty state -->
        <div id="no-invoices-state" class="hidden py-12 text-center border-t border-slate-100 bg-slate-50/50">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-slate-400 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold text-slate-800">No orders found for the selected criteria</h4>
          <p class="text-xs text-slate-500 mt-1" id="no-invoices-hint">Try adjusting your date range or clearing search criteria.</p>
          <button type="button" id="btn-empty-show-all" class="mt-3 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-700 text-white text-xs font-bold transition-colors shadow-3xs">
            View All Time Orders
          </button>
        </div>
      </div>

      <!-- Contextual "Show More Orders" / Adjacent Timeframe Bar -->
