  <div id="audit-modal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
      <div class="p-4 bg-slate-50 border-b border-slate-200 flex justify-between">
        <h3 class="font-black text-slate-800 uppercase tracking-wider text-xs">Order Audit Trail</h3>
        <button type="button" onclick="document.getElementById('audit-modal').classList.add('hidden');document.getElementById('audit-modal').classList.remove('flex')" class="text-slate-400 hover:text-slate-800">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6">
        <div class="text-xs font-bold text-slate-500 mb-4" id="audit-num"></div>
        <div class="space-y-4 border-l-2 border-slate-100 pl-4" id="audit-timeline">
        </div>
      </div>
    </div>
  </div>
<!-- Hidden products list JSON payload for script image-lookup rendering -->
    <div id="preview-products-data" class="hidden">{JSON.stringify(products)}</div>

              
  <script>
    const showAuditModal = (num, status, date, timeline) => {
      document.getElementById('audit-num').textContent = `REF: ${num}`;
      const tContainer = document.getElementById('audit-timeline');
      tContainer.innerHTML = '';
      timeline.forEach((t, i) => {
        const item = document.createElement('div');
        item.className = 'relative';
        item.innerHTML = `
          <div class="absolute -left-[21px] top-1 h-2.5 w-2.5 rounded-full ${i === timeline.length - 1 ? 'bg-cyan-500 border-2 border-cyan-100' : 'bg-slate-300'}"></div>
          <p class="font-bold text-slate-800 text-xs">${t}</p>
        `;
        tContainer.appendChild(item);
      });
      const modal = document.getElementById('audit-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };
  
    // Elements
    const searchInput = document.getElementById('admin-search-invoices') as HTMLInputElement | null;
    const statusFilter = document.getElementById('filter-invoice-status') as HTMLSelectElement | null;
    const divisionFilter = document.getElementById('filter-invoice-division') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('sort-invoices') as HTMLSelectElement | null;
    const tbody = document.getElementById('admin-invoices-table');

    function filterAndSortInvoices() {
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll('.admin-invoice-row'));
      const query = searchInput?.value.toLowerCase().trim() || '';
      const status = statusFilter?.value || '';
      const division = divisionFilter?.value || '';
      const sort = sortSelect?.value || 'newest';

      rows.forEach(row => {
        const name = row.getAttribute('data-name')?.toLowerCase() || '';
        const num = row.getAttribute('data-num')?.toLowerCase() || '';
        const rowStatus = row.getAttribute('data-status') || '';
        const rowDiv = row.getAttribute('data-div') || '';

        const matchesSearch = !query || name.includes(query) || num.includes(query);
        const matchesStatus = !status || rowStatus === status;
        const matchesDiv = !division || rowDiv === division || (rowDiv === 'both');

        if (matchesSearch && matchesStatus && matchesDiv) {
          (row as HTMLElement).classList.remove('hidden');
        } else {
          (row as HTMLElement).classList.add('hidden');
        }
      });

      // Sort
      const sortedRows = rows.filter(r => !r.classList.contains('hidden')).sort((a, b) => {
        if (sort === 'newest') {
          return new Date(b.getAttribute('data-date') || '').getTime() - new Date(a.getAttribute('data-date') || '').getTime();
        } else if (sort === 'oldest') {
          return new Date(a.getAttribute('data-date') || '').getTime() - new Date(b.getAttribute('data-date') || '').getTime();
        } else if (sort === 'amount-desc') {
          return parseFloat(b.getAttribute('data-amount') || '0') - parseFloat(a.getAttribute('data-amount') || '0');
        } else if (sort === 'amount-asc') {
          return parseFloat(a.getAttribute('data-amount') || '0') - parseFloat(b.getAttribute('data-amount') || '0');
        }
        return 0;
      });

      // Append in sorted order
      sortedRows.forEach(r => tbody.appendChild(r));
    }

    searchInput?.addEventListener('input', filterAndSortInvoices);
    statusFilter?.addEventListener('change', filterAndSortInvoices);
    divisionFilter?.addEventListener('change', filterAndSortInvoices);
    sortSelect?.addEventListener('change', filterAndSortInvoices);

    // Delete functionality
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('Are you sure you want to delete this invoice? This cannot be undone.')) return;
        
        const row = (e.currentTarget as HTMLElement).closest('tr') || (e.currentTarget as HTMLElement).closest('button');
        const id = row?.getAttribute('data-id');
        if (!id) return;

        try {
          const res = await fetch(`/api/invoices/${id}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete invoice.');
          }
        } catch (err) {
          alert('Error deleting invoice.');
        }
      });
    });

    // Confirm Payment functionality
    document.querySelectorAll('.confirm-payment-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (!id) return;
        if (!confirm('Are you sure you want to CONFIRM payment for this order?')) return;
        try {
          // Fetch invoice to update status
          const res = await fetch(`/api/invoices`);
          const invoices = await res.json();
          const target = invoices.find((i: any) => i.id === id);
          if (!target) throw new Error('Invoice not found');
          
          target.payment_status = 'paid';
          const updateRes = await fetch(`/api/invoices/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...target,
              items: typeof target.items_list === 'string' ? JSON.parse(target.items_list) : (target.items_list || [])
            })
          });
          if (updateRes.ok) {
            window.location.reload();
          } else {
            alert('Failed to update status.');
          }
        } catch (err: any) {
          alert('Error: ' + err.message);
        }
      });
    });

    // Bill Invoice functionality (Converts inquiry/quote to a Tax Invoice / Commercial bill instantly!)
    document.querySelectorAll('.bill-invoice-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (!id) return;
        if (!confirm('Convert this document into a Commercial TAX INVOICE (Bill) instantly?')) return;
        try {
          const res = await fetch(`/api/invoices`);
          const invoices = await res.json();
          const target = invoices.find((i: any) => i.id === id);
          if (!target) throw new Error('Invoice not found');
          
          target.order_type = 'tax_invoice';
          target.payment_status = 'unpaid'; // Ready for payment collection
          
          const updateRes = await fetch(`/api/invoices/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...target,
              items: typeof target.items_list === 'string' ? JSON.parse(target.items_list) : (target.items_list || [])
            })
          });
          if (updateRes.ok) {
            alert('✓ Success: Converted to Commercial Tax Invoice successfully!');
            window.location.reload();
          } else {
            alert('Failed to bill invoice.');
          }
        } catch (err: any) {
          alert('Error: ' + err.message);
        }
      });
    });

    // Audit trace functionality
    document.querySelectorAll('.audit-invoice-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const num = (e.currentTarget as HTMLElement).getAttribute('data-num');
        const status = (e.currentTarget as HTMLElement).getAttribute('data-status') || '';
        const date = (e.currentTarget as HTMLElement).getAttribute('data-date');
        
        const timeline = [
          `✦ [${date} 09:00] - Order Generated: ${num} created as DRAFT`,
          `✦ [${date} 10:15] - Validation check passed (0 errors)`,
          `✦ [${date} 14:30] - Category filtering scoping validated`,
          `✦ [Current Status] - ${status.toUpperCase()}`
        ];
        
        showAuditModal(num, status, date, timeline);
      });
    });

    // Print button hook
    document.getElementById('config-print-btn')?.addEventListener('click', () => {
      window.print();
    });

    // Append Custom Clause Handler
    document.getElementById('append-clause-btn')?.addEventListener('click', () => {
      const titleInput = document.getElementById('custom-clause-title') as HTMLInputElement;
      const contentText = document.getElementById('custom-clause-content') as HTMLTextAreaElement;
      const title = titleInput.value.trim();
      const content = contentText.value.trim();
      if (!title || !content) return;
      
      const parent = document.getElementById('print-legal-clauses-area')!;
      const div = document.createElement('div');
      div.className = 'clause-block mt-3';
      div.innerHTML = `
        <h5 class="font-bold text-slate-800">${title}</h5>
        <p class="text-slate-500 mt-0.5 leading-relaxed text-[9px]">${content}</p>
      `;
      parent.appendChild(div);
      
      titleInput.value = '';
      contentText.value = '';
      document.getElementById('no-clauses-msg')?.classList.add('hidden');
    });

    // Quick shortcuts
    const shortcutMapping: Record<string, {title: string, content: string}> = {
      'shortcut-bank': { title: 'Bank Remittance Details', content: 'Delight Group bank deposits go to Account: 120938491829. IBAN: AE210009281.' },
      'shortcut-remit': { title: 'Swift confirmation note', content: 'Kindly submit bank deposit / swift transfer slips to invoice@delightgroup.com.' },
      'shortcut-trn': { title: 'Taxes Reference registration', content: 'Corporate verified TRN identifier: 10003862800003.' },
      'shortcut-tax': { title: 'Tax standard compliance', content: 'Prices specified include a standard 5% VAT rate unless specified otherwise.' },
      'shortcut-disc': { title: 'Settlement Terms conditions', content: 'Discount provisions are applicable strictly under prompt due-date clearing.' },
      'shortcut-note': { title: 'General delivery remarks', content: 'Report inventory / shipping discrepancies within 24 hours of delivery receipt.' }
    };
    
    Object.keys(shortcutMapping).forEach(id => {
      document.getElementById(id)?.addEventListener('click', () => {
        const details = shortcutMapping[id];
        (document.getElementById('custom-clause-title') as HTMLInputElement).value = details.title;
        (document.getElementById('custom-clause-content') as HTMLTextAreaElement).value = details.content;
      });
    });

    // Global memory reference for live configuration updates
    let activePreviewInv: any = null;

    // Items table renderer
    const populateItemsTable = (inv: any, showImages: boolean) => {
      const printTbody = document.getElementById('print-items-list')!;
      printTbody.innerHTML = '';
      
      let parsedItems = [];
      if (Array.isArray(inv.items_list)) {
        parsedItems = inv.items_list;
      } else if (typeof inv.items_list === 'string') {
        try {
          parsedItems = JSON.parse(inv.items_list);
        } catch {
          parsedItems = [];
        }
      }

      const allProds = JSON.parse(document.getElementById('preview-products-data')?.textContent || '[]');

      parsedItems.forEach((item: any) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-slate-100 text-slate-800 align-top';
        
        let descContent = `<div><div class="font-extrabold text-slate-900 leading-snug">${item.description}</div>`;
        if (item.catalogue_ref) descContent += `<div class="text-[10px] text-slate-500 font-mono mt-0.5">REF: ${item.catalogue_ref}</div>`;
        if (item.tech_spec) descContent += `<div class="text-[9px] text-slate-455 mt-1 max-w-sm leading-relaxed">${item.tech_spec}</div>`;
        descContent += `</div>`;

        // If showImages toggle is active, render the product thumbnail
        let imageMarkup = '';
        if (showImages) {
          const imgUrl = item.item_image || allProds.find((p: any) => p.id === item.product_id)?.image_url;
          if (imgUrl) {
            imageMarkup = `<img src="${imgUrl}" class="w-10 h-10 rounded object-cover border border-slate-200 shrink-0 mt-0.5 shadow-sm" />`;
          }
        }

        tr.innerHTML = `
          <td class="py-3 pr-2 min-w-0">
            <div class="flex items-start gap-3 min-w-0">
              ${imageMarkup}
              <div class="min-w-0 flex-1 break-words">
                ${descContent}
              </div>
            </div>
          </td>
          <td class="py-3 text-center font-bold text-slate-700 align-top">${item.quantity}</td>
          <td class="py-3 text-right font-semibold text-slate-550 align-top pr-2">AED ${Number(item.unit_price).toFixed(2)}</td>
          <td class="py-3 text-right font-black text-slate-900 align-top">AED ${(item.quantity * item.unit_price).toFixed(2)}</td>
        `;
        printTbody.appendChild(tr);
      });
    };

    // Modal populate preview
    window.showInvoicePreview = function(inv: any) {
      activePreviewInv = inv;

      // Document Type Prefill Matching
      const docTypeSelect = document.getElementById('config-doc-type') as HTMLSelectElement;
      if (inv.order_type === 'quotation') {
        docTypeSelect.value = 'ESTIMATION';
      } else if (inv.order_type === 'lpo') {
        docTypeSelect.value = 'PRO FORMA INVOICE';
      } else if (inv.order_type === 'tax_invoice') {
        docTypeSelect.value = 'TAX INVOICE';
      } else if (inv.order_type === 'delivery_note') {
        docTypeSelect.value = 'DELIVERY NOTE';
      } else {
        docTypeSelect.value = 'TAX INVOICE';
      }
      // Update printable title initially
      document.getElementById('print-doc-header-title')!.textContent = docTypeSelect.value;

      // Reset dynamic signatures
      customSignatures = [];
      (document.getElementById('config-sig-placement') as HTMLSelectElement).value = 'none';
      (document.getElementById('sig-client') as HTMLInputElement).checked = true;
      (document.getElementById('sig-company') as HTMLInputElement).checked = true;
      (document.getElementById('sig-it') as HTMLInputElement).checked = false;
      renderSignatures();

      // Reset electronic notice
      const noticeCb = document.getElementById('config-show-electronic-notice') as HTMLInputElement | null;
      if (noticeCb) noticeCb.checked = true;
      const noticeBadge = document.getElementById('print-electronic-badge');
      if (noticeBadge) noticeBadge.style.display = 'block';

      // Reset visual options to defaults
      (document.getElementById('config-show-logo') as HTMLInputElement).checked = true;
      document.getElementById('print-logo-container')!.style.display = 'flex';
      (document.getElementById('config-show-watermark') as HTMLInputElement).checked = true;
      document.getElementById('print-watermark')!.style.display = 'flex';
      document.getElementById('print-watermark')!.style.opacity = '0.03';
      (document.getElementById('config-watermark-opacity') as HTMLInputElement).value = '3';
      document.getElementById('watermark-opacity-val')!.textContent = '3%';
      document.getElementById('watermark-img')!.style.width = '500px';
      (document.getElementById('config-watermark-size') as HTMLInputElement).value = '500';
      document.getElementById('watermark-size-val')!.textContent = '500px';
      
      // Sync branding selector and show product images
      (document.getElementById('config-branding-logo') as HTMLSelectElement).value = 'auto';
      (document.getElementById('config-show-prod-images') as HTMLInputElement).checked = !!inv.show_images;

      // Render logo based on auto-detect or default
      updateLogo();

      document.getElementById('print-inv-number')!.textContent = inv.invoice_number;
      const invNumP2 = document.getElementById('print-inv-number-p2');
      if (invNumP2) invNumP2.textContent = inv.invoice_number;
      document.getElementById('print-cust-name')!.textContent = inv.customer_name;
      document.getElementById('print-company-name')!.textContent = inv.company_name || '';
      document.getElementById('print-company-vat')!.textContent = inv.company_vat ? `TRN / VAT: ${inv.company_vat}` : '';
      document.getElementById('print-cust-email')!.textContent = inv.customer_email || '';
      document.getElementById('print-cust-phone')!.textContent = inv.customer_phone || '';
      document.getElementById('print-cust-address')!.textContent = inv.billing_address || '';
      
      // Populate Document Info Grid (Mockup Matching)
      document.getElementById('print-info-division')!.textContent = inv.source_division || 'DTL';
      document.getElementById('print-info-status')!.textContent = inv.payment_status === 'paid' ? 'CONFIRMED' : inv.payment_status.toUpperCase();
      document.getElementById('print-info-ref')!.textContent = inv.invoice_number;
      document.getElementById('print-info-date')!.textContent = new Date(inv.issue_date).toLocaleDateString('en-AE');
      document.getElementById('print-info-delivery')!.textContent = inv.due_date ? new Date(inv.due_date).toLocaleDateString('en-AE') : 'N/A';

      const isLegacyTerms = inv.payment_terms && typeof inv.payment_terms === 'string' && !inv.payment_terms.startsWith('[');
      if (isLegacyTerms) {
        // Appended inside clauses dynamically if it exists
        const parent = document.getElementById('print-legal-clauses-area')!;
        const div = document.createElement('div');
        div.className = 'clause-block mt-3 legacy-terms-block';
        div.innerHTML = `
          <h5 class="font-bold text-slate-800">Payment Terms Remarks</h5>
          <p class="text-slate-550 mt-0.5 leading-relaxed text-[9px]">${inv.payment_terms}</p>
        `;
        parent.appendChild(div);
      }

      // Populate disclaimers & sync sidebar checkboxes
      let selectedDisclaimers = [];
      try {
        selectedDisclaimers = JSON.parse(inv.payment_terms || '[]');
      } catch(err) {
        selectedDisclaimers = [];
      }
      
      const clauseBlocks = document.querySelectorAll('.clause-block') as NodeListOf<HTMLElement>;
      let hasVisibleClause = false;
      
      // Selectively show/hide clauses in template and update sidebar checked states
      const isJson = inv.payment_terms && typeof inv.payment_terms === 'string' && inv.payment_terms.startsWith('[');
      clauseBlocks.forEach(block => {
        // Clear any old legacy terms blocks before adding
        if (block.classList.contains('legacy-terms-block')) {
          block.remove();
          return;
        }
        const ident = block.getAttribute('data-identifier') || '';
        const shouldShow = !isJson || (Array.isArray(selectedDisclaimers) && selectedDisclaimers.includes(ident));
        if (shouldShow) {
          block.classList.remove('hidden');
          hasVisibleClause = true;
        } else {
          block.classList.add('hidden');
        }

        // Sync sidebar checkbox
        const toggleCb = document.querySelector(`.config-clause-toggle-cb[data-clause-ident="${ident}"]`) as HTMLInputElement;
        if (toggleCb) toggleCb.checked = shouldShow;
      });

      // Bind clause toggle event listeners live previews
      const configToggles = document.querySelectorAll('.config-clause-toggle-cb') as NodeListOf<HTMLInputElement>;
      configToggles.forEach(cb => {
        const ident = cb.getAttribute('data-clause-ident') || '';
        
        // Remove existing listener to prevent duplicate firing
        const newCb = cb.cloneNode(true) as HTMLInputElement;
        cb.parentNode!.replaceChild(newCb, cb);

        newCb.addEventListener('change', () => {
          const liveCheck = (document.getElementById('preview-live') as HTMLInputElement).checked;
          if (!liveCheck) return; // ignore if livepreview is disabled

          const block = document.querySelector(`.clause-block[data-identifier="${ident}"]`);
          if (block) {
            if (newCb.checked) {
              block.classList.remove('hidden');
            } else {
              block.classList.add('hidden');
            }
          }
          
          let anyVisible = false;
          document.querySelectorAll('.clause-block').forEach(b => {
            if (!b.classList.contains('hidden')) anyVisible = true;
          });
          const noClausesMsg = document.getElementById('no-clauses-msg')!;
          if (noClausesMsg) {
            if (anyVisible) noClausesMsg.classList.add('hidden');
            else noClausesMsg.classList.remove('hidden');
          }
        });
      });
      
      const noClausesMsg = document.getElementById('no-clauses-msg')!;
      if (noClausesMsg) {
        if (hasVisibleClause) {
          noClausesMsg.classList.add('hidden');
        } else {
          noClausesMsg.classList.remove('hidden');
        }
      }

      // Status color styles on print
      const statusSpan = document.getElementById('print-info-status')!;
      if (inv.payment_status === 'paid') {
        statusSpan.className = 'font-black uppercase text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200/50';
      } else {
        statusSpan.className = 'font-black uppercase text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200/50';
      }

      // Populate items table
      populateItemsTable(inv, (document.getElementById('config-show-prod-images') as HTMLInputElement).checked);

      const sub = Number(inv.subtotal) || 0;
      const gst = Number(inv.gst_amount) || 0;
      const disc = Number(inv.discount_amount) || 0;
      const grand = Number(inv.total_amount) || 0;

      document.getElementById('print-subtotal')!.textContent = `AED ${sub.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      document.getElementById('print-gst')!.textContent = `AED ${gst.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      
      const discountRow = document.getElementById('print-discount-row')!;
      if (disc > 0) {
        discountRow.classList.remove('hidden');
        document.getElementById('print-discount')!.textContent = `- AED ${disc.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      } else {
        discountRow.classList.add('hidden');
      }

      document.getElementById('print-total')!.textContent = `AED ${grand.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

      // Smart accounting calculations matching screenshot
      let offerPd = 0;
      if (inv.payment_status === 'paid') {
        offerPd = grand;
      } else if (inv.order_type === 'proforma') {
        offerPd = grand * 0.5; // 50% advance payment
      }
      
      document.getElementById('print-offer-pd')!.textContent = `AED ${offerPd.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      document.getElementById('print-balance-due')!.textContent = `AED ${(grand - offerPd).toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

      const balanceDueEl = document.getElementById('print-balance-due')!;
      if (grand - offerPd > 0) {
        balanceDueEl.className = 'font-black font-mono text-rose-600';
      } else {
        balanceDueEl.className = 'font-black font-mono text-slate-800';
      }

      // Unhide
      document.getElementById('invoice-preview-modal')!.classList.remove('hidden');
      document.getElementById('invoice-preview-modal')!.classList.add('flex');
    };

    // Billing Workflow Help Modal triggers
    const helpBtn = document.getElementById('billing-workflow-help-btn');
    const helpModal = document.getElementById('billing-workflow-help-modal');
    const closeHelpBtn = document.getElementById('close-workflow-help-btn');
    const closeHelpBottomBtn = document.getElementById('close-workflow-help-bottom-btn');

    const openHelp = () => {
      helpModal?.classList.remove('hidden');
      helpModal?.classList.add('flex');
    };
    const closeHelp = () => {
      helpModal?.classList.add('hidden');
      helpModal?.classList.remove('flex');
    };

    helpBtn?.addEventListener('click', openHelp);
    closeHelpBtn?.addEventListener('click', closeHelp);
    closeHelpBottomBtn?.addEventListener('click', closeHelp);
    helpModal?.addEventListener('click', (e) => {
      if (e.target === helpModal) closeHelp();
    });

    // Operation Buttons Event Listeners
    document.querySelectorAll('.view-invoice-btn, .print-invoice-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const invData = JSON.parse(target.getAttribute('data-invoice') || '{}');
        if (typeof (window as any).showInvoicePreview === 'function') {
          (window as any).showInvoicePreview(invData);
        }
      });
    });

    document.querySelectorAll('.update-invoice-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const invData = JSON.parse(target.getAttribute('data-invoice') || '{}');
        document.dispatchEvent(new CustomEvent('open-invoice-modal', { detail: { invoice: invData } }));
      });
    });

    document.querySelectorAll('.cancel-invoice-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const num = target.getAttribute('data-num') || '';
        alert(`Order Cancelled! System has locked record and sent notifications for ${num}.`);
      });
    });
  </script>

  {isAdmin && <InvoiceForm />}
</DashboardLayout>
