---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import InvoiceForm from '../../../components/forms/InvoiceForm.astro';
import { query } from '../../../lib/db';
import { FileSpreadsheet, PlusCircle, Search, Save, AlertTriangle, Printer, CheckCircle, Clock } from '@lucide/astro';

const user = Astro.locals.user;
const roles = Astro.locals.roles || [];
const permissions = Astro.locals.permissions || [];
const isAdmin = roles.includes('admin') || roles.includes('moderator') || permissions.includes('invoices.manage');

let invoices: any[] = [];
let dbConnected = true;
let settings: Record<string, string> = {};
let legalArtifacts: any[] = [];
let products: any[] = [];

try {
  const queryStr = isAdmin
    ? `SELECT i.*, 
         (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list
       FROM invoices i
       ORDER BY i.created_at DESC`
    : `SELECT i.*, 
         (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list
       FROM invoices i
       WHERE i.customer_email = $1
       ORDER BY i.created_at DESC`;
  
  const queryParams = isAdmin ? [] : [user?.email || ''];
  const res = await query(queryStr, queryParams);
  invoices = res.rows;

  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => { acc[row.key] = row.value; return acc; }, {});

  const legalRes = await query('SELECT * FROM legal_artifacts ORDER BY type DESC, identifier ASC');
  legalArtifacts = legalRes.rows;

  const prodRes = await query(`
    SELECT p.id, pi.url as image_url
    FROM products p
    LEFT JOIN product_images pi ON pi.product_id = p.id AND pi.is_primary = TRUE
  `);
  products = prodRes.rows;
} catch (err: any) {
  console.warn('Database offline, running mock invoices billing sheets:', err.message);
  dbConnected = false;

  invoices = [
    {
      id: 'inv-mock-1',
      invoice_number: 'INV-2026-8094',
      customer_name: 'Vance Metallurgy LLC',
      customer_email: 'alex.vance@steelgroup.com',
      customer_phone: '+1 (555) 0189',
      issue_date: '2026-05-10',
      due_date: '2026-06-10',
      payment_status: 'paid',
      subtotal: 10500,
      gst_amount: 1890,
      total_amount: 12390,
      items_list: [
        { description: 'HP-100 Stainless Ball Valve (Duplex option)', quantity: 2, unit_price: 5250, total_price: 10500 }
      ]
    },
    {
      id: 'inv-mock-2',
      invoice_number: 'INV-2026-1102',
      customer_name: 'Stark ot Software Corp',
      customer_email: 'finance@starkcorp.com',
      customer_phone: null,
      issue_date: '2026-05-24',
      due_date: '2026-06-24',
      payment_status: 'unpaid',
      subtotal: 15000,
      gst_amount: 2700,
      total_amount: 17700,
      items_list: [
        { description: 'Vortex Backup Cloud Telemetry Sync Broadsheet License', quantity: 1, unit_price: 15000, total_price: 15000 }
      ]
    }
  ];
}

// Pre-calculate procurement stages and button matrix configs to avoid JSX compiler parser issues with "<"
invoices = invoices.map(inv => {
  const isPaid = inv.payment_status === 'paid';
  const isConfirmed = inv.payment_status === 'paid' || inv.payment_status === 'confirmed';
  const type = inv.order_type || 'tax_invoice';

  let stage = 6;
  if (isPaid) {
    stage = 7;
  } else if (type === 'inquiry') {
    stage = 1;
  } else if (type === 'quotation') {
    stage = 2;
  } else if (type === 'proforma') {
    stage = 3;
  } else if (type === 'lpo') {
    stage = 4;
  } else if (type === 'delivery_note') {
    stage = 5;
  } else if (type === 'tax_invoice') {
    stage = 6;
  }

  const showAudit = stage >= 4;
  const showUpdate = stage <= 3 || (stage === 4 && !isConfirmed);
  const showConfirm = (stage === 2 || stage === 3 || stage === 4) && !isConfirmed;
  const showBill = stage === 6;
  const showCancelOrder = stage === 4 || stage === 5 || stage === 6;

  const isDraftOrUnconfirmed = stage <= 3 || (stage === 4 && !isConfirmed);
  const deleteLabel = isDraftOrUnconfirmed ? 'DELETE' : 'ARCHIVE';
  const deleteBtnClass = isDraftOrUnconfirmed 
    ? "delete-btn px-2 py-1.5 border border-rose-100 bg-rose-50 hover:bg-rose-100 text-[9px] font-black text-rose-700 rounded transition-colors uppercase tracking-wider"
    : "delete-btn px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-bold text-slate-600 rounded transition-colors uppercase tracking-wider";

  return {
    ...inv,
    isPaid,
    isConfirmed,
    stage,
    showAudit,
    showUpdate,
    showConfirm,
    showBill,
    showCancelOrder,
    deleteLabel,
    deleteBtnClass
  };
});
---

<DashboardLayout title="Billing & Invoices" activeItem="invoices">

  <style is:global></style>

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL Connection Offline</span>: Invoicing runs in simulated mock registry mode.
      </div>
    </div>
  )}

  <div class="space-y-6 p-6 lg:p-8">
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 border-b border-slate-200 pb-4">
      <div class="flex flex-wrap items-center gap-2 flex-grow max-w-3xl">
        <div class="relative flex-grow max-w-xs">
          <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" />
          <input 
            type="text" 
            id="admin-search-invoices"
            placeholder="Search by client or INV#..." 
            class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
          />
        </div>
        <select id="filter-invoice-status" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
          <option value="">All Statuses</option>
          <option value="paid">Paid</option>
          <option value="unpaid">Unpaid</option>
          <option value="overdue">Overdue</option>
          <option value="draft">Draft</option>
          <option value="cancelled">Cancelled</option>
        </select>
        <select id="filter-invoice-division" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
          <option value="">All Divisions</option>
          <option value="DTL">Division DTL</option>
          <option value="DGS">Division DGS</option>
        </select>
        <select id="sort-invoices" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 focus:outline-none">
          <option value="newest">Newest Issued</option>
          <option value="oldest">Oldest Issued</option>
          <option value="amount-desc">Total: High to Low</option>
          <option value="amount-asc">Total: Low to High</option>
        </select>
      </div>
      <div class="flex gap-2 shrink-0">
        <button 
          type="button" 
          id="billing-workflow-help-btn"
          class="inline-flex items-center justify-center gap-2 bg-slate-55 border border-slate-200 hover:bg-slate-100 text-slate-700 px-4 py-2.5 rounded-lg text-xs font-bold transition-colors shadow-3xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Billing Workflow
        </button>
        {isAdmin && (
          <button 
            type="button" 
            onclick="document.dispatchEvent(new CustomEvent('open-invoice-modal', { detail: { invoice: null } }))"
            class="inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-4 py-2.5 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <PlusCircle class="h-4 w-4" />
            Generate Invoice
          </button>
        )}
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-widest font-black">
                <th class="px-6 py-4">Reference</th>
                <th class="px-6 py-4">Client Details</th>
                <th class="px-6 py-4 text-center">Valuation</th>
                <th class="px-6 py-4 text-center">Status</th>
                <th class="px-6 py-4 text-right pr-12">Operations</th>
              </tr>
            </thead>
            <tbody id="admin-invoices-table">
              {invoices.map(inv => (
                <tr class="admin-invoice-row border-b border-slate-100 hover:bg-slate-50/50 text-xs transition-colors" 
                  data-id={inv.id} 
                  data-name={inv.customer_name} 
                  data-email={inv.customer_email || ''} 
                  data-phone={inv.customer_phone || ''} 
                  data-issue={inv.issue_date} 
                  data-due={inv.due_date || ''} 
                  data-status={inv.payment_status} 
                  data-items={JSON.stringify(inv.items_list || [])} 
                  data-num={inv.invoice_number}
                  data-div={inv.source_division || ''}
                  data-amount={inv.total_amount}
                  data-date={inv.issue_date}
                >
                  <td class="px-6 py-5">
                    <div class="font-extrabold text-slate-900 text-sm tracking-tight">{inv.invoice_number}</div>
                    <div class="flex items-center gap-1.5 mt-1.5">
                      <span class="inline-block px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-500 text-[9px] font-black uppercase tracking-wider">
                        {inv.order_type === 'quotation' ? 'Estimation' : (inv.order_type === 'lpo' ? 'LPO' : (inv.order_type === 'inquiry' ? 'Inquiry' : (inv.order_type === 'proforma' ? 'Pro Forma' : (inv.order_type === 'delivery_note' ? 'Delivery Note' : 'Tax Invoice'))))}
                      </span>
                      <span class="text-[9px] font-extrabold text-slate-400 uppercase tracking-widest">{inv.source_division || 'DTL'}</span>
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <div class="font-black text-slate-800 uppercase tracking-wide">{inv.customer_name}</div>
                    <div class="text-2xs font-extrabold text-slate-400 mt-1 uppercase tracking-wider">{inv.issue_date ? new Date(inv.issue_date).toLocaleDateString('en-AE', { day: 'numeric', month: 'short', year: 'numeric' }) : ''}</div>
                  </td>
                  <td class="px-6 py-5 text-center">
                    <div class="font-black text-slate-800 text-[13px] tracking-tight">AED {Number(inv.total_amount).toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</div>
                    <div class="text-[9px] font-bold text-slate-400 mt-1 uppercase tracking-widest">Total Valuation</div>
                  </td>
                  <td class="px-6 py-5 text-center">
                    <span class={`inline-block border rounded px-3 py-1 text-[9px] font-black uppercase tracking-widest shadow-2xs ${inv.isPaid ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-200 bg-white text-slate-500'}`}>
                      {inv.payment_status === 'paid' ? 'CONFIRMED' : inv.payment_status.toUpperCase()}
                    </span>
                  </td>
                  <td class="px-6 py-5 text-right pr-6">
                    <div class="flex justify-end">
                      {isAdmin ? (
                        <div class="grid grid-cols-3 gap-1.5 w-64">
                          {/* VIEW button - always visible */}
                          <a href={`/dashboard/invoices/${inv.id}`} class="inline-flex items-center justify-center px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs">
                            View
                          </a>
                          
                          {/* AUDIT button - from Stage 4 onwards */}
                          {inv.showAudit ? (
                            <button type="button" class="audit-invoice-btn px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs" data-num={inv.invoice_number} data-status={inv.payment_status} data-date={inv.issue_date}>
                              Audit
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">N/A</div>
                          )}

                          {/* PRINT button - always visible */}
                          <a href={`/dashboard/invoices/print/${inv.id}`} class="inline-flex items-center justify-center px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs">
                            Print
                          </a>

                          {/* UPDATE button - unconfirmed draft stage only */}
                          {inv.showUpdate ? (
                            <button type="button" class="update-invoice-btn px-2 py-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-[9px] font-black text-slate-600 rounded transition-colors uppercase tracking-wider shadow-3xs" data-invoice={JSON.stringify(inv)}>
                              Update
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">Locked</div>
                          )}

                          {/* BILL button - Stage 6 only */}
                          {inv.showBill ? (
                            <button type="button" class="bill-invoice-btn px-2 py-1.5 border border-emerald-100 bg-emerald-50 hover:bg-emerald-100/70 text-[9px] font-black text-emerald-700 rounded transition-colors uppercase tracking-wider" data-id={inv.id}>
                              Bill
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">N/A</div>
                          )}

                          {/* CONFIRM button - Stage 2, 3, 4 only */}
                          {inv.showConfirm ? (
                            <button type="button" class="confirm-payment-btn px-2 py-1.5 border border-blue-100 bg-blue-50 hover:bg-blue-100/70 text-[9px] font-black text-blue-700 rounded transition-colors uppercase tracking-wider" data-id={inv.id}>
                              Confirm
                            </button>
                          ) : (
                            <div class="px-2 py-1.5 bg-slate-50 border border-slate-100 rounded text-[9px] font-bold text-slate-300 uppercase tracking-wider text-center cursor-not-allowed select-none">Approved</div>
                          )}

                          {/* CANCEL ORDER button - Stages 4, 5, 6 only */}
                          {inv.showCancelOrder ? (
                            <button type="button" class="cancel-invoice-btn px-2 py-1.5 border border-amber-100 bg-amber-50 hover:bg-amber-100 text-[9px] font-black text-amber-700 rounded transition-colors uppercase tracking-wider col-span-3" data-num={inv.invoice_number}>
                              Cancel Order
                            </button>
                          ) : null}

                          {/* DELETE / ARCHIVE button - always visible, layout and labels changes dynamically */}
                          <button type="button" class={inv.deleteBtnClass} data-id={inv.id}>
                            {inv.deleteLabel}
                          </button>
                        </div>
                      ) : (
                        <div class="flex gap-2 justify-end w-44">
                          <a href={`/dashboard/invoices/${inv.id}`} class="inline-flex items-center justify-center px-4 py-2 border border-slate-200 bg-white hover:bg-slate-50 text-[10px] font-black text-slate-650 rounded-lg transition-colors uppercase tracking-wider shadow-3xs flex-1 text-center">
                            View Details
                          </a>
                          <a href={`/dashboard/invoices/print/${inv.id}`} class="inline-flex items-center justify-center px-4 py-2 border border-slate-200 bg-white hover:bg-slate-50 text-[10px] font-black text-slate-650 rounded-lg transition-colors uppercase tracking-wider shadow-3xs flex-1 text-center">
                            Print
                          </a>
                        </div>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

  <!-- Billing Workflow Help Modal / FAQ Overlay -->
  <div id="billing-workflow-help-modal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-5xl max-h-[90vh] flex flex-col overflow-hidden shadow-2xl">
      
      <!-- Header -->
      <div class="p-5 border-b border-slate-200 bg-slate-50/80 flex justify-between items-center shrink-0">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2 uppercase tracking-wider">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Billing Progression & FAQ Guide
        </h3>
        <button type="button" id="close-workflow-help-btn" class="text-slate-500 hover:text-slate-800 rounded-lg p-1.5 hover:bg-slate-100 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Body -->
      <div class="flex-1 overflow-y-auto p-6 space-y-6 text-slate-700">
        
        <!-- 2-Column Split Workspace -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          
          <!-- Left Column (Stepper & Description): 5/12 width -->
          <div class="lg:col-span-5 space-y-4">
            <h4 class="font-extrabold text-cyan-600 uppercase tracking-widest text-xs border-b border-slate-200 pb-2">Document Progression Pipeline</h4>
            
            <div class="space-y-4 bg-slate-50 p-5 rounded-2xl border border-slate-200">
              <!-- Stepper List -->
              <div class="relative pl-6 space-y-5 border-l-2 border-slate-200">
                <div class="relative">
                  <div class="absolute -left-[31px] top-0.5 h-4 w-4 rounded-full bg-slate-200 border-2 border-slate-350 flex items-center justify-center text-[9px] font-black text-slate-700">1</div>
                  <h5 class="font-bold text-slate-800 uppercase tracking-wide text-xs">Stage 1: Inquiry</h5>
                  <p class="text-xs text-slate-550 mt-1">Initial draft of buyer request. Fully editable.</p>
                </div>
                <div class="relative">
                  <div class="absolute -left-[31px] top-0.5 h-4 w-4 rounded-full bg-cyan-50 border-2 border-cyan-300 flex items-center justify-center text-[9px] font-black text-cyan-700">2</div>
                  <h5 class="font-bold text-cyan-700 uppercase tracking-wide text-xs">Stage 2 & 3: Estimation / Pro Forma</h5>
                  <p class="text-xs text-slate-655 mt-1">Official quote sent. "Confirm" locks edit and approves state.</p>
                </div>
                <div class="relative">
                  <div class="absolute -left-[31px] top-0.5 h-4 w-4 rounded-full bg-slate-200 border-2 border-slate-350 flex items-center justify-center text-[9px] font-black text-slate-700">3</div>
                  <h5 class="font-bold text-slate-800 uppercase tracking-wide text-xs">Stage 4: LPO (Purchase Order)</h5>
                  <p class="text-xs text-slate-550 mt-1">Legally confirmed buyer purchase registry order.</p>
                </div>
                <div class="relative">
                  <div class="absolute -left-[31px] top-0.5 h-4 w-4 rounded-full bg-slate-200 border-2 border-slate-350 flex items-center justify-center text-[9px] font-black text-slate-700">4</div>
                  <h5 class="font-bold text-slate-800 uppercase tracking-wide text-xs">Stage 5 & 6: Delivery Note & Commercial Bill</h5>
                  <p class="text-xs text-slate-655 mt-1">Goods shipped. "Bill" processes the tax invoice for payment.</p>
                </div>
                <div class="relative">
                  <div class="absolute -left-[31px] top-0.5 h-4 w-4 rounded-full bg-emerald-50 border-2 border-emerald-300 flex items-center justify-center text-[9px] font-black text-emerald-700">5</div>
                  <h5 class="font-bold text-emerald-700 uppercase tracking-wide text-xs">Stage 7: Settled / Paid</h5>
                  <p class="text-xs text-emerald-600/95 mt-1">Order completed. All parameters locked for financial audit.</p>
                </div>
              </div>
            </div>
            
            <div class="bg-amber-50 border border-amber-250 rounded-xl p-4 text-xs text-amber-800 leading-relaxed space-y-1">
              <span class="font-black uppercase tracking-wider block text-xs">✦ Progression & Lock Rules</span>
              <p>Quotations are draft-editable. Once order transitions to Stage 4 (LPO), all product parameters are safely locked. Stage 6 enables Commercial Billing (Tax Invoice) which locks tax compliance settings.</p>
            </div>
          </div>
          
          <!-- Right Column (FAQ accordion): 7/12 width -->
          <div class="lg:col-span-7 space-y-4">
            <h4 class="font-extrabold text-cyan-600 uppercase tracking-widest text-xs border-b border-slate-200 pb-2">Frequently Asked Billing Questions</h4>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              
              <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2 hover:border-slate-300 hover:bg-slate-100/50 transition-colors">
                <span class="text-emerald-600 text-sm flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"/></svg>
                  <h5 class="font-extrabold uppercase tracking-wider text-xs text-slate-800">1. Print & PDF Generation</h5>
                </span>
                <p class="leading-relaxed text-slate-600 text-xs">
                  Click the **Print** button in any row. This loads the print canvas modal. Set watermark transparency, product image columns, and disclaimer clauses in the sidebar, then click **Print / Save PDF**.
                </p>
              </div>

