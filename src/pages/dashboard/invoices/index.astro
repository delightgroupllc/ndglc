                  <td class="px-4 py-3 text-center flex items-center justify-center gap-1.5"><span class="px-2 py-1 rounded bg-slate-100 text-[9px] font-bold text-slate-700 uppercase">View</span><span class="px-2 py-1 rounded bg-slate-100 text-[9px] font-bold text-slate-700 uppercase">Print</span><span class="px-2 py-1 rounded bg-slate-50 border border-slate-200 text-[9px] font-bold text-slate-600 uppercase">Archive</span></td>
                  <td class="px-4 py-3 text-emerald-600/90 font-medium">Funds safely processed and received. Billing finalized and fully locked.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Footer -->
      <div class="p-4 bg-slate-55 border-t border-slate-200 flex justify-end shrink-0">
        <button type="button" id="close-workflow-help-bottom-btn" class="bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs px-5 py-2.5 rounded-lg transition-colors uppercase tracking-wider">
          Close Guide
        </button>
      </div>
    </div>
  </div>

  <!-- CONFIRMATION MODAL -->
  <div id="confirm-modal-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-white w-full max-w-sm rounded-2xl shadow-xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <div class="p-6">
        <div class="flex items-center gap-3 mb-4">
          <div id="confirm-modal-icon-container" class="w-10 h-10 rounded-full flex items-center justify-center shrink-0">
            <svg id="confirm-modal-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 id="confirm-modal-title" class="text-lg font-bold text-slate-800">Confirm Action</h3>
        </div>
        <p id="confirm-modal-message" class="text-sm font-semibold text-slate-600 mb-6">Are you sure you want to proceed?</p>
        
        <div class="flex justify-end gap-3">
          <button type="button" id="confirm-cancel-btn" class="px-4 py-2 rounded-lg text-xs font-bold border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
            Cancel
          </button>
          <button type="button" id="confirm-proceed-btn" class="px-4 py-2 rounded-lg text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors">
            Proceed
          </button>
        </div>
      </div>
    </div>
  </div>

  
  <div id="audit-modal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
      <div class="p-4 bg-slate-50 border-b border-slate-200 flex justify-between">
        <h3 class="font-black text-slate-800 uppercase tracking-wider text-xs">Order Audit Trail</h3>
        <button type="button" onclick="document.getElementById('audit-modal').classList.add('hidden');document.getElementById('audit-modal').classList.remove('flex')" class="text-slate-400 hover:text-slate-800">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6">
        <div class="text-xs font-bold text-slate-500 mb-4" id="audit-num"></div>
        <div class="space-y-4 border-l-2 border-slate-100 pl-4" id="audit-timeline">
        </div>
      </div>
    </div>
  </div>
<!-- Hidden products list JSON payload for script image-lookup rendering -->
    <div id="preview-products-data" class="hidden">{JSON.stringify(products)}</div>

              
  <script>
    // --- Confirmation Modal Helper ---
    (window as any).showConfirm = (message: string, title: string = 'Confirm Action', isDestructive: boolean = false): Promise<boolean> => {
      return new Promise((resolve) => {
        const confirmModal = document.getElementById('confirm-modal-backdrop')!;
        const confirmTitle = document.getElementById('confirm-modal-title')!;
        const confirmMessage = document.getElementById('confirm-modal-message')!;
        const confirmCancelBtn = document.getElementById('confirm-cancel-btn')!;
        const confirmProceedBtn = document.getElementById('confirm-proceed-btn')!;
        const iconContainer = document.getElementById('confirm-modal-icon-container')!;

        confirmTitle.textContent = title;
        confirmMessage.textContent = message;

        if (isDestructive) {
          iconContainer.className = 'w-10 h-10 rounded-full flex items-center justify-center shrink-0 bg-rose-100 text-rose-600';
          confirmProceedBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white transition-colors';
        } else {
          iconContainer.className = 'w-10 h-10 rounded-full flex items-center justify-center shrink-0 bg-amber-100 text-amber-600';
          confirmProceedBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors';
        }

        confirmModal.classList.remove('hidden');
        confirmModal.classList.add('flex');

        const cleanup = () => {
          confirmProceedBtn.removeEventListener('click', onProceed);
          confirmCancelBtn.removeEventListener('click', onCancel);
          confirmModal.classList.add('hidden');
          confirmModal.classList.remove('flex');
        };

        const onProceed = () => { cleanup(); resolve(true); };
        const onCancel = () => { cleanup(); resolve(false); };

        confirmProceedBtn.addEventListener('click', onProceed);
        confirmCancelBtn.addEventListener('click', onCancel);
      });
    };
    const showAuditModal = (num, status, date, timeline) => {
      document.getElementById('audit-num').textContent = `REF: ${num}`;
      const tContainer = document.getElementById('audit-timeline');
      tContainer.innerHTML = '';
      timeline.forEach((t, i) => {
        const item = document.createElement('div');
        item.className = 'relative';
        item.innerHTML = `
          <div class="absolute -left-[21px] top-1 h-2.5 w-2.5 rounded-full ${i === timeline.length - 1 ? 'bg-cyan-500 border-2 border-cyan-100' : 'bg-slate-300'}"></div>
          <p class="font-bold text-slate-800 text-xs">${t}</p>
        `;
        tContainer.appendChild(item);
      });
      const modal = document.getElementById('audit-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };
  
    // Elements
    const searchInput = document.getElementById('admin-search-invoices') as HTMLInputElement | null;
    const statusFilter = document.getElementById('filter-invoice-status') as HTMLSelectElement | null;
    const divisionFilter = document.getElementById('filter-invoice-division') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('sort-invoices') as HTMLSelectElement | null;
    const tbody = document.getElementById('admin-invoices-table');
    const pickerEl = document.getElementById('invoices-date-picker');

    // Timeframe bar elements
    const timeframeBar = document.getElementById('orders-timeframe-bar');
    const tfLabel = document.getElementById('timeframe-info-label');
    const tfCount = document.getElementById('timeframe-info-count');
    const tfActions = document.getElementById('timeframe-actions');
    const noInvoicesState = document.getElementById('no-invoices-state');

    // Pagination elements
    const startEl = document.getElementById('orders-pagination-start');
    const endEl = document.getElementById('orders-pagination-end');
    const totalEl = document.getElementById('orders-pagination-total');
    const paginationButtons = document.getElementById('orders-pagination-buttons');
    const limitBtns = document.querySelectorAll<HTMLButtonElement>('.orders-limit-btn');

    // State
    let currentPage = 1;
    let itemsPerPage = 10;
    let activePreset = 'all';
    let activeLabel = 'All Time';

    // Helper date functions
    function pad(n: number) { return String(n).padStart(2, '0'); }
    function toISODate(d: Date) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
    function fmtMonthName(d: Date) { return d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }); }
    function fmtFullDay(d: Date) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
    function fmtDatePretty(dStr: string) {
      if (!dStr) return '';
      const [y, m, d] = dStr.split('-').map(Number);
      if (!y || !m || !d) return dStr;
      const dt = new Date(y, m - 1, d);
      return dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }
    function fmtWeekRange(s: Date, e: Date) {
      return `${s.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })} – ${e.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}`;
    }

    // Limit button click handlers (10, 25, 50, 100)
    limitBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = parseInt(btn.getAttribute('data-limit') || '10');
        if (val === itemsPerPage) return;
        itemsPerPage = val;
        currentPage = 1;

        limitBtns.forEach(b => {
          const isActive = parseInt(b.getAttribute('data-limit') || '10') === itemsPerPage;
          b.className = `orders-limit-btn px-2.5 py-1 text-xs transition-colors border-r last:border-r-0 border-slate-200 ${
            isActive ? 'bg-cyan-50 text-cyan-700 font-black' : 'bg-white text-slate-600 hover:bg-slate-50 font-semibold'
          }`;
        });

        filterAndSortInvoices(false);
      });
    });

    document.getElementById('btn-empty-show-all')?.addEventListener('click', () => {
      pickerEl?.dispatchEvent(new CustomEvent('daterange-set', { detail: { preset: 'all' } }));
    });

    function filterAndSortInvoices(resetPage = true) {
      if (!tbody) return;
      if (resetPage) currentPage = 1;

      const rows = Array.from(tbody.querySelectorAll<HTMLElement>('.admin-invoice-row'));
      const query = searchInput?.value.toLowerCase().trim() || '';
      const status = statusFilter?.value || '';
      const division = divisionFilter?.value || '';
      const sort = sortSelect?.value || 'newest';
      const drpStart = (window as any)._drpInvoiceStart || null;
      const drpEnd = (window as any)._drpInvoiceEnd || null;

      // 1. Non-date filter check to gather dataset bounds
      const matchingBaseRows = rows.filter(row => {
        const name = row.getAttribute('data-name')?.toLowerCase() || '';
        const num = row.getAttribute('data-num')?.toLowerCase() || '';
        const rowStatus = row.getAttribute('data-status') || '';
        const rowDiv = (row.getAttribute('data-div') || '').toUpperCase();
        const targetDiv = division.toUpperCase();
        const isArchived = row.getAttribute('data-archived') === 'true';
        const isDeleted = row.getAttribute('data-deleted') === 'true';

        const matchesSearch = !query || name.includes(query) || num.includes(query);
        const matchesDiv = !division || rowDiv === targetDiv || (rowDiv === 'BOTH');

        let matchesStatus = false;
        if (status === 'archived') {
          matchesStatus = isArchived && !isDeleted;
        } else if (status === 'deleted') {
          matchesStatus = isDeleted;
        } else {
          matchesStatus = !isArchived && !isDeleted && (!status || rowStatus === status);
        }

        return matchesSearch && matchesStatus && matchesDiv;
      });

      // Collect all available dates from matchingBaseRows
      const allDates = matchingBaseRows
        .map(r => (r.getAttribute('data-date') || '').split('T')[0])
        .filter(Boolean)
        .sort();

      // 2. Filter matchingBaseRows by active date range
      const matchingRows = matchingBaseRows.filter(row => {
        const rowDate = row.getAttribute('data-date') || '';
        if (!rowDate) return true;
        const d = rowDate.split('T')[0];

        if (drpStart && drpEnd) {
          return d >= drpStart && d <= drpEnd;
        } else if (drpStart) {
          return d >= drpStart;
        }
        return true;
      });

      // 3. Sort matching rows
      matchingRows.sort((a, b) => {
        if (sort === 'newest') {
          return new Date(b.getAttribute('data-date') || '').getTime() - new Date(a.getAttribute('data-date') || '').getTime();
        } else if (sort === 'oldest') {
          return new Date(a.getAttribute('data-date') || '').getTime() - new Date(b.getAttribute('data-date') || '').getTime();
        } else if (sort === 'amount-desc') {
          return parseFloat(b.getAttribute('data-amount') || '0') - parseFloat(a.getAttribute('data-amount') || '0');
        } else if (sort === 'amount-asc') {
          return parseFloat(a.getAttribute('data-amount') || '0') - parseFloat(b.getAttribute('data-amount') || '0');
        }
        return 0;
      });

      // 4. Update Contextual Timeframe Bar ("Show More Orders" / Adjacent Nav)
      renderTimeframeBar(matchingRows, drpStart, drpEnd, allDates);

      // 5. Paginate and Render Table Rows
      const totalItems = matchingRows.length;
      const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = Math.min(startIndex + itemsPerPage, totalItems);

      // Hide all rows first
      rows.forEach(r => r.classList.add('hidden'));

      // Show sliced rows for current page and re-append in sorted order
      matchingRows.forEach((r, idx) => {
        if (idx >= startIndex && idx < endIndex) {
          r.classList.remove('hidden');
        }
        tbody.appendChild(r);
      });

      // Update Empty State
      if (totalItems === 0) {
        noInvoicesState?.classList.remove('hidden');
      } else {
        noInvoicesState?.classList.add('hidden');
      }

      // Update Pagination Stats UI
      if (startEl) startEl.textContent = String(totalItems === 0 ? 0 : startIndex + 1);
      if (endEl) endEl.textContent = String(endIndex);
      if (totalEl) totalEl.textContent = String(totalItems);

      // Render Pagination Buttons
      renderPaginationButtons(totalPages);
    }

    // Contextual Timeframe Navigator Builder
    function renderTimeframeBar(matchingRows: HTMLElement[], start: string | null, end: string | null, allDates: string[]) {
      if (!timeframeBar || !tfLabel || !tfCount || !tfActions) return;

      timeframeBar.classList.remove('hidden');
      timeframeBar.classList.add('flex');

      const matchCount = matchingRows.length;

      // Division breakdown
      let dgsCount = 0;
      let dtlCount = 0;
      let bothCount = 0;
      matchingRows.forEach(r => {
        const div = (r.getAttribute('data-div') || '').toUpperCase();
        if (div === 'DGS') dgsCount++;
        else if (div === 'DTL') dtlCount++;
        else if (div === 'BOTH') bothCount++;
      });

      const selectedDiv = (divisionFilter?.value || '').toUpperCase();
      let divSummary = '';
      if (selectedDiv === 'DGS') {
        divSummary = 'in DGS';
      } else if (selectedDiv === 'DTL') {
        divSummary = 'in DTL';
      } else {
        const parts: string[] = [];
        if (dgsCount > 0) parts.push(`${dgsCount} in DGS`);
        if (dtlCount > 0) parts.push(`${dtlCount} in DTL`);
        if (bothCount > 0) parts.push(`${bothCount} in Both`);
        if (parts.length > 0) {
          divSummary = `(${parts.join(', ')})`;
        }
      }

      // Date span from matching rows
      const visibleDates = matchingRows
        .map(r => (r.getAttribute('data-date') || '').split('T')[0])
        .filter(Boolean)
        .sort();

      let dateSpan = '';
      if (visibleDates.length > 0) {
        const firstD = fmtDatePretty(visibleDates[0]);
        const lastD = fmtDatePretty(visibleDates[visibleDates.length - 1]);
        if (firstD === lastD) {
          dateSpan = `on ${firstD}`;
        } else {
          dateSpan = `from ${firstD} to ${lastD}`;
        }
      }

      const curStatus = statusFilter?.value || '';
      let statusText = '';
      if (curStatus === 'deleted') statusText = 'in Bin (Trash)';
      else if (curStatus === 'archived') statusText = 'Archived';
      else if (curStatus) statusText = `[${curStatus.toUpperCase()}]`;

      // Build readable descriptive text
      if (matchCount === 0) {
        tfCount.textContent = '0 orders found for this selection';
      } else {
        const countStr = `${matchCount} order${matchCount === 1 ? '' : 's'}`;
        const parts = [countStr];
        if (statusText) parts.push(statusText);
        if (divSummary) parts.push(divSummary);
        if (dateSpan) parts.push(dateSpan);
        tfCount.textContent = parts.join(' ');
      }

      // Check existence of older / newer orders
      const hasOlder = start ? allDates.some(d => d < start) : false;
      const hasNewer = end ? allDates.some(d => d > end) : false;

      // Identify mode
      const isAllTime = !start || activePreset === 'all';
      let mode: 'all' | 'month' | 'week' | 'day' | 'custom' = 'custom';

      if (isAllTime) {
        mode = 'all';
      } else if (activePreset === 'today' || activePreset === 'yesterday' || activePreset === 'custom_day' || start === end) {
        mode = 'day';
      } else if (activePreset === 'week' || activePreset === 'custom_week') {
        mode = 'week';
      } else if (activePreset === 'month' || activePreset === 'last_month' || activePreset === 'custom_month') {
        mode = 'month';
      } else if (start && end) {
        const sD = new Date(start + 'T00:00:00');
        const eD = new Date(end + 'T00:00:00');
        const lastDayOfMonth = new Date(sD.getFullYear(), sD.getMonth() + 1, 0).getDate();
        if (sD.getDate() === 1 && (eD.getDate() === lastDayOfMonth || (sD.getMonth() === new Date().getMonth() && eD.getDate() === new Date().getDate()))) {
          mode = 'month';
        } else {
          mode = 'custom';
        }
      }

      tfActions.innerHTML = '';

      if (mode === 'all') {
        tfLabel.textContent = 'All Time View';
        return;
      }

      if (mode === 'month' && start) {
        const [y, m] = start.split('-').map(Number);
        const curMonthDate = new Date(y, m - 1, 1);
        tfLabel.textContent = `Month: ${curMonthDate.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}`;

        const prevMonthDate = new Date(y, m - 2, 1);
        const prevMonthStart = toISODate(prevMonthDate);
        const prevMonthEnd = toISODate(new Date(y, m - 1, 0));
        const prevMonthLabel = fmtMonthName(prevMonthDate);

        const nextMonthDate = new Date(y, m, 1);
        const nextMonthStart = toISODate(nextMonthDate);
        const nextMonthEnd = toISODate(new Date(y, m + 1, 0));
        const nextMonthLabel = fmtMonthName(nextMonthDate);

        // Previous Month button (if older orders exist)
        if (hasOlder) {
          const btn = createNavBtn(`← Previous Month (${prevMonthLabel})`, prevMonthStart, prevMonthEnd, 'custom_month', prevMonthLabel);
          tfActions.appendChild(btn);
        }

        // Next Month button (if newer orders exist)
        if (hasNewer) {
          const btn = createNavBtn(`Next Month (${nextMonthLabel}) →`, nextMonthStart, nextMonthEnd, 'custom_month', nextMonthLabel);
          tfActions.appendChild(btn);
        }

        // Show More / All Time button
        if (hasOlder || hasNewer) {
          const allBtn = createAllTimeBtn();
          tfActions.appendChild(allBtn);
        }
      } else if (mode === 'week' && start && end) {
        const sD = new Date(start + 'T00:00:00');
        const eD = new Date(end + 'T00:00:00');
        tfLabel.textContent = `Week: ${fmtWeekRange(sD, eD)}`;

        const prevS = new Date(sD); prevS.setDate(sD.getDate() - 7);
        const prevE = new Date(eD); prevE.setDate(eD.getDate() - 7);
        const prevLabel = fmtWeekRange(prevS, prevE);

        const nextS = new Date(sD); nextS.setDate(sD.getDate() + 7);
        const nextE = new Date(eD); nextE.setDate(eD.getDate() + 7);
        const nextLabel = fmtWeekRange(nextS, nextE);

        if (hasOlder) {
          const btn = createNavBtn(`← Previous Week (${prevLabel})`, toISODate(prevS), toISODate(prevE), 'custom_week', prevLabel);
          tfActions.appendChild(btn);
        }

        if (hasNewer) {
          const btn = createNavBtn(`Next Week (${nextLabel}) →`, toISODate(nextS), toISODate(nextE), 'custom_week', nextLabel);
          tfActions.appendChild(btn);
        }

        if (hasOlder || hasNewer) {
          const allBtn = createAllTimeBtn();
          tfActions.appendChild(allBtn);
        }
      } else if (mode === 'day' && start) {
        const dayD = new Date(start + 'T00:00:00');
        tfLabel.textContent = `Day: ${fmtFullDay(dayD)}`;

        const prevD = new Date(dayD); prevD.setDate(dayD.getDate() - 1);
        const prevDateStr = toISODate(prevD);
        const prevLabel = fmtFullDay(prevD);

        const nextD = new Date(dayD); nextD.setDate(dayD.getDate() + 1);
        const nextDateStr = toISODate(nextD);
        const nextLabel = fmtFullDay(nextD);

        if (hasOlder) {
          const btn = createNavBtn(`← Previous Day (${prevLabel})`, prevDateStr, prevDateStr, 'custom_day', prevLabel);
          tfActions.appendChild(btn);
        }

        if (hasNewer) {
          const btn = createNavBtn(`Next Day (${nextLabel}) →`, nextDateStr, nextDateStr, 'custom_day', nextLabel);
          tfActions.appendChild(btn);
        }

        if (hasOlder || hasNewer) {
          const allBtn = createAllTimeBtn();
          tfActions.appendChild(allBtn);
        }
      } else {
        // Custom timeframe
        tfLabel.textContent = activeLabel && activeLabel !== 'All Time' ? activeLabel : 'Custom Date Range';
        if (hasOlder || hasNewer) {
          const allBtn = createAllTimeBtn('Show More Orders (All Time)');
          tfActions.appendChild(allBtn);
        }
      }
    }

    function createNavBtn(text: string, start: string, end: string, preset: string, label: string) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 shadow-3xs flex items-center gap-1.5 transition-colors cursor-pointer';
      btn.textContent = text;
      btn.addEventListener('click', () => {
        pickerEl?.dispatchEvent(new CustomEvent('daterange-set', {
          detail: { start, end, preset, label }
        }));
      });
      return btn;
    }

    function createAllTimeBtn(customText = 'View All Time Orders') {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-3xs flex items-center gap-1.5 transition-colors cursor-pointer';
      btn.textContent = customText;
      btn.addEventListener('click', () => {
        pickerEl?.dispatchEvent(new CustomEvent('daterange-set', {
          detail: { preset: 'all' }
        }));
      });
      return btn;
    }

    function renderPaginationButtons(totalPages: number) {
      if (!paginationButtons) return;
      paginationButtons.innerHTML = '';

      if (totalPages <= 1) return;

      // First button
      const firstBtn = document.createElement('button');
      firstBtn.type = 'button';
      firstBtn.disabled = currentPage === 1;
      firstBtn.className = `px-2 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${
        currentPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors'
      }`;
      firstBtn.innerHTML = '&laquo;';
      firstBtn.title = 'First Page';
      firstBtn.addEventListener('click', () => {
        if (currentPage > 1) { currentPage = 1; filterAndSortInvoices(false); }
      });
      paginationButtons.appendChild(firstBtn);

      // Prev button
      const prevBtn = document.createElement('button');
      prevBtn.type = 'button';
      prevBtn.disabled = currentPage === 1;
      prevBtn.className = `px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${
        currentPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-400' : 'bg-white text-slate-700 hover:bg-slate-50 transition-colors'
      }`;
      prevBtn.innerHTML = '&lsaquo; Prev';
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) { currentPage--; filterAndSortInvoices(false); }
      });
      paginationButtons.appendChild(prevBtn);

      // Numbered buttons
      const maxVisiblePages = 5;
      let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
      let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
      if (endPage - startPage + 1 < maxVisiblePages) {
        startPage = Math.max(1, endPage - maxVisiblePages + 1);
      }

      if (startPage > 1) {
        const dot = document.createElement('span');
        dot.className = 'px-1.5 text-xs font-bold text-slate-400 select-none';
        dot.textContent = '...';
        paginationButtons.appendChild(dot);
      }

      for (let i = startPage; i <= endPage; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.type = 'button';
        pageBtn.className = `px-3 py-1.5 rounded-lg border text-xs font-bold transition-colors ${
          currentPage === i
