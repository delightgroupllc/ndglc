        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id');
        const action = target.getAttribute('data-action') || 'DELETE';
        if (!id) return;

        let confirmMsg = 'Are you sure?';
        let body = {};

        if (action === 'DELETE') {
          confirmMsg = 'Are you sure you want to move this order to the recycle bin?';
          body = { is_deleted: true };
        } else if (action === 'ARCHIVE') {
          confirmMsg = 'Are you sure you want to archive this order?';
          body = { is_archived: true };
        } else if (action === 'RESTORE') {
          confirmMsg = 'Are you sure you want to restore this order?';
          body = { is_deleted: false };
        } else if (action === 'UNARCHIVE') {
          confirmMsg = 'Are you sure you want to unarchive this order?';
          body = { is_archived: false };
        }

        const isConfirmed = await (window as any).showConfirm(confirmMsg, 'Confirm Action', action === 'soft_delete');
        if (!isConfirmed) return;

        const originalText = target.innerHTML;
        target.disabled = true;
        target.textContent = '...';

        try {
          const res = await fetch(`/api/invoices/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Operation failed.');
          }
        } catch (err) {
          alert('Error executing operation.');
        } finally {
          target.disabled = false;
          target.innerHTML = originalText;
        }
      });
    });

