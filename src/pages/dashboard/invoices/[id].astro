---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { query } from '../../../lib/db';
import { 
  ArrowLeft, Printer, FileDown, Plus, CreditCard, Banknote, Calendar, Tag, CheckCircle2, AlertCircle, Copy, Archive, RefreshCw, Trash2
} from '@lucide/astro';

const { id } = Astro.params;

let inv: any = null;
let items: any[] = [];
let logs: any[] = [];
let transactions: any[] = [];
let settings: Record<string, string> = {};
let selectedClauses: any[] = [];

try {
  const invRes = await query(`
    SELECT i.*, 
       (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list,
       COALESCE((SELECT is_deleted FROM customers WHERE name = i.customer_name LIMIT 1), TRUE) as is_customer_deleted,
       (SELECT code FROM customers WHERE name = i.customer_name LIMIT 1) as customer_code,
       (SELECT code FROM companies WHERE name = i.company_name LIMIT 1) as company_code
    FROM invoices i WHERE id = $1
  `, [id]);
  inv = invRes.rows[0];

  if (inv) {
    items = typeof inv.items_list === 'string' ? JSON.parse(inv.items_list) : (inv.items_list || []);
  }

  // Fetch transactions (payment history)
  const transRes = await query(`
    SELECT * FROM transactions WHERE invoice_id = $1 ORDER BY transaction_date DESC, created_at DESC
  `, [id]);
  transactions = transRes.rows;

  // Fetch remittance settings
  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => {
    acc[row.key] = row.value;
    return acc;
  }, {});

  // Fetch selected disclaimers/clauses
  if (inv) {
    let activeTerms: string[] = [];
    try {
      activeTerms = inv.payment_terms ? JSON.parse(inv.payment_terms) : [];
    } catch (e) {
      if (typeof inv.payment_terms === 'string') {
        activeTerms = inv.payment_terms.split(',').map((t: string) => t.trim());
      }
    }
    
    if (activeTerms.length > 0) {
      const legalRes = await query('SELECT title, content, identifier FROM legal_artifacts WHERE identifier = ANY($1)', [activeTerms]);
      selectedClauses = legalRes.rows;
    }
  }

  // Get true order audit logs from the database
  const logsRes = await query(`
    SELECT al.action, al.details, al.timestamp as date, COALESCE(u.name, 'System') as user
    FROM audit_logs al
    LEFT JOIN users u ON u.id = al.user_id
    WHERE al.entity_id = $1 AND al.entity_type = 'invoices'
    ORDER BY al.timestamp ASC
  `, [id]);
  
  if (logsRes.rows.length > 0) {
    logs = logsRes.rows.map(row => ({
      action: row.details || row.action.replace(/_/g, ' '),
      date: row.date,
      user: row.user
    }));
  } else {
    // Fallback if no audit logs exist yet
    logs = [
      { action: 'Invoice Generated', date: inv?.created_at || inv?.issue_date, user: 'System' },
      ...transactions.map(t => ({
        action: `Payment of AED ${Number(t.amount).toLocaleString()} (${t.payment_method.replace('_', ' ')}) recorded`,
        date: t.transaction_date,
        user: 'System'
      })),
      { action: `Status set to ${inv?.payment_status}`, date: inv?.updated_at || inv?.created_at, user: 'System' }
    ];
  }

} catch (err: any) {
  console.warn('DB error in order details:', err.message);
}

if (!inv) {
  return Astro.redirect('/dashboard/invoices');
}

const totalPaid = transactions.reduce((sum, t) => sum + Number(t.amount), 0);
const balanceDue = Math.max(0, Number(inv.total_amount) - totalPaid);

// Determine suggested next step
let nextStep: {
  title: string;
  description: string;
  actionText?: string;
  actionId?: string;
  actionColor?: string;
} | null = null;

if (inv.payment_status === 'draft') {
  nextStep = {
    title: 'Finalize Draft / Change Status',
    description: 'This order is currently a Draft. Click below to edit the details and change the status to active.',
    actionText: 'Edit & Activate',
    actionId: 'suggested-edit-btn',
    actionColor: 'bg-cyan-600 hover:bg-cyan-700 text-white hover:shadow-cyan-100'
  };
} else if (inv.payment_status === 'unpaid' || inv.payment_status === 'overdue') {
  nextStep = {
    title: 'Record Payment & Deliver',
    description: 'This order is unpaid. Record a customer payment or convert this to a Delivery Note if items are ready to be dispatched.',
    actionText: 'Record Payment',
    actionId: 'suggested-payment-btn',
    actionColor: 'bg-green-600 hover:bg-green-700 text-white hover:shadow-green-100'
  };
} else if (inv.payment_status === 'partially_paid') {
  nextStep = {
    title: 'Record Remaining Balance',
    description: `A partial payment has been made. There is still a balance of AED ${balanceDue.toLocaleString()} due.`,
    actionText: 'Record Payment',
    actionId: 'suggested-payment-btn',
    actionColor: 'bg-amber-600 hover:bg-amber-700 text-white hover:shadow-amber-100'
  };
} else if (inv.payment_status === 'paid') {
  if (inv.order_type !== 'delivery_note') {
    nextStep = {
      title: 'Generate Delivery Note',
      description: 'This order is fully paid. You can now convert this order to a Delivery Note for shipment.',
      actionText: 'Convert to Delivery Note',
      actionId: 'suggested-delivery-btn',
      actionColor: 'bg-blue-600 hover:bg-blue-700 text-white hover:shadow-blue-100'
    };
  } else {
    nextStep = {
      title: 'Order Fulfilled & Paid',
      description: 'No further actions are required. This order is fully paid and issued as a Delivery Note.',
    };
  }
}

// Enforce Document Progression Pipeline Rules
const isPaid = inv.payment_status === 'paid';
const isConfirmed = inv.payment_status === 'paid' || inv.payment_status === 'confirmed';
const type = inv.order_type || 'tax_invoice';

let stage = 6;
if (isPaid) {
  stage = 7;
} else if (type === 'inquiry') {
  stage = 1;
} else if (type === 'quotation') {
  stage = 2;
} else if (type === 'proforma') {
  stage = 3;
} else if (type === 'lpo') {
  stage = 4;
} else if (type === 'delivery_note') {
  stage = 5;
} else if (type === 'tax_invoice') {
  stage = 6;
}

const isDraftOrUnconfirmed = stage <= 3 || (stage === 4 && !isConfirmed);
const showDeleteAction = isDraftOrUnconfirmed;
const showArchiveAction = !isDraftOrUnconfirmed;
---

<DashboardLayout title={`Order ${inv.invoice_number}`} activeItem="invoices">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Back to Orders Link -->
    <div class="flex items-center pt-4">
      <a href="/dashboard/invoices" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-slate-800 transition-colors uppercase tracking-wider group">
        <ArrowLeft class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" />
        Back to Orders
      </a>
    </div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <div>
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-2xl font-black text-slate-900 tracking-tight">{inv.invoice_number}</h1>
          <span class={`px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider ${
            inv.payment_status === 'paid' ? 'bg-green-100 text-green-800' :
            inv.payment_status === 'partially_paid' ? 'bg-amber-100 text-amber-800' :
            inv.payment_status === 'draft' ? 'bg-slate-100 text-slate-700' :
            inv.payment_status === 'cancelled' ? 'bg-red-100 text-red-800' : 'bg-red-50 text-rose-700'
          }`}>
            {inv.payment_status === 'partially_paid' ? 'Partially Paid' : inv.payment_status}
          </span>
        </div>
        <p class="text-sm text-slate-500 font-medium mt-1">
          {inv.order_type === 'proforma' ? 'Pro Forma Invoice' : 
           inv.order_type === 'lpo' ? 'PO / LPO (Purchase Order)' : 
           inv.order_type === 'delivery_note' ? 'Delivery Note' : 
           inv.order_type === 'tax_invoice' ? 'Commercial Bill' :
           inv.order_type === 'standard' ? 'Invoice' :
           inv.order_type === 'quotation' ? 'Estimation / Quotation' :
           inv.order_type === 'inquiry' ? 'Inquiry' : 'Invoice'}
          • {inv.source_division || 'DTL'}
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <!-- Convert actions for Quotations/Inquiries -->
        {(inv.order_type === 'quotation' || inv.order_type === 'inquiry') && (
          <button 
            type="button" 
            id="convert-invoice-btn" 
            data-target="tax_invoice"
            class="inline-flex items-center justify-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
          >
            <CheckCircle2 class="w-4 h-4" />
            Convert to Tax Invoice
          </button>
          <button 
            type="button" 
            id="convert-delivery-btn" 
            data-target="delivery_note"
            class="inline-flex items-center justify-center gap-1.5 border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
          >
            <Tag class="w-4 h-4" />
            Convert to Delivery Note
          </button>
        )}

        <!-- Edit, Print & Download -->
        <button 
          type="button" 
          id="edit-invoice-btn" 
          data-invoice={JSON.stringify(inv)}
          class="inline-flex items-center justify-center gap-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-cyan-600"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Edit
        </button>
        <a 
          href={`/dashboard/invoices/print/${inv.id}`} 
          target="_blank"
          class="inline-flex items-center justify-center gap-1.5 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
        >
          <Printer class="h-4 w-4" />
          Print / Download PDF
        </a>
        {inv.payment_status !== 'cancelled' && (
          <button 
            type="button" 
            id="cancel-order-btn"
            class="inline-flex items-center justify-center gap-1.5 border border-rose-200 bg-white hover:bg-rose-50 text-rose-700 px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
          >
            <AlertCircle class="h-4 w-4" />
            Cancel Order
          </button>
        )}
        <button 
          type="button" 
          id="duplicate-invoice-btn"
          data-id={inv.id}
          class="inline-flex items-center justify-center gap-1.5 border border-violet-200 bg-violet-50 hover:bg-violet-100 text-violet-700 px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
        >
          <Copy class="h-4 w-4" />
          Duplicate
        </button>

        {showArchiveAction && !inv.is_deleted && (
          <button 
            type="button" 
            id="archive-invoice-btn"
            data-action={inv.is_archived ? 'UNARCHIVE' : 'ARCHIVE'}
            class={`inline-flex items-center justify-center gap-1.5 border px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm ${
              inv.is_archived 
                ? 'border-amber-200 bg-amber-50 hover:bg-amber-100 text-amber-700' 
                : 'border-slate-200 bg-white hover:bg-slate-50 text-slate-700'
            }`}
          >
            <Archive class="h-4 w-4" />
            {inv.is_archived ? 'Unarchive' : 'Archive'}
          </button>
        )}

        {inv.is_deleted ? (
          <>
            <button 
              type="button" 
              id="restore-invoice-btn"
              class="inline-flex items-center justify-center gap-1.5 border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
            >
              <RefreshCw class="h-4 w-4" />
              Restore
            </button>
            <button 
              type="button" 
              id="perm-delete-invoice-btn"
              class="inline-flex items-center justify-center gap-1.5 border border-rose-600 bg-rose-600 hover:bg-rose-700 text-white px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
            >
              <Trash2 class="h-4 w-4" />
              Perm Del
            </button>
          </>
        ) : (
          showDeleteAction && (
            <button 
              type="button" 
              id="delete-invoice-btn"
              class="inline-flex items-center justify-center gap-1.5 border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-sm"
            >
              <Trash2 class="h-4 w-4" />
              Delete
            </button>
          )
        )}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Left Col: Details & Ledger -->
      <div class="md:col-span-2 space-y-6">
        
        <!-- Items overview -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
          <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Items Overview</h2>
          
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="text-slate-400 uppercase text-[10px] tracking-wider font-bold">
                <th class="pb-3">Item Description</th>
                <th class="pb-3 text-center">Qty</th>
                <th class="pb-3 text-right">Price</th>
                <th class="pb-3 text-right">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              {items.map(item => (
                <tr>
                  <td class="py-3 font-medium flex items-center gap-3">
                    {inv.show_images && (
                      <div class="w-10 h-10 rounded border border-slate-200 overflow-hidden bg-slate-50 flex items-center justify-center shrink-0 shadow-3xs">
                        <img src={item.item_image || '/no-image.svg'} class="w-full h-full object-cover" />
                      </div>
                    )}
                    <div>
                      <span class="block">{item.description}</span>
                      {item.catalogue_ref && <span class="text-[10px] text-slate-400 font-mono">REF: {item.catalogue_ref}</span>}
                    </div>
                  </td>
                  <td class="py-3 text-center">{item.quantity}</td>
                  <td class="py-3 text-right font-mono">AED {Number(item.unit_price).toLocaleString()}</td>
                  <td class="py-3 text-right font-mono font-bold text-slate-900">AED {(item.quantity * item.unit_price).toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="flex justify-end pt-4 border-t border-slate-100">
            <div class="w-64 space-y-2 text-sm">
              <div class="flex justify-between text-slate-500"><span>Subtotal</span><span class="font-mono">AED {Number(inv.subtotal).toLocaleString()}</span></div>
              <div class="flex justify-between text-slate-500"><span>Tax (5%)</span><span class="font-mono">AED {Number(inv.gst_amount).toLocaleString()}</span></div>
              <div class="flex justify-between font-black text-slate-900 text-base pt-2 border-t border-slate-200">
                <span>Grand Total</span><span class="font-mono text-cyan-700">AED {Number(inv.total_amount).toLocaleString()}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- TRANSACTION LEDGER -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Transaction Ledger</h2>
            {inv.payment_status !== 'paid' && inv.payment_status !== 'cancelled' && inv.payment_status !== 'draft' && (
              <button 
                type="button" 
                id="open-payment-modal-btn"
                class="inline-flex items-center gap-1.5 text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white px-3 py-1.5 rounded-lg transition-all shadow-xs"
              >
                <Plus class="w-3.5 h-3.5" />
                Record Payment
              </button>
            )}
          </div>

          <div class="grid grid-cols-3 gap-4 bg-slate-50 p-4 rounded-xl text-center">
            <div>
              <span class="block text-[10px] uppercase font-bold text-slate-400">Total Charged</span>
              <span class="text-base font-extrabold text-slate-900 font-mono">AED {Number(inv.total_amount).toLocaleString()}</span>
            </div>
            <div>
              <span class="block text-[10px] uppercase font-bold text-slate-400">Total Paid</span>
              <span class="text-base font-extrabold text-green-600 font-mono">AED {totalPaid.toLocaleString()}</span>
            </div>
            <div>
              <span class="block text-[10px] uppercase font-bold text-slate-400">Balance Due</span>
              <span class="text-base font-extrabold text-rose-600 font-mono">AED {balanceDue.toLocaleString()}</span>
            </div>
          </div>

          {transactions.length === 0 ? (
            <div class="py-8 text-center border border-dashed border-slate-200 rounded-xl">
              <CreditCard class="w-8 h-8 mx-auto text-slate-300" />
              <p class="text-xs text-slate-500 font-medium mt-2">No payment transactions recorded for this order yet.</p>
            </div>
          ) : (
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="text-slate-400 uppercase text-[9px] tracking-wider font-bold">
                  <th class="pb-2">Date</th>
                  <th class="pb-2">Method</th>
                  <th class="pb-2">Reference</th>
                  <th class="pb-2">Notes</th>
                  <th class="pb-2 text-right">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700">
                {transactions.map(t => (
                  <tr>
                    <td class="py-2.5 font-medium">{new Date(t.transaction_date).toLocaleDateString('en-AE')}</td>
                    <td class="py-2.5 uppercase text-[10px] font-bold text-slate-500">{t.payment_method.replace('_', ' ')}</td>
                    <td class="py-2.5 font-mono text-slate-500">{t.transaction_ref || '—'}</td>
                    <td class="py-2.5 italic text-slate-400 max-w-xs truncate">{t.notes || '—'}</td>
                    <td class="py-2.5 text-right font-mono font-bold text-slate-900">AED {Number(t.amount).toLocaleString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>

      </div>

      <!-- Right Col: Metadata & Bank Details -->
      <div class="space-y-6">
        
        <!-- Suggested Action Card -->
        {nextStep && (
          <div class="bg-gradient-to-br from-cyan-50 to-blue-50 border border-cyan-200/60 p-6 rounded-2xl space-y-4 shadow-sm relative overflow-hidden">
            <div class="absolute -right-6 -top-6 w-24 h-24 bg-cyan-200/30 rounded-full blur-xl"></div>
            <div class="flex items-center gap-2">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-500"></span>
              </span>
              <h2 class="text-xs font-extrabold uppercase tracking-widest text-cyan-800">Suggested Next Action</h2>
            </div>
            <div class="space-y-1">
              <h3 class="text-sm font-bold text-slate-900">{nextStep.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{nextStep.description}</p>
            </div>
            {nextStep.actionText && (
              <button
                type="button"
                id={nextStep.actionId}
                class={`w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold transition-all shadow-sm ${nextStep.actionColor}`}
              >
                {nextStep.actionText}
              </button>
            )}
          </div>
        )}

        <!-- Client Info -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
          <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Client Info</h2>
          <div class="space-y-2 text-sm text-slate-600">
            <p><span class="block text-[10px] uppercase font-bold text-slate-400">Name</span><span class="font-medium text-slate-900">{inv.customer_name}{inv.is_customer_deleted ? '*' : ''}</span></p>
            {inv.customer_code && <p><span class="block text-[10px] uppercase font-bold text-slate-400">Customer Code (ID)</span><span class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded font-bold text-slate-700">{inv.customer_code}</span></p>}
            {inv.company_name && <p><span class="block text-[10px] uppercase font-bold text-slate-400">Company</span>{inv.company_name} {inv.company_code && <span class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded ml-1 font-bold text-slate-750">{inv.company_code}</span>}</p>}
            {inv.customer_email && <p><span class="block text-[10px] uppercase font-bold text-slate-400">Email</span>{inv.customer_email}</p>}
            {inv.customer_phone && <p><span class="block text-[10px] uppercase font-bold text-slate-400">Phone</span>{inv.customer_phone}</p>}
            {inv.billing_address && <p><span class="block text-[10px] uppercase font-bold text-slate-400">Address</span>{inv.billing_address}</p>}
          </div>
        </div>

        <!-- Selected Disclaimers & Terms -->
        {selectedClauses.length > 0 && (
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Selected T&C (Page 2)</h2>
            <ul class="space-y-2 list-disc list-inside text-xs font-bold text-slate-700">
              {selectedClauses.map(clause => (
                <li>{clause.title}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Prefilled Bank Details Sidebar Card -->
        <div class="bg-gradient-to-br from-slate-900 to-slate-800 p-6 rounded-2xl text-white space-y-4 shadow-md">
          <h2 class="text-xs font-extrabold uppercase tracking-widest text-slate-400 border-b border-slate-700/50 pb-2">Remittance Bank Details</h2>
          <div class="space-y-3 text-xs">
            <div>
              <span class="block text-[9px] uppercase tracking-wider text-slate-400 font-bold">Bank Name</span>
              <span class="font-bold text-slate-100">{settings.bank_name || 'Not Configured'}</span>
            </div>
            <div>
              <span class="block text-[9px] uppercase tracking-wider text-slate-400 font-bold">Account Name</span>
              <span class="font-bold text-slate-100">{settings.account_name || 'Not Configured'}</span>
            </div>
            <div>
              <span class="block text-[9px] uppercase tracking-wider text-slate-400 font-bold">Account Number</span>
              <span class="font-mono font-bold text-slate-100">{settings.account_number || 'Not Configured'}</span>
            </div>
            <div>
              <span class="block text-[9px] uppercase tracking-wider text-slate-400 font-bold">IBAN</span>
              <div class="flex items-center gap-1.5">
                <span class="font-mono font-bold text-cyan-400 truncate">{settings.iban_number || 'Not Configured'}</span>
                {settings.iban_number && (
                  <button type="button" class="text-slate-400 hover:text-white cursor-pointer copy-iban-btn" data-value={settings.iban_number}>
                    <Copy class="w-3.5 h-3.5" />
                  </button>
                )}
              </div>
            </div>
            <div>
              <span class="block text-[9px] uppercase tracking-wider text-slate-400 font-bold">Swift Code</span>
              <span class="font-mono font-bold text-slate-100">{settings.swift_code || 'Not Configured'}</span>
            </div>
          </div>
        </div>

        <!-- Timeline -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
          <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Timeline</h2>
          <div class="relative pl-4 space-y-4 border-l-2 border-slate-100 text-xs">
            {logs.map((log, i) => (
              <div class="relative">
                <div class={`absolute -left-[21px] top-1 h-2.5 w-2.5 rounded-full ${i === 0 ? 'bg-cyan-500 border-2 border-cyan-100' : 'bg-slate-300'}`}></div>
                <p class="font-bold text-slate-800">{log.action}</p>
                <p class="text-slate-500 mt-0.5">{log.date ? new Date(log.date).toLocaleString('en-AE') : ''} • {log.user}</p>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </div>
</DashboardLayout>

<!-- RECORD PAYMENT MODAL -->
<div id="payment-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    <div class="p-5 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
      <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
        <Banknote class="w-5 h-5 text-cyan-500" />
        Record Payment Transaction
      </h3>
      <button type="button" id="close-payment-modal-btn" class="text-slate-400 hover:text-slate-700 rounded-lg p-1 hover:bg-slate-100 transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <form id="record-payment-form" class="p-6 space-y-4">
      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Payment Amount (AED) *</label>
        <input 
          type="number" 
          name="amount" 
          id="payment-amount" 
          step="0.01" 
          max={balanceDue} 
          value={balanceDue} 
          required 
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none" 
        />
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Payment Method *</label>
        <select name="payment_method" id="payment-method" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-cyan-500 focus:outline-none">
          <option value="bank_transfer">Bank Remittance / Transfer</option>
          <option value="cash">Cash Payment</option>
          <option value="cheque">Cheque</option>
          <option value="card">Credit / Debit Card</option>
          <option value="other">Other Method</option>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Transaction Reference No.</label>
        <input 
          type="text" 
          name="transaction_ref" 
          id="payment-ref" 
          placeholder="e.g. Bank transfer ID, Cheque number" 
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none" 
        />
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Payment Date *</label>
        <input 
          type="date" 
          name="transaction_date" 
          id="payment-date" 
          required 
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none" 
        />
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Internal notes</label>
        <textarea 
          name="notes" 
          id="payment-notes" 
          rows="2" 
          placeholder="Additional details about this transaction…" 
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none resize-none"
        ></textarea>
      </div>

      <div id="payment-error-msg" class="hidden p-3 rounded-lg text-xs bg-rose-50 border border-rose-200 text-rose-700 font-semibold"></div>

      <div class="pt-4 flex justify-end gap-3 border-t border-slate-100">
        <button 
          type="button" 
          id="cancel-payment-btn" 
          class="px-4 py-2 rounded-lg text-xs font-bold border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="px-4 py-2 rounded-lg text-xs font-bold bg-cyan-600 hover:bg-cyan-700 text-white transition-colors"
        >
          Record Transaction
        </button>
      </div>
    </form>
  </div>
</div>
<!-- CONFIRMATION MODAL -->
<div id="confirm-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white w-full max-w-md rounded-xl shadow-xl overflow-hidden border border-slate-200/60 animate-in fade-in zoom-in-95 duration-200">
    <div class="p-6">
      <div class="flex items-center gap-4 mb-4">
        <div id="confirm-modal-icon-container" class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 bg-rose-50 text-rose-700">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div>
          <h3 id="confirm-modal-title" class="text-base font-bold text-slate-800 tracking-tight leading-tight">Confirm Action</h3>
          <p class="text-[9px] font-extrabold text-slate-400 uppercase tracking-wider mt-0.5">Authorization Required</p>
        </div>
      </div>
      
      <p id="confirm-modal-message" class="text-sm font-medium text-slate-700 leading-normal mb-1">Would you like to convert this order?</p>
      
      <p class="text-[10px] font-medium text-slate-500 italic leading-normal mb-6">
        Note: This action will freeze the current document state and create a linked document for review.
      </p>
      
      <div class="flex justify-end items-center gap-3">
        <button type="button" id="confirm-cancel-btn" class="px-4 py-2 text-xs font-bold text-slate-600 hover:text-slate-850 hover:bg-slate-50 transition-colors">
          Cancel
        </button>
        <button type="button" id="confirm-proceed-btn" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md text-xs font-bold bg-cyan-50 hover:bg-cyan-100/80 text-cyan-800 transition-all border border-cyan-100/50 shadow-2xs">
          <svg class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Proceed
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const invoiceId = window.location.pathname.split('/').pop();

  // Custom Confirmation UI
  const confirmModal = document.getElementById('confirm-modal-backdrop');
  const confirmMsg = document.getElementById('confirm-modal-message');
  const confirmProceedBtn = document.getElementById('confirm-proceed-btn');
  const confirmCancelBtn = document.getElementById('confirm-cancel-btn');

  function showConfirm(message: string): Promise<boolean> {
    return new Promise((resolve) => {
      if (!confirmModal || !confirmMsg || !confirmProceedBtn || !confirmCancelBtn) {
        resolve(window.confirm(message));
        return;
      }
      confirmMsg.textContent = message;
      confirmModal.classList.remove('hidden');
      confirmModal.classList.add('flex');

      const cleanup = () => {
        confirmProceedBtn.removeEventListener('click', onProceed);
        confirmCancelBtn.removeEventListener('click', onCancel);
        confirmModal.classList.add('hidden');
        confirmModal.classList.remove('flex');
      };

      const onProceed = () => { cleanup(); resolve(true); };
      const onCancel = () => { cleanup(); resolve(false); };

      confirmProceedBtn.addEventListener('click', onProceed);
      confirmCancelBtn.addEventListener('click', onCancel);
    });
  }

  // Modal controls
  const paymentModal = document.getElementById('payment-modal-backdrop');
  const openPaymentBtn = document.getElementById('open-payment-modal-btn');
  const closePaymentBtn = document.getElementById('close-payment-modal-btn');
  const cancelPaymentBtn = document.getElementById('cancel-payment-btn');
  const paymentDateInput = document.getElementById('payment-date') as HTMLInputElement;

  if (paymentDateInput) {
    paymentDateInput.value = new Date().toISOString().split('T')[0];
  }

  const openModal = () => {
    paymentModal?.classList.remove('hidden');
    paymentModal?.classList.add('flex');
  };

  const closeModal = () => {
    paymentModal?.classList.add('hidden');
    paymentModal?.classList.remove('flex');
    (document.getElementById('record-payment-form') as HTMLFormElement)?.reset();
    if (paymentDateInput) paymentDateInput.value = new Date().toISOString().split('T')[0];
    const errMsg = document.getElementById('payment-error-msg');
    if (errMsg) errMsg.classList.add('hidden');
  };

  openPaymentBtn?.addEventListener('click', openModal);
  closePaymentBtn?.addEventListener('click', closeModal);
  cancelPaymentBtn?.addEventListener('click', closeModal);

  // Form submit
  const recordPaymentForm = document.getElementById('record-payment-form') as HTMLFormElement;
  recordPaymentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = recordPaymentForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    const errMsg = document.getElementById('payment-error-msg')!;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Recording...';
    errMsg.classList.add('hidden');

    const formData = new FormData(recordPaymentForm);
    const data = {
      amount: parseFloat(formData.get('amount') as string),
      payment_method: formData.get('payment_method'),
      transaction_ref: formData.get('transaction_ref'),
      transaction_date: formData.get('transaction_date'),
      notes: formData.get('notes')
    };

    try {
      const res = await fetch(`/api/invoices/${invoiceId}/transactions`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Failed to record payment');

      closeModal();
      window.location.reload();
    } catch (err: any) {
      errMsg.textContent = err.message || 'Error occurred';
      errMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Record Transaction';
    }
  });

  // Convert Actions
  const convertOrder = async (btn: HTMLButtonElement) => {
    const targetType = btn.getAttribute('data-target');
    const isConfirmed = await showConfirm(`Are you sure you want to convert this document to a ${targetType?.replace('_', ' ')}?`);
    if (!isConfirmed) return;

    const originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Converting...';

    try {
      const res = await fetch(`/api/invoices/${invoiceId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_type: targetType })
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Failed to convert document');
      window.location.reload();
    } catch (err: any) {
      alert(err.message || 'Error converting order');
      btn.disabled = false;
      btn.innerHTML = originalContent;
    }
  };

  document.getElementById('convert-invoice-btn')?.addEventListener('click', (e) => convertOrder(e.currentTarget as HTMLButtonElement));
  document.getElementById('convert-delivery-btn')?.addEventListener('click', (e) => convertOrder(e.currentTarget as HTMLButtonElement));

  // Copy IBAN button helper
  document.querySelectorAll('.copy-iban-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const val = btn.getAttribute('data-value') || '';
      navigator.clipboard.writeText(val);
      alert('IBAN copied to clipboard!');
    });
  });

  // Edit invoice: redirect to the dedicated create/edit page
  document.getElementById('edit-invoice-btn')?.addEventListener('click', () => {
    const btn = document.getElementById('edit-invoice-btn');
    const invDataStr = btn?.getAttribute('data-invoice');
    if (invDataStr) {
      const invData = JSON.parse(invDataStr);
      window.location.href = `/dashboard/invoices/create?edit=${invData.id}`;
    }
  });

  // Duplicate button handler
  document.getElementById('duplicate-invoice-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('duplicate-invoice-btn') as HTMLButtonElement;
    const invoiceId = btn.getAttribute('data-id');
    const isConfirmed = await showConfirm('Create a duplicate of this order?');
    if (!isConfirmed) return;
    btn.disabled = true;
    const originalContent = btn.innerHTML;
    btn.textContent = 'Duplicating...';
    try {
      const res = await fetch('/api/invoices', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ duplicateFrom: invoiceId }),
      });
      const result = await res.json();
      if (res.ok) {
        window.location.href = `/dashboard/invoices/${result.id}`;
      } else {
        alert(`Error: ${result.error || 'Unknown error occurred'}`);
      }
    } catch (e: any) {
      alert(`Network error: ${e.message}`);
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalContent;
    }
  });

  // Archive button handler
  document.getElementById('archive-invoice-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const action = btn.getAttribute('data-action');
    const isConfirmed = await showConfirm(`Are you sure you want to ${action?.toLowerCase()} this document?`);
    if (!isConfirmed) return;

    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Processing...';

    try {
      const res = await fetch(`/api/invoices/${invoiceId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_archived: action === 'ARCHIVE' })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Operation failed.');
      }
    } catch (err) {
      alert('Error executing operation.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // Delete button handler (Soft Delete)
  document.getElementById('delete-invoice-btn')?.addEventListener('click', async (e) => {
    const isConfirmed = await showConfirm('Are you sure you want to move this document to trash?');
    if (!isConfirmed) return;
    const btn = e.currentTarget as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Deleting...';
    try {
      const res = await fetch(`/api/invoices/${invoiceId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_deleted: true })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Operation failed.');
      }
    } catch (err) {
      alert('Error executing operation.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // Restore button handler
  document.getElementById('restore-invoice-btn')?.addEventListener('click', async (e) => {
    const isConfirmed = await showConfirm('Are you sure you want to restore this document from trash?');
    if (!isConfirmed) return;
    
    const btn = e.currentTarget as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Restoring...';
    try {
      console.log(`[Restore Button] Sending PATCH request to /api/invoices/${invoiceId}...`);
      const startTime = performance.now();
      const res = await fetch(`/api/invoices/${invoiceId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_deleted: false })
      });
      console.log(`[Restore Button] Received response in ${Math.round(performance.now() - startTime)}ms. Status: ${res.status}`);
      if (res.ok) {
        console.log(`[Restore Button] Success! Reloading page...`);
        window.location.reload();
      } else {
        console.error(`[Restore Button] Request failed!`);
        alert('Operation failed.');
      }
    } catch (err) {
      console.error(`[Restore Button] Network/Fetch error:`, err);
      alert('Error executing operation.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // Permanent Delete button handler
  document.getElementById('perm-delete-invoice-btn')?.addEventListener('click', async (e) => {
    console.log(`[Perm Delete Button] Clicked!`);
    const isConfirmed = await showConfirm('Are you absolutely sure you want to permanently delete this order? This action cannot be undone.');
    if (!isConfirmed) {
      console.log(`[Perm Delete Button] User cancelled confirmation.`);
      return;
    }
    const btn = e.currentTarget as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Deleting...';
    try {
      console.log(`[Perm Delete Button] Sending DELETE request to /api/invoices/${invoiceId}...`);
      const startTime = performance.now();
      const res = await fetch(`/api/invoices/${invoiceId}`, { method: 'DELETE' });
      console.log(`[Perm Delete Button] Received response in ${Math.round(performance.now() - startTime)}ms. Status: ${res.status}`);
      if (res.ok) {
        console.log(`[Perm Delete Button] Success! Redirecting to dashboard...`);
        window.location.href = '/dashboard/invoices';
      } else {
        const err = await res.json();
        console.error(`[Perm Delete Button] Request failed! Error:`, err.error);
        alert(`Failed to permanently delete: ${err.error || 'Unknown error'}`);
      }
    } catch (err) {
      console.error(`[Perm Delete Button] Network/Fetch error:`, err);
      alert('Error executing permanent deletion.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });

  // Suggested Actions event triggers
  document.getElementById('suggested-edit-btn')?.addEventListener('click', () => {
    document.getElementById('edit-invoice-btn')?.click();
  });
  document.getElementById('suggested-payment-btn')?.addEventListener('click', () => {
    document.getElementById('open-payment-modal-btn')?.click();
  });
  document.getElementById('suggested-delivery-btn')?.addEventListener('click', () => {
    const convertDeliveryBtn = document.getElementById('convert-delivery-btn');
    if (convertDeliveryBtn) {
      convertDeliveryBtn.click();
    } else {
      convertOrder('delivery_note');
    }
  });
  // Cancel Order button handler
  document.getElementById('cancel-order-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const isConfirmed = await showConfirm('Are you sure you want to cancel this order? It will restore deducted inventory.');
    if (!isConfirmed) return;

    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Cancelling...';

    try {
      const res = await fetch(`/api/invoices/${invoiceId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ payment_status: 'cancelled' })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to cancel the order.');
      }
    } catch (err) {
      console.error(err);
      alert('Error executing operation.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  });
</script>

</DashboardLayout>
