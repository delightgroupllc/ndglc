    }
    
    .arrco-address-td {
      width: 50%;
      text-align: right;
      vertical-align: top;
      font-size: 7.5pt;
      line-height: 1.3;
      color: #333333;
    }
    .arrco-company-name-en {
      font-size: 11pt;
      font-weight: 800;
      color: #1a1a1a;
      margin-bottom: 2px;
    }
    .arrco-company-name-ar {
      font-size: 12pt;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 2px;
    }
    .arrco-website {
      font-weight: 700;
      letter-spacing: 1px;
      display: block;
      margin-bottom: 4px;
    }

    .arrco-doc-title-section {
      text-align: center;
      margin-bottom: 15px;
    }
    .arrco-doc-title {
      font-size: 15pt;
      font-weight: 900;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #000000;
    }
    .arrco-trn-label {
      font-size: 11pt;
      font-weight: 700;
      margin-top: 3px;
    }

    .arrco-grid-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #000000;
      margin-bottom: 15px;
    }
    .arrco-grid-td {
      width: 50%;
      vertical-align: top;
      padding: 8px 12px;
    }
    .arrco-grid-td:first-child {
      border-right: 1px solid #000000;
    }
    .arrco-field-table {
      width: 100%;
      border-collapse: collapse;
    }
    .arrco-field-table td {
      padding: 3px 0;
      vertical-align: top;
      font-size: 8.5pt;
    }
    .arrco-field-label {
      width: 38%;
      color: #333333;
      font-weight: 500;
    }
    .arrco-field-value {
      width: 62%;
      font-weight: 700;
      color: #000000;
    }

    .arrco-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      border: 1px solid #000000;
    }
    .arrco-table th {
      background-color: #000000;
      color: #ffffff;
      font-weight: 700;
      font-size: 8pt;
      padding: 8px 6px;
      text-align: left;
      text-transform: uppercase;
      border: 1px solid #000000;
    }
    .arrco-table td {
      padding: 8px 6px;
      border-bottom: 1px solid #e2e8f0;
      border-right: 1px solid #e2e8f0;
      font-size: 8.5pt;
      color: #000000;
    }
    .arrco-table td:last-child {
      border-right: none;
    }
    
    .arrco-watermark {
      position: absolute;
      top: 35%;
      left: 10%;
      right: 10%;
      opacity: 0.03;
      pointer-events: none;
      z-index: -10;
      text-align: center;
    }
    .arrco-watermark svg {
      width: 80%;
      height: auto;
    }

    .arrco-dn-totals {
      text-align: right;
      font-size: 9.5pt;
      font-weight: 700;
      margin-bottom: 25px;
      padding-right: 30px;
    }
    .arrco-dn-fields {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }
    .arrco-dn-fields-box {
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 8px;
      background-color: #fcfcfc;
    }
    .arrco-dn-signatures {
      display: flex;
      justify-content: space-between;
      margin-top: 50px;
      font-size: 9pt;
      font-weight: 700;
    }
    .arrco-dn-sign-box {
      width: 45%;
      text-align: left;
      line-height: 1.6;
    }
    .arrco-dn-sign-line {
      border-top: 1px solid #000000;
      margin-top: 40px;
      padding-top: 4px;
    }
    .arrco-dn-note {
      margin-top: 30px;
      font-size: 8pt;
      font-weight: 700;
      color: #000000;
      border-top: 1px solid #e2e8f0;
      padding-top: 10px;
    }

    .arrco-inv-bottom-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      border: 1px solid #000000;
      margin-bottom: 20px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .arrco-inv-words-panel {
      padding: 10px 12px;
      border-right: 1px solid #000000;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .arrco-inv-totals-panel {
      width: 100%;
    }
    .arrco-inv-totals-table {
      width: 100%;
      border-collapse: collapse;
    }
    .arrco-inv-totals-table td {
      padding: 6px 12px;
      font-size: 8.5pt;
      border-bottom: 1px solid #e2e8f0;
    }
    .arrco-inv-totals-table tr:last-child td {
      border-bottom: none;
    }
    .arrco-inv-totals-table td:first-child {
      border-right: 1px solid #e2e8f0;
      color: #333333;
    }
    .arrco-inv-totals-table td:last-child {
      font-weight: 700;
      text-align: right;
    }

    .arrco-inv-signature-section {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 20px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .arrco-inv-disclaimer-text {
      width: 55%;
      font-size: 7pt;
      color: #555555;
      line-height: 1.4;
    }
    .arrco-inv-sign-stamp-box {
      width: 38%;
      border: 1px solid #000000;
      text-align: center;
      background-color: white;
    }
    .arrco-inv-sign-stamp-header {
      background-color: #000000;
      color: #ffffff;
      font-weight: 700;
      font-size: 8pt;
      padding: 5px;
    }
    .arrco-inv-sign-stamp-body {
      height: 60px;
      position: relative;
    }
    .arrco-inv-sign-stamp-footer {
      border-top: 1px solid #000000;
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      font-size: 7.5pt;
    }
    .arrco-inv-sign-stamp-footer-cell {
      padding: 4px;
      font-weight: 700;
    }
    .arrco-inv-sign-stamp-footer-cell:first-child {
      border-right: 1px solid #000000;
      text-align: left;
    }

    .page-break {
      page-break-before: always;
      break-before: always;
    }

    /* Terms of Sale Page */
    .terms-page {
      padding: 5px;
      color: #111111;
      font-size: 6.8pt;
      line-height: 1.3;
    }
    .terms-title {
      font-size: 13pt;
      font-weight: 900;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 12px;
      border-bottom: 2px solid #000000;
      padding-bottom: 4px;
    }
    .terms-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .terms-col {
      text-align: justify;
    }
    .terms-section {
      margin-bottom: 8px;
    }
    .terms-section-title {
      font-weight: 700;
      text-transform: uppercase;
      color: #000000;
      margin-bottom: 2px;
      font-size: 7.2pt;
    }
  </style>
</head>
<body>
  
  <div class="print-page">

    <!-- Print control bar (hidden in printed doc) -->
    <div class="no-print">
      <div>
        <label for="layoutSelector" class="text-xs font-bold text-slate-600 mr-2">Choose Print Layout:</label>
        <select id="layoutSelector" class="layout-select">
          <option value="standard">Standard Template (Delight Group)</option>
          <option value="arrco">Modern Grid Layout (Delight Group)</option>
        </select>
      </div>
      <div class="flex gap-2">
        <button class="btn btn-secondary" onclick="window.close()">Close Preview</button>
        <button class="btn btn-primary" onclick="window.print()">Print Document</button>
      </div>
    </div>

    <!-- Render Standard Layout component -->
    <div id="layout-standard-wrapper" style="display: block;">
      <StandardPrintLayout 
        inv={inv} 
        items={items} 
        settings={settings} 
        documentTitle={documentTitle} 
        logoColor={logoColor}
        companyNameEN={companyNameEN}
      />
    </div>

    <!-- Render Modern Grid Layout component -->
    <div id="layout-arrco-wrapper" style="display: none;">
      <ModernGridPrintLayout 
        inv={inv} 
        items={items} 
        settings={settings} 
        logoColor={logoColor}
        isDGS={isDGS}
        companyNameEN={companyNameEN}
        companyNameAR={companyNameAR}
        websiteURL={websiteURL}
        amountInWords={amountInWords}
        totalQty={totalQty}
      />
    </div>

  </div>

  <script>
    // Toggle templates based on layout selector
    const layoutSelector = document.getElementById('layoutSelector') as HTMLSelectElement;
    const stdLayoutWrapper = document.getElementById('layout-standard-wrapper');
    const arrcoLayoutWrapper = document.getElementById('layout-arrco-wrapper');

    const updateLayout = (layout: string) => {
      if (layout === 'arrco') {
        stdLayoutWrapper!.style.display = 'none';
        arrcoLayoutWrapper!.style.display = 'block';
      } else {
        stdLayoutWrapper!.style.display = 'block';
        arrcoLayoutWrapper!.style.display = 'none';
      }
    };

    // Listen to selection changes
    layoutSelector?.addEventListener('change', (e) => {
      const selected = (e.target as HTMLSelectElement).value;
      updateLayout(selected);
      // Persist selection in URL
      const url = new URL(window.location.href);
      url.searchParams.set('layout', selected);
      window.history.replaceState({}, '', url.toString());
    });

    // Read initial layout from URL params
    const urlParams = new URLSearchParams(window.location.search);
    const initialLayout = urlParams.get('layout') || 'standard';
    if (layoutSelector) {
      layoutSelector.value = initialLayout;
      updateLayout(initialLayout);
    }

    // Auto print if requested via query param
    if (urlParams.get('autoprint') === 'true' || urlParams.get('download') === 'true') {
      window.onload = () => {
        setTimeout(() => {
          window.print();
        }, 400);
      };
    }
  </script>
</body>
</html>
