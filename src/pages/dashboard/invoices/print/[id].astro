---
import { query } from '../../../../lib/db';
import StandardPrintLayout from '../../../../components/print/StandardPrintLayout.astro';
import ModernGridPrintLayout from '../../../../components/print/ModernGridPrintLayout.astro';

const { id } = Astro.params;

let inv: any = null;
let items: any[] = [];
let settings: Record<string, string> = {};
let selectedClauses: any[] = [];

try {
  // Fetch invoice details
  const invRes = await query(`
    SELECT i.*, 
       (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list
    FROM invoices i WHERE id = $1
  `, [id]);
  inv = invRes.rows[0];

  if (inv) {
    items = typeof inv.items_list === 'string' ? JSON.parse(inv.items_list) : (inv.items_list || []);
  }

  // Fetch settings
  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => {
    acc[row.key] = row.value;
    return acc;
  }, {});

  // Fetch selected disclaimers/clauses
  let selectedIdentifiers: string[] = [];
  try {
    selectedIdentifiers = JSON.parse(inv?.payment_terms || '[]');
  } catch (e) {
    selectedIdentifiers = [];
  }

  if (selectedIdentifiers.length > 0) {
    const placeholders = selectedIdentifiers.map((_, i) => `$${i + 1}`).join(',');
    const legalRes = await query(`
      SELECT title, content FROM legal_artifacts 
      WHERE identifier IN (${placeholders})
    `, selectedIdentifiers);
    selectedClauses = legalRes.rows;
  }

} catch (err: any) {
  console.error('Error fetching print invoice details:', err.message);
}

if (!inv) {
  return Astro.redirect('/dashboard/invoices');
}

const showTaxInvoice = Number(inv.gst_amount) > 0 || inv.order_type === 'tax_invoice';
const documentTitle = inv.order_type === 'quotation' ? 'QUOTATION / ESTIMATE' : 
                      inv.order_type === 'lpo' ? 'LOCAL PURCHASE ORDER' : 
                      inv.order_type === 'delivery_note' ? 'DELIVERY NOTE' : 
                      inv.order_type === 'inquiry' ? 'INQUIRY' :
                      showTaxInvoice ? 'TAX INVOICE' : 'COMMERCIAL INVOICE';

// Number to Words converter (compliant with AED Dirhams and Fils)
function numberToWords(num: number): string {
  const a = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
  const b = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
  
  function convert(n: number): string {
    if (n < 20) return a[n];
    if (n < 100) return b[Math.floor(n / 10)] + (n % 10 ? ' ' + a[n % 10] : '');
    if (n < 1000) return a[Math.floor(n / 100)] + ' hundred' + (n % 100 ? ' and ' + convert(n % 100) : '');
    if (n < 1000000) return convert(Math.floor(n / 1000)) + ' thousand' + (n % 1000 ? ' ' + convert(n % 1000) : '');
    return '';
  }

  const parts = num.toFixed(2).split('.');
  const dirhams = parseInt(parts[0]);
  const fils = parseInt(parts[1]);

  let result = '';
  if (dirhams > 0) {
    result += convert(dirhams) + ' Dirham';
    if (dirhams > 1) result += 's';
  } else {
    result += 'Zero Dirhams';
  }

  if (fils > 0) {
    result += ' and ' + convert(fils) + ' fils';
  }
  result += ' Only';
  
  return result.charAt(0).toUpperCase() + result.slice(1);
}

const amountInWords = numberToWords(inv.total_amount);
const totalQty = items.reduce((sum, item) => sum + Number(item.quantity), 0);

// Division branding
const isDGS = inv.source_division === 'DGS';
const companyNameEN = isDGS ? 'Delight Global Solutions LLC' : 'Delight Group LLC';
const companyNameAR = isDGS ? 'ديلايت للحلول العالمية ش.ذ.م.م' : 'مجموعة ديلايت ش.ذ.م.م';
const websiteURL = 'www.delightgroupllc.com';
const logoColor = isDGS ? '#15803d' : '#0891b2'; // Green for DGS, Cyan for DTL/Group
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{documentTitle} - {inv.invoice_number}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@300;400;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap');
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Inter', sans-serif;
      color: #0f172a;
      background-color: #ffffff;
      line-height: 1.3;
      font-size: 10pt;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    @page {
      size: A4 portrait;
      margin: 12mm 12mm 12mm 12mm;
    }

    .print-page {
      width: 100%;
      max-width: 186mm;
      margin: 0 auto;
      background: #ffffff;
      position: relative;
    }

    .font-mono { font-family: 'JetBrains Mono', monospace; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .font-bold { font-weight: 700; }
    .font-black { font-weight: 900; }
    .text-muted { color: #64748b; }
    .uppercase { text-transform: uppercase; }

    /* Top control bar (hidden in print) */
    .no-print {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding: 12px 16px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
    }
    .btn {
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.15s ease;
    }
    .btn-primary { background: #0f172a; color: #ffffff; }
    .btn-secondary { background: #ffffff; color: #334155; border: 1px solid #d1d5db; }
    .layout-select {
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      border: 1px solid #cbd5e1;
      font-weight: 600;
      background-color: white;
    }

    @media print {
      .no-print { display: none !important; }
      body { margin: 0; padding: 0; }
    }

    /* ========================================================================= */
    /* STANDARD LAYOUT STYLES                                                    */
    /* ========================================================================= */
    .std-container {
      display: block;
    }
    .std-header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .std-company-info {
      vertical-align: top;
      width: 60%;
    }
    .std-company-title {
      font-size: 20pt;
      font-weight: 900;
      color: #0891b2;
      text-transform: uppercase;
    }
    .std-doc-meta {
      vertical-align: top;
      text-align: right;
      width: 40%;
    }
    .std-doc-title {
      font-size: 18pt;
      font-weight: 900;
      text-transform: uppercase;
      color: #0f172a;
      margin-bottom: 5px;
    }
    .std-details-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .std-details-col {
      width: 50%;
      vertical-align: top;
      border: 1px solid #e2e8f0;
      padding: 10px;
      border-radius: 6px;
    }
    .std-section-label {
      font-size: 7.5pt;
      font-weight: 900;
      color: #94a3b8;
      text-transform: uppercase;
      margin-bottom: 4px;
      letter-spacing: 0.5px;
    }
    .std-items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .std-items-table th {
      background-color: #f8fafc;
      border-bottom: 2px solid #cbd5e1;
      padding: 6px 8px;
      font-size: 8pt;
      font-weight: 900;
      text-transform: uppercase;
      color: #475569;
    }
    .std-items-table td {
      padding: 8px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 9pt;
      vertical-align: top;
    }
    .std-summary-table {
      width: 240px;
      margin-left: auto;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .std-summary-table td {
      padding: 5px 8px;
      font-size: 9.5pt;
    }
    .std-summary-table tr.grand-total {
      border-top: 2px solid #0f172a;
      font-weight: 900;
      font-size: 11pt;
    }
    .std-bank-block {
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 12px;
      background-color: #f8fafc;
      margin-bottom: 20px;
    }
    .std-bank-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-top: 6px;
      font-size: 8.5pt;
    }
    .std-signatures-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 30px;
    }
    .std-signature-col {
      width: 50%;
      vertical-align: bottom;
      text-align: center;
    }
    .std-signature-line {
      border-top: 1.5px solid #94a3b8;
      margin-top: 40px;
      padding-top: 4px;
      font-size: 8.5pt;
      font-weight: 700;
      color: #475569;
    }

    /* ========================================================================= */
    /* MODERN GRID LAYOUT STYLES                                                 */
    /* ========================================================================= */
    .arrco-container {
      display: block;
      color: #000000;
      font-size: 8.5pt;
    }
    .arrco-header {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    .arrco-logo-td {
      width: 50%;
      vertical-align: top;
    }
    .arrco-logo-svg-wrapper {
      display: inline-block;
      text-align: left;
    }
    .arrco-logo-text {
      font-family: 'Outfit', sans-serif;
      font-size: 30pt;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -1.5px;
    }
    .arrco-logo-sub {
      font-size: 7.5pt;
      letter-spacing: 2px;
      font-weight: 600;
      color: #555555;
      text-transform: uppercase;
      margin-top: -3px;
    }
    .arrco-logo-tagline {
      font-size: 5.5pt;
      color: #777777;
      margin-top: 4px;
