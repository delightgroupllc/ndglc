---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { query } from '../../../../lib/db';
import { Printer, Settings2, HelpCircle } from 'lucide-astro';

const { id } = Astro.params;

let inv: any = null;
let settings: Record<string, string> = {};
let legalArtifacts: any[] = [];
let products: any[] = [];

try {
  const invRes = await query(`
    SELECT i.*, 
       (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list
    FROM invoices i WHERE id = $1
  `, [id]);
  inv = invRes.rows[0];

  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => { acc[row.key] = row.value; return acc; }, {});

  const legalRes = await query('SELECT * FROM legal_artifacts ORDER BY type DESC, identifier ASC');
  legalArtifacts = legalRes.rows;

  const prodRes = await query(`
    SELECT p.id, pi.url as image_url
    FROM products p
    LEFT JOIN product_images pi ON pi.product_id = p.id AND pi.is_primary = TRUE
  `);
  products = prodRes.rows;
} catch (err: any) {
  console.warn('DB error in print engine:', err.message);
}

if (!inv) {
  // If we can't find it (or DB offline), render a dummy for preview
  inv = {
    id: id || 'inv-mock-1',
    invoice_number: 'INV-2026-8094',
    customer_name: 'Vance Metallurgy LLC',
    customer_email: 'alex.vance@steelgroup.com',
    customer_phone: '+1 (555) 0189',
    issue_date: '2026-05-10',
    due_date: '2026-06-10',
    payment_status: 'paid',
    order_type: 'tax_invoice',
    subtotal: 10500,
    gst_amount: 1890,
    total_amount: 12390,
    items_list: [
      { description: 'HP-100 Stainless Ball Valve (Duplex option)', quantity: 2, unit_price: 5250, total_price: 10500 }
    ]
  };
}

let items: any[] = [];
try {
  items = typeof inv.items_list === 'string' ? JSON.parse(inv.items_list) : (inv.items_list || []);
} catch {
  items = [];
}

const subtotal = Number(inv.subtotal) || 0;
const gst = Number(inv.gst_amount) || 0;
const discount = Number(inv.discount_amount) || 0;
const grandTotal = Number(inv.total_amount) || 0;

let offerPd = 0;
if (inv.payment_status === 'paid') offerPd = grandTotal;
else if (inv.order_type === 'proforma') offerPd = grandTotal * 0.5;

const balanceDue = grandTotal - offerPd;
---

<DashboardLayout title={`Print ${inv.invoice_number}`} activeItem="invoices">

  <style is:global>
    /* Print Engine Specific Styles */
    body { background-color: #f8fafc; }

    /* Screen preview footer styles */
    .print-page-footer {
      position: absolute;
      bottom: 24px;
      left: 48px;
      right: 48px;
      display: flex;
      justify-content: space-between;
      border-top: 1px solid #e2e8f0;
      padding-top: 8px;
      font-size: 8px;
      font-weight: 800;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      pointer-events: none;
    }
    
    @media print {
      @page { size: A4; margin: 15mm; }
      body { counter-reset: page; background-color: white; }
      /* Hide dashboard layout and sidebar */
      #sidebar, header, .print-hidden { display: none !important; }
      main { padding: 0 !important; margin: 0 !important; background: white !important; }
      
      .a4-sheet {
        box-shadow: none !important;
        margin: 0 !important;
        border: none !important;
        page-break-after: always;
        height: auto !important;
        min-height: 0 !important;
      }
      
      .print-page-footer {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        display: flex; justify-content: space-between;
        border-top: 1px solid #e2e8f0; padding-top: 8px;
        font-size: 8px; font-weight: bold; color: #64748b;
        text-transform: uppercase; letter-spacing: 0.05em;
        pointer-events: auto;
      }
      .print-page-footer-num::after {
        counter-increment: page;
        content: "Page " counter(page) " of 2";
      }
    }
  </style>

  <div id="print-root-container" data-grand-total={grandTotal} data-division={inv.source_division || 'DTL'} class="flex h-[calc(100vh-80px)] -m-4 sm:-m-6 lg:-m-8 overflow-hidden print:h-auto print:overflow-visible print:block">
    
    <!-- LEFT: Document Canvas (Simulated A4 Pages) -->
    <div class="flex-1 overflow-y-auto bg-slate-200/50 p-8 flex flex-col items-center gap-8 custom-scrollbar print:p-0 print:bg-white print:block">
      
      <!-- Print Canvas Top Action Bar (Visible on screen, hidden when printing) -->
      <div class="w-[210mm] bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between print:hidden shrink-0">
        <a href="/dashboard/invoices" class="inline-flex items-center justify-center gap-2 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 px-4 py-2 rounded-lg text-xs font-bold transition-all shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Orders
        </a>
        <div class="flex items-center gap-2">
          <button type="button" onclick="window.print()" class="inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-bold transition-all shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            Send to Printer
          </button>
        </div>
      </div>

      <!-- PAGE 1: The Invoice Form -->
      <div class="a4-sheet w-[210mm] min-h-[297mm] bg-white shadow-xl rounded border border-slate-200 p-12 relative overflow-hidden shrink-0 print:rounded-none">
        <!-- Watermark -->
        <div id="print-watermark" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.03] transition-opacity z-0">
          <img src="/dgllclogolarge.png" class="w-[500px] h-auto max-w-full" id="watermark-img" />
        </div>

        <div class="relative z-10 space-y-8 pb-24">
          <!-- Header -->
          <div class="flex justify-between items-start gap-4">
            <div id="print-logo-container" class="h-24 flex items-center">
              <img src="/dgllclogosmall.png" class="h-24 w-auto" id="print-company-logo" />
            </div>
            <div class="text-right">
              <h3 class="text-3xl font-black text-slate-900 tracking-tight uppercase" id="print-doc-header-title" style="font-family: 'Outfit', sans-serif;">
                {inv.order_type === 'quotation' ? 'ESTIMATION' : (inv.order_type === 'lpo' ? 'PRO FORMA INVOICE' : (inv.order_type === 'delivery_note' ? 'DELIVERY NOTE' : 'TAX INVOICE'))}
              </h3>
              <p class="text-xs text-slate-500 font-extrabold tracking-widest mt-1 font-mono uppercase">{inv.invoice_number}</p>
            </div>
          </div>

          <!-- 3-Column Info -->
          <div class="grid grid-cols-3 gap-6 text-[10px] leading-relaxed">
            <!-- From -->
            <div class="border border-slate-200 rounded-xl p-5 bg-white space-y-2">
              <div class="border-b border-slate-100 pb-2 mb-2"><h4 class="font-extrabold text-slate-400 uppercase tracking-widest text-[9px]">FROM (SENDER)</h4></div>
              <p class="font-black text-slate-900 text-xs uppercase tracking-wide">Delight Group LLC</p>
              <p class="text-slate-600 font-bold" id="print-from-division-desc">{inv.source_division === 'DGS' ? 'Delight Greenscapes' : 'Delight Technical Lighting'}</p>
              <p class="text-slate-500 text-[9px] leading-relaxed">{settings.business_address || 'Dubai, United Arab Emirates'}</p>
              <p class="text-slate-500 font-mono mt-1">TRN: {settings.trn_number || '10003862800003'}</p>
            </div>

            <!-- To -->
            <div class="border border-slate-200 rounded-xl p-5 bg-white space-y-2">
              <div class="border-b border-slate-100 pb-2 mb-2"><h4 class="font-extrabold text-slate-400 uppercase tracking-widest text-[9px]">BILLING TO</h4></div>
              <p class="font-black text-slate-900 text-xs uppercase tracking-wide">{inv.customer_name}</p>
              <p class="text-slate-600 font-bold" id="print-cust-company">{inv.company_name || ''}</p>
              <p class="text-slate-500 text-[9px] leading-relaxed" id="print-cust-address">{inv.billing_address || ''}</p>
              <p class="text-slate-500 font-semibold" id="print-cust-contact">{inv.customer_email || ''}{inv.customer_phone ? ` • ${inv.customer_phone}` : ''}</p>
              {inv.company_vat && <p class="text-slate-500 font-mono mt-1" id="print-cust-trn">TRN: {inv.company_vat}</p>}
            </div>

            <!-- Details -->
            <div class="border border-slate-200 rounded-xl p-5 bg-slate-50 space-y-2">
              <div class="border-b border-slate-200 pb-2 mb-2"><h4 class="font-extrabold text-slate-400 uppercase tracking-widest text-[9px]">DOCUMENT INFO</h4></div>
              <div class="space-y-1.5 text-slate-700 font-semibold text-[10px]">
                <div class="flex justify-between items-center" id="print-info-status">
                  <span class="text-slate-400 uppercase">STATUS:</span>
                  <span class={`font-black uppercase px-1.5 py-0.5 rounded ${inv.payment_status === 'paid' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>
                    {inv.payment_status === 'paid' ? 'CONFIRMED' : inv.payment_status}
                  </span>
                </div>
                <div class="flex justify-between items-center" id="print-info-date"><span class="text-slate-400 uppercase">DATE:</span><span class="font-mono">{new Date(inv.issue_date).toLocaleDateString('en-AE')}</span></div>
                <div class="flex justify-between items-center" id="print-info-due"><span class="text-slate-400 uppercase">DUE/DELIVERY:</span><span class="font-mono">{inv.due_date ? new Date(inv.due_date).toLocaleDateString('en-AE') : 'N/A'}</span></div>
              </div>
            </div>
          </div>

          <!-- Items Table -->
          <table class="w-full text-left border-collapse text-[10px]">
            <thead>
              <tr class="border-b-2 border-slate-800 text-slate-800 uppercase text-[9px] tracking-widest font-black">
                <th class="py-3 pr-2">Item Description</th>
                <th class="py-3 text-center">Qty</th>
                <th class="py-3 text-right pr-2 print-col-price-header">Price</th>
                <th class="py-3 text-right">Total</th>
              </tr>
            </thead>
            <tbody id="print-items-list" class="divide-y divide-slate-100">
              {items.map(item => {
                const matchingProd = products.find(p => p.id === item.product_id);
                const imageUrl = item.item_image || matchingProd?.image_url;
                return (
                  <tr class="align-top">
                    <td class="py-4 pr-4">
                      <div class="flex items-start gap-3">
                        {imageUrl && (
                          <img src={imageUrl} class="w-10 h-10 rounded object-cover border border-slate-200 shrink-0 mt-0.5 shadow-sm product-thumbnail-img hidden animate-fade-in" />
                        )}
                        <div class="flex-1">
                          <div class="font-extrabold text-slate-900 text-[11px]">{item.description}</div>
                          {item.catalogue_ref && <div class="text-[9px] text-slate-400 font-mono mt-1 print-item-cat-ref">REF: {item.catalogue_ref}</div>}
                          {item.tech_spec && <div class="text-[9px] text-slate-500 mt-1 max-w-sm leading-relaxed print-item-tech-spec">{item.tech_spec}</div>}
                        </div>
                      </div>
                    </td>
                    <td class="py-4 text-center font-bold text-slate-700">{item.quantity}</td>
                    <td class="py-4 text-right font-semibold text-slate-550 pr-2 font-mono print-col-price-cell">AED {Number(item.unit_price).toLocaleString('en-AE', { minimumFractionDigits: 2 })}</td>
                    <td class="py-4 text-right font-black text-slate-900 font-mono">AED {(item.quantity * item.unit_price).toLocaleString('en-AE', { minimumFractionDigits: 2 })}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>

          <!-- Totals -->
          <div class="flex justify-end pt-4 border-t border-slate-200">
            <div class="w-72 text-xs space-y-2">
              <div class="flex justify-between text-slate-500 font-bold uppercase tracking-wider text-[10px]" id="print-total-subtotal"><span>Subtotal</span><span class="text-slate-800 font-mono">AED {subtotal.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</span></div>
              <div class="flex justify-between text-slate-500 font-bold uppercase tracking-wider text-[10px]" id="print-total-vat"><span>VAT (5%)</span><span class="text-slate-800 font-mono">AED {gst.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</span></div>
              {discount > 0 && <div class="flex justify-between text-slate-500 font-bold uppercase tracking-wider text-[10px]" id="print-total-discount"><span>Discount</span><span class="text-slate-800 font-mono">- AED {discount.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</span></div>}
              
              <div class="flex justify-between border-t border-slate-800 pt-3 mt-3 text-slate-900 font-black uppercase tracking-wider text-sm">
                <span>Grand Total</span><span class="font-mono">AED {grandTotal.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</span>
              </div>
              
              <div class="flex justify-between text-slate-500 font-bold uppercase tracking-wider text-[10px] mt-2" id="print-total-settled">
                <span>Amount Settled</span><span class="font-mono text-slate-800">AED {offerPd.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</span>
              </div>
              <div class="flex justify-between border-t border-slate-200 pt-2 font-black uppercase tracking-wider text-[11px] text-rose-600" id="print-total-due">
                <span>Balance Due</span><span class="font-mono">AED {balanceDue.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</span>
              </div>
            </div>
          </div>

          <!-- Finance Settlement Injection -->
          <div id="finance-settlement-block" class="hidden mt-8 p-5 bg-blue-50/50 border border-blue-100 rounded-xl">
            <h4 class="font-extrabold text-blue-800 uppercase tracking-widest text-[9px] mb-3">Finance Settlement Schedule</h4>
            <table class="w-full text-left border-collapse text-[10px]">
              <thead>
                <tr class="border-b border-blue-200 text-blue-600 uppercase text-[8px] tracking-widest">
                  <th class="pb-2">Installment</th>
                  <th class="pb-2">Date</th>
                  <th class="pb-2 text-right">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-blue-100/50">
                <tr>
                  <td id="print-finance-p1-label-cell" class="py-2 text-blue-900 font-bold">Advance Payment (50%)</td>
                  <td id="print-finance-p1-date-cell" class="py-2 text-blue-700">{new Date().toLocaleDateString('en-AE')}</td>
                  <td id="print-finance-p1-amount-cell" class="py-2 text-right font-mono text-blue-900">AED {(grandTotal * 0.5).toLocaleString('en-AE', { minimumFractionDigits: 2 })}</td>
                </tr>
                <tr>
                  <td id="print-finance-p2-label-cell" class="py-2 text-blue-900 font-bold">Final Settlement (50%)</td>
                  <td id="print-finance-p2-date-cell" class="py-2 text-blue-700">Before Delivery</td>
                  <td id="print-finance-p2-amount-cell" class="py-2 text-right font-mono text-blue-900">AED {(grandTotal * 0.5).toLocaleString('en-AE', { minimumFractionDigits: 2 })}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Bank Transfer / Remittance Details -->
          <div id="bank-details-block" class="hidden mt-8 p-5 bg-slate-50 border border-slate-200 rounded-xl">
            <h4 class="font-extrabold text-slate-800 uppercase tracking-widest text-[9px] mb-3">Bank Transfer & Remittance Details</h4>
            <div class="grid grid-cols-2 gap-4 text-[10px]">
              <div>
                <span class="text-slate-400 uppercase font-black text-[8px] block tracking-wider">Beneficiary Bank</span>
                <span id="print-bank-name" class="text-slate-900 font-black uppercase text-[10px]">Delight Bank International</span>
              </div>
              <div>
                <span class="text-slate-400 uppercase font-black text-[8px] block tracking-wider">Account Number</span>
                <span id="print-bank-acc" class="text-slate-900 font-mono font-bold">120938491829</span>
              </div>
              <div class="col-span-2 sm:col-span-1">
                <span class="text-slate-400 uppercase font-black text-[8px] block tracking-wider">IBAN Number</span>
                <span id="print-bank-iban" class="text-slate-900 font-mono font-bold">AE2100092810000120938491829</span>
              </div>
              <div class="col-span-2 sm:col-span-1">
                <span class="text-slate-400 uppercase font-black text-[8px] block tracking-wider">Swift / BIC Code</span>
                <span id="print-bank-swift" class="text-slate-900 font-mono font-bold uppercase">DBIUAE2DXXX</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Page 1 Footer (Screen preview only, hidden in print as fixed print footer takes over) -->
        <div class="print-page-footer print:hidden">
          <div>
            <span class="text-slate-900">DELIGHT GROUP LLC</span>
            <span class="mx-1 text-slate-300">|</span>
            <span class="text-slate-500">TECHNICAL LIGHTING & GREENSCAPES</span>
          </div>
          <div id="screen-page-1-num" class="font-mono text-slate-400">Page 1 of 2</div>
        </div>
      </div>

      <!-- PAGE 2: Terms & Signatures -->
      <div id="print-page-2-container" class="a4-sheet w-[210mm] min-h-[297mm] bg-white shadow-xl rounded border border-slate-200 p-12 relative overflow-hidden shrink-0 print:rounded-none">
        
        <div class="flex justify-between items-start gap-4 mb-8">
          <div class="h-16 flex items-center"><img src="/dgllclogosmall.png" class="h-16 w-auto" id="print-company-logo-p2" /></div>
          <div class="text-right">
            <h3 class="text-xl font-black text-slate-900 tracking-tight uppercase" style="font-family: 'Outfit', sans-serif;">TERMS & CONDITIONS</h3>
            <p class="text-[10px] text-slate-500 font-extrabold tracking-widest mt-1 font-mono uppercase">{inv.invoice_number}</p>
          </div>
        </div>
        <div class="border-b-2 border-slate-800 mb-8"></div>

        <div class="space-y-5 text-[10px] leading-relaxed text-slate-700 min-h-[180mm]">
          <div id="print-legal-clauses-area" class="space-y-5">
            {legalArtifacts.map(artifact => (
              <div class="clause-block" data-identifier={artifact.identifier}>
                <h5 class="font-extrabold text-slate-900 uppercase tracking-wider text-[10px]">{artifact.title}</h5>
                <p class="text-slate-600 mt-1 uppercase text-[9px]">{artifact.content}</p>
              </div>
            ))}
          </div>
        </div>

        <div id="corporate-auth-standard-block" class="grid grid-cols-3 gap-12 mt-auto pt-12 text-[10px] font-black uppercase tracking-wider text-slate-800">
          <div id="print-sig-client-col"><div class="border-t border-slate-900 pt-2"><p>CLIENT ACKNOWLEDGEMENT</p></div></div>
          <div id="print-sig-company-col"><div class="border-t border-slate-900 pt-2"><p>AUTHORIZED SIGNATORY</p></div></div>
          <div id="print-sig-it-col" class="hidden"><div class="border-t border-slate-900 pt-2"><p>IT VERIFIED AUTH</p><span class="text-[8px] font-bold text-emerald-600 mt-1 block tracking-normal normal-case">✓ SECURE RECORD</span></div></div>
        </div>

        <div id="print-electronic-badge" class="mt-8 p-4 bg-slate-50 border border-slate-200 rounded-xl text-center text-[9px] font-bold text-slate-500 uppercase tracking-widest space-y-1">
          <div class="text-slate-800 flex items-center justify-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>ELECTRONIC DOCUMENT</span>
          </div>
          <p class="text-[8px] font-semibold text-slate-400 normal-case">This invoice is electronically generated & requires no physical signature or company stamp.</p>
        </div>

        <!-- Print Footer (Visible in print and screen) -->
        <div class="print-page-footer">
          <div>
            <span class="text-slate-900">DELIGHT GROUP LLC</span>
            <span class="mx-1 text-slate-300">|</span>
            <span class="text-slate-500">TECHNICAL LIGHTING & GREENSCAPES</span>
          </div>
          <div class="print-page-footer-num font-mono print:block hidden"></div>
          <div id="screen-page-2-num" class="font-mono text-slate-400 print:hidden">Page 2 of 2</div>
        </div>
      </div>
    </div>

    <!-- Backdrop for mobile floating sidebar (hidden on large screens) -->
    <div id="print-sidebar-backdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-30 hidden lg:hidden print:hidden transition-opacity duration-300 opacity-0"></div>

    <!-- Floating Sidebar Toggle Button (Visible only on mobile/tablet screen) -->
    <button type="button" id="print-sidebar-toggle" class="fixed bottom-6 right-6 z-50 p-4 bg-cyan-600 hover:bg-cyan-500 text-slate-950 rounded-full shadow-2xl transition-all active:scale-95 lg:hidden print:hidden flex items-center justify-center border border-cyan-400/30">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    </button>

    <!-- RIGHT: Configuration Sidebar -->
