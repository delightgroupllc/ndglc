                <option value="none">Hide Signature Area Completely</option>
              </select>
            </div>

            <div class="mt-2.5 pt-2 border-t border-slate-800/40">
              <label class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block mb-1">Select Signatory Stamp</label>
