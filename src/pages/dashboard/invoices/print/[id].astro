                  <>
                    <option value="Delight Greenscapes" selected={companyNameEN === 'Delight Greenscapes' || companyNameEN === 'Delight Global Solutions'}>Delight Greenscapes</option>
                    <option value="Delight Group LLC" selected={companyNameEN === 'Delight Group LLC'}>Delight Group LLC</option>
                  </>
                ) : (
                  <>
                    <option value="Delight Technical Lighting" selected={companyNameEN === 'Delight Technical Lighting'}>Delight Technical Lighting</option>
                    <option value="Delight Group LLC" selected={companyNameEN === 'Delight Group LLC'}>Delight Group LLC</option>
                  </>
                )}
              </select>
            </div>
            
            <div class="pt-2 border-t border-slate-805 space-y-2 font-semibold">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="sig-client" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Customer Signature Line</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="sig-receiver" class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
