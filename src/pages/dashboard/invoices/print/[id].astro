---
import { query } from '../../../../lib/db';

const { id } = Astro.params;

let inv: any = null;
let items: any[] = [];
let settings: Record<string, string> = {};
let selectedClauses: any[] = [];

try {
  // Fetch invoice details
  const invRes = await query(`
    SELECT i.*, 
       (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list
    FROM invoices i WHERE id = $1
  `, [id]);
  inv = invRes.rows[0];

  if (inv) {
    items = typeof inv.items_list === 'string' ? JSON.parse(inv.items_list) : (inv.items_list || []);
  }

  // Fetch settings
  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => {
    acc[row.key] = row.value;
    return acc;
  }, {});

  // Fetch selected disclaimers/clauses
  let selectedIdentifiers: string[] = [];
  try {
    selectedIdentifiers = JSON.parse(inv?.payment_terms || '[]');
  } catch (e) {
    selectedIdentifiers = [];
  }

  if (selectedIdentifiers.length > 0) {
    const placeholders = selectedIdentifiers.map((_, i) => `$${i + 1}`).join(',');
    const legalRes = await query(`
      SELECT title, content FROM legal_artifacts 
      WHERE identifier IN (${placeholders})
    `, selectedIdentifiers);
    selectedClauses = legalRes.rows;
  }

} catch (err: any) {
  console.error('Error fetching print invoice details:', err.message);
}

if (!inv) {
  return Astro.redirect('/dashboard/invoices');
}

const showTaxInvoice = Number(inv.gst_amount) > 0 || inv.order_type === 'tax_invoice';
const documentTitle = inv.order_type === 'quotation' ? 'QUOTATION / ESTIMATE' : 
                      inv.order_type === 'lpo' ? 'LOCAL PURCHASE ORDER' : 
                      inv.order_type === 'delivery_note' ? 'DELIVERY NOTE' : 
                      inv.order_type === 'inquiry' ? 'INQUIRY' :
                      showTaxInvoice ? 'TAX INVOICE' : 'COMMERCIAL INVOICE';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{documentTitle} - {inv.invoice_number}</title>
  <style>
    /* CSS Reset and Font configuration */
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap');
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Outfit', sans-serif;
      color: #0f172a;
      background-color: #ffffff;
      line-height: 1.4;
      font-size: 11pt;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* A4 portrait layout specifications */
    @page {
      size: A4 portrait;
      margin: 15mm 15mm 20mm 15mm;
    }

    .print-page {
      width: 100%;
      max-width: 180mm;
      margin: 0 auto;
      background: #ffffff;
    }

    /* Typography & Utilities */
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .font-black { font-weight: 900; }
    .font-bold { font-weight: 700; }
    .font-semibold { font-weight: 600; }
    .text-muted { color: #64748b; }
    .uppercase { text-transform: uppercase; }
    .tracking-wider { tracking-spacing: 0.05em; }

    /* Header styling */
    .header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }
    .company-info {
      vertical-align: top;
      width: 60%;
    }
    .company-title {
      font-size: 20pt;
      font-weight: 900;
      color: #0891b2;
      text-transform: uppercase;
      letter-spacing: -0.5px;
    }
    .doc-meta {
      vertical-align: top;
      text-align: right;
      width: 40%;
    }
    .doc-title {
      font-size: 18pt;
      font-weight: 900;
      text-transform: uppercase;
      color: #0f172a;
      margin-bottom: 5px;
    }

    /* Details Grid */
    .details-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }
    .details-col {
      width: 50%;
      vertical-align: top;
      border: 1px solid #e2e8f0;
      padding: 12px;
      border-radius: 8px;
    }
    .details-col:first-child {
      border-right: none;
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }
    .details-col:last-child {
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }
    .section-label {
      font-size: 8pt;
      font-weight: 900;
      color: #94a3b8;
      text-transform: uppercase;
      margin-bottom: 6px;
      letter-spacing: 1px;
    }

    /* Items Table */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }
    .items-table th {
      background-color: #f8fafc;
      border-bottom: 2px solid #cbd5e1;
      padding: 8px 10px;
      font-size: 8pt;
      font-weight: 900;
      text-transform: uppercase;
      color: #475569;
    }
    .items-table td {
      padding: 10px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 9.5pt;
      vertical-align: top;
    }
    .items-table tr {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    /* Summary block */
    .summary-wrapper {
      width: 100%;
      margin-bottom: 30px;
    }
    .summary-table {
      width: 260px;
      margin-left: auto;
      border-collapse: collapse;
    }
    .summary-table td {
      padding: 6px 10px;
      font-size: 10pt;
    }
    .summary-table tr.grand-total {
      border-top: 2px solid #0f172a;
      font-weight: 900;
      font-size: 12pt;
    }

    /* Bank Remittance Details block */
    .bank-block {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 15px;
      background-color: #f8fafc;
      margin-bottom: 30px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .bank-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 8px;
    }
    .bank-item {
      font-size: 9pt;
    }
    .bank-item span.label {
      font-weight: 700;
      color: #64748b;
      margin-right: 5px;
    }
    .bank-item span.val {
      font-weight: 600;
      color: #0f172a;
    }

    /* Signature & Clauses styling */
    .footer-section {
      margin-top: auto;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .clauses-block {
      margin-bottom: 25px;
      font-size: 8pt;
      color: #64748b;
      line-height: 1.5;
      border-top: 1px solid #e2e8f0;
      padding-top: 15px;
    }
    .clauses-block h4 {
      font-weight: 900;
      text-transform: uppercase;
      color: #475569;
      margin-bottom: 5px;
      font-size: 8.5pt;
    }
    .signatures-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 40px;
    }
    .signature-col {
      width: 50%;
      vertical-align: bottom;
      text-align: center;
      padding: 0 20px;
    }
    .signature-line {
      border-top: 1.5px solid #94a3b8;
      margin-top: 50px;
      padding-top: 5px;
      font-size: 9pt;
      font-weight: 700;
      color: #475569;
    }

    /* Hide print controls during print */
    .no-print {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-bottom: 20px;
      padding: 10px;
      background: #f1f5f9;
      border-radius: 8px;
    }
    .btn {
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      border: none;
    }
    .btn-primary { background: #0f172a; color: #ffffff; }
    .btn-secondary { background: #ffffff; color: #334155; border: 1px solid #d1d5db; }

    @media print {
      .no-print { display: none !important; }
      body { margin: 0; padding: 0; }
    }
  </style>
</head>
<body>
  
  <div class="print-page">

    <!-- Print control bar (hidden in printed doc) -->
    <div class="no-print">
      <button class="btn btn-secondary" onclick="window.close()">Close Preview</button>
      <button class="btn btn-primary" onclick="window.print()">Print Document</button>
    </div>

    <!-- Header Block -->
    <table class="header-table">
      <tr>
        <td class="company-info">
          <div class="company-title">DELIGHT GROUP LLC</div>
          <div class="text-muted" style="font-size: 9pt; margin-top: 5px; line-height: 1.4;">
            {settings.business_address || 'Dubai, United Arab Emirates'}<br>
            TRN: <span class="font-mono font-bold" style="color:#0f172a;">{settings.trn_number || '100xxxxxxxxxxxx'}</span><br>
            Email: corporate@delightgroupllc.com | Phone: +971 4 000 0000
          </div>
        </td>
        <td class="doc-meta">
          <div class="doc-title">{documentTitle}</div>
          <div style="font-size: 10pt; line-height: 1.5;">
            Document No: <span class="font-mono font-bold">{inv.invoice_number}</span><br>
            Issue Date: <span class="font-bold">{inv.issue_date}</span><br>
            {inv.due_date && <span>Due Date: <span class="font-bold">{inv.due_date}</span><br></span>}
            {inv.lpo_number && <span>Ref LPO No: <span class="font-mono font-bold">{inv.lpo_number}</span><br></span>}
            Division: <span class="font-bold">{inv.source_division || 'DTL'}</span>
          </div>
        </td>
      </tr>
    </table>

    <!-- Billing Details Grid -->
    <table class="details-table">
      <tr>
        <td class="details-col">
          <div class="section-label">Remit / Bill To</div>
          <div class="font-bold" style="font-size: 11pt; color: #0f172a;">{inv.customer_name}</div>
          {inv.company_name && <div class="font-semibold text-muted" style="font-size: 9.5pt;">{inv.company_name}</div>}
          <div class="text-muted" style="font-size: 9pt; margin-top: 4px; white-space: pre-line;">
            {inv.billing_address || 'N/A'}
          </div>
          {inv.customer_email && <div class="text-muted" style="font-size: 9pt; margin-top: 4px;">Email: {inv.customer_email}</div>}
          {inv.customer_phone && <div class="text-muted" style="font-size: 9pt;">Phone: {inv.customer_phone}</div>}
        </td>
        <td class="details-col">
          <div class="section-label">Deliver To / Shipping Address</div>
          {inv.shipping_address ? (
            <div class="text-muted" style="font-size: 9pt; white-space: pre-line;">
              {inv.shipping_address}
            </div>
          ) : (
            <div class="text-muted" style="font-size: 9pt; italic">Same as Billing Address</div>
          )}
          {inv.company_vat && (
            <div style="margin-top: 10px; font-size: 9pt;">
              <span class="font-bold text-muted uppercase tracking-wider" style="font-size: 7.5pt; block">Client TRN / Tax Reg</span>
              <span class="font-mono font-bold" style="color: #0f172a;">{inv.company_vat}</span>
            </div>
          )}
        </td>
      </tr>
    </table>

    <!-- Line Items Table -->
    <table class="items-table">
      <thead>
        <tr>
          <th style="text-align: left; width: 5%;">#</th>
          <th style="text-align: left; width: 45%;">Item Description / Spec</th>
          <th style="text-align: center; width: 10%;">Qty</th>
          <th style="text-align: right; width: 15%;">Unit Price</th>
          <th style="text-align: right; width: 10%;">VAT</th>
          <th style="text-align: right; width: 15%;">Total (AED)</th>
        </tr>
      </thead>
      <tbody>
        {items.map((item, idx) => {
          const lineTotal = item.quantity * item.unit_price;
          const taxAmt = item.tax_type === 'percentage' ? lineTotal * (item.tax_value / 100) : item.tax_value;
          return (
            <tr>
              <td>{idx + 1}</td>
              <td>
                <span class="font-semibold" style="color: #0f172a;">{item.description}</span>
                {item.catalogue_ref && <span class="text-muted font-mono" style="font-size: 8pt; display: block;">Cat Ref: {item.catalogue_ref}</span>}
                {item.tech_spec && <span class="text-muted" style="font-size: 8pt; display: block; margin-top: 2px;">Specs: {item.tech_spec}</span>}
              </td>
              <td class="text-center">{item.quantity}</td>
              <td class="text-right font-mono">AED {Number(item.unit_price).toFixed(2)}</td>
              <td class="text-right font-mono">{item.tax_type === 'percentage' ? `${item.tax_value}%` : `AED ${item.tax_value}`}</td>
              <td class="text-right font-mono font-bold">AED {Number(lineTotal + taxAmt).toFixed(2)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <!-- Summary Section -->
    <div class="summary-wrapper">
      <table class="summary-table">
        <tr>
          <td class="text-muted">Subtotal (Excl. VAT):</td>
          <td class="text-right font-mono">AED {Number(inv.subtotal).toFixed(2)}</td>
        </tr>
        <tr>
          <td class="text-muted">Total VAT amount:</td>
          <td class="text-right font-mono" style="color: #c2410c;">AED {Number(inv.gst_amount).toFixed(2)}</td>
        </tr>
        {Number(inv.discount_amount) > 0 && (
          <tr>
            <td class="text-muted">Discount:</td>
            <td class="text-right font-mono" style="color: #15803d;">- AED {Number(inv.discount_amount).toFixed(2)}</td>
          </tr>
        )}
        <tr class="grand-total">
          <td>Grand Total:</td>
          <td class="text-right font-mono" style="color: #0891b2;">AED {Number(inv.total_amount).toFixed(2)}</td>
        </tr>
      </table>
    </div>

    <!-- Prefilled Remittance Details Section -->
    <div class="bank-block">
      <div class="section-label" style="color: #0891b2; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-bottom: 8px;">Remittance & Bank Instructions</div>
      <div class="bank-grid">
        <div class="bank-item"><span class="label">Bank Name:</span><span class="val">{settings.bank_name || 'N/A'}</span></div>
        <div class="bank-item"><span class="label">Account Name:</span><span class="val">{settings.account_name || 'N/A'}</span></div>
        <div class="bank-item"><span class="label">Account Number:</span><span class="val font-mono">{settings.account_number || 'N/A'}</span></div>
        <div class="bank-item"><span class="label">Swift Code:</span><span class="val font-mono">{settings.swift_code || 'N/A'}</span></div>
        <div class="bank-item" style="grid-column: span 2;"><span class="label">IBAN:</span><span class="val font-mono" style="color: #0891b2;">{settings.iban_number || 'N/A'}</span></div>
      </div>
    </div>

    <!-- Footer: Disclaimers & Signatures -->
    <div class="footer-section">
      {selectedClauses.length > 0 && (
        <div class="clauses-block">
          {selectedClauses.map(clause => (
            <div style="margin-bottom: 10px;">
              <h4>{clause.title}</h4>
              <p>{clause.content}</p>
            </div>
          ))}
        </div>
      )}

      <table class="signatures-table">
        <tr>
          <td class="signature-col">
            <div class="signature-line">Customer Signature & Stamp</div>
          </td>
          <td class="signature-col">
            <div style="font-size: 9.5pt; font-weight: 700; margin-bottom: 25px; color: #475569;">For Delight Group LLC</div>
            <div class="signature-line">Authorized Signatory ({settings.signatory_name || 'Management'})</div>
          </td>
        </tr>
      </table>
    </div>

  </div>

  <script>
    // Auto print if requested via query param
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('autoprint') === 'true' || urlParams.get('download') === 'true') {
      window.onload = () => {
        // Simple delay to ensure fonts/layout are fully rendered
        setTimeout(() => {
          window.print();
        }, 300);
      };
    }
  </script>
</body>
</html>
