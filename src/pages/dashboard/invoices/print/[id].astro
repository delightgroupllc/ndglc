      margin-bottom: 2px;
    }
    .delightgroupllc-company-name-ar {
      font-size: 12pt;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 2px;
    }
    .delightgroupllc-website {
      font-weight: 700;
      letter-spacing: 1px;
      display: block;
      margin-bottom: 4px;
    }

    .delightgroupllc-doc-title-section {
      text-align: center;
      margin-bottom: 15px;
    }
    .delightgroupllc-doc-title {
      font-size: 15pt;
      font-weight: 900;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #000000;
    }
    .delightgroupllc-trn-label {
      font-size: 11pt;
      font-weight: 700;
      margin-top: 3px;
    }

    .delightgroupllc-grid-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #000000;
      margin-bottom: 15px;
    }
    .delightgroupllc-grid-td {
      width: 50%;
      vertical-align: top;
      padding: 8px 12px;
    }
    .delightgroupllc-grid-td:first-child {
      border-right: 1px solid #000000;
    }
    .delightgroupllc-field-table {
      width: 100%;
      border-collapse: collapse;
    }
    .delightgroupllc-field-table td {
      padding: 3px 0;
      vertical-align: top;
      font-size: 8.5pt;
    }
    .delightgroupllc-field-label {
      width: 38%;
      color: #333333;
      font-weight: 500;
    }
    .delightgroupllc-field-value {
      width: 62%;
      font-weight: 700;
      color: #000000;
    }

    .delightgroupllc-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      border-top: 1.5px solid #000000;
      border-bottom: 1.5px solid #000000;
    }
    .delightgroupllc-table th {
      background-color: #000000;
      color: #ffffff;
      font-weight: 700;
      font-size: 8pt;
      padding: 7px 8px;
      text-transform: uppercase;
      border: none;
    }
    .delightgroupllc-table td {
      padding: 8px 8px;
      border-bottom: 1px solid #e2e8f0;
      border-right: none;
      font-size: 8.5pt;
      color: #000000;
    }
    
    .delightgroupllc-watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 380px;
      height: 380px;
      opacity: 1;
      pointer-events: none;
      z-index: 0;
    }

    .delightgroupllc-dn-totals {
      text-align: right;
      font-size: 9.5pt;
      font-weight: 700;
      margin-bottom: 25px;
      padding-right: 30px;
    }
    .delightgroupllc-dn-fields {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }
    .delightgroupllc-dn-fields-box {
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 8px;
      background-color: #fcfcfc;
    }
    .delightgroupllc-dn-signatures {
      display: flex;
      justify-content: space-between;
      margin-top: 50px;
      font-size: 9pt;
      font-weight: 700;
    }
    .delightgroupllc-dn-sign-box {
      width: 45%;
      text-align: left;
      line-height: 1.6;
    }
    .delightgroupllc-dn-sign-line {
      border-top: 1px solid #000000;
      margin-top: 40px;
      padding-top: 4px;
    }
    .delightgroupllc-dn-note {
      margin-top: 30px;
      font-size: 8pt;
      font-weight: 700;
      color: #000000;
      border-top: 1px solid #e2e8f0;
      padding-top: 10px;
    }

    .delightgroupllc-inv-bottom-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      border: 1px solid #000000;
      margin-bottom: 20px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .delightgroupllc-inv-bottom-grid .print-words-panel.hidden + .delightgroupllc-inv-totals-panel {
      grid-column: 1 / -1;
    }
    .delightgroupllc-inv-bottom-grid:has(.print-words-panel.hidden) {
      grid-template-columns: 1fr;
    }
    .delightgroupllc-inv-words-panel {
      padding: 10px 12px;
      border-right: 1px solid #000000;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .delightgroupllc-inv-totals-panel {
      width: 100%;
    }
    .delightgroupllc-inv-totals-table {
      width: 100%;
      border-collapse: collapse;
    }
    .delightgroupllc-inv-totals-table td {
      padding: 6px 12px;
      font-size: 8.5pt;
      border-bottom: 1px solid #e2e8f0;
    }
    .delightgroupllc-inv-totals-table tr:last-child td {
      border-bottom: none;
    }
    .delightgroupllc-inv-totals-table td:first-child {
      color: #333333;
    }
    .delightgroupllc-inv-totals-table td:last-child {
      font-weight: 700;
      text-align: right;
    }

    .delightgroupllc-inv-signature-section {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 20px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .delightgroupllc-inv-disclaimer-text {
      width: 55%;
      font-size: 7pt;
      color: #555555;
      line-height: 1.4;
    }
    .delightgroupllc-inv-sign-stamp-box {
      width: 38%;
      border: 1px solid #000000;
      text-align: center;
      background-color: white;
    }
    .delightgroupllc-inv-sign-stamp-header {
      background-color: #000000;
      color: #ffffff;
      font-weight: 700;
      font-size: 8pt;
      padding: 5px;
    }
    .delightgroupllc-inv-sign-stamp-body {
      height: 60px;
      position: relative;
    }
    .delightgroupllc-inv-sign-stamp-footer {
      border-top: 1px solid #000000;
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      font-size: 7.5pt;
    }
    .delightgroupllc-inv-sign-stamp-footer-cell {
      padding: 4px;
      font-weight: 700;
    }
    .delightgroupllc-inv-sign-stamp-footer-cell:first-child {
      border-right: 1px solid #000000;
      text-align: left;
    }

    .page-break {
      page-break-before: always;
      break-before: always;
    }

    /* Terms of Sale Page */
    .terms-page {
      padding: 2px;
      color: #111111;
      font-size: 6pt;
      line-height: 1.25;
    }
    .terms-title {
      font-size: 12pt;
      font-weight: 900;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 7px;
      border-bottom: 1.5px solid #000000;
      padding-bottom: 2px;
    }
    .terms-columns {
      column-count: 2;
      column-gap: 12px;
      display: block;
      counter-reset: term-counter;
    }
    .terms-col {
      text-align: justify;
    }
    .terms-section {
      margin-bottom: 4px;
      break-inside: avoid;
      page-break-inside: avoid;
      text-align: justify;
    }
    .terms-section:not(.hidden) {
      counter-increment: term-counter;
    }
    .terms-section p {
      margin: 0 0 3px 0;
    }
    .terms-section-title {
      font-weight: 700;
      text-transform: uppercase;
      color: #000000;
      margin-bottom: 1.5px;
      font-size: 7.2pt;
    }
    .terms-columns .terms-section-title::before {
      content: counter(term-counter) ". ";
    }
    .print-page-2-container {
      padding: 8mm 12mm 6mm 12mm !important;
    }
    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>
  
  <div id="print-root-container" data-grand-total={inv.total_amount} data-division={inv.source_division || 'DTL'} data-order-type={inv.order_type} data-id={inv.id} data-invoice-number={inv.invoice_number} class="flex h-screen overflow-hidden print:h-auto print:overflow-visible print:block">
    
    <!-- LEFT: Document Canvas (Simulated A4 Pages) -->
    <div class="flex-1 overflow-y-auto bg-slate-200/50 p-8 flex flex-col items-center gap-8 custom-scrollbar print:p-0 print:bg-white print:block">
      
      <!-- Print Canvas Top Action Bar (Visible on screen, hidden when printing) -->
      <div class="w-[210mm] no-print flex items-center justify-between shrink-0">
        <a href="/dashboard/invoices" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 text-blue-900">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Orders
        </a>
        <div class="flex items-center gap-2">
          <button type="button" onclick="window.print()" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 text-blue-900">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download as PDF
          </button>
          <button type="button" onclick="window.print()" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4" />
            </svg>
            Send to Printer
          </button>
        </div>
      </div>

      <!-- Render Standard Layout component -->
      <div id="layout-standard-wrapper" class="w-full" style="display: block;">
        <StandardPrintLayout 
          inv={inv} 
          items={items} 
          settings={settings} 
          documentTitle={documentTitle} 
          logoColor={logoColor}
          companyNameEN={companyNameEN}
          selectedClauses={selectedClauses}
          signatureImage={signatureImage}
          isCustomerDeleted={inv.is_customer_deleted}
          dnNote={dnNote}
          totalQtyInWords={totalQtyInWords}
        />
      </div>

      <!-- Render Modern Grid Layout component -->
      <div id="layout-delightgroupllc-wrapper" class="w-full" style="display: none;">
        <ModernGridPrintLayout 
          inv={inv} 
          items={items} 
          settings={settings} 
          logoColor={logoColor}
          isDGS={isDGS}
          companyNameEN={companyNameEN}
          companyNameAR={companyNameAR}
          websiteURL={websiteURL}
          amountInWords={amountInWords}
          totalQty={totalQty}
          totalQtyInWords={totalQtyInWords}
          documentTitle={documentTitle}
          selectedClauses={selectedClauses}
          signatureImage={signatureImage}
          isCustomerDeleted={inv.is_customer_deleted}
          dnNote={dnNote}
        />
      </div>
    </div>

    <!-- RIGHT: Configuration Sidebar -->
    <div id="print-sidebar-config" class="w-80 bg-white text-slate-755 p-6 flex flex-col justify-between overflow-y-auto no-print border-l border-slate-200 shrink-0 custom-scrollbar h-full z-40 transition-transform duration-300 translate-x-0">
      <div class="space-y-6">
        <div class="flex items-center justify-center gap-2.5 pb-3 border-b border-slate-200 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5 text-blue-600"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg>
          <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Print Options</h3>
        </div>

        <!-- CATEGORY 1: Template & Branding -->
        <details class="group border border-slate-200 rounded-xl bg-white overflow-hidden" open>
          <summary class="flex items-center justify-between p-3 text-xs font-bold text-slate-800 uppercase tracking-wider cursor-pointer hover:bg-slate-50 select-none transition-all">
            <div class="flex items-center gap-2">
              <div class="p-1.5 bg-blue-50 text-blue-600 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
              </div>
              <span>Template & Branding</span>
            </div>
            <span class="transition-transform duration-200 group-open:rotate-180 text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="p-3.5 border-t border-slate-850 space-y-3.5 text-xs text-slate-300">
            <!-- 1. Document Template Selector -->
            <div class="space-y-1">
              <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Print Template Layout</label>
              <select id="layoutSelector" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0">
                <option value="standard">Standard Template (Delight Group)</option>
                <option value="delightgroupllc">Modern Grid Layout (Delight Group)</option>
              </select>
            </div>

            <!-- 2. Document Title Override -->
            <div class="space-y-1">
              <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Document Header Title</label>
              <select id="config-doc-type" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0">
                <option value="TAX INVOICE" selected={inv.order_type !== 'quotation' && inv.order_type !== 'lpo' && inv.order_type !== 'delivery_note'}>TAX INVOICE</option>
                <option value="ESTIMATION / QUOTE" selected={inv.order_type === 'quotation'}>ESTIMATION / QUOTE</option>
                <option value="PRO FORMA INVOICE" selected={inv.order_type === 'lpo'}>PRO FORMA INVOICE</option>
                <option value="DELIVERY NOTE" selected={inv.order_type === 'delivery_note'}>DELIVERY NOTE</option>
                <option value="COMMERCIAL BILL">COMMERCIAL BILL</option>
                <option value="PURCHASE ORDER">PURCHASE ORDER</option>
              </select>
            </div>

            <!-- 3. Branding Selection -->
            <div class="space-y-1">
              <label class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block">Company Logo Branding</label>
              <select id="config-branding-logo" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0">
                <option value="auto">Auto-detect</option>
                {isDGS ? (
                  <option value="dgs">DGS Logo Only</option>
                ) : (
                  <option value="dtl">DTL Logo Only</option>
                )}
                <option value="dgllc">DGLLC Master Logo</option>
              </select>
            </div>

            <!-- 4. Company Name Branding Selection -->
            <div class="space-y-1 mt-1.5">
              <label class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block">Company Name Branding</label>
              <select id="config-branding-name" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0">
                <option value="auto">Auto-detect</option>
                {isDGS ? (
                  <>
                    <option value="dgs">Delight Greenscapes</option>
                    <option value="dgllc">Delight Group LLC</option>
                  </>
                ) : (
                  <>
                    <option value="dtl">Delight Technical Lighting</option>
                    <option value="dgllc">Delight Group LLC</option>
                  </>
                )}
              </select>
            </div>

            <!-- 5. Total Summary Display Mode -->
            <div class="space-y-1 mt-1.5">
              <label class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block">Total Summary Display</label>
              <select id="config-total-show-mode" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0">
                <option value="both">Show Both (Quantity & Amount)</option>
                <option value="amount">Show Total Amount Only</option>
                <option value="quantity">Show Total Quantity Only</option>
              </select>
            </div>

            <!-- Address / Profile Selector -->
            <div class="space-y-1 mt-2.5 pt-2 border-t border-slate-800/40">
              <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Office Address Profile</label>
              <select id="config-address-selector" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0">
                {addressesList.map((a: any) => (
                  <option value={a.id} selected={a.id === (settings.default_address_id || addressesList[0]?.id)}>
                    {a.business_address ? (a.business_address.substring(0, 32) + '...') : 'Default Address'}
                  </option>
                ))}
              </select>
            </div>

            <!-- Header logo size -->
            <div class="space-y-2 pt-1 border-t border-slate-800/40">
              <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="config-show-logo" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Header Primary Logo</span>
              </label>
              <div class="space-y-1 pl-5">
                <label class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Header Logo Size</label>
                <select id="config-header-logo-size" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2 py-0.5 text-xs focus:ring-0">
                  <option value="96" selected>Default</option>
                  <option value="128">Large</option>
                  <option value="160">X-Large</option>
                </select>
              </div>
            </div>

            <!-- Terms logo size -->
            <div class="space-y-2 pt-1 border-t border-slate-800/40">
              <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="config-show-logo-p2" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Terms of Service Page Header Logo</span>
              </label>
              <div class="space-y-1 pl-5">
                <label class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block mb-0.5">Terms of Service Logo Size</label>
                <select id="config-terms-logo-size" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2 py-0.5 text-xs focus:ring-0">
                  <option value="40">Default (Small)</option>
                  <option value="72">Large</option>
                  <option value="96" selected>X-Large</option>
                  <option value="128">XXL</option>
                  <option value="160">XXXL</option>
                </select>
              </div>
            </div>

            <!-- Watermark customization -->
            <div class="space-y-2 pt-2 border-t border-slate-800/60">
              <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="config-show-watermark" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Background Watermark</span>
              </label>
              <div>
                <label class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block mb-1 pl-5">Watermark Image Source</label>
                <div class="pl-5 mb-1.5">
                  <select id="config-watermark-source" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-0.5 text-xs focus:ring-0">
                    <option value="dgllc">DGLLC Master Logo</option>
                    <option value="dtl">DTL Logo Only</option>
                    <option value="dgs">DGS Logo Only</option>
                  </select>
                </div>
              </div>
              <div class="space-y-1 pl-5">
                <div class="flex justify-between text-[9px] font-bold text-slate-500"><span>Watermark Opacity</span><span id="wm-op-val">6%</span></div>
                <input type="range" id="config-watermark-opacity" min="1" max="40" value="6" class="w-full h-1 bg-slate-700 rounded-lg appearance-none accent-cyan-500" />
              </div>
              <div class="space-y-1 pl-5">
                <div class="flex justify-between text-[9px] font-bold text-slate-500"><span>Watermark Width</span><span id="wm-sz-val">380px</span></div>
                <input type="range" id="config-watermark-size" min="200" max="600" step="20" value="380" class="w-full h-1 bg-slate-700 rounded-lg appearance-none accent-cyan-500" />
              </div>
            </div>
          </div>
        </details>

        <!-- CATEGORY 2: Customer & Metadata Visibility -->
        <details class="group border border-slate-200 rounded-xl bg-white overflow-hidden">
          <summary class="flex items-center justify-between p-3 text-xs font-bold text-slate-800 uppercase tracking-wider cursor-pointer hover:bg-slate-50 select-none transition-all">
            <div class="flex items-center gap-2">
              <div class="p-1.5 bg-blue-50 text-blue-600 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              </div>
              <span>Customer & Metadata</span>
            </div>
            <span class="transition-transform duration-200 group-open:rotate-180 text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="p-3.5 border-t border-slate-850 space-y-4 text-xs text-slate-300 font-semibold">
            <!-- Billing Details Visibility -->
            <div class="space-y-2">
              <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block mb-1">Billing Details Visibility</label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="config-show-cust-company" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
