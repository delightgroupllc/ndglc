              <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block">Signature Area Placement</label>
              <select id="config-sig-placement" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0">
