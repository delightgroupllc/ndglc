              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="config-show-disclaimer" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Disclaimer Text</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="config-show-product-images" checked={inv.show_images} class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Product Images</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="config-show-duplicate-tag" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
