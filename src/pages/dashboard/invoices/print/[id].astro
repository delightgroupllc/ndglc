---
import { query } from '../../../../lib/db';
import StandardPrintLayout from '../../../../components/print/StandardPrintLayout.astro';
import ModernGridPrintLayout from '../../../../components/print/ModernGridPrintLayout.astro';
import '../../../../styles/global.css';


const { id } = Astro.params;

let inv: any = null;
let items: any[] = [];
let settings: Record<string, string> = {};
let selectedClauses: any[] = [];
let dnNote: string = 'DELIVERY NOTE : Customer must check good\'s condition and quantity at the time of delivery of the material';

try {
  // Fetch invoice details
  const invRes = await query(`
    SELECT i.*, 
       (SELECT JSON_AGG(it) FROM (SELECT * FROM invoice_items WHERE invoice_id = i.id) it) as items_list,
       COALESCE((SELECT is_deleted FROM customers WHERE name = i.customer_name LIMIT 1), TRUE) as is_customer_deleted,
       (SELECT code FROM customers WHERE name = i.customer_name LIMIT 1) as customer_code,
       (SELECT code FROM companies WHERE name = i.company_name LIMIT 1) as company_code
    FROM invoices i WHERE id = $1
  `, [id]);
  inv = invRes.rows[0];

  if (inv) {
    items = typeof inv.items_list === 'string' ? JSON.parse(inv.items_list) : (inv.items_list || []);
  }

  // Fetch settings
  const settingsRes = await query('SELECT key, value FROM settings');
  settings = settingsRes.rows.reduce((acc: any, row: any) => {
    acc[row.key] = row.value;
    return acc;
  }, {});

  // Parse list configurations
  var banksList = [];
  try {
    banksList = settings.banks ? JSON.parse(settings.banks) : [];
  } catch (e) {}
  if (banksList.length === 0 && (settings.bank_name || settings.account_number)) {
    banksList = [{
      id: 'bank_legacy',
      bank_name: settings.bank_name || '',
      account_name: settings.account_name || '',
      account_number: settings.account_number || '',
      swift_code: settings.swift_code || '',
      iban_number: settings.iban_number || ''
    }];
  }

  var signaturesList = [];
  try {
    signaturesList = settings.signatures ? JSON.parse(settings.signatures) : [];
  } catch (e) {}
  if (signaturesList.length === 0 && settings.signatory_name) {
    signaturesList = [{
      id: 'sig_legacy',
      signatory_name: settings.signatory_name || '',
      signatory_title: settings.signatory_title || ''
    }];
  }

  var addressesList = [];
  try {
    addressesList = settings.addresses ? JSON.parse(settings.addresses) : [];
  } catch (e) {}
  if (addressesList.length === 0 && (settings.business_address || settings.trn_number)) {
    addressesList = [{
      id: 'addr_legacy',
      business_address: settings.business_address || '',
      trn_number: settings.trn_number || '',
      business_registration: settings.business_registration || '',
      permits_info: settings.permits_info || ''
    }];
  }

  // Delivery Note disclaimer - dynamically loaded from DB

  // Fetch all disclaimers/clauses
  try {
    const legalRes = await query(`SELECT title, content, identifier, type, show_in_invoice, division FROM legal_artifacts ORDER BY CASE identifier WHEN 'general-terms' THEN 1 WHEN 'Acceptance of order' THEN 2 WHEN 'Illustrations, Description, Dimensions, Weight, Volume:' THEN 3 WHEN 'Designs:' THEN 4 WHEN 'Samples:' THEN 5 WHEN 'Delivery:' THEN 6 WHEN 'Cancellation:' THEN 7 WHEN 'Returns:' THEN 8 WHEN 'payment-terms' THEN 9 WHEN 'Installation :' THEN 10 WHEN 'Workmanship Warranty:' THEN 11 WHEN 'warranty' THEN 12 WHEN 'Liability' THEN 13 WHEN 'Others' THEN 14 WHEN 'Force Majeure:' THEN 15 ELSE 99 END ASC`);
    const allClauses = legalRes.rows;
    
    const activeDivision = (inv.source_division || '').toLowerCase();
    selectedClauses = allClauses.filter((c: any) => {
      if (!c.show_in_invoice) return false;
      if (activeDivision === 'dgs') return c.division === 'dgs';
      if (activeDivision === 'dtl') return c.division === 'dtl';
      return true;
    });

    // Extract delivery note disclaimer specifically (any identifier containing 'delivery-note')
    const dnClause = allClauses.find((c: any) => c.identifier === 'delivery-note-disclaimer' || c.identifier === 'delivery-terms' || c.identifier === 'dn-disclaimer');
    if (dnClause) {
      dnNote = dnClause.content;
    }
  } catch (e) {
    console.error("Error fetching legal artifacts:", e);
  }

} catch (err: any) {
  console.error('Error fetching print invoice details:', err.message);
}

if (!inv) {
  return Astro.redirect('/dashboard/invoices');
}

const documentTitle = inv.order_type === 'proforma' ? 'PRO FORMA' : 
                      inv.order_type === 'lpo' ? 'PURCHASE ORDER' : 
                      inv.order_type === 'delivery_note' ? 'DELIVERY NOTE' : 
                      inv.order_type === 'tax_invoice' ? 'COMMERCIAL BILL' :
                      inv.order_type === 'standard' ? 'INVOICE' :
                      inv.order_type === 'quotation' ? 'QUOTATION / ESTIMATE' :
                      inv.order_type === 'inquiry' ? 'INQUIRY' :
                      'INVOICE';

// Number to Words converter (compliant with AED Dirhams and Fils)
function numberToWords(num: number): string {
  const a = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
  const b = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
  
  function convert(n: number): string {
    if (n < 20) return a[n];
    if (n < 100) return b[Math.floor(n / 10)] + (n % 10 ? ' ' + a[n % 10] : '');
    if (n < 1000) return a[Math.floor(n / 100)] + ' hundred' + (n % 100 ? ' and ' + convert(n % 100) : '');
    if (n < 1000000) return convert(Math.floor(n / 1000)) + ' thousand' + (n % 1000 ? ' ' + convert(n % 1000) : '');
    return '';
  }

  const parts = num.toFixed(2).split('.');
  const dirhams = parseInt(parts[0]);
  const fils = parseInt(parts[1]);

  let result = '';
  if (dirhams > 0) {
    result += convert(dirhams) + ' Dirham';
    if (dirhams > 1) result += 's';
  } else {
    result += 'Zero Dirhams';
  }

  if (fils > 0) {
    result += ' and ' + convert(fils) + ' fils';
  }
  result += ' Only';
  
  return result.charAt(0).toUpperCase() + result.slice(1);
}

const amountInWords = numberToWords(inv.total_amount);
const totalQty = items.reduce((sum, item) => sum + Number(item.quantity), 0);
const totalQtyInWords = numberToWords(totalQty).replace(/Dirham.*/i, 'Only');

// Division branding
const isDGS = inv.source_division === 'DGS';
const companyNameEN = isDGS ? 'Delight Greenscapes' : 'Delight Technical Lighting';
const companyNameAR = isDGS ? 'ديلايت جرين سكيبس' : 'ديلايت للاضاءة الفنية';
const websiteURL = 'www.delightgroupllc.com';
const logoColor = isDGS ? '#15803d' : '#0891b2'; // Green for DGS, Cyan for DTL/Group

const activeSignature = signaturesList.find((s: any) => s.id === (settings.default_signature_id || (signaturesList[0]?.id || ''))) || signaturesList[0] || null;
const signatureImage = activeSignature?.signature_image || '';

let activeTerms: string[] = [];
try {
  activeTerms = inv.payment_terms ? JSON.parse(inv.payment_terms) : [];
} catch (e) {
  if (typeof inv.payment_terms === 'string') {
    activeTerms = inv.payment_terms.split(',').map((t: string) => t.trim());
  }
}

const isTermChecked = (identifier: string): boolean => {
  if (!inv.payment_terms) return true;
  return activeTerms.includes(identifier);
};
