              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="sig-company" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Company Stamp / Signature</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer pl-4">
                <input type="checkbox" id="config-show-sig-image" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Signature Image</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer pl-4">
                <input type="checkbox" id="config-show-stamp-box" class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
