  <script>
    const rootContainer = document.getElementById('print-root-container');
    const invDiv = rootContainer?.getAttribute('data-division') || 'DTL';

    // Helper to toggle visibility by ID
    const toggleById = (id: string, visible: boolean) => {
      const el = document.getElementById(id);
      if (el) el.style.display = visible ? '' : 'none';
    };

    // Helper to toggle visibility by Selector
    const toggleBySelector = (selector: string, visible: boolean) => {
      document.querySelectorAll(selector).forEach(el => {
        if (visible) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    };

    // Helper to dynamically update screen page numbers
    const updatePageNumbersOnScreen = () => {
      const page2Checked = (document.getElementById('config-show-page-2') as HTMLInputElement)?.checked;
      const screenPage1 = document.getElementById('screen-page-1-num');
      const screenPage2 = document.getElementById('screen-page-2-num');
      
      if (page2Checked) {
        if (screenPage1) screenPage1.textContent = 'Page 1 of 2';
        if (screenPage2) screenPage2.textContent = 'Page 2 of 2';
      } else {
        if (screenPage1) screenPage1.textContent = 'Page 1 of 1';
      }
    };

    // Document Header Title manager
    document.getElementById('config-doc-type')?.addEventListener('change', (e) => {
      const title = (e.target as HTMLSelectElement).value;
      const headerTitle = document.getElementById('print-doc-header-title');
      if (headerTitle) headerTitle.textContent = title;
    });

    // Logo Manager
    document.getElementById('config-branding-logo')?.addEventListener('change', (e) => {
      const mode = (e.target as HTMLSelectElement).value;
      const logo1 = document.getElementById('print-company-logo') as HTMLImageElement;
      const logo2 = document.getElementById('print-company-logo-p2') as HTMLImageElement;
      const desc = document.getElementById('print-from-division-desc');
      
      let src = '/dgllclogosmall.png';
      if (mode === 'dtl' || (mode === 'auto' && invDiv !== 'DGS')) { src = '/dtllogo.jpg'; if(desc) desc.textContent = 'Delight Technical Lighting'; }
      else if (mode === 'dgs' || (mode === 'auto' && invDiv === 'DGS')) { src = '/dgslogo.jpg'; if(desc) desc.textContent = 'Delight Greenscapes'; }
      else { if(desc) desc.textContent = 'Delight Group LLC'; }
      
      if (logo1) logo1.src = src;
      if (logo2) logo2.src = src;
    });

    // Show/Hide Primary Logo
    document.getElementById('config-show-logo')?.addEventListener('change', (e) => {
      const visible = (e.target as HTMLInputElement).checked;
      const logoContainer = document.getElementById('print-logo-container');
      if (logoContainer) logoContainer.style.display = visible ? 'flex' : 'none';
    });

    // Watermark
    document.getElementById('config-show-watermark')?.addEventListener('change', (e) => {
      document.getElementById('print-watermark')!.style.display = (e.target as HTMLInputElement).checked ? 'flex' : 'none';
    });
    document.getElementById('config-watermark-opacity')?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      document.getElementById('print-watermark')!.style.opacity = (parseFloat(val) / 100).toString();
      document.getElementById('wm-op-val')!.textContent = val + '%';
    });
    document.getElementById('config-watermark-size')?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      const wmImg = document.getElementById('watermark-img');
      if (wmImg) wmImg.style.width = val + 'px';
      document.getElementById('wm-sz-val')!.textContent = val + 'px';
    });

    // Billing Details Visibility
    document.getElementById('config-show-cust-company')?.addEventListener('change', (e) => {
      toggleById('print-cust-company', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-cust-address')?.addEventListener('change', (e) => {
      toggleById('print-cust-address', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-cust-contact')?.addEventListener('change', (e) => {
      toggleById('print-cust-contact', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-cust-trn')?.addEventListener('change', (e) => {
      toggleById('print-cust-trn', (e.target as HTMLInputElement).checked);
    });

    // Document Info Visibility
    document.getElementById('config-show-info-status')?.addEventListener('change', (e) => {
      toggleById('print-info-status', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-info-date')?.addEventListener('change', (e) => {
      toggleById('print-info-date', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-info-due')?.addEventListener('change', (e) => {
      toggleById('print-info-due', (e.target as HTMLInputElement).checked);
    });

    // Table Columns Visibility
    document.getElementById('config-show-col-ref')?.addEventListener('change', (e) => {
      toggleBySelector('.print-item-cat-ref', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-col-spec')?.addEventListener('change', (e) => {
      toggleBySelector('.print-item-tech-spec', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-col-price')?.addEventListener('change', (e) => {
      const show = (e.target as HTMLInputElement).checked;
      toggleBySelector('.print-col-price-header', show);
      toggleBySelector('.print-col-price-cell', show);
    });

    // Pricing breakdowns
    document.getElementById('config-show-subtotal')?.addEventListener('change', (e) => {
      toggleById('print-total-subtotal', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-vat')?.addEventListener('change', (e) => {
      toggleById('print-total-vat', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-discount')?.addEventListener('change', (e) => {
      toggleById('print-total-discount', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-settled')?.addEventListener('change', (e) => {
      toggleById('print-total-settled', (e.target as HTMLInputElement).checked);
    });
    document.getElementById('config-show-due')?.addEventListener('change', (e) => {
      toggleById('print-total-due', (e.target as HTMLInputElement).checked);
    });

    // Page 2 & footer settings
    document.getElementById('config-show-page-2')?.addEventListener('change', (e) => {
      toggleById('print-page-2-container', (e.target as HTMLInputElement).checked);
      updatePageNumbersOnScreen();
    });
    document.getElementById('config-show-page-numbers')?.addEventListener('change', (e) => {
      toggleBySelector('.print-page-footer', (e.target as HTMLInputElement).checked);
    });

    // Product Images Toggle
    document.getElementById('config-show-prod-images')?.addEventListener('change', (e) => {
      const show = (e.target as HTMLInputElement).checked;
      document.querySelectorAll('.product-thumbnail-img').forEach(img => {
        if (show) {
          img.classList.remove('hidden');
        } else {
          img.classList.add('hidden');
        }
      });
    });

    // Signature Area placement
    document.getElementById('config-sig-placement')?.addEventListener('change', (e) => {
      const placement = (e.target as HTMLSelectElement).value;
      const sigBlock = document.getElementById('corporate-auth-standard-block');
      if (sigBlock) {
        if (placement === 'none') {
          sigBlock.style.display = 'none';
        } else {
          sigBlock.style.display = 'grid';
        }
      }
    });

    // Individual signature toggles
    document.getElementById('sig-client')?.addEventListener('change', (e) => {
      const col = document.getElementById('print-sig-client-col');
      if (col) col.style.display = (e.target as HTMLInputElement).checked ? 'block' : 'none';
    });
    document.getElementById('sig-company')?.addEventListener('change', (e) => {
      const col = document.getElementById('print-sig-company-col');
      if (col) col.style.display = (e.target as HTMLInputElement).checked ? 'block' : 'none';
    });
    document.getElementById('sig-it')?.addEventListener('change', (e) => {
      const col = document.getElementById('print-sig-it-col');
      if (col) {
        if ((e.target as HTMLInputElement).checked) {
          col.classList.remove('hidden');
          col.style.display = 'block';
        } else {
          col.classList.add('hidden');
          col.style.display = 'none';
        }
      }
    });

    // Electronic notice compliant stamp
    document.getElementById('config-show-electronic-notice')?.addEventListener('change', (e) => {
      const notice = document.getElementById('print-electronic-badge');
      if (notice) notice.style.display = (e.target as HTMLInputElement).checked ? 'block' : 'none';
    });

    // Finance Block & Customization Real-time Recalculations
    const grandTotal = Number(rootContainer?.getAttribute('data-grand-total')) || 0;

    const updateFinanceSettlement = () => {
      const p1Label = (document.getElementById('config-finance-p1-label') as HTMLInputElement)?.value || 'Advance Payment';
      const p1Pct = parseFloat((document.getElementById('config-finance-p1-pct') as HTMLInputElement)?.value) || 0;
      const p1Date = (document.getElementById('config-finance-p1-date') as HTMLInputElement)?.value || '';
      
      const p2Label = (document.getElementById('config-finance-p2-label') as HTMLInputElement)?.value || 'Final Settlement';
      const p2Pct = parseFloat((document.getElementById('config-finance-p2-pct') as HTMLInputElement)?.value) || 0;
      const p2Date = (document.getElementById('config-finance-p2-date') as HTMLInputElement)?.value || '';
      
      const p1Amount = grandTotal * (p1Pct / 100);
      const p2Amount = grandTotal * (p2Pct / 100);
      
      const p1LabelCell = document.getElementById('print-finance-p1-label-cell');
      const p1DateCell = document.getElementById('print-finance-p1-date-cell');
      const p1AmountCell = document.getElementById('print-finance-p1-amount-cell');
      
      const p2LabelCell = document.getElementById('print-finance-p2-label-cell');
      const p2DateCell = document.getElementById('print-finance-p2-date-cell');
      const p2AmountCell = document.getElementById('print-finance-p2-amount-cell');
      
      if (p1LabelCell) p1LabelCell.textContent = `${p1Label} (${p1Pct}%)`;
      if (p1DateCell) p1DateCell.textContent = p1Date;
      if (p1AmountCell) p1AmountCell.textContent = `AED ${p1Amount.toLocaleString('en-AE', { minimumFractionDigits: 2 })}`;
      
      if (p2LabelCell) p2LabelCell.textContent = `${p2Label} (${p2Pct}%)`;
      if (p2DateCell) p2DateCell.textContent = p2Date;
      if (p2AmountCell) p2AmountCell.textContent = `AED ${p2Amount.toLocaleString('en-AE', { minimumFractionDigits: 2 })}`;
    };

    // Bank Details Real-time Sync
    const updateBankDetails = () => {
      const bankName = (document.getElementById('config-bank-name') as HTMLInputElement)?.value || '';
      const bankAcc = (document.getElementById('config-bank-acc') as HTMLInputElement)?.value || '';
      const bankIban = (document.getElementById('config-bank-iban') as HTMLInputElement)?.value || '';
      const bankSwift = (document.getElementById('config-bank-swift') as HTMLInputElement)?.value || '';
      
      const printBankName = document.getElementById('print-bank-name');
      const printBankAcc = document.getElementById('print-bank-acc');
      const printBankIban = document.getElementById('print-bank-iban');
      const printBankSwift = document.getElementById('print-bank-swift');
      
      if (printBankName) printBankName.textContent = bankName;
      if (printBankAcc) printBankAcc.textContent = bankAcc;
      if (printBankIban) printBankIban.textContent = bankIban;
      if (printBankSwift) printBankSwift.textContent = bankSwift;
    };

    // Listeners for Finance customizer inputs
    ['config-finance-p1-label', 'config-finance-p1-pct', 'config-finance-p1-date',
     'config-finance-p2-label', 'config-finance-p2-pct', 'config-finance-p2-date'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateFinanceSettlement);
    });

    // Listeners for Bank details customizer inputs
    ['config-bank-name', 'config-bank-acc', 'config-bank-iban', 'config-bank-swift'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateBankDetails);
    });

    // Toggle Finance block & its configuration settings
    document.getElementById('config-show-finance')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      const block = document.getElementById('finance-settlement-block');
      const inputs = document.getElementById('finance-customization-inputs');
      
      if (checked) {
        block?.classList.remove('hidden');
        inputs?.classList.remove('hidden');
      } else {
        block?.classList.add('hidden');
        inputs?.classList.add('hidden');
      }
    });

    // Toggle Bank details card & its configuration settings
    document.getElementById('config-show-bank')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      const block = document.getElementById('bank-details-block');
      const inputs = document.getElementById('bank-customization-inputs');
      
      if (checked) {
        block?.classList.remove('hidden');
        inputs?.classList.remove('hidden');
      } else {
        block?.classList.add('hidden');
        inputs?.classList.add('hidden');
      }
    });

    // Clauses Checkbox Toggles
    document.querySelectorAll('.config-clause-toggle-cb').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const ident = (e.target as HTMLInputElement).getAttribute('data-clause-ident');
        const block = document.querySelector(`.clause-block[data-identifier="${ident}"]`);
        if (block) {
          if ((e.target as HTMLInputElement).checked) block.classList.remove('hidden');
          else block.classList.add('hidden');
        }
      });
    });

    // Custom Clause Shortcuts
    const shortcutMapping: Record<string, {title: string, content: string}> = {
      'shortcut-bank': { title: 'Bank Remittance Details', content: 'Delight Group bank deposits go to Account: 120938491829. IBAN: AE210009281.' },
      'shortcut-remit': { title: 'Swift confirmation note', content: 'Kindly submit bank deposit / swift transfer slips to invoice@delightgroup.com.' },
      'shortcut-trn': { title: 'Taxes Reference registration', content: 'Corporate verified TRN identifier: 10003862800003.' },
      'shortcut-tax': { title: 'Tax standard compliance', content: 'Prices specified include a standard 5% VAT rate unless specified otherwise.' },
      'shortcut-disc': { title: 'Settlement Terms conditions', content: 'Discount provisions are applicable strictly under prompt due-date clearing.' },
      'shortcut-note': { title: 'General delivery remarks', content: 'Report inventory / shipping discrepancies within 24 hours of delivery receipt.' }
    };

    Object.keys(shortcutMapping).forEach(id => {
      document.getElementById(id)?.addEventListener('click', () => {
        const details = shortcutMapping[id];
        (document.getElementById('custom-clause-title') as HTMLInputElement).value = details.title;
        (document.getElementById('custom-clause-content') as HTMLTextAreaElement).value = details.content;
      });
    });

    // Append Custom Clause Handler
    document.getElementById('append-clause-btn')?.addEventListener('click', () => {
      const titleInput = document.getElementById('custom-clause-title') as HTMLInputElement;
      const contentText = document.getElementById('custom-clause-content') as HTMLTextAreaElement;
      const title = titleInput.value.trim();
      const content = contentText.value.trim();
      if (!title || !content) return;
      
      const parent = document.getElementById('print-legal-clauses-area')!;
      const div = document.createElement('div');
      div.className = 'clause-block mt-3';
      div.innerHTML = `
        <h5 class="font-bold text-slate-800">${title}</h5>
        <p class="text-slate-500 mt-0.5 leading-relaxed text-[9px]">${content}</p>
      `;
      parent.appendChild(div);
      
      titleInput.value = '';
      contentText.value = '';
    });

    // Sidebar Mobile/Tablet Toggle
    const sidebar = document.getElementById('print-sidebar-config');
    const backdrop = document.getElementById('print-sidebar-backdrop');
    const toggleBtn = document.getElementById('print-sidebar-toggle');

    const openSidebar = () => {
      if (sidebar && backdrop) {
        sidebar.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
        setTimeout(() => backdrop.classList.add('opacity-100'), 10);
      }
    };

    const closeSidebar = () => {
      if (sidebar && backdrop) {
        sidebar.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100');
        setTimeout(() => backdrop.classList.add('hidden'), 300);
      }
    };

    toggleBtn?.addEventListener('click', () => {
      if (sidebar?.classList.contains('translate-x-full')) {
        openSidebar();
      } else {
        closeSidebar();
      }
    });

    backdrop?.addEventListener('click', closeSidebar);

    // Initial Trigger for page numbers and Auto mode logo
    const syncCheckboxes = () => {
      const selectors = [
        '#config-show-logo', '#config-show-watermark', '#config-show-cust-company',
        '#config-show-cust-address', '#config-show-cust-contact', '#config-show-cust-trn',
        '#config-show-info-status', '#config-show-info-date', '#config-show-info-due',
        '#config-show-col-ref', '#config-show-col-spec', '#config-show-col-price',
        '#config-show-subtotal', '#config-show-vat', '#config-show-discount',
        '#config-show-settled', '#config-show-due', '#config-show-page-2',
        '#config-show-page-numbers', '#config-show-prod-images', '#sig-client',
        '#sig-company', '#sig-it', '#config-show-electronic-notice',
        '#config-show-finance', '#config-show-bank'
      ];
      selectors.forEach(sel => {
        const el = document.querySelector(sel);
        if (el) el.dispatchEvent(new Event('change'));
      });
      
      // Also dispatch change on select menus
      document.getElementById('config-doc-type')?.dispatchEvent(new Event('change'));
      document.getElementById('config-branding-logo')?.dispatchEvent(new Event('change'));
      document.getElementById('config-sig-placement')?.dispatchEvent(new Event('change'));
      
      // Clause checkboxes
      document.querySelectorAll('.config-clause-toggle-cb').forEach(cb => {
        cb.dispatchEvent(new Event('change'));
      });
    };

    syncCheckboxes();
    updateFinanceSettlement();
    updateBankDetails();
  </script>
</DashboardLayout>
