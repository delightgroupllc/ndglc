                  <option value={b.id} selected={b.id === (settings.default_bank_id || banksList[0]?.id)}>{b.bank_name} - {b.account_number}</option>
                ))}
              </select>
            </div>

            <div id="bank-customization-inputs" class="space-y-2.5 pt-2 border-t border-slate-800 text-xs text-slate-350">
              <div>
                <label class="text-[8px] text-slate-500 uppercase block mb-0.5">Bank Name</label>
                <input type="text" id="config-bank-name" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0" value={settings.bank_name || ''} />
              </div>
              <div>
                <label class="text-[8px] text-slate-500 uppercase block mb-0.5">Account Name</label>
                <input type="text" id="config-bank-acc-name" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0" value={settings.account_name || ''} />
              </div>
              <div>
                <label class="text-[8px] text-slate-500 uppercase block mb-0.5">Account Number</label>
                <input type="text" id="config-bank-acc" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0" value={settings.account_number || ''} />
              </div>
              <div>
                <label class="text-[8px] text-slate-500 uppercase block mb-0.5">IBAN Number</label>
                <input type="text" id="config-bank-iban" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0" value={settings.iban_number || ''} />
              </div>
              <div>
                <label class="text-[8px] text-slate-500 uppercase block mb-0.5">SWIFT / BIC Code</label>
                <input type="text" id="config-bank-swift" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0" value={settings.swift_code || ''} />
              </div>
            </div>
          </div>
        </details>

        <!-- CATEGORY 5: Signatures Options -->
        <details class="group border border-slate-200 rounded-xl bg-white overflow-hidden" open>
          <summary class="flex items-center justify-between p-3 text-xs font-bold text-slate-800 uppercase tracking-wider cursor-pointer hover:bg-slate-50 select-none transition-all">
            <div class="flex items-center gap-2">
              <div class="p-1.5 bg-blue-50 text-blue-600 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
              </div>
              <span>Signatures Options</span>
            </div>
            <span class="transition-transform duration-200 group-open:rotate-180 text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="p-3.5 border-t border-slate-850 space-y-3.5 text-xs text-slate-300">
