                <option value="custom" selected={inv.signatory_incharge && inv.signatory_incharge !== 'any' && !signaturesList.some((s: any) => s.id === inv.signatory_incharge)}>Enter Manually...</option>
              </select>
              <div id="sidebar-signature-preview-wrapper" class="hidden mt-2 p-1.5 bg-slate-100 border border-slate-200 rounded text-center">
                <div class="text-[8px] text-slate-500 uppercase font-bold mb-1">Signature Image</div>
                <img id="sidebar-signature-preview" class="h-8 w-auto object-contain mx-auto" src="" />
              </div>
              <div id="custom-signature-input-wrapper" class="hidden mt-2">
                <label class="text-[8px] text-slate-500 uppercase block mb-0.5">Custom Signatory Name</label>
                <input type="text" id="config-custom-signature-name" class="w-full rounded border border-slate-700 bg-slate-800 text-white px-2.5 py-1 text-xs focus:ring-0" placeholder="Type name..." />
              </div>
            </div>

            <div class="mt-2.5 pt-2 border-t border-slate-800/40">
