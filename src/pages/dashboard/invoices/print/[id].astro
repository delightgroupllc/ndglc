              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="config-electronic-sig" class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Electronic / No Signature Needed</span>
              </label>
            </div>
          </div>
        </details>

        <!-- CATEGORY 6: Terms of Sale (TOS) Options -->
        <details class="group border border-slate-200 rounded-xl bg-white overflow-hidden">
          <summary class="flex items-center justify-between p-3 text-xs font-bold text-slate-800 uppercase tracking-wider cursor-pointer hover:bg-slate-50 select-none transition-all">
            <div class="flex items-center gap-2">
              <div class="p-1.5 bg-blue-50 text-blue-600 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              </div>
              <span>Terms of Sale (TOS)</span>
            </div>
            <span class="transition-transform duration-200 group-open:rotate-180 text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="p-3.5 border-t border-slate-850 space-y-3.5 text-xs text-slate-300">
            <!-- Page Toggles -->
            <div class="space-y-2 font-semibold">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="config-show-page-2" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Terms & Conditions Page</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="config-show-company-card-tos" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show Company Details Card at bottom of TOS</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-cyan-400 font-bold">
                <input type="checkbox" id="config-only-selected-tos" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" />
                <span>Show only selected T&amp;C from invoice</span>
              </label>
              <div id="config-only-selected-tos-note" class="text-[10px] text-amber-400 font-semibold pl-6 mt-1">
                ✦ Showing only your invoice selections. Untick above to make custom inclusions.
              </div>
              <div id="config-custom-inclusion-note" class="text-[10px] text-emerald-400 font-semibold pl-6 mt-1 hidden">
                ✦ Custom mode — tick or untick any section below.
              </div>
            </div>

            <!-- Visible TOS Sections Checkboxes -->
            <div class="pt-2.5 border-t border-slate-800 space-y-2 font-semibold">
              <label class="text-[9px] font-bold text-slate-500 uppercase tracking-wider block mb-1">Visible TOS Sections</label>
              <div class="grid grid-cols-1 gap-1.5 pl-1 text-[10px] text-slate-350" id="tos-sections-checkboxes-list">
                {selectedClauses
                  .map((clause: any, idx: number) => (
                    <label class="flex items-center gap-2 cursor-pointer hover:text-white transition-colors" data-identifier={clause.identifier}>
                      <input 
                        type="checkbox" 
                        id={`config-show-tos-${clause.identifier.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} 
                        checked={isTermChecked(clause.identifier)} 
                        class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0" 
                      />
                      <span>{idx + 1}. {clause.title}</span>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>
        </details>
      </div>

      <!-- Action Footer -->
      <div class="pt-6 border-t border-slate-200 mt-6 shrink-0 space-y-2">
        <button type="button" onclick="window.print()" class="w-full bg-blue-700 hover:bg-blue-600 text-white font-black py-2.5 rounded-none text-xs transition-all uppercase tracking-wider shadow-md">
          Print Document
        </button>
        <button type="button" id="config-save-btn" class="w-full bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 font-bold py-2 rounded-none text-xs transition-all uppercase tracking-wider flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5 text-slate-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
          </svg>
          Save Configuration
        </button>
        <div class="text-[9px] text-slate-500 text-center mt-1 leading-normal font-medium max-w-xs mx-auto">
          Note: This saves your print preferences temporarily in your browser cache on this computer.
        </div>
      </div>
    </div>

  </div>

  <script define:vars={{ banksList, signaturesList, addressesList, activeTerms }}>
    // Only show selected Terms of Sale filter
    const onlySelectedTOSCheckbox = document.getElementById('config-only-selected-tos');
    const listContainer = document.getElementById('tos-sections-checkboxes-list');
    
    if (listContainer) {
      listContainer.querySelectorAll('label[data-identifier]').forEach(label => {
        const checkbox = label.querySelector('input[type="checkbox"]');
        if (checkbox) {
          checkbox.setAttribute('data-original-checked', checkbox.checked.toString());
        }
      });
    }
    
    const applySelectedTOSFilter = () => {
      const showOnlySelected = onlySelectedTOSCheckbox ? onlySelectedTOSCheckbox.checked : false;
      
      // Toggle note visibility
      const lockedNote = document.getElementById('config-only-selected-tos-note');
      const customNote = document.getElementById('config-custom-inclusion-note');
      if (lockedNote) lockedNote.classList.toggle('hidden', !showOnlySelected);
      if (customNote) customNote.classList.toggle('hidden', showOnlySelected);

      if (!listContainer) return;
      
      const labels = listContainer.querySelectorAll('label[data-identifier]');
      labels.forEach(label => {
        const ident = label.getAttribute('data-identifier');
        const checkbox = label.querySelector('input[type="checkbox"]');
        const isSelectedOnInvoice = activeTerms && activeTerms.includes(ident);
        
        if (showOnlySelected) {
          // Lock mode: show only invoice-selected items, disable the rest
          label.style.display = isSelectedOnInvoice ? 'flex' : 'none';
          if (checkbox) {
            checkbox.disabled = false;
            if (isSelectedOnInvoice && !checkbox.checked) {
              checkbox.checked = true;
              checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            } else if (!isSelectedOnInvoice && checkbox.checked) {
              checkbox.checked = false;
              checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
        } else {
          // Custom mode: show all items freely
          label.style.display = 'flex';
          label.style.opacity = '1';
          if (checkbox) {
            checkbox.disabled = false;
            // Restore original server-rendered state
            const originalChecked = checkbox.getAttribute('data-original-checked') === 'true';
            if (checkbox.checked !== originalChecked) {
              checkbox.checked = originalChecked;
              checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
        }
      });
    };
    
    onlySelectedTOSCheckbox?.addEventListener('change', applySelectedTOSFilter);

    // When in locked mode and user tries to check a non-invoice item — show banner
    listContainer?.addEventListener('click', (e) => {
      if (!onlySelectedTOSCheckbox?.checked) return; // custom mode — allow freely
      const checkbox = e.target;
      if (checkbox && checkbox.tagName === 'INPUT' && checkbox.type === 'checkbox') {
        const label = checkbox.closest('label[data-identifier]');
        if (!label) return;
        const ident = label.getAttribute('data-identifier');
        const isSelectedOnInvoice = activeTerms && activeTerms.includes(ident);
        if (!isSelectedOnInvoice) {
          // The label is hidden in locked mode so this shouldn't fire, but as safety net:
          e.preventDefault();
        }
      }
    }, true); // capture phase so we intercept before change

    // *** Auto-apply on page load (toggle is checked by default) ***
    applySelectedTOSFilter();

    // Dynamic change listener for terms checkboxes inside the sidebar list
    const tosCheckboxesList = document.getElementById('tos-sections-checkboxes-list');
    tosCheckboxesList?.addEventListener('change', (e) => {
      const checkbox = e.target;
      if (checkbox && checkbox.tagName === 'INPUT' && checkbox.type === 'checkbox') {
        const label = checkbox.closest('label[data-identifier]');
        if (label) {
          const ident = label.getAttribute('data-identifier');
          const checked = checkbox.checked;
          
          // Generate target class from identifier
          const sanitizedIdent = ident.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase();
          const targetClass = `terms-sec-${sanitizedIdent}`;
          
          document.querySelectorAll(`.${targetClass}`).forEach(el => {
            if (checked) {
              el.classList.remove('hidden');
            } else {
              el.classList.add('hidden');
            }
          });
        }
      }
    });

    // Toggle templates based on layout selector
    const layoutSelector = document.getElementById('layoutSelector');
    const stdLayoutWrapper = document.getElementById('layout-standard-wrapper');
    const delightgroupllcLayoutWrapper = document.getElementById('layout-delightgroupllc-wrapper');

    const updateLayout = (layout) => {
      if (layout === 'delightgroupllc') {
        stdLayoutWrapper.style.display = 'none';
        delightgroupllcLayoutWrapper.style.display = 'block';
      } else {
        stdLayoutWrapper.style.display = 'block';
        delightgroupllcLayoutWrapper.style.display = 'none';
      }
    };

    // Listen to selection changes
    layoutSelector?.addEventListener('change', (e) => {
      const selected = e.target.value;
      updateLayout(selected);
      // Persist selection in URL
      const url = new URL(window.location.href);
      url.searchParams.set('layout', selected);
      window.history.replaceState({}, '', url.toString());
    });

    // Read initial layout from URL params
    const urlParams = new URLSearchParams(window.location.search);
    const initialLayout = urlParams.get('layout') || 'standard';
    if (layoutSelector) {
      layoutSelector.value = initialLayout;
      updateLayout(initialLayout);
    }

    // Dynamic document title override
    document.getElementById('config-doc-type')?.addEventListener('change', async (e) => {
      const val = e.target.value;
      
      const root = document.getElementById('print-root-container');
      const orderType = root?.getAttribute('data-order-type');
      const invoiceId = root?.getAttribute('data-id');
      const currentInvoiceNumber = root?.getAttribute('data-invoice-number');

      let targetOrderType = null;
      let targetPrefix = null;
      let promptMsg = null;

      if (val === 'ESTIMATION / QUOTE') {
         targetOrderType = 'quotation';
         targetPrefix = 'EST-';
         promptMsg = 'Would you like to convert this order to an Estimation/Quotation (EST)?';
      } else if (val === 'PRO FORMA INVOICE') {
         targetOrderType = 'lpo';
         targetPrefix = 'PRO-';
         promptMsg = 'Would you like to convert this order to a Pro Forma Invoice (PRO)?';
      } else if (val === 'TAX INVOICE') {
         targetOrderType = 'standard';
         targetPrefix = 'INV-';
         promptMsg = 'Would you like to convert this order to a Tax Invoice (INV)?';
      }

      const needsConversion = targetOrderType && (orderType !== targetOrderType || (currentInvoiceNumber && !currentInvoiceNumber.startsWith(targetPrefix)));

      if (needsConversion) {
        if (e.isTrusted) {
          if (confirm(promptMsg)) {
            try {
              const res = await fetch(`/api/invoices/${invoiceId}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_type: targetOrderType })
              });
              const result = await res.json();
              if (res.ok) {
                alert('Order successfully converted!');
                window.location.reload();
                return;
              } else {
                alert(`Error: ${result.error || 'Failed to convert order'}`);
              }
            } catch (err) {
              alert(`Error: ${err.message}`);
            }
          }
        }
      }

      document.querySelectorAll('.delightgroupllc-doc-title, .std-doc-title').forEach(el => {
        el.textContent = val;
      });

      const layoutWrapper = document.getElementById('layout-delightgroupllc');
      if (layoutWrapper) {
        if (val === 'DELIVERY NOTE') {
          layoutWrapper.classList.remove('mode-invoice');
          layoutWrapper.classList.add('mode-delivery-note');
        } else {
          layoutWrapper.classList.remove('mode-delivery-note');
          layoutWrapper.classList.add('mode-invoice');
        }
      }

      if (val === 'DELIVERY NOTE') {
        const toUntick = [
          'config-show-col-spec',
          'config-show-col-price',
          'config-show-col-units',
          'config-show-col-vat',
          'config-show-subtotal',
          'config-show-vat',
          'config-show-discount',
          'config-show-total',
          'config-show-page-2',
          'config-show-words',
          'config-show-disclaimer'
        ];
        toUntick.forEach(id => {
          const cb = document.getElementById(id);
          if (cb && cb.checked) {
            cb.checked = false;
            cb.dispatchEvent(new Event('change'));
          }
        });

        const dueCb = document.getElementById('config-show-info-due');
        if (dueCb && !dueCb.checked) {
          dueCb.checked = true;
          dueCb.dispatchEvent(new Event('change'));
        }

        const remittanceSelect = document.getElementById('config-remittance-placement');
        if (remittanceSelect && remittanceSelect.value !== 'none') {
          remittanceSelect.value = 'none';
          remittanceSelect.dispatchEvent(new Event('change'));
        }
      } else {
        const dueCb = document.getElementById('config-show-info-due');
        if (dueCb && dueCb.checked) {
          dueCb.checked = false;
          dueCb.dispatchEvent(new Event('change'));
        }

        if (val === 'TAX INVOICE') {
          const dnNoteCb = document.getElementById('config-show-dn-condition-note');
          if (dnNoteCb && dnNoteCb.checked) {
            dnNoteCb.checked = false;
            dnNoteCb.dispatchEvent(new Event('change'));
          }
          const layoutVal = document.getElementById('layoutSelector')?.value || 'standard';
          if (layoutVal === 'standard') {
            const qtyWordsCb = document.getElementById('config-show-qty-words');
            if (qtyWordsCb && qtyWordsCb.checked) {
              qtyWordsCb.checked = false;
              qtyWordsCb.dispatchEvent(new Event('change'));
            }
          }
        }
      }

      setTimeout(repaginate, 50);
    });

    // Setup helper for simple class toggle lists
    const setupToggle = (checkboxId, targetClass) => {
      document.getElementById(checkboxId)?.addEventListener('change', (e) => {
        const checked = e.target.checked;
        document.querySelectorAll(`.${targetClass}`).forEach(el => {
          if (checked) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      });
    };

    // Register simple class visibility toggles
    setupToggle('config-show-logo', 'print-logo-container');
    setupToggle('config-show-product-images', 'product-image-column');
    setupToggle('config-show-sig-image', 'signature-image-render');
    setupToggle('config-show-logo-p2', 'print-logo-container-p2');
    setupToggle('config-show-watermark', 'print-watermark');
    setupToggle('config-show-dn-notice', 'print-dn-material-condition-disclaimer');
    setupToggle('config-show-duplicate-tag', 'print-info-duplicate');
    setupToggle('config-show-cust-id', 'print-cust-id');
    setupToggle('config-show-comp-id', 'print-comp-id');
    setupToggle('config-show-cust-company', 'print-cust-company');
    setupToggle('config-show-cust-address', 'print-cust-address');
    setupToggle('config-show-cust-contact', 'print-cust-contact');
    setupToggle('config-show-cust-trn', 'print-cust-trn');
    setupToggle('config-show-info-status', 'print-info-status');
    setupToggle('config-show-info-date', 'print-info-date');
    setupToggle('config-show-info-due', 'print-info-due');
    setupToggle('config-show-col-ref', 'print-item-cat-ref');
    document.getElementById('config-show-col-ref')?.addEventListener('change', () => {
      repaginate();
    });
    setupToggle('config-show-col-price', 'print-col-price');
    document.getElementById('config-show-col-price')?.addEventListener('change', () => {
      repaginate();
    });
    setupToggle('config-show-col-units', 'print-col-units');
    document.getElementById('config-show-col-units')?.addEventListener('change', () => {
      repaginate();
    });
    setupToggle('config-show-col-vat', 'print-col-vat');
    document.getElementById('config-show-col-vat')?.addEventListener('change', () => {
      repaginate();
    });
    setupToggle('config-show-subtotal', 'print-total-subtotal');
    setupToggle('config-show-vat', 'print-total-vat');
    setupToggle('config-show-discount', 'print-total-discount');
    setupToggle('config-show-total', 'print-total-due-row');
    setupToggle('config-show-total-qty', 'print-total-quantity');
    document.getElementById('config-show-total-qty')?.addEventListener('change', () => {
      repaginate();
    });
    setupToggle('config-show-qty-words', 'print-qty-words-panel');
    document.getElementById('config-show-qty-words')?.addEventListener('change', () => {
      repaginate();
    });
    setupToggle('config-show-dn-condition-note', 'print-dn-material-condition-disclaimer');
    document.getElementById('config-show-dn-condition-note')?.addEventListener('change', () => {
      repaginate();
    });
    setupToggle('config-show-words', 'print-words-panel');
    setupToggle('config-show-page-2', 'print-page-2-container');
    setupToggle('config-show-company-card-tos', 'company-card-tos-wrapper');
    setupToggle('config-show-disclaimer', 'print-disclaimer-text');

    // Dynamic Client-side Repagination to utilize page space and avoid footer overflows
    const repaginate = () => {
      const layout = document.getElementById('layoutSelector')?.value || 'standard';
      const wrapperId = layout === 'delightgroupllc' ? 'layout-delightgroupllc-wrapper' : 'layout-standard-wrapper';
      const wrapper = document.getElementById(wrapperId);
      if (!wrapper) return;

      // 1. Move totals & signatures block out of pages to redistribute at the end
      const mathBlock = wrapper.querySelector('.print-footer-math');
      const sigsBlock = wrapper.querySelector('.print-footer-sigs');
      if (mathBlock) mathBlock.remove();
      if (sigsBlock) sigsBlock.remove();

      // 2. Gather all rows from all pages (including dynamic overflow pages) BEFORE removing the pages
      const allRows = [];
      wrapper.querySelectorAll('.print-page').forEach(page => {
        if (page.classList.contains('print-page-2-container')) return;
        page.querySelectorAll('tbody tr.item-row-render').forEach(r => {
          allRows.push(r);
          r.remove(); // detach from DOM to redistribute
        });
      });

      // Remove any dynamically-created overflow pages from previous runs before re-measuring
      wrapper.querySelectorAll('.print-page.dynamic-overflow-page').forEach(p => p.remove());

      const pages = Array.from(wrapper.querySelectorAll('.print-page')).filter(p => !p.classList.contains('print-page-2-container'));
      if (pages.length === 0) return;

      // Make sure all pages are visible initially to do measurements
      pages.forEach(p => { p.style.display = 'block'; });

      if (allRows.length === 0) {
        if (mathBlock) pages[pages.length - 1].appendChild(mathBlock);
        if (sigsBlock) pages[pages.length - 1].appendChild(sigsBlock);
        return;
      }

      // Hide continuation notices during layout reflow
      wrapper.querySelectorAll('.italic').forEach(el => {
        if (el.textContent.includes('continued')) el.style.display = 'none';
      });

      let currentPageIndex = 0;
      let currentRowIndex = 0;

      const specsChecked = document.getElementById('config-show-col-spec')?.checked;
      const docType = document.getElementById('config-doc-type')?.value;
      const isDeliveryNote = docType === 'DELIVERY NOTE';
      
      let maxItemsPage1 = 5;
      let maxItemsSubsequent = 14;

      if (layout === 'delightgroupllc') {
        if (isDeliveryNote) {
          maxItemsPage1 = 8;
          maxItemsSubsequent = 8;
        } else if (specsChecked) {
          maxItemsPage1 = 6;
          maxItemsSubsequent = 5;
        } else {
          maxItemsPage1 = 10;
          maxItemsSubsequent = 10;
        }
      } else {
        if (specsChecked) {
          maxItemsPage1 = 5;
          maxItemsSubsequent = 14;
        } else {
          maxItemsPage1 = 8;
          maxItemsSubsequent = 14;
        }
      }

      // Footer reserve as a fraction of page height — this is SCALE-INDEPENDENT.
      const PAGE_HEIGHT_PX = 1123; // 297mm at 96dpi
      const FOOTER_RESERVE_FRACTION = 75 / PAGE_HEIGHT_PX; // ~6.6%
      const TOTALS_RESERVE_FRACTION = 40 / PAGE_HEIGHT_PX; // ~3.5%

      const getItemsTbody = (page) => {
        return page.querySelector('.std-items-table tbody') ||
               page.querySelector('.delightgroupllc-table tbody') ||
               page.querySelector('.dg-items-table tbody');
      };

      const rowOverflows = (page, row) => {
        const pageRect = page.getBoundingClientRect();
        if (pageRect.height === 0) return false;
        const rowBottom = row.getBoundingClientRect().bottom;
        const fraction = (rowBottom - pageRect.top) / pageRect.height;
        return fraction > (1 - FOOTER_RESERVE_FRACTION);
      };

      const blockOverflows = (page, block) => {
        const pageRect = page.getBoundingClientRect();
        if (pageRect.height === 0) return false;
        const blockBottom = block.getBoundingClientRect().bottom;
        const fraction = (blockBottom - pageRect.top) / pageRect.height;
        return fraction > (1 - TOTALS_RESERVE_FRACTION);
      };

      const createOverflowPage = () => {
        const templatePage = pages[pages.length - 1];
        const newPage = templatePage.cloneNode(true);
        newPage.classList.add('dynamic-overflow-page'); 

        const clonedTbody = getItemsTbody(newPage);
        if (clonedTbody) clonedTbody.innerHTML = '';

        newPage.querySelector('.print-footer-math')?.remove();
        newPage.querySelector('.print-footer-sigs')?.remove();

        newPage.querySelectorAll('.italic').forEach(el => {
          if (el.textContent.includes('continued')) el.style.display = 'none';
        });

        const container = wrapper.firstElementChild || wrapper;
        const tosPage = container.querySelector('.print-page-2-container');
        tosPage ? container.insertBefore(newPage, tosPage) : container.appendChild(newPage);

        pages.push(newPage);
        return newPage;
      };

      while (currentRowIndex < allRows.length) {
        let page = pages[currentPageIndex];
        if (!page) page = createOverflowPage();

        const tbody = getItemsTbody(page);
        if (!tbody) {
          currentRowIndex++;
          continue;
        }

        const row = allRows[currentRowIndex];
        row.firstElementChild.textContent = (currentRowIndex + 1).toString();
        tbody.appendChild(row);

        const currentMax = (currentPageIndex === 0) ? maxItemsPage1 : maxItemsSubsequent;

        if (rowOverflows(page, row) || tbody.children.length > currentMax) {
          row.remove();
          if (currentPageIndex >= pages.length - 1) createOverflowPage();
          currentPageIndex++;
        } else {
          currentRowIndex++;
        }
      }

      // Place blocks on the last active page
      if (mathBlock) {
        let lastPage = pages[currentPageIndex];
        lastPage.appendChild(mathBlock);
        
        const totalItemsCount = allRows.length;
        const isForcedFit = (totalItemsCount <= 10 && currentPageIndex <= 1);

        if (!isForcedFit && blockOverflows(lastPage, mathBlock)) {
          mathBlock.remove();
          
          const tbody = getItemsTbody(lastPage);
          let orphanedRow = null;
          if (tbody && tbody.children.length > 1) {
            orphanedRow = tbody.lastElementChild;
            orphanedRow.remove();
          }

          if (currentPageIndex >= pages.length - 1) createOverflowPage();
          currentPageIndex++;

          if (orphanedRow) {
            const newTbody = getItemsTbody(pages[currentPageIndex]);
            if (newTbody) newTbody.appendChild(orphanedRow);
          }

          pages[currentPageIndex].appendChild(mathBlock);
        }
      }

      // Place signatures block
      if (sigsBlock) {
        let lastPage = pages[currentPageIndex];
        lastPage.appendChild(sigsBlock);
        if (blockOverflows(lastPage, sigsBlock)) {
          sigsBlock.remove();
          if (currentPageIndex >= pages.length - 1) createOverflowPage();
          currentPageIndex++;
          pages[currentPageIndex].appendChild(sigsBlock);
        }
      }
      
      // Hide completely empty pages, track visible count
      let actualItemsPagesCount = 0;
      pages.forEach((page, idx) => {
        const tbody = getItemsTbody(page);
        const hasRows = tbody && tbody.children.length > 0;
        const hasTotals = mathBlock && page.contains(mathBlock);
        const hasSigs = sigsBlock && page.contains(sigsBlock);

        // Hide empty items tables to avoid orphaned headers
        const itemsTable = page.querySelector('.std-items-table, .delightgroupllc-table, .dg-items-table');
        if (itemsTable) {
          if (hasRows) {
            itemsTable.style.display = 'table';
          } else {
            itemsTable.style.display = 'none';
          }
        }

        if (hasRows || hasTotals || hasSigs || idx === 0) {
          page.style.display = 'block';
          actualItemsPagesCount = idx + 1;
        } else {
          page.style.display = 'none';
        }
      });

      // Show/hide continuation notices
      pages.forEach((page, idx) => {
        if (page.style.display === 'none') return;
        const isLastVisible = idx >= actualItemsPagesCount - 1;
        page.querySelectorAll('.italic').forEach(el => {
          if (el.textContent.includes('continued')) {
            el.style.display = isLastVisible ? 'none' : 'block';
          }
        });
      });

      // Update page number footers
      let visNum = 0;
      pages.forEach((page) => {
        if (page.style.display === 'none') return;
        visNum++;
        const showPage2Checkbox = document.getElementById('config-show-page-2');
        const isPage2Visible = showPage2Checkbox ? showPage2Checkbox.checked : true;
        const totalPages = isPage2Visible ? (actualItemsPagesCount + 1) : actualItemsPagesCount;
        
        const footerNum = page.querySelector('.print-page-footer-num');
        if (footerNum) {
          footerNum.innerHTML = `Page ${visNum} of <span class="dynamic-total-pages">${totalPages}</span>`;
        }
        
        // Update the top continuation header page number
        page.querySelectorAll('.dynamic-page-num').forEach(el => {
          el.textContent = visNum.toString();
        });
      });

      updateTotalPagesCount();
    };

    // Re-paginating on show technical specs change
    document.getElementById('config-show-col-spec')?.addEventListener('change', (e) => {
      const checked = e.target.checked;
      document.querySelectorAll('.print-item-tech-spec').forEach(el => {
        if (checked) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      repaginate();
    });

    // Run repagination on template load
    setTimeout(() => {
      const unitsCheckbox = document.getElementById('config-show-col-units');
      if (unitsCheckbox) {
        unitsCheckbox.dispatchEvent(new Event('change'));
      } else {
        repaginate();
      }
    }, 200);

    // Repaginate whenever layout changes
    layoutSelector?.addEventListener('change', () => {
      setTimeout(repaginate, 250);
    });

    // Watermark customizer range inputs
    document.getElementById('config-watermark-opacity')?.addEventListener('input', (e) => {
      const val = e.target.value;
      const label = document.getElementById('wm-op-val');
      if (label) label.textContent = val + '%';
      document.querySelectorAll('.print-watermark img').forEach(el => {
        el.style.opacity = (Number(val) / 100).toString();
      });
    });

    document.getElementById('config-watermark-size')?.addEventListener('input', (e) => {
      const val = e.target.value;
      const label = document.getElementById('wm-sz-val');
      if (label) label.textContent = val + 'px';
      document.querySelectorAll('.print-watermark img').forEach(el => {
        el.style.width = val + 'px';
      });
    });

    // Watermark image source selector
    document.getElementById('config-watermark-source')?.addEventListener('change', (e) => {
      const selected = e.target.value;
      let wmUrl = '/dgllclogolarge.png';
      if (selected === 'dtl') wmUrl = '/dtllogo.jpg';
      else if (selected === 'dgs') wmUrl = '/dgslogo.jpg';
      document.querySelectorAll('.print-watermark img').forEach(img => {
        img.src = wmUrl;
      });
    });

    // Company Logo/Name branding switcher
    const updateBranding = () => {
      const selectedLogo = document.getElementById('config-branding-logo')?.value || 'auto';
      const selectedName = document.getElementById('config-branding-name')?.value || 'auto';
      const division = document.getElementById('print-root-container')?.getAttribute('data-division') || 'DTL';

      // 1. Resolve logo URL
      let logoUrl = '/dgllclogosmall.png';
      if (selectedLogo === 'dtl') {
        logoUrl = '/dtllogo.jpg';
      } else if (selectedLogo === 'dgs') {
        logoUrl = '/dgslogo.jpg';
      } else if (selectedLogo === 'dgllc') {
        logoUrl = '/dgllclogolarge.png';
      } else {
        // Auto detect logo
        logoUrl = division === 'DGS' ? '/dgslogo.jpg' : '/dtllogo.jpg';
      }

      // 2. Resolve company names
      let currentCompanyEN = 'Delight Technical Lighting';
      let currentCompanyAR = 'ديلايت للاضاءة الفنية';

      if (selectedName === 'dgs') {
        currentCompanyEN = 'Delight Greenscapes';
        currentCompanyAR = 'ديلايت جرين سكيبس';
      } else if (selectedName === 'dtl') {
        currentCompanyEN = 'Delight Technical Lighting';
        currentCompanyAR = 'ديلايت للاضاءة الفنية';
      } else if (selectedName === 'dgllc') {
        currentCompanyEN = 'Delight Group LLC';
        currentCompanyAR = 'مجموعة ديلايت ش.ذ.م.م';
      } else {
        // Auto-detect name
        if (division === 'DGS') {
          currentCompanyEN = 'Delight Greenscapes';
          currentCompanyAR = 'ديلايت جرين سكيبس';
        } else {
          currentCompanyEN = 'Delight Technical Lighting';
          currentCompanyAR = 'ديلايت للاضاءة الفنية';
        }
      }

      document.querySelectorAll('#print-company-logo, #print-company-logo-p2, #print-company-logo-std, #print-company-logo-std-p2, .company-card-tos-logo, .print-company-logo-subsequent').forEach(img => {
        img.src = logoUrl;
      });

      // Dynamically update text fields
      document.querySelectorAll('.dynamic-company-name-en').forEach(el => {
        el.textContent = currentCompanyEN;
      });
      document.querySelectorAll('.dynamic-company-name-ar').forEach(el => {
        el.textContent = currentCompanyAR;
      });
    };

    document.getElementById('config-branding-logo')?.addEventListener('change', updateBranding);
    document.getElementById('config-branding-name')?.addEventListener('change', updateBranding);

    // Total Summary Display Mode switcher
    const updateTotalsDisplay = () => {
      const mode = document.getElementById('config-total-show-mode')?.value || 'both';
      
      const amountClasses = ['.print-total-subtotal', '.print-total-vat', '.print-total-discount', '.print-total-due-row'];
      const quantityClasses = ['.print-total-quantity'];

      amountClasses.forEach(cls => {
        document.querySelectorAll(cls).forEach(el => {
          if (mode === 'quantity') {
            el.classList.add('hidden');
          } else {
            el.classList.remove('hidden');
          }
        });
      });

      quantityClasses.forEach(cls => {
        document.querySelectorAll(cls).forEach(el => {
          if (mode === 'amount') {
            el.classList.add('hidden');
          } else {
            el.classList.remove('hidden');
          }
        });
      });
    };

    document.getElementById('config-total-show-mode')?.addEventListener('change', updateTotalsDisplay);

    // Dynamic total pages count updater
    const updateTotalPagesCount = () => {
      const showPage2Checkbox = document.getElementById('config-show-page-2');
      const isPage2Visible = showPage2Checkbox ? showPage2Checkbox.checked : true;
      
      const layout = document.getElementById('layoutSelector')?.value || 'standard';
      let itemsPagesCount = 1;
      if (layout === 'delightgroupllc') {
        const pages = document.querySelectorAll('#layout-delightgroupllc-wrapper .print-page');
        const itemsPages = Array.from(pages).filter(p => !p.classList.contains('print-page-2-container') && p.style.display !== 'none');
        itemsPagesCount = itemsPages.length || 1;
      } else {
        const pages = document.querySelectorAll('#layout-standard-wrapper .print-page');
        const itemsPages = Array.from(pages).filter(p => !p.classList.contains('print-page-2-container') && p.style.display !== 'none');
        itemsPagesCount = itemsPages.length || 1;
      }

      const totalPages = isPage2Visible ? (itemsPagesCount + 1) : itemsPagesCount;

      document.querySelectorAll('.dynamic-total-pages').forEach(el => {
        el.textContent = totalPages.toString();
      });
    };

    document.getElementById('config-show-page-2')?.addEventListener('change', () => {
      setTimeout(updateTotalPagesCount, 50);
    });
    document.getElementById('layoutSelector')?.addEventListener('change', () => {
      setTimeout(updateTotalPagesCount, 50);
    });
    
    // Run on initial load/restore
    setTimeout(updateTotalPagesCount, 150);

    // Header Logo size adjustment
    document.getElementById('config-header-logo-size')?.addEventListener('change', (e) => {
      const val = e.target.value;
      document.querySelectorAll('#print-company-logo, #print-company-logo-std').forEach(img => {
        img.style.height = val + 'px';
        img.style.maxHeight = val + 'px';
      });
    });

    // Terms Logo size adjustment
    document.getElementById('config-terms-logo-size')?.addEventListener('change', (e) => {
      const val = e.target.value;
      document.querySelectorAll('#print-company-logo-p2, #print-company-logo-std-p2').forEach(img => {
        img.style.height = val + 'px';
        img.style.maxHeight = val + 'px';
      });
    });

    // Signature Area placement selector
    document.getElementById('config-sig-placement')?.addEventListener('change', (e) => {
      const val = e.target.value;
      document.querySelectorAll('.print-signature-section').forEach(el => {
        if (val === 'none') {
          el.classList.add('hidden');
        } else {
          el.classList.remove('hidden');
        }
      });
    });

    // Signatures detail toggles — smart receiver positioning
    const updateReceiverPosition = () => {
      const receiverEl = document.getElementById('sig-receiver');
      const clientEl = document.getElementById('sig-client');
      const receiverChecked = receiverEl ? receiverEl.checked : false;
      const clientChecked = clientEl ? clientEl.checked : true;

      // Customer sig column (left, standard)
      document.querySelectorAll('.print-sig-client-col').forEach(el => {
        if (clientChecked) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });

      // Receiver-in-left slot (shown when receiver is on AND customer is OFF)
      document.querySelectorAll('.print-sig-receiver-left').forEach(el => {
        if (receiverChecked && !clientChecked) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });

      // Receiver-in-bottom slot (shown when receiver is on AND customer is also on)
      document.querySelectorAll('.print-sig-receiver-col').forEach(el => {
        if (receiverChecked && clientChecked) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
    };

    // Signature Company Name handler
    document.getElementById('config-sig-company-name')?.addEventListener('change', (e) => {
      const val = e.target.value;
      document.querySelectorAll('.dynamic-sig-company-name-en').forEach(el => {
        el.textContent = val;
      });
    });

    document.getElementById('sig-client')?.addEventListener('change', updateReceiverPosition);
    document.getElementById('sig-receiver')?.addEventListener('change', updateReceiverPosition);

    document.getElementById('sig-company')?.addEventListener('change', (e) => {
      const checked = e.target.checked;
      document.querySelectorAll('.print-sig-company-col').forEach(el => {
        if (checked) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
    });

    document.getElementById('config-show-stamp-box')?.addEventListener('change', (e) => {
      const checked = e.target.checked;
      document.querySelectorAll('.print-stamp-box').forEach(el => {
        if (checked) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
      document.querySelectorAll('.delightgroupllc-inv-sign-stamp-body').forEach(el => {
        if (checked) {
          el.style.height = '100px';
        } else {
          el.style.height = '60px';
        }
      });
    });

    document.getElementById('config-show-dn-note')?.addEventListener('change', (e) => {
      const checked = e.target.checked;
      document.querySelectorAll('.print-dn-material-condition-disclaimer').forEach(el => {
        if (checked) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
    });

    // Electronic Signature toggle handler
    document.getElementById('config-electronic-sig')?.addEventListener('change', (e) => {
      const checked = e.target.checked;
      const physicalSigs = document.querySelectorAll('.print-signature-section');
      const electronicBadges = document.querySelectorAll('.print-electronic-badge');
      const sigPlacement = document.getElementById('config-sig-placement');
      
      if (checked) {
        physicalSigs.forEach(el => el.classList.add('hidden'));
        electronicBadges.forEach(el => el.classList.remove('hidden'));
        if (sigPlacement) sigPlacement.disabled = true;
      } else {
        const val = sigPlacement?.value || 'bottom-fixed';
        if (val !== 'none') {
          physicalSigs.forEach(el => el.classList.remove('hidden'));
        }
        electronicBadges.forEach(el => el.classList.add('hidden'));
        if (sigPlacement) sigPlacement.disabled = false;
        
        // Refresh checkboxes
        updateReceiverPosition();
        document.getElementById('sig-company')?.dispatchEvent(new Event('change'));
      }
    });

    // Bank Details customizer inputs real-time sync
    const updateBankDetails = () => {
      const name = document.getElementById('config-bank-name')?.value || '';
      const accName = document.getElementById('config-bank-acc-name')?.value || '';
      const acc = document.getElementById('config-bank-acc')?.value || '';
      const iban = document.getElementById('config-bank-iban')?.value || '';
      const swift = document.getElementById('config-bank-swift')?.value || '';
      
      document.querySelectorAll('#print-bank-name, #print-bank-name-p1-arr, #print-bank-name-std-p2, #print-bank-name-p2').forEach(el => el.textContent = name);
      document.querySelectorAll('#print-bank-acc-name, #print-bank-acc-name-p1-arr, #print-bank-acc-name-std-p2, #print-bank-acc-name-p2').forEach(el => el.textContent = accName);
      document.querySelectorAll('#print-bank-acc, #print-bank-acc-p1-arr, #print-bank-acc-std-p2, #print-bank-acc-p2').forEach(el => el.textContent = acc);
      document.querySelectorAll('#print-bank-iban, #print-bank-iban-p1-arr, #print-bank-iban-std-p2, #print-bank-iban-p2').forEach(el => el.textContent = iban);
      document.querySelectorAll('#print-bank-swift, #print-bank-swift-p1-arr, #print-bank-swift-std-p2, #print-bank-swift-p2').forEach(el => el.textContent = swift);
    };

    // Remittance block placement selector
    document.getElementById('config-remittance-placement')?.addEventListener('change', (e) => {
      const val = e.target.value;
      const p1Blocks = document.querySelectorAll('.print-bank-block-p1');
      const p2Blocks = document.querySelectorAll('.print-bank-block-p2');
      const inputs = document.getElementById('bank-customization-inputs');

      if (val === 'both') {
        p1Blocks.forEach(el => el.classList.remove('hidden'));
        p2Blocks.forEach(el => el.classList.remove('hidden'));
        inputs?.classList.remove('hidden');
      } else if (val === 'page1') {
        p1Blocks.forEach(el => el.classList.remove('hidden'));
        p2Blocks.forEach(el => el.classList.add('hidden'));
        inputs?.classList.remove('hidden');
      } else if (val === 'tos') {
        p1Blocks.forEach(el => el.classList.add('hidden'));
        p2Blocks.forEach(el => el.classList.remove('hidden'));
        inputs?.classList.remove('hidden');
      } else {
        // none
        p1Blocks.forEach(el => el.classList.add('hidden'));
        p2Blocks.forEach(el => el.classList.add('hidden'));
        inputs?.classList.add('hidden');
      }
    });

    // Bank detail event listeners
    ['config-bank-name', 'config-bank-acc-name', 'config-bank-acc', 'config-bank-iban', 'config-bank-swift'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateBankDetails);
    });

    // Selector event listeners
    document.getElementById('config-bank-selector')?.addEventListener('change', (e) => {
      const id = e.target.value;
      const bank = banksList.find((b) => b.id === id);
      if (!bank) return;

      const bankNameInput = document.getElementById('config-bank-name');
      const accNameInput = document.getElementById('config-bank-acc-name');
      const accInput = document.getElementById('config-bank-acc');
      const ibanInput = document.getElementById('config-bank-iban');
      const swiftInput = document.getElementById('config-bank-swift');

      if (bankNameInput) bankNameInput.value = bank.bank_name || '';
      if (accNameInput) accNameInput.value = bank.account_name || '';
      if (accInput) accInput.value = bank.account_number || '';
      if (ibanInput) ibanInput.value = bank.iban_number || '';
      if (swiftInput) swiftInput.value = bank.swift_code || '';

      updateBankDetails();
    });

    const updateSidebarSignaturePreview = (id) => {
      const wrapper = document.getElementById('sidebar-signature-preview-wrapper');
      const img = document.getElementById('sidebar-signature-preview');
      if (id === 'custom') {
        if (img) img.src = '';
        wrapper?.classList.add('hidden');
        return;
      }
      const sig = signaturesList.find((s) => s.id === id);
      if (sig && sig.signature_image) {
        if (img) img.src = sig.signature_image;
        wrapper?.classList.remove('hidden');
      } else {
        if (img) img.src = '';
        wrapper?.classList.add('hidden');
      }
    };

    document.getElementById('config-signature-selector')?.addEventListener('change', (e) => {
      const id = e.target.value;
      const customWrapper = document.getElementById('custom-signature-input-wrapper');
      
      updateSidebarSignaturePreview(id);

      if (id === 'any') {
        customWrapper?.classList.add('hidden');
        document.querySelectorAll('#print-sig-name-std, #print-sig-name-arr').forEach(el => {
          el.textContent = '';
        });
        document.querySelectorAll('.print-sig-paren-std, .print-sig-paren-arr').forEach(el => {
          el.style.display = 'none';
        });
        document.querySelectorAll('.signature-image-render').forEach(el => {
          el.src = '';
          el.classList.add('hidden');
        });
      } else if (id === 'custom') {
        customWrapper?.classList.remove('hidden');
        const customVal = document.getElementById('config-custom-signature-name')?.value || '';
        document.querySelectorAll('#print-sig-name-std, #print-sig-name-arr').forEach(el => {
          el.textContent = customVal;
        });
        document.querySelectorAll('.print-sig-paren-std, .print-sig-paren-arr').forEach(el => {
          el.style.display = customVal ? 'inline' : 'none';
        });
        document.querySelectorAll('.signature-image-render').forEach(el => {
          el.src = '';
          el.classList.add('hidden');
        });
      } else {
        customWrapper?.classList.add('hidden');
        const sig = signaturesList.find((s) => s.id === id);
        if (!sig) return;
        document.querySelectorAll('#print-sig-name-std, #print-sig-name-arr').forEach(el => {
          el.textContent = sig.signatory_name || '';
        });
        document.querySelectorAll('.print-sig-paren-std, .print-sig-paren-arr').forEach(el => {
          el.style.display = sig.signatory_name ? 'inline' : 'none';
        });
        document.querySelectorAll('.signature-image-render').forEach(el => {
          if (sig.signature_image) {
            el.src = sig.signature_image;
            el.classList.remove('hidden');
          } else {
            el.src = '';
            el.classList.add('hidden');
          }
        });
      }
    });

    document.getElementById('config-custom-signature-name')?.addEventListener('input', (e) => {
      const val = e.target.value;
      document.querySelectorAll('#print-sig-name-std, #print-sig-name-arr').forEach(el => {
        el.textContent = val;
      });
      document.querySelectorAll('.print-sig-paren-std, .print-sig-paren-arr').forEach(el => {
        el.style.display = val ? 'inline' : 'none';
      });
    });

    document.getElementById('config-address-selector')?.addEventListener('change', (e) => {
      const id = e.target.value;
      const addr = addressesList.find((a) => a.id === id);
      if (!addr) return;

      // Update address
      document.querySelectorAll('#print-company-address-std, #print-company-address-std-p2, #print-company-address-arr, #print-company-address-arr-p2').forEach(el => {
        el.textContent = addr.business_address || '';
      });

      // Update TRN
      document.querySelectorAll('#print-company-trn-std, #print-company-trn-std-p2, #print-company-trn-arr, #print-company-trn-arr-p2').forEach(el => {
        el.textContent = addr.trn_number || '';
      });

      // Update Registration
      document.querySelectorAll('#print-company-reg-std, #print-company-reg-std-p2, #print-company-reg-arr, #print-company-reg-arr-p2').forEach(el => {
        el.textContent = addr.business_registration || '';
      });
      document.querySelectorAll('#print-company-reg-std-wrapper, #print-company-reg-std-p2-wrapper, #print-company-reg-arr-wrapper, #print-company-reg-arr-p2-wrapper').forEach(el => {
        if (addr.business_registration) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });

      // Update Permits
      document.querySelectorAll('#print-company-permits-std, #print-company-permits-std-p2, #print-company-permits-arr, #print-company-permits-arr-p2').forEach(el => {
        el.textContent = addr.permits_info || '';
      });
      document.querySelectorAll('#print-company-permits-std-wrapper, #print-company-permits-std-p2-wrapper, #print-company-permits-arr-wrapper, #print-company-permits-arr-p2-wrapper').forEach(el => {
        if (addr.permits_info) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });

      // Update Phone
      document.querySelectorAll('#print-company-phone-std').forEach(el => {
        el.textContent = addr.phone_number || '';
      });
      document.querySelectorAll('#print-company-phone-std-type').forEach(el => {
        el.textContent = addr.phone_type || 'Phone';
      });
      document.querySelectorAll('#print-company-phone-arr').forEach(el => {
        el.textContent = addr.phone_number || '';
      });
      document.querySelectorAll('#print-company-phone-arr-type').forEach(el => {
        el.textContent = addr.phone_type || 'Tel';
      });
    });

    // Save configuration to localStorage
    document.getElementById('config-save-btn')?.addEventListener('click', () => {
      const config = {};
      const inputs = [
        'layoutSelector', 'config-doc-type', 'config-branding-logo', 'config-branding-name', 'config-total-show-mode', 'config-show-logo',
        'config-header-logo-size', 'config-show-logo-p2', 'config-terms-logo-size',
        'config-show-watermark', 'config-watermark-source', 'config-watermark-opacity', 'config-watermark-size',
        'config-show-cust-company', 'config-show-cust-address', 'config-show-cust-contact', 'config-show-cust-trn',
        'config-show-info-status', 'config-show-info-date', 'config-show-info-due',
        'config-show-col-ref', 'config-show-col-spec', 'config-show-col-price',
        'config-show-subtotal', 'config-show-vat', 'config-show-discount', 'config-show-total', 'config-show-total-qty', 'config-show-qty-words', 'config-show-dn-condition-note', 'config-show-page-2',
        'config-show-company-card-tos', 'config-sig-placement', 'sig-client', 'sig-receiver', 'sig-company', 
        'config-show-sig-image', 'config-show-stamp-box', 'config-show-disclaimer', 'config-show-dn-note', 'config-electronic-sig',
        'config-remittance-placement', 'config-bank-name', 'config-bank-acc-name', 'config-bank-acc', 'config-bank-iban', 'config-bank-swift',
        'config-bank-selector', 'config-signature-selector', 'config-address-selector', 'config-only-selected-tos'
      ];
      inputs.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        if (el.tagName === 'INPUT' && el.type === 'checkbox') {
          config[id] = el.checked;
        } else {
          config[id] = el.value;
        }
      });
      localStorage.setItem('print_config_invoices', JSON.stringify(config));
      
      // Visual feedback on save button
      const saveBtn = document.getElementById('config-save-btn');
      if (saveBtn) {
        const originalHtml = saveBtn.innerHTML;
        saveBtn.innerHTML = `
          <svg class="h-3.5 w-3.5 text-emerald-400 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Saved!
        `;
        setTimeout(() => {
          saveBtn.innerHTML = originalHtml;
        }, 1500);
      }
    });

    // Load configuration from localStorage
    const loadSavedConfig = () => {
      try {
        const saved = localStorage.getItem('print_config_invoices');
        if (!saved) return;
        const config = JSON.parse(saved);
        Object.keys(config).forEach(id => {
          const el = document.getElementById(id);
          if (!el) return;
          if (el.tagName === 'INPUT' && el.type === 'checkbox') {
            el.checked = config[id];
          } else {
            el.value = config[id];
          }
          // Trigger events to update the layout rendering
          el.dispatchEvent(new Event('change'));
          el.dispatchEvent(new Event('input'));
        });
        setTimeout(repaginate, 50);
      } catch (err) {
        console.error('Error loading print config:', err);
      }
    };
    
    // Call loadSavedConfig on startup
    loadSavedConfig();
    // Run filter
    applySelectedTOSFilter();

    // Set initial signature preview and trigger update based on current selector value
    const sigSelector = document.getElementById('config-signature-selector');
    if (sigSelector) {
      sigSelector.dispatchEvent(new Event('change'));
    }

    const docTypeSelector = document.getElementById('config-doc-type');
    if (docTypeSelector) {
      docTypeSelector.dispatchEvent(new Event('change'));
    }

    // Auto print if requested via query param
    if (urlParams.get('autoprint') === 'true' || urlParams.get('download') === 'true') {
      window.onload = () => {
        setTimeout(() => {
          window.print();
        }, 400);
      };
    }
  </script>
</body>
</html>
