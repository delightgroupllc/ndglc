---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CategoryForm from '../../components/forms/CategoryForm.astro';
import { query } from '../../lib/db';
import { FolderGit2, PlusCircle, Search, AlertTriangle, Tag, BedDouble, Trash2, Edit3, Image as ImageIcon } from '@lucide/astro';

let categories: any[] = [];
let divisions: any[] = [];
let rooms: any[] = [];
let roomCounts: Record<string, number> = {};
let dbConnected = true;

// Self-healing database migration for categories image_url column
try {
  await query('ALTER TABLE categories ADD COLUMN IF NOT EXISTS image_url TEXT');
} catch (e: any) {
  console.warn('Migration for categories.image_url failed or already exists:', e.message);
}

try {
  const catRes = await query(
    `SELECT c.*, d.name as division_name,
       (SELECT COUNT(*) FROM products WHERE category_id = c.id) as product_count
     FROM categories c
     JOIN divisions d ON d.id = c.division_id
     ORDER BY d.name ASC, c.display_order ASC`
  );
  categories = catRes.rows;

  const divRes = await query('SELECT * FROM divisions ORDER BY name ASC');
  divisions = divRes.rows;

  // Load configurable rooms
  try {
    const sres = await query('SELECT value FROM settings WHERE key = $1', ['rooms']);
    if (sres.rows.length > 0) {
      try { rooms = JSON.parse(sres.rows[0].value); } catch { rooms = []; }
    }
  } catch (e) {
    console.warn('Unable to load rooms setting:', e?.message || e);
  }

  // Load count of products per room
  const roomCountRes = await query(
    `SELECT ideal_room, COUNT(*) as count FROM products WHERE ideal_room IS NOT NULL AND ideal_room != '' GROUP BY ideal_room`
  );
  roomCounts = roomCountRes.rows.reduce((acc: any, row: any) => {
    acc[row.ideal_room] = parseInt(row.count) || 0;
    return acc;
  }, {});
} catch (err: any) {
  console.warn('Database offline, loading mock categories list:', err.message);
  dbConnected = false;

  divisions = [
    { id: 'div-1', name: 'Division DTL', slug: 'dtl' },
    { id: 'div-2', name: 'Division DGS', slug: 'dgs' }
  ];

  categories = [
    { id: 'cat-1', name: 'Valves & Actuators', slug: 'valves-actuators', division_id: 'div-1', division_name: 'Division DTL', display_order: 1, seo_title: 'Valves & Flow Controls', product_count: 5, image_url: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=200' },
    { id: 'cat-2', name: 'Industrial Pumps', slug: 'industrial-pumps', division_id: 'div-1', division_name: 'Division DTL', display_order: 2, seo_title: 'Hydraulic Pumps', product_count: 12, image_url: 'https://images.unsplash.com/photo-1597430138224-0096b3741870?q=80&w=200' },
    { id: 'cat-3', name: 'Cloud Infrastructure', slug: 'cloud-infrastructure', division_id: 'div-2', division_name: 'Division DGS', display_order: 1, seo_title: 'Enterprise Cloud Backup', product_count: 2, image_url: 'https://images.unsplash.com/photo-1544197150-b99a580bb7a8?q=80&w=200' },
    { id: 'cat-4', name: 'Cyber Security', slug: 'cyber-security', division_id: 'div-2', division_name: 'Division DGS', display_order: 2, seo_title: 'Neural OT Firewalls', product_count: 0, image_url: 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=200' }
  ];

  rooms = [
    { name: 'Outdoor', iconUrl: 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?q=80&w=200' },
    { name: 'Living room', iconUrl: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=200' },
    { name: 'Dining room', iconUrl: 'https://images.unsplash.com/photo-1617806118233-18e1db207f62?q=80&w=200' },
    { name: 'Kitchen', iconUrl: 'https://images.unsplash.com/photo-1556911220-e15b29be8c8f?q=80&w=200' },
    { name: 'Bedroom', iconUrl: 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?q=80&w=200' },
    { name: 'Bathroom', iconUrl: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?q=80&w=200' }
  ];

  roomCounts = {
    'Outdoor': 14,
    'Living room': 9,
    'Dining room': 4
  };
}

// Map rooms safely if they are stored as strings or objects
const normalizedRooms = rooms.map((r, idx) => {
  const name = typeof r === 'string' ? r : (r?.name || '');
  const iconUrl = typeof r === 'string' ? '' : (r?.iconUrl || '');
  return { name, iconUrl, index: idx };
});
---

<DashboardLayout title="Categories & Rooms map" activeItem="categories">

  {!dbConnected && (
    <div class="mb-6 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4 w-4 shrink-0" />
      <div><span class="font-bold">PostgreSQL is Offline</span>: Telemetry displays simulated category listings.</div>
    </div>
  )}

  <div class="space-y-6 max-w-7xl mx-auto p-6 lg:p-8">
    
    <!-- Workspace Title -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-3">
      <div>
        <h2 class="text-xl font-bold text-slate-800 tracking-tight flex items-center gap-2">
          <FolderGit2 class="w-6 h-6 text-cyan-600 animate-pulse" />
          Catalog Layout Manager
        </h2>
        <p class="text-xs text-slate-500">Configure divisions' categories, rooms, image assets, and dynamic product catalog relationships.</p>
      </div>
      
      <!-- Primary Tab Switcher -->
      <div class="bg-slate-100 p-1 rounded-xl flex items-center border border-slate-200 shadow-sm shrink-0">
        <button 
          id="tab-btn-categories" 
          class="tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all bg-white text-slate-800 shadow-xs flex items-center gap-1.5"
        >
          📁 Categories Directory
        </button>
        <button 
          id="tab-btn-rooms" 
          class="tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-slate-550 hover:text-slate-800 flex items-center gap-1.5"
        >
          🏠 Rooms Designer
        </button>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- 1. CATEGORIES WORKSPACE PANEL                  -->
    <!-- ============================================== -->
    <div id="panel-categories" class="space-y-6">
      
      <!-- Action Filters Header -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-slate-50 border border-slate-200 p-3 rounded-xl shadow-3xs">
        <div class="relative flex-grow max-w-md">
          <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
          <input
            type="text"
            id="admin-search-categories"
            placeholder="Filter categories by name, slug or division..."
            class="w-full rounded-lg border border-slate-250 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50 font-semibold"
          />
        </div>
        <div class="flex gap-2 shrink-0 flex-wrap">
          <button
            type="button"
            id="cat-mass-rename-btn"
            class="hidden inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <Tag class="h-4 w-4" />
            Rename Selected (<span id="cat-selected-count">0</span>)
          </button>
          <button
            type="button"
            id="open-category-modal-btn"
            class="inline-flex items-center justify-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <PlusCircle class="h-4 w-4" />
            New Category
          </button>
        </div>
      </div>

      <!-- Categories Table Grid -->
      <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
              <th class="px-4 py-4 font-semibold w-8">
                <input type="checkbox" id="select-all-categories" class="rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" title="Select all" />
              </th>
              <th class="px-4 py-4 font-semibold">Image</th>
              <th class="px-4 py-4 font-semibold">Category Name</th>
              <th class="px-4 py-4 font-semibold">Slug</th>
              <th class="px-4 py-4 font-semibold">Division</th>
              <th class="px-4 py-4 font-semibold text-center">Products Contained</th>
              <th class="px-4 py-4 font-semibold text-center">Order</th>
              <th class="px-4 py-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="admin-categories-table">
            {categories.map(c => (
              <tr
                class="admin-category-row border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors"
                data-id={c.id}
                data-name={c.name}
                data-category={JSON.stringify(c)}
              >
                <td class="px-4 py-3">
                  <input type="checkbox" class="cat-row-check rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" data-id={c.id} data-name={c.name} />
                </td>
                <td class="px-4 py-3">
                  <div class="w-10 h-10 rounded-lg bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center shadow-3xs">
                    <img 
                      src={c.image_url || '/noimage.jpg'} 
                      alt={c.name} 
                      class="w-full h-full object-cover" 
                      onerror="this.onerror=null; this.src='/noimage.jpg'" 
                    />
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span class={`font-bold block ${c.name.startsWith('deleted-cat-') ? 'text-rose-500 line-through' : 'text-slate-900'}`}>{c.name}</span>
                  {c.name.startsWith('deleted-cat-') && <span class="inline-block mt-0.5 text-[9px] font-bold bg-rose-100 text-rose-600 px-1.5 py-0.5 rounded uppercase">Tagged</span>}
                </td>
                <td class="px-4 py-3 text-slate-500 font-mono">{c.slug}</td>
                <td class="px-4 py-3 text-slate-600 font-semibold">{c.division_name}</td>
                <td class="px-4 py-3 text-center">
                  <span class={`px-2 py-0.5 rounded-full text-3xs font-extrabold ${c.product_count > 0 ? 'bg-cyan-50 text-cyan-600 border border-cyan-200/50' : 'bg-slate-50 text-slate-400 border border-slate-200/50'} border shadow-3xs`}>
                    {c.product_count || 0} Products
                  </span>
                </td>
                <td class="px-4 py-3 text-center font-bold text-cyan-600">{c.display_order}</td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button type="button" class="edit-cat-btn text-blue-500 hover:text-blue-600 font-semibold transition-colors flex items-center gap-1">
                      <Edit3 class="w-3.5 h-3.5" /> Edit
                    </button>
                    <button type="button" class="delete-cat-btn text-red-500 hover:text-red-600 font-semibold transition-colors flex items-center gap-1">
                      <Trash2 class="w-3.5 h-3.5" /> Delete
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>


    <!-- ============================================== -->
    <!-- 2. ROOMS DESIGNER WORKSPACE PANEL              -->
    <!-- ============================================== -->
    <div id="panel-rooms" class="hidden space-y-6">
      
      <!-- Rooms Action Header -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-slate-50 border border-slate-200 p-3 rounded-xl shadow-3xs">
        <div class="relative flex-grow max-w-md">
          <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
          <input
            type="text"
            id="admin-search-rooms"
            placeholder="Search rooms..."
            class="w-full rounded-lg border border-slate-250 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50 font-semibold"
          />
        </div>
        <div>
          <button
            type="button"
            id="open-room-modal-btn"
            class="inline-flex items-center justify-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors shadow-sm"
          >
            <PlusCircle class="h-4 w-4" />
            New Room / Ideal Place
          </button>
        </div>
      </div>

      <!-- Rooms Editable Table Grid -->
      <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
              <th class="px-4 py-4 font-semibold w-12 text-center">Position</th>
              <th class="px-4 py-4 font-semibold w-24">Room Cover</th>
              <th class="px-4 py-4 font-semibold">Room / Ideal Place Name</th>
              <th class="px-4 py-4 font-semibold text-center">Associated Products</th>
              <th class="px-4 py-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="admin-rooms-table" class="divide-y divide-slate-100">
            {normalizedRooms.map(r => {
              const productCount = roomCounts[r.name] || 0;
              return (
                <tr 
                  class="admin-room-row hover:bg-slate-50 text-xs transition-colors" 
                  data-name={r.name}
                  data-icon={r.iconUrl}
                  data-index={r.index}
                >
                  <td class="px-4 py-4 text-center font-mono text-slate-400 font-bold select-none cursor-grab active:cursor-grabbing">
                    ≡
                  </td>
                  <td class="px-4 py-3">
                    <div class="w-14 h-10 rounded-lg bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center shadow-3xs">
                      <img 
                        src={r.iconUrl || '/noimage.jpg'} 
                        alt={r.name} 
                        class="w-full h-full object-cover" 
                        onerror="this.onerror=null; this.src='/noimage.jpg'" 
                      />
                    </div>
                  </td>
                  <td class="px-4 py-3 font-bold text-slate-900 text-sm">
                    {r.name}
                  </td>
                  <td class="px-4 py-3 text-center">
                    <span class={`px-2 py-0.5 rounded-full text-3xs font-extrabold ${productCount > 0 ? 'bg-indigo-50 text-indigo-600 border border-indigo-200/50' : 'bg-slate-50 text-slate-400 border border-slate-200/50'} border shadow-3xs`}>
                      {productCount} Products inside
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <button type="button" class="edit-room-btn text-blue-500 hover:text-blue-600 font-semibold transition-colors flex items-center gap-1">
                        <Edit3 class="w-3.5 h-3.5" /> Edit
                      </button>
                      <button type="button" class="delete-room-btn text-red-500 hover:text-red-600 font-semibold transition-colors flex items-center gap-1">
                        <Trash2 class="w-3.5 h-3.5" /> Delete
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}

            {normalizedRooms.length === 0 && (
              <tr>
                <td colspan="5" class="py-12 text-center text-slate-400 font-medium bg-slate-50/50">
                  No rooms designer records found. Click "New Room" to configure one immediately!
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- ============================================== -->
  <!-- MODALS DIALOG SECTION                          -->
  <!-- ============================================== -->

  <!-- ===== Category Add/Edit Modal ===== -->
  <div id="category-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg max-h-[92vh] flex flex-col overflow-hidden">
      <div class="p-5 border-b border-slate-200 bg-slate-50 flex justify-between items-center shrink-0">
        <h3 id="category-modal-title" class="text-base font-bold text-slate-900 flex items-center gap-2">
          <PlusCircle class="h-5 w-5 text-cyan-500" />
          Map New Category
        </h3>
        <button id="close-category-modal" class="text-slate-400 hover:text-slate-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="overflow-y-auto p-6">
        <CategoryForm divisions={divisions} />
      </div>
    </div>
  </div>

  <!-- ===== Room Add/Edit Modal (Highly requested visual editor!) ===== -->
  <div id="room-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden">
      <div class="p-5 border-b border-slate-200 bg-slate-50 flex justify-between items-center shrink-0">
        <h3 id="room-modal-title" class="text-base font-bold text-slate-900 flex items-center gap-2">
          <BedDouble class="h-5 w-5 text-cyan-500" />
          Designer Room Setting
        </h3>
        <button id="close-room-modal" class="text-slate-400 hover:text-slate-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <form id="room-designer-form" class="p-6 space-y-4 text-left">
        <input type="hidden" id="form-room-index" value="" />
        <input type="hidden" id="form-room-original-name" value="" />
        
        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Room Name / Ideal Place</label>
          <input 
            type="text" 
            id="form-room-name" 
            required 
            placeholder="e.g. Luxury Living Room" 
            class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none font-bold" 
          />
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wider font-sans">Room Image / Cover URL</label>
          <input 
            type="url" 
            id="form-room-icon" 
            placeholder="https://images.unsplash.com/photo-..." 
            class="w-full rounded-lg border border-slate-300 bg-white text-slate-900 px-3 py-2 text-xs focus:border-cyan-500 focus:outline-none" 
          />
          <div class="mt-2 rounded-lg border border-slate-200 bg-slate-50 p-2 flex items-center justify-center h-32 overflow-hidden shadow-inner">
            <img id="form-room-preview" src="/noimage.jpg" class="h-full object-contain" alt="Room Cover Preview" onerror="this.onerror=null; this.src='/noimage.jpg'" />
          </div>
        </div>

        <button 
          type="submit" 
          id="room-submit-btn" 
          class="w-full bg-cyan-650 hover:bg-cyan-755 text-white py-3 rounded-lg text-sm font-bold transition-colors shadow-sm"
        >
          Save Room Layout
        </button>
      </form>
    </div>
  </div>

  <!-- ===== Mass Rename Modal (Categories) ===== -->
  <div id="cat-mass-rename-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex-col items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-xl overflow-hidden">
      <div class="p-5 border-b border-slate-200 bg-amber-50 flex justify-between items-center">
        <h3 class="text-base font-bold text-amber-900 flex items-center gap-2">
          <Tag class="h-5 w-5 text-amber-600" />
          Mass Rename Categories
        </h3>
        <button id="close-cat-mass-rename-modal" class="text-slate-400 hover:text-slate-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <p class="text-xs text-slate-600 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
          Apply a <strong>Find & Replace</strong> across all selected category names.
        </p>
        <div id="cat-mass-rename-list" class="space-y-2 max-h-40 overflow-y-auto pr-1 text-xs text-slate-700 font-medium"></div>
        <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-100">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Find</label>
            <input type="text" id="cat-rename-find" placeholder="Text to find..." class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-amber-500" />
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Replace with</label>
            <input type="text" id="cat-rename-replace" placeholder="Replacement text..." class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-amber-500" />
          </div>
        </div>
        <p class="text-[10px] text-slate-500 italic">Note: The slug will also be auto-updated to match the new name.</p>
        <div id="cat-mass-rename-msg" class="hidden p-3 rounded-lg text-sm font-semibold"></div>
        <button
          id="cat-mass-rename-confirm-btn"
          class="w-full bg-amber-500 hover:bg-amber-600 text-white py-3 rounded-xl text-sm font-bold transition-colors shadow-sm"
        >
          Apply Rename to Selected Categories
        </button>
      </div>
    </div>
  </div>

  <script>
    // ============================================================
    // WORKSPACE TABS SWITCHER
    // ============================================================
    const tabBtnCats = document.getElementById('tab-btn-categories');
    const tabBtnRooms = document.getElementById('tab-btn-rooms');
    const panelCats = document.getElementById('panel-categories');
    const panelRooms = document.getElementById('panel-rooms');

    const switchWorkspaceTab = (tab: 'categories' | 'rooms') => {
      if (tab === 'categories') {
        panelCats?.classList.remove('hidden');
        panelRooms?.classList.add('hidden');
        tabBtnCats?.classList.add('bg-white', 'text-slate-800', 'shadow-xs');
        tabBtnCats?.classList.remove('text-slate-550');
        tabBtnRooms?.classList.remove('bg-white', 'text-slate-800', 'shadow-xs');
        tabBtnRooms?.classList.add('text-slate-550');
        localStorage.setItem('catalog-active-tab', 'categories');
      } else {
        panelRooms?.classList.remove('hidden');
        panelCats?.classList.add('hidden');
        tabBtnRooms?.classList.add('bg-white', 'text-slate-800', 'shadow-xs');
        tabBtnRooms?.classList.remove('text-slate-550');
        tabBtnCats?.classList.remove('bg-white', 'text-slate-800', 'shadow-xs');
        tabBtnCats?.classList.add('text-slate-550');
        localStorage.setItem('catalog-active-tab', 'rooms');
      }
    };

    tabBtnCats?.addEventListener('click', () => switchWorkspaceTab('categories'));
    tabBtnRooms?.addEventListener('click', () => switchWorkspaceTab('rooms'));

    // Restore active tab
    const savedActiveTab = localStorage.getItem('catalog-active-tab') || 'categories';
    switchWorkspaceTab(savedActiveTab as 'categories' | 'rooms');

    // ============================================================
    // CATEGORY MODAL OPEN/CLOSE
    // ============================================================
    const catModal = document.getElementById('category-modal-backdrop');
    const closeCatModal = document.getElementById('close-category-modal');
    const openCatModalBtn = document.getElementById('open-category-modal-btn');
    const catModalTitle = document.getElementById('category-modal-title');

    const openCategoryModal = () => {
      catModal?.classList.remove('hidden');
      catModal?.classList.add('flex');
    };

    const closeCategoryModal = () => {
      catModal?.classList.add('hidden');
      catModal?.classList.remove('flex');
    };

    openCatModalBtn?.addEventListener('click', () => {
      (document.getElementById('category-id') as HTMLInputElement).value = '';
      (document.querySelector('input[name="name"]') as HTMLInputElement).value = '';
      (document.querySelector('input[name="slug"]') as HTMLInputElement).value = '';
      (document.querySelector('select[name="division_id"]') as HTMLSelectElement).value = '';
      (document.querySelector('input[name="display_order"]') as HTMLInputElement).value = '0';
      (document.querySelector('input[name="image_url"]') as HTMLInputElement).value = '';
      (document.querySelector('#category-image-preview') as HTMLImageElement).src = '/noimage.jpg';
      (document.querySelector('input[name="seo_title"]') as HTMLInputElement).value = '';
      (document.querySelector('textarea[name="seo_description"]') as HTMLTextAreaElement).value = '';
      if (catModalTitle) catModalTitle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-500"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg> Map New Category';
      (document.getElementById('category-submit-btn') as HTMLButtonElement).textContent = 'Create Category';
      openCategoryModal();
    });

    closeCatModal?.addEventListener('click', closeCategoryModal);
    catModal?.addEventListener('click', (e) => { if (e.target === catModal) closeCategoryModal(); });

    // ============================================================
    // SEARCH CATEGORIES & ROOMS
    // ============================================================
    document.getElementById('admin-search-categories')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll('.admin-category-row').forEach(row => {
        const catStr = row.getAttribute('data-category') || '';
        const cat = JSON.parse(catStr);
        (row as HTMLElement).style.display = (cat.name.toLowerCase().includes(q) || cat.slug.toLowerCase().includes(q) || cat.division_name?.toLowerCase().includes(q)) ? '' : 'none';
      });
    });

    document.getElementById('admin-search-rooms')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll('.admin-room-row').forEach(row => {
        const name = row.getAttribute('data-name')?.toLowerCase() || '';
        (row as HTMLElement).style.display = name.includes(q) ? '' : 'none';
      });
    });

    // ============================================================
    // MASS SELECTOR
    // ============================================================
    const selectAllCats = document.getElementById('select-all-categories') as HTMLInputElement;
    const catMassRenameBtn = document.getElementById('cat-mass-rename-btn');
    const catSelectedCount = document.getElementById('cat-selected-count');
    let selectedCats: { id: string; name: string; data: any }[] = [];

    const updateCatSelectionUI = () => {
      const checks = document.querySelectorAll('.cat-row-check:checked');
      selectedCats = Array.from(checks).map(c => {
        const row = (c as HTMLElement).closest('tr');
        const catStr = row?.getAttribute('data-category') || '{}';
        return { id: c.getAttribute('data-id') || '', name: c.getAttribute('data-name') || '', data: JSON.parse(catStr) };
      });

      if (catSelectedCount) catSelectedCount.textContent = String(selectedCats.length);
      if (catMassRenameBtn) {
        if (selectedCats.length > 0) {
          catMassRenameBtn.classList.remove('hidden');
          catMassRenameBtn.classList.add('inline-flex');
        } else {
          catMassRenameBtn.classList.add('hidden');
          catMassRenameBtn.classList.remove('inline-flex');
        }
      }
    };

    selectAllCats?.addEventListener('change', () => {
      document.querySelectorAll('.cat-row-check').forEach((cb: any) => { cb.checked = selectAllCats.checked; });
      updateCatSelectionUI();
    });

    document.querySelectorAll('.cat-row-check').forEach(cb => cb.addEventListener('change', updateCatSelectionUI));

    // ============================================================
    // MASS RENAME CATEGORIES
    // ============================================================
    const catMassRenameModal = document.getElementById('cat-mass-rename-modal');
    const closeCatMassRename = document.getElementById('close-cat-mass-rename-modal');
    const catMassRenameList = document.getElementById('cat-mass-rename-list');
    const catRenameFindInput = document.getElementById('cat-rename-find') as HTMLInputElement;
    const catRenameReplaceInput = document.getElementById('cat-rename-replace') as HTMLInputElement;
    const catMassRenameConfirmBtn = document.getElementById('cat-mass-rename-confirm-btn');
    const catMassRenameMsg = document.getElementById('cat-mass-rename-msg');

    catMassRenameBtn?.addEventListener('click', () => {
      if (!catMassRenameModal || !catMassRenameList) return;
      catMassRenameList.innerHTML = selectedCats.map(s =>
        `<div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span>
          <span>${s.name}</span>
        </div>`
      ).join('');
      catRenameFindInput.value = '';
      catRenameReplaceInput.value = '';
      if (catMassRenameMsg) catMassRenameMsg.classList.add('hidden');
      catMassRenameModal.classList.remove('hidden');
      catMassRenameModal.classList.add('flex');
    });

    closeCatMassRename?.addEventListener('click', () => {
      catMassRenameModal?.classList.add('hidden');
      catMassRenameModal?.classList.remove('flex');
    });

    // ============================================================
    // EDIT & DELETE CATEGORY Handlers
    // ============================================================
    document.querySelectorAll('.edit-cat-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = (e.target as HTMLElement).closest('tr') as HTMLElement | null;
        const catStr = row?.getAttribute('data-category');
        if (!catStr) return;
        const cat = JSON.parse(catStr);

        (document.getElementById('category-id') as HTMLInputElement).value = cat.id;
        (document.querySelector('input[name="name"]') as HTMLInputElement).value = cat.name;
        (document.querySelector('input[name="slug"]') as HTMLInputElement).value = cat.slug;
        (document.querySelector('select[name="division_id"]') as HTMLSelectElement).value = cat.division_id;
        (document.querySelector('input[name="display_order"]') as HTMLInputElement).value = cat.display_order;
        (document.querySelector('input[name="image_url"]') as HTMLInputElement).value = cat.image_url || '';
        (document.querySelector('#category-image-preview') as HTMLImageElement).src = cat.image_url || '/noimage.jpg';
        (document.querySelector('input[name="seo_title"]') as HTMLInputElement).value = cat.seo_title || '';
        (document.querySelector('textarea[name="seo_description"]') as HTMLTextAreaElement).value = cat.seo_description || '';

        if (catModalTitle) catModalTitle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit Category';
        (document.getElementById('category-submit-btn') as HTMLButtonElement).textContent = 'Update Category';
        openCategoryModal();
      });
    });

    document.querySelectorAll('.delete-cat-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const row = (e.target as HTMLElement).closest('tr') as HTMLElement | null;
        const catStr = row?.getAttribute('data-category');
        if (!catStr) return;
        const cat = JSON.parse(catStr);

        if (!confirm(`Delete category "${cat.name}"? If it has products, it will be tagged as "deleted-cat-${cat.name}" instead.`)) return;

        try {
          const res = await fetch(`/api/categories/${cat.id}`, { method: 'DELETE' });
          const result = await res.json();
          if (res.ok) {
            if (result.renamed) {
              const nameCell = row?.querySelector('td:nth-child(3)');
              if (nameCell) nameCell.innerHTML = `<span class="font-bold text-rose-500 line-through">deleted-cat-${cat.name}</span><span class="inline-block mt-0.5 text-[9px] font-bold bg-rose-100 text-rose-600 px-1.5 py-0.5 rounded uppercase">Tagged</span>`;
              alert(`Category has active products, so it was tagged as "deleted-cat-${cat.name}" instead of deleted.`);
            } else {
              row?.remove();
            }
          } else {
            alert(result.error || 'Failed to delete category.');
          }
        } catch (err) {
          alert('Error deleting category.');
        }
      });
    });

    catMassRenameConfirmBtn?.addEventListener('click', async () => {
      const findText = catRenameFindInput.value;
      const replaceText = catRenameReplaceInput.value;
      if (!findText) { alert('Please enter text to find.'); return; }

      const originalText = catMassRenameConfirmBtn.textContent;
      catMassRenameConfirmBtn.textContent = 'Renaming...';
      catMassRenameConfirmBtn.setAttribute('disabled', 'true');

      let successCount = 0;
      let failCount = 0;

      for (const cat of selectedCats) {
        const newName = cat.name.split(findText).join(replaceText);
        if (newName === cat.name) continue;

        const newSlug = newName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '-' + Date.now();

        const payload = {
          name: newName,
          slug: newSlug,
          division_id: cat.data.division_id,
          display_order: cat.data.display_order || 0,
          image_url: cat.data.image_url || null,
          seo_title: cat.data.seo_title || null,
          seo_description: cat.data.seo_description || null
        };

        try {
          const res = await fetch(`/api/categories/${cat.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (res.ok) successCount++;
          else failCount++;
        } catch (err) {
          failCount++;
        }
      }

      catMassRenameConfirmBtn.removeAttribute('disabled');
      catMassRenameConfirmBtn.textContent = originalText || 'Apply Rename';

      if (catMassRenameMsg) {
        catMassRenameMsg.classList.remove('hidden');
        if (failCount === 0) {
          catMassRenameMsg.className = 'p-3 rounded-lg text-sm font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
          catMassRenameMsg.textContent = `Successfully renamed ${successCount} category(s). Reloading...`;
          setTimeout(() => window.location.reload(), 1200);
        } else {
          catMassRenameMsg.className = 'p-3 rounded-lg text-sm font-semibold bg-red-50 text-red-700 border border-red-200';
          catMassRenameMsg.textContent = `${successCount} renamed, ${failCount} failed.`;
        }
      }
    });

    // ============================================================
    // ROOMS DESIGNER MODAL / ACTIONS
    // ============================================================
    const roomModal = document.getElementById('room-modal-backdrop');
    const closeRoomModal = document.getElementById('close-room-modal');
    const openRoomModalBtn = document.getElementById('open-room-modal-btn');
    const roomModalTitle = document.getElementById('room-modal-title');
    const roomForm = document.getElementById('room-designer-form') as HTMLFormElement;

    const openRoomModal = () => {
      roomModal?.classList.remove('hidden');
      roomModal?.classList.add('flex');
    };

    const closeRoomModalFunc = () => {
      roomModal?.classList.add('hidden');
      roomModal?.classList.remove('flex');
    };

    closeRoomModal?.addEventListener('click', closeRoomModalFunc);

    openRoomModalBtn?.addEventListener('click', () => {
      document.getElementById('form-room-index')!.setAttribute('value', '');
      document.getElementById('form-room-original-name')!.setAttribute('value', '');
      (document.getElementById('form-room-name') as HTMLInputElement).value = '';
      (document.getElementById('form-room-icon') as HTMLInputElement).value = '';
      (document.getElementById('form-room-preview') as HTMLImageElement).src = '/noimage.jpg';
      if (roomModalTitle) roomModalTitle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-500"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg> New Room Design';
      openRoomModal();
    });

    // Live Room image preview binding
    document.getElementById('form-room-icon')?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.trim();
      (document.getElementById('form-room-preview') as HTMLImageElement).src = val || '/noimage.jpg';
    });

    // Edit Room Trigger
    document.querySelectorAll('.edit-room-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = (e.target as HTMLElement).closest('.admin-room-row') as HTMLElement | null;
        if (!row) return;

        const name = row.getAttribute('data-name') || '';
        const icon = row.getAttribute('data-icon') || '';
        const idx = row.getAttribute('data-index') || '';

        document.getElementById('form-room-index')!.setAttribute('value', idx);
        document.getElementById('form-room-original-name')!.setAttribute('value', name);
        (document.getElementById('form-room-name') as HTMLInputElement).value = name;
        (document.getElementById('form-room-icon') as HTMLInputElement).value = icon;
        (document.getElementById('form-room-preview') as HTMLImageElement).src = icon || '/noimage.jpg';

        if (roomModalTitle) roomModalTitle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit Room Layout';
        openRoomModal();
      });
    });

    // Save/Submit Room Designer Form
    roomForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const idxVal = document.getElementById('form-room-index')!.getAttribute('value');
      const originalName = document.getElementById('form-room-original-name')!.getAttribute('value') || '';
      const name = (document.getElementById('form-room-name') as HTMLInputElement).value.trim();
      const iconUrl = (document.getElementById('form-room-icon') as HTMLInputElement).value.trim();

      if (!name) return;

      const submitBtn = document.getElementById('room-submit-btn') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving Room...';

      // Load all rooms from HTML table dataset to assemble complete updated rooms array
      const allRows = Array.from(document.querySelectorAll('.admin-room-row'));
      let allRooms = allRows.map(row => ({
        name: row.getAttribute('data-name') || '',
        iconUrl: row.getAttribute('data-icon') || ''
      })).filter(r => r.name);

      if (idxVal !== null && idxVal !== '') {
        // Edit Mode
        const idx = parseInt(idxVal);
        if (!isNaN(idx) && allRooms[idx]) {
          allRooms[idx] = { name, iconUrl };
        } else {
          // Fallback by original name
          allRooms = allRooms.map(r => r.name === originalName ? { name, iconUrl } : r);
        }
      } else {
        // Create Mode
        allRooms.push({ name, iconUrl });
      }

      try {
        const res = await fetch('/api/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rooms: allRooms })
        });
        if (res.ok) {
          closeRoomModalFunc();
          window.location.reload();
        } else {
          alert('Failed to save rooms settings.');
        }
      } catch (err) {
        alert('Error saving room.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Room Layout';
      }
    });

    // Delete Room Handler
    document.querySelectorAll('.delete-room-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const row = (e.target as HTMLElement).closest('.admin-room-row') as HTMLElement | null;
        if (!row) return;
        const name = row.getAttribute('data-name') || '';

        if (!confirm(`Are you sure you want to permanently delete the room "${name}"? Products set to this ideal room will lose their room tags.`)) return;

        const allRows = Array.from(document.querySelectorAll('.admin-room-row'));
        const remainingRooms = allRows
          .map(r => ({
            name: r.getAttribute('data-name') || '',
            iconUrl: r.getAttribute('data-icon') || ''
          }))
          .filter(r => r.name && r.name !== name);

        try {
          const res = await fetch('/api/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rooms: remainingRooms })
          });
          if (res.ok) {
            row.remove();
            window.location.reload();
          } else {
            alert('Failed to delete room.');
          }
        } catch (err) {
          alert('Error deleting room.');
        }
      });
    });
  </script>
</DashboardLayout>
