---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PartnerForm from '../../components/forms/PartnerForm.astro';
import { query } from '../../lib/db';
import { Search, PlusCircle, Link, LayoutGrid, EyeOff, Settings2, Monitor, AlignJustify, Columns } from '@lucide/astro';

let partners: any[] = [];

// Default display config per page
const defaultPageConfig = { style: 'grid', max_visible: 12, grid_cols: 6, grid_rows: 2 };

let displayConfig: Record<string, any> = {
  home: { ...defaultPageConfig },
  dtl:  { ...defaultPageConfig, grid_cols: 5 },
  dgs:  { ...defaultPageConfig, grid_cols: 4 },
};

try {
  const [partnersRes, settingsRes] = await Promise.all([
    query('SELECT * FROM trusted_partners ORDER BY created_at DESC'),
    query(`SELECT key, value FROM settings WHERE key LIKE 'partners_display_%'`),
  ]);
  partners = partnersRes.rows;
  
  for (const row of settingsRes.rows) {
    const page = row.key.replace('partners_display_', '');
    try { displayConfig[page] = { ...defaultPageConfig, ...JSON.parse(row.value) }; } catch {}
  }
} catch (err: any) {
  console.warn('Database offline, mock partners:', err.message);
  partners = [
    { id: '1', name: 'Global Tech Corp', logo_url: 'https://via.placeholder.com/150', website_url: 'https://example.com', visibility_pages: ['home'], display_style: 'grid', status: 'active', division: 'dtl' }
  ];
}

const PAGES = [
  { key: 'home', label: 'Home Page', color: 'indigo' },
  { key: 'dtl',  label: 'DTL Division', color: 'emerald' },
  { key: 'dgs',  label: 'DGS Division', color: 'cyan' },
];
---


<DashboardLayout title="Trusted Partners Configurator" activeItem="partners">
  
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header Controls & Filters -->
    <div class="flex flex-col gap-4 border-b border-slate-200 pb-6">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <div class="relative flex-grow max-w-md">
          <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
          <input 
            type="text" 
            id="admin-search-partners"
            placeholder="Search partners by name..." 
            class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500/50"
          />
        </div>
        <button 
          type="button" 
          onclick="document.dispatchEvent(new CustomEvent('open-partner-modal'))"
          class="inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-lg text-xs font-bold transition-colors shadow-sm shrink-0"
        >
          <PlusCircle class="h-4 w-4" />
          Add Partner
        </button>
      </div>

      <!-- Advanced Filter & Sort panel -->
      <div class="flex flex-wrap items-center gap-4 bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
        <!-- Division Filter -->
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Division:</span>
          <select id="filter-division" class="bg-white border border-slate-200 rounded-lg text-xs px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-700 font-medium">
            <option value="all">All Divisions</option>
            <option value="dtl">DTL (Tech Line)</option>
            <option value="dgs">DGS (Global Solutions)</option>
            <option value="both">Both</option>
          </select>
        </div>

        <!-- Status Filter -->
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Status:</span>
          <select id="filter-status" class="bg-white border border-slate-200 rounded-lg text-xs px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-700 font-medium">
            <option value="all">All Statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="archived">Archived</option>
          </select>
        </div>

        <!-- Display Style Filter -->
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Style:</span>
          <select id="filter-style" class="bg-white border border-slate-200 rounded-lg text-xs px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-700 font-medium">
            <option value="all">All Styles</option>
            <option value="grid">Grid</option>
            <option value="list">List</option>
            <option value="scroll">Scroll</option>
          </select>
        </div>

        <!-- Sort By -->
        <div class="flex items-center gap-2 sm:ml-auto">
          <span class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Sort:</span>
          <select id="sort-partners" class="bg-white border border-slate-200 rounded-lg text-xs px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-700 font-medium">
            <option value="date-desc">Newest First</option>
            <option value="date-asc">Oldest First</option>
            <option value="name-asc">Name (A-Z)</option>
            <option value="name-desc">Name (Z-A)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Global Partners Display Configuration -->
    <div class="bg-white border border-slate-200 rounded-xl p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <Settings2 class="w-5 h-5 text-slate-500" />
          <div>
            <div class="text-sm font-bold text-slate-900">Global Partners Display</div>
            <div class="text-[11px] text-slate-500">Set the default display style for partners on each page.</div>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button id="save-partners-display" class="bg-indigo-600 text-white px-3 py-2 rounded-lg text-xs font-bold">Save</button>
        </div>
      </div>

      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3">
        {PAGES.map(pg => (
          <div class="p-3 border border-slate-100 rounded-lg flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <div class="text-sm font-semibold">{pg.label}</div>
              <div class="text-[11px] text-slate-400">{displayConfig[pg.key]?.style || 'grid'}</div>
            </div>
            <select class="partners-display-select bg-white border border-slate-200 rounded-md px-2 py-1 text-xs" data-page={pg.key}>
              <option value="grid">Grid</option>
              <option value="list">List</option>
              <option value="scroll">Scroll</option>
            </select>
          </div>
        ))}
      </div>
    </div>

    <!-- Data Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="partners-grid">
      {partners.map(p => (
        <div class="partner-card bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col" 
             data-name={p.name.toLowerCase()} 
             data-id={p.id}
             data-division={p.division || 'dtl'}
             data-status={p.status}
             data-style={p.display_style}
             data-date={new Date(p.created_at).getTime()}
        >
          
          <!-- Logo Display Area -->
          <div class="h-40 bg-slate-50 border-b border-slate-100 flex items-center justify-center p-6 relative group">
            <img src={p.logo_url} alt={p.name} class="max-h-full max-w-full object-contain" onerror="this.onerror=null; this.src='/noimage.jpg'" />
            
            {p.status === 'inactive' && (
              <div class="absolute inset-0 bg-white/70 backdrop-blur-[1px] flex items-center justify-center status-badge-inactive">
                <span class="bg-slate-800 text-white text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider flex items-center gap-1"><EyeOff class="w-3 h-3"/> Hidden</span>
              </div>
            )}

            {p.status === 'archived' && (
              <div class="absolute inset-0 bg-amber-50/70 backdrop-blur-[1px] flex items-center justify-center status-badge-archived">
                <span class="bg-amber-600 text-white text-[10px] font-bold px-2.5 py-1.5 rounded-lg uppercase tracking-wider flex items-center gap-1 shadow-sm">Archived</span>
              </div>
            )}
            
            <!-- Actions Overlay -->
            <div class="absolute inset-0 bg-slate-900/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 backdrop-blur-sm">
              <button class="edit-btn bg-white hover:bg-indigo-50 text-indigo-600 px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors shadow" data-partner={JSON.stringify(p)}>
                Configure
              </button>
              {p.status === 'archived' ? (
                <button class="archive-btn bg-emerald-500 hover:bg-emerald-600 text-white px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors shadow" data-action="restore">
                  Activate
                </button>
              ) : (
                <button class="archive-btn bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors shadow" data-action="archive">
                  Archive
                </button>
              )}
              <button class="delete-btn bg-red-500 hover:bg-red-600 text-white px-2.5 py-1.5 rounded-lg text-[10px] font-bold transition-colors shadow">
                Delete
              </button>
            </div>
          </div>
          
          <!-- Details -->
          <div class="p-4 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2">
                <h4 class="font-bold text-slate-900 truncate flex-grow" title={p.name}>{p.name}</h4>
                <span class={`text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-md shrink-0 shadow-2xs ${
                  p.division === 'dgs' ? 'bg-cyan-50 text-cyan-600 border border-cyan-200' :
                  p.division === 'both' ? 'bg-indigo-50 text-indigo-600 border border-indigo-200' :
                  'bg-emerald-50 text-emerald-600 border border-emerald-200'
                }`}>
                  {p.division === 'both' ? 'Both' : (p.division || 'dtl').toUpperCase()}
                </span>
              </div>
              <div class="flex items-center gap-1 mt-1.5 text-slate-500 hover:text-indigo-600 transition-colors">
                <Link class="w-3 h-3" />
                <a href={p.website_url || '#'} target="_blank" class="text-xs truncate w-full">{p.website_url || 'No website'}</a>
              </div>
            </div>
            
            <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-slate-500">
              <div class="flex items-center gap-1">
                <LayoutGrid class="w-3.5 h-3.5 text-slate-400" />
                <span class="text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded">{p.display_style}</span>
              </div>
              <div>
                Pages: <span class="text-slate-800">{Array.isArray(p.visibility_pages) ? p.visibility_pages.length : (JSON.parse(p.visibility_pages || '[]')).length}</span>
              </div>
            </div>
          </div>
        </div>
      ))}

      {partners.length === 0 && (
        <div class="col-span-full py-12 text-center text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-300">
          No trusted partners found. Click "Add Partner" to create one.
        </div>
      )}
    </div>
  </div>

  <PartnerForm />

  <script>
    // Search, Filter, Sort elements
    const searchInput = document.getElementById('admin-search-partners') as HTMLInputElement | null;
    const filterDivision = document.getElementById('filter-division') as HTMLSelectElement | null;
    const filterStatus = document.getElementById('filter-status') as HTMLSelectElement | null;
    const filterStyle = document.getElementById('filter-style') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('sort-partners') as HTMLSelectElement | null;
    const partnersGrid = document.getElementById('partners-grid');

    const updateFilters = () => {
      const query = searchInput?.value.toLowerCase() || '';
      const divFilter = filterDivision?.value || 'all';
      const statusFilter = filterStatus?.value || 'all';
      const styleFilter = filterStyle?.value || 'all';
      const cards = document.querySelectorAll('.partner-card');

      cards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        const division = card.getAttribute('data-division') || 'dtl';
        const status = card.getAttribute('data-status') || 'active';
        const style = card.getAttribute('data-style') || 'grid';

        const matchesQuery = name.includes(query);
        const matchesDivision = divFilter === 'all' || division === divFilter || division === 'both';
        const matchesStatus = statusFilter === 'all' || status === statusFilter;
        const matchesStyle = styleFilter === 'all' || style === styleFilter;

        if (matchesQuery && matchesDivision && matchesStatus && matchesStyle) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    };

    // Event listeners for inputs
    searchInput?.addEventListener('input', updateFilters);
    filterDivision?.addEventListener('change', updateFilters);
    filterStatus?.addEventListener('change', updateFilters);
    filterStyle?.addEventListener('change', updateFilters);

    // Sorting functionality
    sortSelect?.addEventListener('change', () => {
      if (!partnersGrid) return;
      const cardsArray = Array.from(document.querySelectorAll('.partner-card'));
      const sortBy = sortSelect.value;

      cardsArray.sort((a, b) => {
        if (sortBy === 'name-asc') {
          return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        } else if (sortBy === 'name-desc') {
          return (b.getAttribute('data-name') || '').localeCompare(a.getAttribute('data-name') || '');
        } else if (sortBy === 'date-asc') {
          return Number(a.getAttribute('data-date')) - Number(b.getAttribute('data-date'));
        } else { // date-desc
          return Number(b.getAttribute('data-date')) - Number(a.getAttribute('data-date'));
        }
      });

      // Re-append in new order
      cardsArray.forEach(card => partnersGrid.appendChild(card));
    });

    // Edit logic
    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const raw = (e.currentTarget as HTMLElement).getAttribute('data-partner');
        if (raw) {
          const partner = JSON.parse(raw);
          document.dispatchEvent(new CustomEvent('open-partner-modal', { detail: { partner } }));
        }
      });
    });

    // Archive / Activate logic
    document.querySelectorAll('.archive-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const action = (e.currentTarget as HTMLElement).getAttribute('data-action');
        const card = (e.currentTarget as HTMLElement).closest('.partner-card');
        const id = card?.getAttribute('data-id');
        if (!id || !card) return;

        const nextStatus = action === 'archive' ? 'archived' : 'active';
        
        try {
          // Fetch existing partner config from edit-btn to preserve other fields
          const editBtn = card.querySelector('.edit-btn');
          const raw = editBtn?.getAttribute('data-partner');
          if (!raw) return;
          const partner = JSON.parse(raw);
          partner.status = nextStatus;

          const res = await fetch(`/api/partners/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(partner)
          });

          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to update status.');
          }
        } catch (err) {
          alert('Error updating status.');
        }
      });
    });

    // Delete logic
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('Are you sure you want to permanently delete this partner?')) return;
        
        const card = (e.currentTarget as HTMLElement).closest('.partner-card');
        const id = card?.getAttribute('data-id');
        if (!id) return;

        const originalHtml = (e.currentTarget as HTMLElement).innerHTML;
        (e.currentTarget as HTMLElement).innerHTML = '...';

        try {
          const res = await fetch(`/api/partners/${id}`, { method: 'DELETE' });
          if (res.ok) {
            card?.remove();
          } else {
            alert('Failed to delete partner.');
            (e.currentTarget as HTMLElement).innerHTML = originalHtml;
          }
        } catch (err) {
          alert('Error deleting partner.');
          (e.currentTarget as HTMLElement).innerHTML = originalHtml;
        }
      });
    });

    // Global partners display save logic
    const saveBtn = document.getElementById('save-partners-display');
    saveBtn?.addEventListener('click', async () => {
      const selects = Array.from(document.querySelectorAll('.partners-display-select')) as HTMLSelectElement[];
      const payload: Record<string, any> = {};
      selects.forEach(s => {
        const page = s.getAttribute('data-page');
        if (!page) return;
        payload[`partners_display_${page}`] = JSON.stringify({ style: s.value });
      });

      try {
        saveBtn.setAttribute('disabled', 'true');
        saveBtn.innerHTML = 'Saving...';
        const res = await fetch('/api/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('Failed to save display settings');
        window.location.reload();
      } catch (err) {
        alert(err?.message || 'Error saving display settings');
      } finally {
        saveBtn.removeAttribute('disabled');
        saveBtn.innerHTML = 'Save';
      }
    });
  </script>
</DashboardLayout>
