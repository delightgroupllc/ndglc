---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { Inbox, CheckCircle, Search, AlertTriangle, AlertCircle, Phone, Mail } from '@lucide/astro';

let contacts: any[] = [];
let dbConnected = true;
let formMessage = '';
let formSuccess = false;

// Handle Resolve Actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();
    const contact_id = formData.get('contact_id')?.toString() || '';

    if (action === 'resolve' && contact_id) {
      await query(
        'UPDATE contacts SET is_resolved = TRUE WHERE id = $1',
        [contact_id]
      );
      formSuccess = true;
      formMessage = 'CRM Dispatch marked as resolved successfully.';
    }
  } catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}
---

<DashboardLayout title="CRM Contacts Inbox" activeItem="contacts">

  {formMessage && (
    <div class={`mb-8 p-4 rounded-xl border flex items-center justify-between ${
      formSuccess ? 'bg-emerald-500/5 border-emerald-500/20 text-emerald-600' : 'bg-rose-500/5 border-rose-500/20 text-rose-600'
    }`}>
      <span class="text-xs font-semibold">{formMessage}</span>
      <button onclick="this.parentElement.remove()" class="text-slate-500 hover:text-slate-900">&times;</button>
    </div>
  )}

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL is Offline</span>: Telemetry displays simulated inquiries from B2B frontends.
      </div>
    </div>
  )}

  <div class="space-y-6 p-6 lg:p-8">
    <!-- Filter bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
      <div class="relative flex-grow max-w-md">
        <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
        <input 
          type="text" 
          id="admin-search-contacts"
          placeholder="Filter customer dispatches..." 
          class="w-full rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 px-9 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-cyan-500/50"
        />
      </div>
    </div>

    <!-- Contacts list -->
    {contacts.length === 0 ? (
      <div class="text-center py-20 border border-dashed border-slate-200 rounded-2xl bg-slate-50">
        <Inbox class="h-12 w-12 text-slate-300 mx-auto" />
        <h3 class="text-lg font-bold text-slate-900 mt-4 font-display">Inboxes Empty</h3>
        <p class="text-xs text-slate-500 max-w-xs mx-auto mt-2">No CRM correspondence logs currently loaded in system registry.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-6" id="contacts-grid">
        {contacts.map(c => (
          <div class={`rounded-xl border p-5 md:p-6 shadow-sm backdrop-blur-md transition-all duration-200 contact-card ${
            c.is_resolved 
              ? 'border-slate-100 bg-slate-50/50 opacity-60' 
              : 'border-slate-200 bg-white hover:border-slate-300'
          }`} data-name={c.name.toLowerCase()} data-msg={c.message.toLowerCase()} data-email={c.email.toLowerCase()}>
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-100 pb-4 mb-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h4 class="text-sm font-bold text-slate-900">{c.name}</h4>
                  <span class={`rounded-full px-2 py-0.5 text-2xs font-semibold uppercase tracking-wider ${
                    c.inquiry_type === 'sales' 
                      ? 'bg-emerald-500/10 text-emerald-600' 
                      : c.inquiry_type === 'support' ? 'bg-cyan-500/10 text-cyan-600' : 'bg-slate-100 text-slate-600'
                  }`}>
                    {c.inquiry_type}
                  </span>
                </div>
                
                <div class="flex flex-wrap gap-4 text-xs text-slate-500">
                  <span class="flex items-center gap-1"><Mail class="h-3.5 w-3.5" /> {c.email}</span>
                  {c.phone && <span class="flex items-center gap-1"><Phone class="h-3.5 w-3.5" /> {c.phone}</span>}
                </div>
              </div>

              <div>
                {c.is_resolved ? (
                  <span class="rounded bg-slate-100 border border-slate-200 px-2.5 py-1 text-2xs font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
                    <CheckCircle class="h-3.5 w-3.5 text-slate-400" />
                    Resolved
                  </span>
                ) : (
                  <form method="POST">
                    <input type="hidden" name="action" value="resolve" />
                    <input type="hidden" name="contact_id" value={c.id} />
                    <button 
                      type="submit"
                      class="flex items-center gap-1.5 text-slate-950 bg-gradient-to-r from-cyan-400 to-blue-500 hover:from-cyan-300 hover:to-blue-400 px-4 py-1.5 rounded-lg text-2xs font-bold transition-all shadow-sm"
                    >
                      <CheckCircle class="h-3.5 w-3.5" />
                      Mark Resolved
                    </button>
                  </form>
                )}
              </div>
            </div>

            <p class="text-xs text-slate-700 leading-relaxed whitespace-pre-wrap">{c.message}</p>
            <div class="text-3xs text-slate-400 text-right mt-4">{new Date(c.created_at).toLocaleString()}</div>
          </div>
        ))}
      </div>
    )}
  </div>

  <script>
    const searchInput = document.getElementById('admin-search-contacts') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.contact-card');

    searchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      cards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        const msg = card.getAttribute('data-msg') || '';
        const email = card.getAttribute('data-email') || '';
        if (name.includes(query) || msg.includes(query) || email.includes(query)) {
          (card as HTMLElement).classList.remove('hidden');
        } else {
          (card as HTMLElement).classList.add('hidden');
        }
      });
    });
  </script>
</DashboardLayout>
