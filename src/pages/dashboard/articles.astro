    // ── TEMPLATE INSERTION (fixed: dangerouslyPasteHTML for full Quill editability) ────
    const templateSelector = document.getElementById('editor-template-selector') as HTMLSelectElement | null;
    templateSelector?.addEventListener('change', () => {
      const val = templateSelector.value;
      if (val && (templates as any)[val]) {
        const isEmpty = !quill.root.innerHTML || quill.root.innerHTML === '<p><br></p>';
        if (isEmpty || confirm('Insert this template? Your current content will be replaced.')) {
          // Use dangerouslyPasteHTML so Quill properly processes the HTML into its Delta model
          // This keeps the editor fully editable after insertion
          quill.enable();
          const htmlContent = (templates as any)[val];
          quill.clipboard.dangerouslyPasteHTML(htmlContent);
          quill.setSelection(quill.getLength(), 0); // move cursor to end
          updateLivePreview();
        }
        templateSelector.value = '';
      }
    });

    // ── BLOCK INSERTION (Tables, Grids, Callouts) via direct DOM injection ──────────────
    // Quill 1.x strips block-level elements (table, div) when using dangerouslyPasteHTML
    // with an index. We bypass this by directly injecting into quill.root's DOM,
    // then placing a cursor paragraph after the element.
    function insertBlockIntoEditor(htmlContent: string) {
      // Get caret position and find reference paragraph node
      const range = quill.getSelection(true);
      const [leaf] = range ? quill.getLeaf(range.index) : [null];
      const caretNode: HTMLElement | null = leaf ? (leaf.domNode as HTMLElement) : null;
      
      // Wrap HTML string into a temp container to get actual DOM nodes
      const temp = document.createElement('div');
      temp.innerHTML = htmlContent.trim();
      
      // Find the paragraph at/after cursor to insert before, or append to end
      let insertBefore: HTMLElement | null = null;
      if (caretNode) {
        // Walk up to find a direct child of quill.root
        let node: HTMLElement | null = caretNode;
        while (node && node.parentElement !== quill.root) {
          node = node.parentElement;
        }
        if (node && node.parentElement === quill.root) {
          insertBefore = node;
        }
      }
      
      // Move all child nodes from temp into quill.root
      const fragments = Array.from(temp.childNodes);
      fragments.forEach(node => {
        if (insertBefore) {
          quill.root.insertBefore(node.cloneNode(true), insertBefore);
        } else {
          quill.root.appendChild(node.cloneNode(true));
        }
      });
      
      updateLivePreview();
    }

