    // ── TAB SWITCHING (Edit / Preview) ──────────────────────────────
    const tabEdit = document.getElementById('tab-edit');
    const tabPreview = document.getElementById('tab-preview');
    const panelEdit = document.getElementById('panel-edit');
    const panelPreview = document.getElementById('panel-preview');

    const switchTab = (active: 'edit' | 'preview') => {
      if (active === 'edit') {
        panelEdit?.classList.remove('hidden');
        panelPreview?.classList.add('hidden');
        if (tabEdit) { tabEdit.className = 'tab-btn px-5 py-1.5 rounded-md text-xs font-bold bg-white text-slate-800 shadow-sm transition-all'; }
        if (tabPreview) { tabPreview.className = 'tab-btn px-5 py-1.5 rounded-md text-xs font-bold text-slate-500 hover:text-slate-700 transition-all'; }
      } else {
        panelEdit?.classList.add('hidden');
        panelPreview?.classList.remove('hidden');
        if (tabPreview) { tabPreview.className = 'tab-btn px-5 py-1.5 rounded-md text-xs font-bold bg-white text-slate-800 shadow-sm transition-all'; }
        if (tabEdit) { tabEdit.className = 'tab-btn px-5 py-1.5 rounded-md text-xs font-bold text-slate-500 hover:text-slate-700 transition-all'; }
        updateLivePreview();
      }
    };

    tabEdit?.addEventListener('click', () => switchTab('edit'));
    tabPreview?.addEventListener('click', () => switchTab('preview'));

    // ── SEARCH & FILTERING ──────────────────────────────────────
    const updateFilters = () => {
      const q = searchInput?.value.toLowerCase() || '';
      const divVal = filterDivision?.value || 'all';
      const typeVal = filterType?.value || 'all';
      const statusVal = filterStatus?.value || 'all';
      
      const cards = document.querySelectorAll('.article-card');
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const division = card.getAttribute('data-division') || 'both';
        const type = card.getAttribute('data-type') || '';
        const status = card.getAttribute('data-status') || '';

        const matchesSearch = title.includes(q);
        const matchesDiv = divVal === 'all' || division === divVal || division === 'both';
        const matchesType = typeVal === 'all' || type === typeVal;
        const matchesStatus = statusVal === 'all' || status === statusVal;

        if (matchesSearch && matchesDiv && matchesType && matchesStatus) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    };

    searchInput?.addEventListener('input', updateFilters);
    filterDivision?.addEventListener('change', updateFilters);
    filterType?.addEventListener('change', updateFilters);
    filterStatus?.addEventListener('change', updateFilters);

    // ── OPEN & CLOSE DRAWER ────────────────────────────────────
    const openDrawer = (article: any = null) => {
      sourceMode = false;
      if (sourceContainer) sourceContainer.classList.add('hidden');
      richContainer?.classList.remove('hidden');
      (document.querySelector('.ql-toolbar') as HTMLElement)?.classList.remove('hidden');
      if (sourceToggle) {
        sourceToggle.innerHTML = '💻 Source HTML';
        sourceToggle.className = 'bg-slate-100 border border-slate-200 rounded text-[10px] px-2.5 py-1 text-slate-700 font-bold hover:bg-slate-200 transition-colors focus:outline-none flex items-center gap-1 shadow-3xs';
      }

      drawer?.classList.remove('hidden');
      setTimeout(() => {
        drawerOverlay?.classList.remove('opacity-0', 'pointer-events-none');
        drawerPanel?.classList.remove('translate-x-full');
      }, 50);

      if (article) {
        drawerTitle!.textContent = 'Edit Announcement / Press';
        (document.getElementById('form-art-id') as HTMLInputElement).value = article.id;
        (document.getElementById('form-title') as HTMLInputElement).value = article.title;
        (document.getElementById('form-division') as HTMLSelectElement).value = article.division;
        (document.getElementById('form-type') as HTMLSelectElement).value = article.type;
        (document.getElementById('form-image') as HTMLInputElement).value = article.featured_image || '';
        (document.getElementById('form-status') as HTMLSelectElement).value = article.status;
        (document.getElementById('form-summary') as HTMLTextAreaElement).value = article.summary || '';
        
        // Populate footer fields
        (document.getElementById('form-show-footer') as HTMLInputElement).checked = article.show_footer ?? true;
        (document.getElementById('form-footer-brand') as HTMLInputElement).value = article.footer_brand || '';
        (document.getElementById('form-footer-address') as HTMLInputElement).value = article.footer_address || '';
        (document.getElementById('form-footer-cta') as HTMLInputElement).value = article.footer_cta || '';

        quill.root.innerHTML = article.content || '';
      } else {
        drawerTitle!.textContent = 'New Article Writer';
        form.reset();
        (document.getElementById('form-art-id') as HTMLInputElement).value = '';
        
        // Reset footer fields
        (document.getElementById('form-show-footer') as HTMLInputElement).checked = true;
        (document.getElementById('form-footer-brand') as HTMLInputElement).value = '';
        (document.getElementById('form-footer-address') as HTMLInputElement).value = '';
        (document.getElementById('form-footer-cta') as HTMLInputElement).value = '';

        quill.root.innerHTML = '';
      }

      // Initialize live preview content
      updateLivePreview();
    };

    const closeDrawer = () => {
      drawerOverlay?.classList.add('opacity-0', 'pointer-events-none');
      drawerPanel?.classList.add('translate-x-full');
      setTimeout(() => {
        drawer?.classList.add('hidden');
      }, 300);
    };

    newBtn?.addEventListener('click', () => openDrawer());
    closeBtn?.addEventListener('click', closeDrawer);
    cancelBtn?.addEventListener('click', closeDrawer);

    // ── EDIT & DELETE ACTION HANDLERS ──────────────────────────
    document.querySelectorAll('.edit-art-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const raw = (e.currentTarget as HTMLElement).getAttribute('data-article');
        if (raw) {
          const article = JSON.parse(raw);
          openDrawer(article);
        }
      });
    });

    document.querySelectorAll('.delete-art-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!confirm('Are you sure you want to permanently delete this article? This cannot be undone.')) return;
        const card = (e.currentTarget as HTMLElement).closest('.article-card') as HTMLElement | null;
        const id = card?.getAttribute('data-id');
        if (!id) return;

        try {
          const res = await fetch(`/api/articles/${id}`, { method: 'DELETE' });
          if (res.ok) {
            card.remove();
            if (window.showToast) window.showToast('Article deleted successfully');
            else window.location.reload();
          } else {
            alert('Failed to delete article');
          }
        } catch (err) {
          alert('Error deleting article');
        }
      });
    });

    // ── SUBMIT ARTICLE Form ────────────────────────────────────
    submitBtn?.addEventListener('click', async () => {
      const id = (document.getElementById('form-art-id') as HTMLInputElement).value;
      const title = (document.getElementById('form-title') as HTMLInputElement).value;
      const division = (document.getElementById('form-division') as HTMLSelectElement).value;
      const type = (document.getElementById('form-type') as HTMLSelectElement).value;
      const image = (document.getElementById('form-image') as HTMLInputElement).value;
      const status = (document.getElementById('form-status') as HTMLSelectElement).value;
      const summary = (document.getElementById('form-summary') as HTMLTextAreaElement).value;
      
      const show_footer = (document.getElementById('form-show-footer') as HTMLInputElement).checked;
      const footer_brand = (document.getElementById('form-footer-brand') as HTMLInputElement).value;
      const footer_address = (document.getElementById('form-footer-address') as HTMLInputElement).value;
      const footer_cta = (document.getElementById('form-footer-cta') as HTMLInputElement).value;

      const rawContent = sourceMode ? (sourceContainer?.value || '') : quill.root.innerHTML;
      const content = rawContent === '<p><br></p>' ? '' : rawContent;

      if (!title || !content) {
        alert('Please fill out the Title and Content fields.');
        return;
      }

      const payload = {
        title,
        division,
        type,
        featured_image: image,
        status,
        summary,
        content,
        show_footer,
        footer_brand,
        footer_address,
        footer_cta
      };

      const submitButton = submitBtn as HTMLButtonElement;
      submitButton.disabled = true;
      submitButton.textContent = 'Saving...';

      try {
        const url = id ? `/api/articles/${id}` : '/api/articles';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          closeDrawer();
          if (window.showToast) window.showToast('Article saved successfully');
          window.location.reload();
        } else {
          const errData = await res.json();
          alert(errData.error || 'Failed to save article');
        }
      } catch (err) {
        alert('Error saving article');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Save Announcement';
      }
    });
  </script>
