  </div>


  <script>
    // Register custom fonts in Quill
    const Font = (window as any).Quill.import('formats/font');
    Font.whitelist = ['inter', 'outfit', 'playfair', 'fira', 'roboto'];
    (window as any).Quill.register(Font, true);

    const quill = new (window as any).Quill('#editor-container', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ 'font': ['', 'inter', 'outfit', 'playfair', 'fira', 'roboto'] }],
          [{ 'header': [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          [{ 'color': [] }, { 'background': [] }],
          [{ 'align': [] }],
          [{ 'list': 'ordered'}, { 'list': 'bullet' }, { 'indent': '-1' }, { 'indent': '+1' }],
          ['blockquote', 'code-block'],
          ['link', 'image', 'video', 'clean']
        ]
      },
      formats: ['font', 'header','bold','italic','underline','strike','color','background',
                 'align','list','indent','blockquote','code-block','link','image','video']
    });


    // ── FLOATING UNIVERSAL ELEMENT STYLER TOOLBAR ──────────────────────────────────────
    // Creates a dynamic toolbar positioned above any clicked element (images, grid columns, tables, callout boxes)
    // inside the editor to configure alignments, opacity/transparency, background colors, and deletion.
    const imgToolbarEl = document.createElement('div');
    imgToolbarEl.id = 'img-toolbar';
    imgToolbarEl.style.display = 'none';
    document.body.appendChild(imgToolbarEl);

    let activeEl: HTMLElement | null = null;
    let activeType: 'image' | 'table' | 'grid' | 'callout' | 'other' = 'other';

    // Show toolbar when an element inside the Quill editor is clicked
    const editorContainer = document.getElementById('editor-container');
    editorContainer?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      
      // Prevent trigger when clicking toolbar itself
      if (imgToolbarEl.contains(target) || target === imgToolbarEl) return;

      // Identify active element and type
      let found: { el: HTMLElement, type: typeof activeType } | null = null;
      
      if (target.tagName === 'IMG') {
        found = { el: target, type: 'image' };
      } else {
        const callout = target.closest('.ql-callout-gold, .ql-callout-green') as HTMLElement | null;
        if (callout) {
          found = { el: callout, type: 'callout' };
        } else {
          const grid = target.closest('.ql-grid-2, .ql-grid-3') as HTMLElement | null;
          if (grid) {
            found = { el: grid, type: 'grid' };
          } else {
            const td = target.closest('td, th') as HTMLElement | null;
            if (td) {
              found = { el: td, type: 'table' };
            }
          }
        }
      }

      if (found) {
        activeEl = found.el;
        activeType = found.type;
        
        // Dynamically populate toolbar buttons
        let html = '';
        const currentOpacity = activeEl.style.opacity || '1';
        const currentWidth = activeEl.style.width || '';

        if (activeType === 'image') {
          const currentClass = activeEl.className || '';
          html = `
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">ALIGN</span>
            <button data-action="align" data-val="left" class="${currentClass.includes('ql-img-left') ? 'active' : ''}">Left</button>
            <button data-action="align" data-val="center" class="${currentClass.includes('ql-img-center') ? 'active' : ''}">Center</button>
            <button data-action="align" data-val="right" class="${currentClass.includes('ql-img-right') ? 'active' : ''}">Right</button>
            <button data-action="align" data-val="none" class="${(!currentClass.includes('ql-img-left') && !currentClass.includes('ql-img-right') && !currentClass.includes('ql-img-center')) ? 'active' : ''}">None</button>
            <div class="sep"></div>
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">WIDTH</span>
            <button data-action="width" data-val="25%" class="${currentWidth === '25%' ? 'active' : ''}">25%</button>
            <button data-action="width" data-val="50%" class="${currentWidth === '50%' ? 'active' : ''}">50%</button>
            <button data-action="width" data-val="75%" class="${currentWidth === '75%' ? 'active' : ''}">75%</button>
            <button data-action="width" data-val="100%" class="${(currentWidth === '100%' || !currentWidth) ? 'active' : ''}">Full</button>
            <div class="sep"></div>
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">OPACITY</span>
            <button data-action="opacity" data-val="1" class="${currentOpacity === '1' ? 'active' : ''}">100%</button>
            <button data-action="opacity" data-val="0.8" class="${currentOpacity === '0.8' ? 'active' : ''}">80%</button>
            <button data-action="opacity" data-val="0.6" class="${currentOpacity === '0.6' ? 'active' : ''}">60%</button>
            <button data-action="opacity" data-val="0.4" class="${currentOpacity === '0.4' ? 'active' : ''}">40%</button>
            <div class="sep"></div>
            <button data-action="delete" style="color:#f87171">&times; Delete</button>
          `;
        } else if (activeType === 'callout') {
          const isGold = activeEl.classList.contains('ql-callout-gold');
          html = `
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">THEME</span>
            <button data-action="theme" data-val="gold" class="${isGold ? 'active' : ''}">Gold Box</button>
            <button data-action="theme" data-val="green" class="${!isGold ? 'active' : ''}">Green Box</button>
            <div class="sep"></div>
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">OPACITY</span>
            <button data-action="opacity" data-val="1" class="${currentOpacity === '1' ? 'active' : ''}">100%</button>
            <button data-action="opacity" data-val="0.8" class="${currentOpacity === '0.8' ? 'active' : ''}">80%</button>
            <button data-action="opacity" data-val="0.6" class="${currentOpacity === '0.6' ? 'active' : ''}">60%</button>
            <button data-action="opacity" data-val="0.4" class="${currentOpacity === '0.4' ? 'active' : ''}">40%</button>
            <div class="sep"></div>
            <button data-action="delete" style="color:#f87171">&times; Delete</button>
          `;
        } else if (activeType === 'grid') {
          html = `
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">GRID OPACITY</span>
            <button data-action="opacity" data-val="1" class="${currentOpacity === '1' ? 'active' : ''}">100%</button>
            <button data-action="opacity" data-val="0.8" class="${currentOpacity === '0.8' ? 'active' : ''}">80%</button>
            <button data-action="opacity" data-val="0.6" class="${currentOpacity === '0.6' ? 'active' : ''}">60%</button>
            <button data-action="opacity" data-val="0.4" class="${currentOpacity === '0.4' ? 'active' : ''}">40%</button>
            <div class="sep"></div>
            <button data-action="delete" style="color:#f87171">&times; Delete</button>
          `;
        } else if (activeType === 'table') {
          const currentBg = activeEl.style.backgroundColor || '';
          html = `
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">CELL BG</span>
            <button data-action="cell-bg" data-val="#ffffff" class="${(!currentBg || currentBg.includes('255')) ? 'active' : ''}">White</button>
            <button data-action="cell-bg" data-val="#f8fafc" class="${currentBg.includes('248') ? 'active' : ''}">Zebra</button>
            <button data-action="cell-bg" data-val="#fcf8f2" class="${currentBg.includes('252') ? 'active' : ''}">Gold</button>
            <button data-action="cell-bg" data-val="#f0faf2" class="${currentBg.includes('240') ? 'active' : ''}">Green</button>
            <div class="sep"></div>
            <span style="color:#94a3b8;font-size:9px;font-weight:800;letter-spacing:0.05em;margin-right:2px;">OPACITY</span>
            <button data-action="opacity" data-val="1" class="${currentOpacity === '1' ? 'active' : ''}">100%</button>
            <button data-action="opacity" data-val="0.8" class="${currentOpacity === '0.8' ? 'active' : ''}">80%</button>
            <button data-action="opacity" data-val="0.6" class="${currentOpacity === '0.6' ? 'active' : ''}">60%</button>
            <button data-action="opacity" data-val="0.4" class="${currentOpacity === '0.4' ? 'active' : ''}">40%</button>
            <div class="sep"></div>
            <button data-action="delete-table" style="color:#f87171">Del Table</button>
          `;
        }

        imgToolbarEl.innerHTML = html;

        // Position toolbar above the element
        const rect = activeEl.getBoundingClientRect();
        imgToolbarEl.style.display = 'flex';
        imgToolbarEl.style.top  = `${rect.top  + window.scrollY - 44}px`;
        imgToolbarEl.style.left = `${Math.max(8, rect.left + window.scrollX)}px`;
        e.stopPropagation();
      } else {
        imgToolbarEl.style.display = 'none';
        activeEl = null;
      }
    });

    // Handle toolbar button clicks
    imgToolbarEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button') as HTMLButtonElement | null;
      if (!btn || !activeEl) return;

      const action = btn.dataset.action;
      const val = btn.dataset.val;

      if (action === 'delete') {
        activeEl.remove();
        imgToolbarEl.style.display = 'none';
        activeEl = null;
        updateLivePreview();
        return;
      }

      if (action === 'delete-table') {
        const tbl = activeEl.closest('table');
        if (tbl) tbl.remove();
        imgToolbarEl.style.display = 'none';
        activeEl = null;
        updateLivePreview();
        return;
      }

      if (action === 'align' && activeType === 'image') {
        activeEl.classList.remove('ql-img-left', 'ql-img-right', 'ql-img-center');
        if (val === 'left') {
          activeEl.classList.add('ql-img-left');
          activeEl.style.cssText += 'float:left;margin-right:1rem;margin-bottom:0.5rem;display:inline;';
        } else if (val === 'right') {
          activeEl.classList.add('ql-img-right');
          activeEl.style.cssText += 'float:right;margin-left:1rem;margin-bottom:0.5rem;display:inline;';
        } else if (val === 'center') {
          activeEl.classList.add('ql-img-center');
          activeEl.style.cssText += 'float:none;display:block;margin:0.75rem auto;';
        } else {
          activeEl.style.float = 'none';
          activeEl.style.margin = '0.5rem 0';
          activeEl.style.display = 'block';
        }
      }

      if (action === 'width' && activeType === 'image') {
        activeEl.style.width = val || '';
        activeEl.style.height = 'auto';
      }

      if (action === 'opacity') {
        activeEl.style.opacity = val || '';
      }

      if (action === 'theme' && activeType === 'callout') {
        if (val === 'gold') {
          activeEl.classList.remove('ql-callout-green');
          activeEl.classList.add('ql-callout-gold');
        } else {
          activeEl.classList.remove('ql-callout-gold');
          activeEl.classList.add('ql-callout-green');
        }
      }

      if (action === 'cell-bg' && activeType === 'table') {
        activeEl.style.backgroundColor = val || '';
      }

      // Re-trigger render to sync button states
      if (activeEl) {
        const rect = activeEl.getBoundingClientRect();
        imgToolbarEl.style.top  = `${rect.top  + window.scrollY - 44}px`;
        imgToolbarEl.style.left = `${Math.max(8, rect.left + window.scrollX)}px`;
        
        // Re-run population to update active classes
        const clickEvent = new MouseEvent('click', { bubbles: true });
        activeEl.dispatchEvent(clickEvent);
      }

      updateLivePreview();
    });

    // Hide toolbar when clicking outside editor
    document.addEventListener('click', (e) => {
      if (!editorContainer?.contains(e.target as Node) && e.target !== imgToolbarEl && !imgToolbarEl.contains(e.target as Node)) {
        imgToolbarEl.style.display = 'none';
        activeEl = null;
      }
    });

    let sourceMode = false;
    const sourceToggle = document.getElementById('toggle-editor-source');
    const sourceContainer = document.getElementById('source-editor-container') as HTMLTextAreaElement | null;
    const richContainer = document.getElementById('editor-container');

    const searchInput = document.getElementById('search-articles') as HTMLInputElement | null;
    const filterDivision = document.getElementById('filter-division') as HTMLSelectElement | null;
    const filterType = document.getElementById('filter-type') as HTMLSelectElement | null;
    const filterStatus = document.getElementById('filter-status') as HTMLSelectElement | null;
    const newBtn = document.getElementById('new-article-btn');
    const drawer = document.getElementById('article-drawer');
    const drawerOverlay = document.getElementById('drawer-overlay');
    const drawerPanel = document.getElementById('drawer-panel');
    const closeBtn = document.getElementById('close-drawer');
    const cancelBtn = document.getElementById('cancel-btn');
    const submitBtn = document.getElementById('submit-art-btn');
    
    const form = document.getElementById('article-form') as HTMLFormElement;
    const drawerTitle = document.getElementById('drawer-title');

    sourceToggle?.addEventListener('click', () => {
      sourceMode = !sourceMode;
      if (sourceMode) {
        // Switch to HTML source code view
        const html = quill.root.innerHTML;
        if (sourceContainer) {
          sourceContainer.value = html === '<p><br></p>' ? '' : html;
