              <!-- Browser Window Frame (Takes full remaining space) -->
              <div class="flex flex-col rounded-xl border border-slate-300 shadow-xl overflow-hidden bg-white flex-grow min-h-[500px]">

                <!-- Browser Chrome Bar -->
                <div class="bg-slate-100 border-b border-slate-200 px-3 py-2 flex items-center gap-2 shrink-0">
                  <div class="flex items-center gap-1.5">
                    <div class="w-2.5 h-2.5 rounded-full bg-red-400/80"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></div>
                  </div>
                  <div class="flex-grow bg-white rounded border border-slate-200 px-3 py-1 flex items-center gap-2">
                    <svg class="w-2.5 h-2.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                    <span class="text-[10px] text-slate-400 font-mono truncate">delightgroup.ae/news/your-article-slug</span>
                  </div>
