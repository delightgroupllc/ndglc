---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { Search, PlusCircle, Calendar, Tag, ShieldCheck, Trash2, Eye, Edit3, Newspaper, Radio, Settings } from 'lucide-astro';

// Run self-healing schema migrations for customizable corporate footer fields
try {
  await query('ALTER TABLE articles ADD COLUMN IF NOT EXISTS show_footer BOOLEAN DEFAULT TRUE');
  await query('ALTER TABLE articles ADD COLUMN IF NOT EXISTS footer_brand TEXT');
  await query('ALTER TABLE articles ADD COLUMN IF NOT EXISTS footer_address TEXT');
  await query('ALTER TABLE articles ADD COLUMN IF NOT EXISTS footer_cta TEXT');
} catch (e: any) {
  console.warn('Migration for articles footer columns failed or already exists:', e.message);
}

let articles: any[] = [];
try {
  const res = await query('SELECT * FROM articles ORDER BY created_at DESC');
  articles = res.rows;
} catch (e: any) {
  console.warn('DB offline or articles missing:', e?.message || e);
}

// Compute statistics
const publishedCount = articles.filter(a => a.status === 'published').length;
const draftCount = articles.filter(a => a.status === 'draft').length;
const totalCount = articles.length;
---

<DashboardLayout title="Articles & Press CMS" activeItem="articles">
  <!-- Load Quill Rich Text Editor CDN -->
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@400;600;800&family=Outfit:wght@400;700;900&family=Fira+Code:wght@400;700&family=Roboto:wght@400;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.quilljs.com/1.3.6/quill.js" is:inline></script>

  <!-- Full-Site Article Preview Styles + Quill Editor Styles -->
  <style is:global>
    /* Custom fonts inside Quill and Preview */
    .ql-font-inter, .article-body-content .ql-font-inter { font-family: 'Inter', sans-serif !important; }
    .ql-font-outfit, .article-body-content .ql-font-outfit { font-family: 'Outfit', sans-serif !important; }
    .ql-font-playfair, .article-body-content .ql-font-playfair { font-family: 'Playfair Display', serif !important; }
    .ql-font-fira, .article-body-content .ql-font-fira { font-family: 'Fira Code', monospace !important; }
    .ql-font-roboto, .article-body-content .ql-font-roboto { font-family: 'Roboto', sans-serif !important; }

    /* Custom Responsive Grid and Box Layouts */
    .ql-grid-2, .article-body-content .ql-grid-2 {
      display: grid !important;
      grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
      gap: 1.5rem !important;
      margin: 1.25rem 0 !important;
    }
    @media (min-width: 768px) {
      .ql-grid-2, .article-body-content .ql-grid-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      }
    }
    .ql-grid-3, .article-body-content .ql-grid-3 {
      display: grid !important;
      grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
      gap: 1.25rem !important;
      margin: 1.25rem 0 !important;
    }
    @media (min-width: 768px) {
      .ql-grid-3, .article-body-content .ql-grid-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      }
    }

    /* Callout Boxes Styles */
    .ql-callout-gold, .article-body-content .ql-callout-gold {
      background: linear-gradient(135deg, #fdfbf7, #fcf8f2) !important;
      border-left: 4px solid #BE854C !important;
      border-radius: 8px !important;
      padding: 1rem 1.25rem !important;
      margin: 1.25rem 0 !important;
      box-shadow: 0 4px 12px rgba(190, 133, 76, 0.04) !important;
    }
    .ql-callout-green, .article-body-content .ql-callout-green {
      background: linear-gradient(135deg, #f6fcf8, #f0faf2) !important;
      border-left: 4px solid #10b981 !important;
      border-radius: 8px !important;
      padding: 1rem 1.25rem !important;
      margin: 1.25rem 0 !important;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.04) !important;
    }

    /* Quill Editor Outlines and Helper Cues for Grid Divisions & Tables */
    .ql-editor .ql-grid-2, .ql-editor .ql-grid-3 {
      border: 1px dotted rgba(99, 102, 241, 0.4) !important;
      padding: 0.5rem !important;
      border-radius: 8px !important;
      background: rgba(99, 102, 241, 0.01) !important;
    }
    .ql-editor .ql-grid-2 > div, .ql-editor .ql-grid-3 > div {
      border: 1px dashed rgba(99, 102, 241, 0.25) !important;
      padding: 0.5rem !important;
      border-radius: 6px !important;
      background: rgba(255, 255, 255, 0.9) !important;
    }
    .ql-editor .ql-grid-2 > div:hover, .ql-editor .ql-grid-3 > div:hover {
      border-color: rgba(99, 102, 241, 0.5) !important;
    }
    .ql-editor .ql-callout-gold, .ql-editor .ql-callout-green {
      outline: 1px dashed rgba(190, 133, 76, 0.2) !important;
      cursor: pointer;
    }
    .ql-editor table, .article-body-content table {
      border-collapse: collapse !important;
      width: 100% !important;
      margin: 1.25rem 0 !important;
    }
    .ql-editor td, .ql-editor th, .article-body-content td, .article-body-content th {
      border: 1px solid #cbd5e1 !important;
      padding: 10px !important;
      min-width: 40px !important;
    }
    .ql-editor th, .article-body-content th {
      background-color: #f1f5f9;
      font-weight: bold;
    }

    /* ── ARTICLE BODY CONTENT STYLES (mirrors /news/[slug].astro) ─── */
    .article-body-content h2 {
      font-weight: 700 !important;
      color: #0f172a !important;
      margin-top: 1rem !important;
      margin-bottom: 0.4rem !important;
      line-height: 1.3 !important;
    }
    .article-body-content p {
      font-family: 'Inter', sans-serif;
      font-size: 0.78rem !important;
      line-height: 1.7 !important;
      color: #334155 !important;
      margin-bottom: 0.75rem !important;
    }
    .article-body-content img {
      max-width: 100% !important;
      height: auto !important;
      border-radius: 0.6rem !important;
      box-shadow: 0 6px 20px -4px rgba(0,0,0,0.1) !important;
      border: 1px solid #f1f5f9 !important;
    }
    .article-body-content ul {
      list-style-type: none !important;
      padding-left: 0 !important;
      margin-bottom: 0.75rem !important;
    }
    .article-body-content ol {
      list-style-type: decimal !important;
      padding-left: 1.2rem !important;
      margin-bottom: 0.75rem !important;
    }
    .article-body-content a {
      color: #2563eb !important;
      text-decoration: underline !important;
    }
    .article-body-content hr {
      border: 0 !important;
      border-top: 1px solid #e2e8f0 !important;
      margin: 1rem 0 !important;
    }
    .article-body-content blockquote {
      border-left: 3px solid #BE854C !important;
      padding-left: 0.75rem !important;
      font-style: italic !important;
      color: #475569 !important;
      margin: 1rem 0 !important;
    }
    /* Quill editor image style */
    .ql-editor img {
      max-width: 100%;
      height: auto;
      border-radius: 0.375rem;
      margin: 0.5rem 0;
      box-shadow: 0 2px 4px rgb(0 0 0 / 0.05);
      cursor: pointer;
    }
    /* Image alignment helpers for Quill output */
    .ql-editor img.ql-img-left  { float: left;  margin-right: 1rem; margin-bottom: 0.5rem; }
    .ql-editor img.ql-img-right { float: right; margin-left:  1rem; margin-bottom: 0.5rem; }
    .ql-editor img.ql-img-center { display: block; float: none; margin: 0.75rem auto; }
    /* Floating image toolbar */
    #img-toolbar {
      position: absolute;
      z-index: 9999;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 5px 8px;
      display: flex;
      align-items: center;
      gap: 4px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
      pointer-events: auto;
    }
    #img-toolbar button {
      background: transparent;
      border: 1px solid transparent;
      color: #cbd5e1;
      border-radius: 5px;
      padding: 3px 7px;
      font-size: 10px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }
    #img-toolbar button:hover, #img-toolbar button.active {
      background: #334155;
      border-color: #475569;
      color: #f1f5f9;
    }
    #img-toolbar .sep { width: 1px; height: 16px; background: #334155; margin: 0 2px; }
  </style>

  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header -->
    <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-200 pb-6">
      <div>
        <h1 class="text-xl font-bold">Articles & Press Releases</h1>
        <p class="text-sm text-slate-500">Create, edit, and publish press releases, company events, or project blogs for DTL and DGS.</p>
      </div>
      
      <button 
        type="button" 
        id="new-article-btn"
        class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-lg text-xs font-bold transition-colors shadow-sm shrink-0"
      >
        <PlusCircle class="h-4 w-4" />
        Compose Article
      </button>
    </header>

    <!-- Stats Quick Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-center gap-4">
        <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-655 flex items-center justify-center">
          <Newspaper class="h-5 w-5" />
        </div>
        <div>
          <p class="text-xs text-slate-500 font-semibold uppercase">Total Articles</p>
          <p class="text-2xl font-bold text-slate-900">{totalCount}</p>
        </div>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-center gap-4">
        <div class="h-10 w-10 rounded-lg bg-emerald-50 text-emerald-650 flex items-center justify-center">
          <Radio class="h-5 w-5" />
        </div>
        <div>
          <p class="text-xs text-slate-500 font-semibold uppercase">Published Live</p>
          <p class="text-2xl font-bold text-slate-900">{publishedCount}</p>
        </div>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-center gap-4">
        <div class="h-10 w-10 rounded-lg bg-amber-50 text-amber-650 flex items-center justify-center">
          <Settings class="h-5 w-5" />
        </div>
        <div>
          <p class="text-xs text-slate-500 font-semibold uppercase">Drafts & Scheduled</p>
          <p class="text-2xl font-bold text-slate-900">{draftCount}</p>
        </div>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="flex flex-col gap-3 md:flex-row items-stretch md:items-center justify-between bg-slate-50 p-4 rounded-xl border border-slate-200/80">
      <div class="relative flex-grow max-w-md">
        <Search class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
        <input 
          type="text" 
          id="search-articles" 
          placeholder="Search articles by title..." 
          class="w-full rounded-lg border border-slate-200 bg-white px-9 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-indigo-500/50"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <select id="filter-division" class="bg-white border border-slate-200 rounded-lg text-xs px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-700 font-medium">
          <option value="all">All Divisions</option>
          <option value="dtl">DTL (Technical Lighting)</option>
          <option value="dgs">DGS (Greenscapes)</option>
          <option value="both">Both Divisions</option>
        </select>

        <select id="filter-type" class="bg-white border border-slate-200 rounded-lg text-xs px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-700 font-medium">
          <option value="all">All Types</option>
          <option value="press_release">Press Releases</option>
          <option value="event">Company Events</option>
          <option value="project_blog">Project Blogs</option>
        </select>

        <select id="filter-status" class="bg-white border border-slate-200 rounded-lg text-xs px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-700 font-medium">
          <option value="all">All Statuses</option>
          <option value="published">Published</option>
          <option value="draft">Draft</option>
          <option value="archived">Archived</option>
        </select>
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="articles-grid">
      {articles.map((art) => (
        <div 
          class="article-card bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
          data-title={art.title.toLowerCase()}
          data-division={art.division}
          data-type={art.type}
          data-status={art.status}
          data-id={art.id}
        >
          <div>
            <!-- Banner Image -->
            <div class="h-40 bg-slate-50 border-b border-slate-100 relative overflow-hidden flex items-center justify-center">
              {art.featured_image ? (
                <img src={art.featured_image} alt={art.title} class="w-full h-full object-cover" onerror="this.style.display='none'" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-indigo-50 to-indigo-100 flex items-center justify-center text-indigo-400">
                  <Newspaper class="h-12 w-12 opacity-40" />
                </div>
              )}
              
              <!-- Badges -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                <span class={`text-[9px] font-extrabold uppercase px-2 py-0.5 rounded shadow-sm text-white ${
                  art.status === 'published' ? 'bg-emerald-600' :
                  art.status === 'archived' ? 'bg-slate-700' :
                  'bg-amber-600'
                }`}>
                  {art.status}
                </span>
                
                <span class={`text-[9px] font-extrabold uppercase px-2 py-0.5 rounded shadow-sm text-white ${
                  art.division === 'dgs' ? 'bg-cyan-600' :
                  art.division === 'both' ? 'bg-indigo-650' :
                  'bg-emerald-650'
                }`}>
                  {art.division.toUpperCase()}
                </span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-4 space-y-2 text-left">
              <span class="text-[10px] font-black uppercase text-indigo-600 tracking-wider flex items-center gap-1">
                <Tag class="w-3 h-3" />
                {art.type.replace('_', ' ')}
              </span>
              <h3 class="font-bold text-slate-900 leading-snug line-clamp-2" title={art.title}>
                {art.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed line-clamp-3">
                {art.summary || 'No summary overview provided.'}
              </p>
            </div>
          </div>

          <!-- Bottom Footer Details & Actions -->
          <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-1 text-[10px] text-slate-550 font-semibold">
              <Calendar class="w-3.5 h-3.5" />
              <span>
                {art.published_at ? new Date(art.published_at).toLocaleDateString() : 'Draft'}
              </span>
            </div>
            
            <div class="flex items-center gap-1.5">
              <!-- View (opens live article page) -->
              <a 
                href={`/news/${art.slug}`}
                target="_blank"
                rel="noopener"
                class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 px-2 py-1 rounded text-[10px] font-bold transition-colors flex items-center gap-1 shadow-sm"
              >
                <Eye class="w-3 h-3" /> View
              </a>
              <!-- Edit -->
              <button 
                type="button" 
                class="edit-art-btn bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 px-2 py-1 rounded text-[10px] font-bold transition-colors flex items-center gap-1 shadow-sm"
                data-article={JSON.stringify(art)}
              >
                <Edit3 class="w-3 h-3" /> Edit
              </button>
              <!-- Delete -->
              <button 
                type="button" 
                class="delete-art-btn bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 px-2 py-1 rounded text-[10px] font-bold transition-colors flex items-center gap-1 shadow-sm"
                data-id={art.id}
              >
                <Trash2 class="w-3 h-3" /> Delete
              </button>
            </div>
          </div>
        </div>
      ))}

      {articles.length === 0 && (
        <div class="col-span-full py-16 text-center text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-350">
          No articles written yet. Click "Compose Article" to write your first press release!
        </div>
      )}
    </div>
  </div>

  <!-- ARTICLE COMPOSE DRAWER DIALOG MODAL (Ultra-Wide Split Screen Editor Panel) -->
  <div 
    id="article-drawer" 
    class="fixed inset-0 z-50 overflow-hidden hidden" 
    aria-labelledby="slide-over-title" 
    role="dialog" 
    aria-modal="true"
  >
    <div class="absolute inset-0 overflow-hidden">
      <!-- Background Overlay -->
      <div id="drawer-overlay" class="absolute inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity opacity-0 pointer-events-none duration-300"></div>

      <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full">
        <!-- Panel (Width optimized to max-w-6xl for side-by-side editing) -->
        <div 
          id="drawer-panel"
          class="pointer-events-auto w-screen max-w-full transform translate-x-full transition-transform duration-300 bg-white shadow-2xl flex flex-col justify-between"
        >
          
          <!-- Drawer Header -->
          <div class="bg-indigo-900 px-6 py-5 sm:px-6 flex items-center justify-between text-white shrink-0">
            <div>
              <h2 class="text-base font-bold font-display" id="drawer-title">New Article Writer</h2>
              <p class="text-[11px] text-indigo-200">Compose and catalog press releases, corporate news, or blogs.</p>
            </div>
            <button 
              type="button" 
              id="close-drawer"
              class="text-indigo-200 hover:text-white font-bold text-2xl"
            >
              &times;
            </button>
          </div>

          <!-- Drawer Form Body (Full-Width Side-by-Side Split Workspace) -->
          <div class="flex-grow overflow-hidden flex flex-col lg:flex-row bg-slate-100">
            
            <!-- LEFT COLUMN: Editor & Form Metadata (55% width) -->
            <div class="w-full lg:w-[55%] flex flex-col h-full bg-white border-r border-slate-200 overflow-y-auto p-6 space-y-6">
              
              <!-- Form Metadata Grid -->
              <form id="article-form" class="space-y-4 text-left shrink-0">
                <input type="hidden" name="id" id="form-art-id" />
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <!-- Row 1 -->
                  <div class="md:col-span-2">
                    <label class="text-xs font-bold text-slate-700">Article Title</label>
                    <input 
                      type="text" 
                      name="title" 
                      id="form-title"
                      required
                      placeholder="e.g. Landmark Landscaping Contract Awarded"
                      class="w-full mt-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 font-semibold text-slate-800" 
                    />
                  </div>
                  <div>
                    <label class="text-xs font-bold text-slate-700">Scope Division</label>
                    <select 
                      name="division" 
                      id="form-division"
                      class="w-full mt-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 font-semibold text-slate-700 cursor-pointer"
                    >
                      <option value="both">Both DTL & DGS</option>
                      <option value="dtl">DTL (Technical Lighting)</option>
                      <option value="dgs">DGS (Greenscapes)</option>
                    </select>
                  </div>

                  <!-- Row 2 -->
                  <div class="md:col-span-2">
                    <div class="flex items-center justify-between">
                      <label class="text-xs font-bold text-slate-700">Featured Image URL</label>
                      <button 
                        type="button" 
                        onclick="window.openResourcePicker('form-image', 'preview-featured-image')" 
                        class="text-[9px] font-black text-emerald-600 hover:text-emerald-700 bg-emerald-50 hover:bg-emerald-100/70 border border-emerald-250 rounded px-2 py-0.5 uppercase tracking-wider transition-colors shrink-0 cursor-pointer"
                      >
                        Browse Resources
                      </button>
                    </div>
                    <input 
                      type="text" 
                      name="featured_image" 
                      id="form-image"
                      placeholder="https://images.unsplash.com/photo-..."
                      class="w-full mt-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-650" 
                    />
                  </div>
                  <div>
                    <label class="text-xs font-bold text-slate-700">Content Type</label>
                    <select 
                      name="type" 
                      id="form-type"
                      class="w-full mt-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 font-semibold text-slate-700 cursor-pointer"
                    >
                      <option value="press_release">Press Release</option>
                      <option value="event">Corporate Event</option>
                      <option value="project_blog">Project Case Blog</option>
                    </select>
                  </div>

                  <!-- Row 3 -->
                  <div class="md:col-span-2">
                    <label class="text-xs font-bold text-slate-700">Summary Overview (Synopsis)</label>
                    <textarea 
                      name="summary" 
                      id="form-summary"
                      rows="2"
                      placeholder="Provide a brief summary overview explaining this announcement..."
                      class="w-full mt-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-600 resize-none"
                    ></textarea>
                  </div>
                  <div>
                    <label class="text-xs font-bold text-slate-700">Publish State Status</label>
                    <select 
                      name="status" 
                      id="form-status"
                      class="w-full mt-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 font-semibold text-slate-700 cursor-pointer"
                    >
                      <option value="draft">Draft (Saved in DB only)</option>
                      <option value="published">Published (Visible immediately on active portals)</option>
                    </select>
                  </div>
                </div>

                <!-- Corporate Signature Footer Settings Block -->
                <div class="mt-4 border-t border-slate-250 pt-4 space-y-3 shrink-0">
                  <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                      💼 Corporate Footer Signature Card
                    </label>
                    <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded px-2 py-0.5 shadow-3xs">
                      <input type="checkbox" name="show_footer" id="form-show-footer" checked class="rounded border-slate-350 text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5 cursor-pointer" />
