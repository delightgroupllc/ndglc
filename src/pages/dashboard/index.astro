---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { 
  DollarSign, FolderGit2, Inbox, ShieldCheck, 
  TrendingUp, Activity, History, AlertTriangle,
  Users, Building2, ShoppingBag, Layers,
  FileText, CheckCircle2, XCircle, AlertCircle,
  FileEdit, Archive
} from '@lucide/astro';
import DirhamIcon from '../../components/ui/DirhamIcon.astro';

const user = Astro.locals.user;
const roles = Astro.locals.roles || [];
const isAdmin = roles.includes('admin') || roles.includes('moderator');

let metrics = {
  totalValuation: 185200.00, // Stock valuation
  pendingSettlements: 0.00,
  totalRevenue: 0.00,
  projectCount: 0,
  accountStanding: 'NOMINAL',
  activeInquiries: 0,
  customerCount: 0,
  companyCount: 0,
  invoicesByStatus: {
    paid: { count: 0, value: 0 },
    unpaid: { count: 0, value: 0 },
    overdue: { count: 0, value: 0 },
    cancelled: { count: 0, value: 0 },
    draft: { count: 0, value: 0 }
  },
  productsByStatus: {
    active: 0,
    inactive: 0,
    draft: 0
  },
  projectsByStatus: {
    active: 0,
    archived: 0
  }
};

let connectionStatuses = {
  db: { status: 'ONLINE', latency: '0ms' },
  clerk: { status: 'CONFIGURED', version: 'v1' },
  resend: { status: 'CONFIGURED', limit: 'Free Tier' },
  vercel: { status: 'CONNECTED', environment: 'production' }
};

let dbConnected = true;

try {
  // 1. Get Project/Categories count
  const catRes = await query('SELECT COUNT(*) FROM categories');
  metrics.projectCount = parseInt(catRes.rows[0].count);

  // 2. Get Revenue (Paid invoices)
  const revRes = await query("SELECT COALESCE(SUM(total_amount), 0) as total FROM invoices WHERE payment_status = 'paid'");
  metrics.totalRevenue = parseFloat(revRes.rows[0].total);

  // 3. Get Pending Settlements (Unpaid invoices)
  const pendQuery = isAdmin
    ? "SELECT COALESCE(SUM(total_amount), 0) as total FROM invoices WHERE payment_status = 'unpaid'"
    : "SELECT COALESCE(SUM(total_amount), 0) as total FROM invoices WHERE customer_email = $1 AND payment_status = 'unpaid'";
  
  const pendParams = isAdmin ? [] : [user?.email || ''];
  const pendRes = await query(pendQuery, pendParams);
  metrics.pendingSettlements = parseFloat(pendRes.rows[0].total);

  // 4. Get active CRM enquiries
  const enqRes = await query('SELECT COUNT(*) FROM contacts WHERE is_resolved = false');
  metrics.activeInquiries = parseInt(enqRes.rows[0].count);

  // 5. User Account Standing
  if (user) {
    metrics.accountStanding = user.is_suspended ? 'SUSPENDED' : 'EXCELLENT';
  }

  // 6. Get Dynamic Valuation (based on stock levels)
  const valRes = await query("SELECT COALESCE(SUM(stock_level * 180), 0) as total FROM inventory");
  const dbVal = parseFloat(valRes.rows[0].total);
  if (dbVal > 0) {
    metrics.totalValuation = dbVal;
  }

  // 7. Get Customers & Companies counts
  const custCountRes = await query('SELECT COUNT(*) as count FROM customers');
  metrics.customerCount = parseInt(custCountRes.rows[0].count);
  
  const compCountRes = await query("SELECT COUNT(DISTINCT company_name) as count FROM customers WHERE company_name IS NOT NULL AND company_name != ''");
  metrics.companyCount = parseInt(compCountRes.rows[0].count);

  // 8. Invoices Breakdown
  const invRes = await query("SELECT COUNT(*) as count, COALESCE(SUM(total_amount), 0) as value, payment_status FROM invoices GROUP BY payment_status");
  metrics.invoicesByStatus = invRes.rows.reduce((acc: any, row: any) => {
    acc[row.payment_status] = { count: parseInt(row.count), value: parseFloat(row.value) };
    return acc;
  }, { paid: { count: 0, value: 0 }, unpaid: { count: 0, value: 0 }, overdue: { count: 0, value: 0 }, cancelled: { count: 0, value: 0 }, draft: { count: 0, value: 0 } });

  // 9. Products Breakdown
  const prodRes = await query("SELECT COUNT(*) as count, status FROM products GROUP BY status");
  metrics.productsByStatus = prodRes.rows.reduce((acc: any, row: any) => {
    acc[row.status] = parseInt(row.count);
    return acc;
  }, { active: 0, inactive: 0, draft: 0 });

  // 10. Projects Breakdown
  const projRes = await query("SELECT COUNT(*) as count, status FROM projects GROUP BY status");
  metrics.projectsByStatus = projRes.rows.reduce((acc: any, row: any) => {
    acc[row.status] = parseInt(row.count);
    return acc;
  }, { active: 0, archived: 0 });

  // 11. Recent activity for rich operational stream
  let recentInvoices: any[] = [];
  try {
    const rInv = await query("SELECT invoice_number, customer_name, total_amount, payment_status, created_at FROM invoices ORDER BY created_at DESC LIMIT 5");
    recentInvoices = rInv.rows;
  } catch {}

  let recentInquiries: any[] = [];
  try {
    const rInq = await query("SELECT name, email, division, subject, created_at, is_resolved FROM contacts ORDER BY created_at DESC LIMIT 5");
    recentInquiries = rInq.rows;
  } catch {}

  // 12. Load connection status checks
  connectionStatuses.db.status = 'ONLINE';
  const start = Date.now();
  await query('SELECT 1');
  connectionStatuses.db.latency = `${Date.now() - start}ms`;

} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}

// 12. Load other API checks
const hasClerkKey = !!(process.env.CLERK_SECRET_KEY || import.meta.env?.CLERK_SECRET_KEY);
connectionStatuses.clerk.status = hasClerkKey ? 'CONFIGURED' : 'MISSING';

const hasResendKey = !!(process.env.RESEND_API_KEY || import.meta.env?.RESEND_API_KEY);
connectionStatuses.resend.status = hasResendKey ? 'CONFIGURED' : 'MISSING';

const isVercel = !!(process.env.VERCEL || import.meta.env?.VERCEL);
connectionStatuses.vercel.status = isVercel ? 'CONNECTED' : 'LOCAL HOST';
connectionStatuses.vercel.environment = process.env.NODE_ENV === 'production' ? 'production' : 'development';
---

<DashboardLayout title="Overview" activeItem="dashboard">

  <div class="p-6 lg:p-8 space-y-8">
  <!-- Real-Time Command Center Header -->
  <div class="rounded-2xl border border-slate-200 bg-gradient-to-r from-white via-slate-50 to-white p-6 md:p-8 backdrop-blur-xl relative overflow-hidden flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-sm">
    <div class="space-y-2">
      <span class="text-xs font-semibold text-cyan-600 uppercase tracking-widest flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-cyan-500 animate-pulse"></span>
        Command Center
      </span>
      <h2 class="text-2xl font-bold font-display text-slate-900">Delight Group LLC</h2>
      <p class="text-xs text-slate-500">Corporate portal and live B2B supply logistics console</p>
    </div>

    <!-- GST Time & Date widget -->
    <div class="flex gap-6 text-xs text-slate-500 self-stretch sm:self-auto border-t border-slate-200 md:border-t-0 pt-4 md:pt-0">
      <div>
        <p class="text-3xs font-semibold uppercase tracking-wider text-slate-500">System Time (GST)</p>
        <p id="live-gst-clock" class="text-lg font-bold text-slate-800 font-mono mt-1">12:00:00 GST</p>
      </div>
      <div class="h-10 w-px bg-slate-200"></div>
      <div>
        <p class="text-3xs font-semibold uppercase tracking-wider text-slate-500">System Date</p>
        <p id="live-gst-date" class="text-lg font-bold text-slate-800 font-mono mt-1">YYYY-MM-DD</p>
      </div>
    </div>
  </div>

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-500 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL is Offline</span>: Telemetry displays simulated change logs.
      </div>
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Metrics Grid (lg:col-span-12) -->
    <div class="lg:col-span-12 space-y-8">
      
      {isAdmin ? (
        <!-- Admin Command Center View -->
        <div class="space-y-8">
          
          <!-- ── ROW 1: PRIMARY FINANCIAL PULSE ─────────────────────────── -->
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
                <DollarSign class="h-4 w-4 text-emerald-500" />
                Financial Telemetry & Treasury
              </h3>
              <a href="/dashboard/invoices" class="text-xs font-bold text-blue-600 hover:text-blue-700 transition">View Full Ledger →</a>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <!-- Card 1: Revenue -->
              <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-28 h-28 bg-emerald-500/5 rounded-bl-full pointer-events-none transition-all group-hover:scale-110"></div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Settled Revenue</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200/60 flex items-center gap-1">
                    <CheckCircle2 class="h-3 w-3 text-emerald-600" />
                    {metrics.invoicesByStatus.paid.count} Paid
                  </span>
                </div>
                <div class="flex items-baseline gap-2">
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">AED</span>
                  <p class="text-3xl font-extrabold font-display text-slate-900 tracking-tight">
                    {metrics.totalRevenue.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                  <span>Cleared invoices</span>
                  <span class="font-semibold text-emerald-600">Active</span>
                </div>
              </div>

              <!-- Card 2: Pending Settlements -->
              <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-28 h-28 bg-amber-500/5 rounded-bl-full pointer-events-none transition-all group-hover:scale-110"></div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Pending Settlements</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-50 text-amber-700 border border-amber-200/60 flex items-center gap-1">
                    <AlertCircle class="h-3 w-3 text-amber-600" />
                    {metrics.invoicesByStatus.unpaid.count} Pending
                  </span>
                </div>
                <div class="flex items-baseline gap-2">
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">AED</span>
                  <p class="text-3xl font-extrabold font-display text-amber-600 tracking-tight">
                    {metrics.pendingSettlements.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                  <span>Awaiting payment clearance</span>
                  <span class="font-semibold text-amber-600">Follow-up Needed</span>
                </div>
              </div>

              <!-- Card 3: Inventory Valuation -->
              <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-28 h-28 bg-blue-500/5 rounded-bl-full pointer-events-none transition-all group-hover:scale-110"></div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Stock Valuation</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-blue-50 text-blue-700 border border-blue-200/60 flex items-center gap-1">
                    <Activity class="h-3 w-3 text-blue-600" />
                    Live
                  </span>
                </div>
                <div class="flex items-baseline gap-2">
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">AED</span>
                  <p class="text-3xl font-extrabold font-display text-slate-900 tracking-tight">
                    {metrics.totalValuation.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                  <span>Warehouse active valuation</span>
                  <a href="/dashboard/inventory" class="font-bold text-blue-600 hover:underline">Manage Stock</a>
                </div>
              </div>
            </div>

            <!-- Invoices Ledger Status Strip -->
            <div class="mt-4 bg-white rounded-xl border border-slate-200/80 p-4 shadow-sm">
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 divide-y sm:divide-y-0 sm:divide-x divide-slate-100">
                <div class="pt-2 sm:pt-0 sm:px-3 first:pl-0 flex flex-col justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Paid Invoices</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-base font-extrabold text-emerald-600">{metrics.invoicesByStatus.paid.count}</span>
                    <span class="text-[11px] font-semibold text-slate-500">AED {metrics.invoicesByStatus.paid.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                  </div>
                </div>
                <div class="pt-2 sm:pt-0 sm:px-3 flex flex-col justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Unpaid</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-base font-extrabold text-amber-600">{metrics.invoicesByStatus.unpaid.count}</span>
                    <span class="text-[11px] font-semibold text-slate-500">AED {metrics.invoicesByStatus.unpaid.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                  </div>
                </div>
                <div class="pt-2 sm:pt-0 sm:px-3 flex flex-col justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Overdue</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-base font-extrabold text-rose-600">{metrics.invoicesByStatus.overdue.count}</span>
                    <span class="text-[11px] font-semibold text-slate-500">AED {metrics.invoicesByStatus.overdue.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                  </div>
                </div>
                <div class="pt-2 sm:pt-0 sm:px-3 flex flex-col justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Drafts</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-base font-extrabold text-slate-700">{metrics.invoicesByStatus.draft.count}</span>
                    <span class="text-[11px] font-semibold text-slate-500">AED {metrics.invoicesByStatus.draft.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                  </div>
                </div>
                <div class="pt-2 sm:pt-0 sm:px-3 flex flex-col justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Cancelled / Void</span>
                  <div class="flex items-baseline gap-1.5 mt-1">
                    <span class="text-base font-extrabold text-slate-400">{metrics.invoicesByStatus.cancelled.count}</span>
                    <span class="text-[11px] font-semibold text-slate-400">AED {metrics.invoicesByStatus.cancelled.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ── ROW 2: OPERATIONS BENTO (CATALOG, CRM & PROJECTS) ──────── -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Bento Box 1: Catalog & Inventory Summary -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
                    <ShoppingBag class="h-4 w-4 text-cyan-600" />
                    Product Catalog
                  </h4>
                  <a href="/dashboard/products" class="text-[11px] font-bold text-cyan-700 hover:underline">Manage →</a>
                </div>
                <div class="grid grid-cols-2 gap-4 mt-5">
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Active Products</span>
                    <span class="text-2xl font-black text-emerald-600 mt-1 block">{metrics.productsByStatus.active}</span>
                    <span class="text-[10px] text-slate-400">Live online</span>
                  </div>
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Categories</span>
                    <span class="text-2xl font-black text-slate-800 mt-1 block">{metrics.projectCount}</span>
                    <span class="text-[10px] text-slate-400">Active groups</span>
                  </div>
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Draft Products</span>
                    <span class="text-2xl font-black text-slate-600 mt-1 block">{metrics.productsByStatus.draft}</span>
                    <span class="text-[10px] text-slate-400">Unpublished</span>
                  </div>
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Inactive / Out</span>
                    <span class="text-2xl font-black text-rose-500 mt-1 block">{metrics.productsByStatus.inactive}</span>
                    <span class="text-[10px] text-slate-400">Archived</span>
                  </div>
                </div>
              </div>
              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <a href="/dashboard/categories" class="font-bold text-slate-600 hover:text-slate-900">Categories Hub</a>
                <a href="/dashboard/inventory" class="font-bold text-cyan-600 hover:underline">Warehouse Stock</a>
              </div>
            </div>

            <!-- Bento Box 2: CRM & Stakeholders -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
                    <Users class="h-4 w-4 text-blue-600" />
                    Clients & Inquiries
                  </h4>
                  <a href="/dashboard/users" class="text-[11px] font-bold text-blue-700 hover:underline">Directory →</a>
                </div>
                <div class="grid grid-cols-2 gap-4 mt-5">
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total Clients</span>
                    <span class="text-2xl font-black text-slate-900 mt-1 block">{metrics.customerCount}</span>
                    <span class="text-[10px] text-slate-400">Registered users</span>
                  </div>
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Enterprises</span>
                    <span class="text-2xl font-black text-slate-900 mt-1 block">{metrics.companyCount}</span>
                    <span class="text-[10px] text-slate-400">Corporate accounts</span>
                  </div>
                </div>
                <div class="mt-4 p-3.5 bg-blue-50/60 rounded-xl border border-blue-100 flex items-center justify-between">
                  <div>
                    <span class="text-[10px] font-bold text-blue-800 uppercase tracking-wider block">Pending Requests</span>
                    <p class="text-xs text-blue-600 font-medium mt-0.5">Unresolved contact inquiries</p>
                  </div>
                  <span class="text-xl font-black text-blue-700 bg-white px-2.5 py-1 rounded-lg border border-blue-200 shadow-2xs">
                    {metrics.activeInquiries}
                  </span>
                </div>
              </div>
              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-400">Support standing: <strong class="text-emerald-600">Active</strong></span>
                <a href="/dashboard/contact-setup" class="font-bold text-blue-600 hover:underline">Configure Forms</a>
              </div>
            </div>

            <!-- Bento Box 3: Showcase & Portfolio Projects -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
                    <FolderGit2 class="h-4 w-4 text-purple-600" />
                    Portfolio & Showcases
                  </h4>
                  <a href="/dashboard/projects" class="text-[11px] font-bold text-purple-700 hover:underline">Manage →</a>
                </div>
                <div class="grid grid-cols-2 gap-4 mt-5">
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Live Projects</span>
                    <span class="text-2xl font-black text-purple-700 mt-1 block">{metrics.projectsByStatus.active}</span>
                    <span class="text-[10px] text-slate-400">Public showcase</span>
                  </div>
                  <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Archived</span>
                    <span class="text-2xl font-black text-slate-500 mt-1 block">{metrics.projectsByStatus.archived}</span>
                    <span class="text-[10px] text-slate-400">Historical records</span>
                  </div>
                </div>
                <div class="mt-4 p-3.5 bg-purple-50/50 rounded-xl border border-purple-100 flex items-center justify-between">
                  <div>
                    <span class="text-[10px] font-bold text-purple-900 uppercase tracking-wider block">Division Scope</span>
                    <p class="text-xs text-purple-700 font-medium mt-0.5">DTL • DGS • Delight Vision</p>
                  </div>
                  <a href="/projects" target="_blank" class="text-[11px] font-bold text-purple-700 bg-white px-2.5 py-1 rounded-md border border-purple-200 hover:bg-purple-50 shadow-2xs">
                    Live View ↗
                  </a>
                </div>
              </div>
              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <a href="/dashboard/page-visibility" class="font-bold text-slate-600 hover:text-slate-900">Visibility Control</a>
                <a href="/dashboard/projects" class="font-bold text-purple-600 hover:underline">+ Add Project</a>
              </div>
            </div>

          </div>

          <!-- ── ROW 3: LIVE OPERATIONAL ACTIVITY FEEDS ─────────────────── -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Feed 1: Recent Invoices / Orders -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800 flex items-center gap-2">
                  <FileText class="h-4 w-4 text-emerald-600" />
                  Recent Ledger Transactions
                </h4>
                <a href="/dashboard/invoices" class="text-xs font-bold text-blue-600 hover:underline">All Invoices →</a>
              </div>
              
              {recentInvoices.length === 0 ? (
                <div class="py-8 text-center text-xs text-slate-400">
                  No invoice records found in active database.
                </div>
              ) : (
                <div class="divide-y divide-slate-100">
                  {recentInvoices.map((inv: any) => (
                    <div class="py-3 flex items-center justify-between hover:bg-slate-50/80 px-2 rounded-lg transition-colors">
                      <div class="min-w-0 pr-3">
                        <p class="text-xs font-bold text-slate-900 truncate">{inv.customer_name || 'Client Order'}</p>
                        <p class="text-[10px] text-slate-400 font-mono mt-0.5">{inv.invoice_number}</p>
                      </div>
                      <div class="text-right shrink-0">
                        <p class="text-xs font-extrabold text-slate-900">AED {parseFloat(inv.total_amount || 0).toLocaleString('en-AE', { minimumFractionDigits: 2 })}</p>
                        <span class={`inline-block mt-0.5 text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full ${
                          inv.payment_status === 'paid' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/60' :
                          inv.payment_status === 'unpaid' ? 'bg-amber-50 text-amber-700 border border-amber-200/60' :
                          inv.payment_status === 'overdue' ? 'bg-rose-50 text-rose-700 border border-rose-200/60' :
                          'bg-slate-100 text-slate-600'
                        }`}>
                          {inv.payment_status || 'draft'}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- Feed 2: Recent CRM Inquiries -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800 flex items-center gap-2">
                  <Inbox class="h-4 w-4 text-blue-600" />
                  Recent Contact Requests
                </h4>
                <span class="text-xs font-bold text-slate-400">{metrics.activeInquiries} Pending</span>
              </div>
              
              {recentInquiries.length === 0 ? (
                <div class="py-8 text-center text-xs text-slate-400">
                  No active customer messages at this time.
                </div>
              ) : (
                <div class="divide-y divide-slate-100">
                  {recentInquiries.map((inq: any) => (
                    <div class="py-3 flex items-center justify-between hover:bg-slate-50/80 px-2 rounded-lg transition-colors">
                      <div class="min-w-0 pr-3">
                        <p class="text-xs font-bold text-slate-900 truncate">{inq.name || 'Anonymous User'}</p>
                        <p class="text-[11px] text-slate-500 truncate mt-0.5">{inq.subject || inq.email}</p>
                      </div>
                      <div class="text-right shrink-0">
                        <span class="text-[10px] font-bold uppercase text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                          {inq.division || 'General'}
                        </span>
                        <p class="text-[9px] text-slate-400 mt-1">
                          {inq.is_resolved ? '✓ Resolved' : '● Open'}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

          </div>

        </div>
      ) : (
        <!-- Regular User View: 3 Metrics -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Project Count -->
          <div class="rounded-2xl border border-slate-200/80 bg-white p-6 space-y-3 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Project Collections</p>
            <p class="text-3xl font-extrabold font-display text-cyan-600">{metrics.projectCount}</p>
            <p class="text-xs text-slate-400">Configured catalogue collections</p>
          </div>

          <!-- Awaiting Settlement -->
          <div class="rounded-2xl border border-slate-200/80 bg-white p-6 space-y-3 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Awaiting Settlement</p>
            <div class="flex items-baseline gap-2">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">AED</span>
              <p class="text-3xl font-extrabold font-display text-amber-600">
                {metrics.pendingSettlements.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
              </p>
            </div>
            <p class="text-xs text-slate-400">Outstanding ledger balance</p>
          </div>

          <!-- Account Standing -->
          <div class="rounded-2xl border border-slate-200/80 bg-white p-6 space-y-3 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Account Standing</p>
            <p class="text-3xl font-extrabold font-display text-emerald-600">{metrics.accountStanding}</p>
            <p class="text-xs text-slate-400">Authenticated profile credentials</p>
          </div>
        </div>
      )}

      <!-- Connection Status Console -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-6 space-y-4 shadow-sm">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Platform Health & Integrations
            </h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Real-time status of connected cloud services and backends</p>
          </div>
          <span class="text-[10px] font-mono font-bold bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-md border border-emerald-200/60">All Systems Operational</span>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-2">
          <!-- PostgreSQL DB -->
          <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">PostgreSQL DB</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.db.status}</p>
              <p class="text-[10px] text-slate-400 font-mono">Latency: {connectionStatuses.db.latency}</p>
            </div>
            <span class={`h-2.5 w-2.5 rounded-full mt-1 ${connectionStatuses.db.status === 'ONLINE' ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}></span>
          </div>

          <!-- Clerk Auth -->
          <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Clerk Auth Provider</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.clerk.status}</p>
              <p class="text-[10px] text-slate-400 font-mono">Service: Active</p>
            </div>
            <span class={`h-2.5 w-2.5 rounded-full mt-1 ${connectionStatuses.clerk.status === 'CONFIGURED' ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}></span>
          </div>

          <!-- Resend Service -->
          <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Resend Mail API</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.resend.status}</p>
              <p class="text-[10px] text-slate-400 font-mono">Tier: {connectionStatuses.resend.limit}</p>
            </div>
            <span class={`h-2.5 w-2.5 rounded-full mt-1 ${connectionStatuses.resend.status === 'CONFIGURED' ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}></span>
          </div>

          <!-- Vercel hosting -->
          <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Hosting & Runtime</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.vercel.status}</p>
              <p class="text-[10px] text-slate-400 font-mono">Env: {connectionStatuses.vercel.environment}</p>
            </div>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 mt-1 animate-pulse"></span>
          </div>
        </div>
      </div>

      <!-- Quick Shortcuts -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-6 space-y-4 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">Operational Fast Actions</h3>
        <div class="flex flex-wrap gap-3">
          {isAdmin && (
            <>
              <a href="/dashboard/invoices" class="text-xs font-bold bg-slate-50 hover:bg-slate-100 border border-slate-200 px-4 py-2.5 rounded-xl text-slate-800 transition-all flex items-center gap-2 shadow-2xs hover:shadow-xs">
                <span>Invoices Ledger</span>
              </a>
              <a href="/dashboard/projects" class="text-xs font-bold bg-slate-50 hover:bg-slate-100 border border-slate-200 px-4 py-2.5 rounded-xl text-slate-800 transition-all flex items-center gap-2 shadow-2xs hover:shadow-xs">
                <span>Manage Projects</span>
              </a>
              <a href="/dashboard/products" class="text-xs font-bold bg-slate-50 hover:bg-slate-100 border border-slate-200 px-4 py-2.5 rounded-xl text-slate-800 transition-all flex items-center gap-2 shadow-2xs hover:shadow-xs">
                <span>Manage Products</span>
              </a>
              <a href="/dashboard/page-visibility" class="text-xs font-bold bg-slate-50 hover:bg-slate-100 border border-slate-200 px-4 py-2.5 rounded-xl text-slate-800 transition-all flex items-center gap-2 shadow-2xs hover:shadow-xs">
                <span>Visibility Configurator</span>
              </a>
            </>
          )}
          <a href="/dashboard/downloads" class="text-xs font-bold bg-slate-50 hover:bg-slate-100 border border-slate-200 px-4 py-2.5 rounded-xl text-slate-800 transition-all flex items-center gap-2 shadow-2xs hover:shadow-xs">
            <span>Downloads Setup</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Real-time Clock and Date Script -->
  <script>
    function updateGSTClock() {
      const clockEl = document.getElementById('live-gst-clock');
      const dateEl = document.getElementById('live-gst-date');
      
      if (!clockEl || !dateEl) return;
 
      const now = new Date();
      
      // Calculate GST timezone (+4:00)
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const gstTime = new Date(utc + (3600000 * 4));

      // Clock
      const hours = String(gstTime.getHours()).padStart(2, '0');
      const minutes = String(gstTime.getMinutes()).padStart(2, '0');
      const seconds = String(gstTime.getSeconds()).padStart(2, '0');
      clockEl.textContent = `${hours}:${minutes}:${seconds} GST`;

      // Date
      const year = gstTime.getFullYear();
      const month = String(gstTime.getMonth() + 1).padStart(2, '0');
      const day = String(gstTime.getDate()).padStart(2, '0');
      dateEl.textContent = `${year}-${month}-${day}`;
    }

    // Run immediately and start intervals
    updateGSTClock();
    setInterval(updateGSTClock, 1000);
  </script>
  </div>

</DashboardLayout>
