---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { query } from '../../lib/db';
import { 
  DollarSign, FolderGit2, Inbox, ShieldCheck, 
  TrendingUp, Activity, History, AlertTriangle,
  Users, Building2, ShoppingBag, Layers,
  FileText, CheckCircle2, XCircle, AlertCircle,
  FileEdit, Archive
} from '@lucide/astro';
import DirhamIcon from '../../components/ui/DirhamIcon.astro';

const user = Astro.locals.user;
const roles = Astro.locals.roles || [];
const isAdmin = roles.includes('admin') || roles.includes('moderator');

let metrics = {
  totalValuation: 185200.00, // Stock valuation
  pendingSettlements: 0.00,
  totalRevenue: 0.00,
  projectCount: 0,
  accountStanding: 'NOMINAL',
  activeInquiries: 0,
  customerCount: 0,
  companyCount: 0,
  invoicesByStatus: {
    paid: { count: 0, value: 0 },
    unpaid: { count: 0, value: 0 },
    overdue: { count: 0, value: 0 },
    cancelled: { count: 0, value: 0 },
    draft: { count: 0, value: 0 }
  },
  productsByStatus: {
    active: 0,
    inactive: 0,
    draft: 0
  },
  projectsByStatus: {
    active: 0,
    archived: 0
  }
};

let connectionStatuses = {
  db: { status: 'ONLINE', latency: '0ms' },
  clerk: { status: 'CONFIGURED', version: 'v1' },
  resend: { status: 'CONFIGURED', limit: 'Free Tier' },
  vercel: { status: 'CONNECTED', environment: 'production' }
};

let dbConnected = true;

try {
  // 1. Get Project/Categories count
  const catRes = await query('SELECT COUNT(*) FROM categories');
  metrics.projectCount = parseInt(catRes.rows[0].count);

  // 2. Get Revenue (Paid invoices)
  const revRes = await query("SELECT COALESCE(SUM(total_amount), 0) as total FROM invoices WHERE payment_status = 'paid'");
  metrics.totalRevenue = parseFloat(revRes.rows[0].total);

  // 3. Get Pending Settlements (Unpaid invoices)
  const pendQuery = isAdmin
    ? "SELECT COALESCE(SUM(total_amount), 0) as total FROM invoices WHERE payment_status = 'unpaid'"
    : "SELECT COALESCE(SUM(total_amount), 0) as total FROM invoices WHERE customer_email = $1 AND payment_status = 'unpaid'";
  
  const pendParams = isAdmin ? [] : [user?.email || ''];
  const pendRes = await query(pendQuery, pendParams);
  metrics.pendingSettlements = parseFloat(pendRes.rows[0].total);

  // 4. Get active CRM enquiries
  const enqRes = await query('SELECT COUNT(*) FROM contacts WHERE is_resolved = false');
  metrics.activeInquiries = parseInt(enqRes.rows[0].count);

  // 5. User Account Standing
  if (user) {
    metrics.accountStanding = user.is_suspended ? 'SUSPENDED' : 'EXCELLENT';
  }

  // 6. Get Dynamic Valuation (based on stock levels)
  const valRes = await query("SELECT COALESCE(SUM(stock_level * 180), 0) as total FROM inventory");
  const dbVal = parseFloat(valRes.rows[0].total);
  if (dbVal > 0) {
    metrics.totalValuation = dbVal;
  }

  // 7. Get Customers & Companies counts
  const custCountRes = await query('SELECT COUNT(*) as count FROM customers');
  metrics.customerCount = parseInt(custCountRes.rows[0].count);
  
  const compCountRes = await query("SELECT COUNT(DISTINCT company_name) as count FROM customers WHERE company_name IS NOT NULL AND company_name != ''");
  metrics.companyCount = parseInt(compCountRes.rows[0].count);

  // 8. Invoices Breakdown
  const invRes = await query("SELECT COUNT(*) as count, COALESCE(SUM(total_amount), 0) as value, payment_status FROM invoices GROUP BY payment_status");
  metrics.invoicesByStatus = invRes.rows.reduce((acc: any, row: any) => {
    acc[row.payment_status] = { count: parseInt(row.count), value: parseFloat(row.value) };
    return acc;
  }, { paid: { count: 0, value: 0 }, unpaid: { count: 0, value: 0 }, overdue: { count: 0, value: 0 }, cancelled: { count: 0, value: 0 }, draft: { count: 0, value: 0 } });

  // 9. Products Breakdown
  const prodRes = await query("SELECT COUNT(*) as count, status FROM products GROUP BY status");
  metrics.productsByStatus = prodRes.rows.reduce((acc: any, row: any) => {
    acc[row.status] = parseInt(row.count);
    return acc;
  }, { active: 0, inactive: 0, draft: 0 });

  // 10. Projects Breakdown
  const projRes = await query("SELECT COUNT(*) as count, status FROM projects GROUP BY status");
  metrics.projectsByStatus = projRes.rows.reduce((acc: any, row: any) => {
    acc[row.status] = parseInt(row.count);
    return acc;
  }, { active: 0, archived: 0 });

  // 11. Load connection status checks
  connectionStatuses.db.status = 'ONLINE';
  const start = Date.now();
  await query('SELECT 1');
  connectionStatuses.db.latency = `${Date.now() - start}ms`;

} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}

// 12. Load other API checks
const hasClerkKey = !!(process.env.CLERK_SECRET_KEY || import.meta.env?.CLERK_SECRET_KEY);
connectionStatuses.clerk.status = hasClerkKey ? 'CONFIGURED' : 'MISSING';

const hasResendKey = !!(process.env.RESEND_API_KEY || import.meta.env?.RESEND_API_KEY);
connectionStatuses.resend.status = hasResendKey ? 'CONFIGURED' : 'MISSING';

const isVercel = !!(process.env.VERCEL || import.meta.env?.VERCEL);
connectionStatuses.vercel.status = isVercel ? 'CONNECTED' : 'LOCAL HOST';
connectionStatuses.vercel.environment = process.env.NODE_ENV === 'production' ? 'production' : 'development';
---

<DashboardLayout title="Overview" activeItem="dashboard">

  <div class="p-6 lg:p-8 space-y-8">
  <!-- Real-Time Command Center Header -->
  <div class="rounded-2xl border border-slate-200 bg-gradient-to-r from-white via-slate-50 to-white p-6 md:p-8 backdrop-blur-xl relative overflow-hidden flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-sm">
    <div class="space-y-2">
      <span class="text-xs font-semibold text-cyan-600 uppercase tracking-widest flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-cyan-500 animate-pulse"></span>
        Command Center
      </span>
      <h2 class="text-2xl font-bold font-display text-slate-900">Delight Group LLC</h2>
      <p class="text-xs text-slate-500">Corporate portal and live B2B supply logistics console</p>
    </div>

    <!-- GST Time & Date widget -->
    <div class="flex gap-6 text-xs text-slate-500 self-stretch sm:self-auto border-t border-slate-200 md:border-t-0 pt-4 md:pt-0">
      <div>
        <p class="text-3xs font-semibold uppercase tracking-wider text-slate-500">System Time (GST)</p>
        <p id="live-gst-clock" class="text-lg font-bold text-slate-800 font-mono mt-1">12:00:00 GST</p>
      </div>
      <div class="h-10 w-px bg-slate-200"></div>
      <div>
        <p class="text-3xs font-semibold uppercase tracking-wider text-slate-500">System Date</p>
        <p id="live-gst-date" class="text-lg font-bold text-slate-800 font-mono mt-1">YYYY-MM-DD</p>
      </div>
    </div>
  </div>

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-500 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL is Offline</span>: Telemetry displays simulated change logs.
      </div>
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Metrics Grid (lg:col-span-12) -->
    <div class="lg:col-span-12 space-y-6">
      <h3 class="text-sm font-bold font-display text-slate-900 uppercase tracking-wider">Telemetry Overview</h3>
      
      {isAdmin ? (
        <!-- Admin Command Center View -->
        <div class="space-y-8">
          
          <!-- Financials & Orders Section -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
              <DollarSign class="h-4 w-4 text-emerald-500" />
              Financials & Ledger Summary
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <!-- Total Revenue -->
              <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-emerald-50/30 to-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <div class="flex justify-between items-center">
                  <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Total Revenue (Paid)</p>
                  <span class="px-2 py-0.5 rounded-full text-3xs font-medium bg-emerald-100 text-emerald-800 flex items-center gap-1">
                    <CheckCircle2 class="h-3 w-3" />
                    {metrics.invoicesByStatus.paid.count} Orders
                  </span>
                </div>
                <p class="text-2xl font-bold font-display text-emerald-600 flex items-center gap-1.5"><DirhamIcon class="w-6 h-6" /> {metrics.totalRevenue.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</p>
                <p class="text-3xs text-slate-400">Settled and logged transactions</p>
              </div>

              <!-- Pending Settlements -->
              <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-amber-50/30 to-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <div class="flex justify-between items-center">
                  <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Pending Settlements (Unpaid)</p>
                  <span class="px-2 py-0.5 rounded-full text-3xs font-medium bg-amber-100 text-amber-800 flex items-center gap-1">
                    <AlertCircle class="h-3 w-3" />
                    {metrics.invoicesByStatus.unpaid.count} Pending
                  </span>
                </div>
                <p class="text-2xl font-bold font-display text-amber-600 flex items-center gap-1.5"><DirhamIcon class="w-6 h-6" /> {metrics.pendingSettlements.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</p>
                <p class="text-3xs text-slate-400">Awaiting clearance/payment</p>
              </div>

              <!-- Stock Inventory Valuation -->
              <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50/50 to-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <div class="flex justify-between items-center">
                  <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Stock Valuation</p>
                  <span class="px-2 py-0.5 rounded-full text-3xs font-medium bg-slate-100 text-slate-800">
                    Est. Value
                  </span>
                </div>
                <p class="text-2xl font-bold font-display text-slate-900 font-mono flex items-center gap-1.5"><DirhamIcon class="w-6 h-6" /> {metrics.totalValuation.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</p>
                <p class="text-3xs text-slate-400">Calculated from warehouse inventory levels</p>
              </div>
            </div>

            <!-- Invoices Ledger Breakdown Details -->
            <div class="rounded-xl border border-slate-200 bg-white p-6 space-y-4 shadow-sm">
              <p class="text-xs font-bold text-slate-750 uppercase tracking-wider">Invoices & Orders Breakdown</p>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                <!-- Paid -->
                <div class="border border-slate-100 rounded-lg p-3 bg-slate-50/50 flex flex-col justify-between">
                  <span class="text-3xs font-semibold text-slate-500 uppercase">Paid</span>
                  <span class="text-lg font-bold text-emerald-600 mt-1">{metrics.invoicesByStatus.paid.count}</span>
                  <span class="text-3xs text-slate-400 flex items-center gap-1"><DirhamIcon class="w-2.5 h-2.5" /> {metrics.invoicesByStatus.paid.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                </div>
                <!-- Unpaid -->
                <div class="border border-slate-100 rounded-lg p-3 bg-slate-50/50 flex flex-col justify-between">
                  <span class="text-3xs font-semibold text-slate-500 uppercase">Unpaid</span>
                  <span class="text-lg font-bold text-amber-600 mt-1">{metrics.invoicesByStatus.unpaid.count}</span>
                  <span class="text-3xs text-slate-400 flex items-center gap-1"><DirhamIcon class="w-2.5 h-2.5" /> {metrics.invoicesByStatus.unpaid.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                </div>
                <!-- Overdue -->
                <div class="border border-slate-100 rounded-lg p-3 bg-slate-50/50 flex flex-col justify-between">
                  <span class="text-3xs font-semibold text-slate-500 uppercase">Overdue</span>
                  <span class="text-lg font-bold text-rose-600 mt-1">{metrics.invoicesByStatus.overdue.count}</span>
                  <span class="text-3xs text-slate-400 flex items-center gap-1"><DirhamIcon class="w-2.5 h-2.5" /> {metrics.invoicesByStatus.overdue.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                </div>
                <!-- Drafts -->
                <div class="border border-slate-100 rounded-lg p-3 bg-slate-50/50 flex flex-col justify-between">
                  <span class="text-3xs font-semibold text-slate-500 uppercase">Drafts</span>
                  <span class="text-lg font-bold text-slate-600 mt-1">{metrics.invoicesByStatus.draft.count}</span>
                  <span class="text-3xs text-slate-400 flex items-center gap-1"><DirhamIcon class="w-2.5 h-2.5" /> {metrics.invoicesByStatus.draft.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                </div>
                <!-- Cancelled (Trash) -->
                <div class="border border-slate-100 rounded-lg p-3 bg-slate-50/50 flex flex-col justify-between">
                  <span class="text-3xs font-semibold text-slate-500 uppercase">Cancelled / Trash</span>
                  <span class="text-lg font-bold text-red-700 mt-1">{metrics.invoicesByStatus.cancelled.count}</span>
                  <span class="text-3xs text-slate-400 flex items-center gap-1"><DirhamIcon class="w-2.5 h-2.5" /> {metrics.invoicesByStatus.cancelled.value.toLocaleString('en-AE', { maximumFractionDigits: 0 })}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- CRM & Communications Section -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
              <Users class="h-4 w-4 text-blue-500" />
              CRM & Communications
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <!-- Customers -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Total Customers</p>
                <p class="text-2xl font-bold font-display text-slate-900">{metrics.customerCount}</p>
                <p class="text-3xs text-slate-400">Registered client accounts</p>
              </div>

              <!-- Companies -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Distinct Companies</p>
                <p class="text-2xl font-bold font-display text-slate-900">{metrics.companyCount}</p>
                <p class="text-3xs text-slate-400">Unique corporate entities</p>
              </div>

              <!-- Active Enquiries -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <div class="flex justify-between items-center">
                  <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Active Inquiries</p>
                  {metrics.activeInquiries > 0 && (
                    <span class="h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span>
                  )}
                </div>
                <p class="text-2xl font-bold font-display text-blue-600">{metrics.activeInquiries} Pending</p>
                <p class="text-3xs text-slate-400">Unresolved contact requests</p>
              </div>
            </div>
          </div>

          <!-- Catalog & Inventory Section -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
              <ShoppingBag class="h-4 w-4 text-cyan-500" />
              Catalog & Inventory
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              <!-- Categories -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Total Categories</p>
                <p class="text-2xl font-bold font-display text-slate-900">{metrics.projectCount}</p>
                <p class="text-3xs text-slate-400">Product groupings</p>
              </div>

              <!-- Active Products -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Active Products</p>
                <p class="text-2xl font-bold font-display text-emerald-600">{metrics.productsByStatus.active}</p>
                <p class="text-3xs text-slate-400">Visible in online catalog</p>
              </div>

              <!-- Draft Products -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Draft Products</p>
                <p class="text-2xl font-bold font-display text-slate-500">{metrics.productsByStatus.draft}</p>
                <p class="text-3xs text-slate-400">In-progress or unpublished</p>
              </div>

              <!-- Inactive Products -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Inactive Products</p>
                <p class="text-2xl font-bold font-display text-red-600">{metrics.productsByStatus.inactive}</p>
                <p class="text-3xs text-slate-400">Archived/out of stock products</p>
              </div>
            </div>
          </div>

          <!-- Projects Section -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
              <FolderGit2 class="h-4 w-4 text-purple-500" />
              Portfolio & Projects
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <!-- Active Projects -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Active Projects</p>
                <p class="text-2xl font-bold font-display text-purple-600">{metrics.projectsByStatus.active}</p>
                <p class="text-3xs text-slate-400">Live display installations</p>
              </div>

              <!-- Archived Projects -->
              <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-all">
                <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Archived Projects</p>
                <p class="text-2xl font-bold font-display text-slate-450">{metrics.projectsByStatus.archived}</p>
                <p class="text-3xs text-slate-400">Completed historical showcases</p>
              </div>
            </div>
          </div>

        </div>
      ) : (
        <!-- Regular User View: 3 Metrics -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Project Count -->
          <div class="rounded-lg border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Project Mapped Count</p>
            <p class="text-2xl font-bold font-display text-cyan-600">{metrics.projectCount} Collections</p>
          </div>

          <!-- Awaiting Settlement -->
          <div class="rounded-lg border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Awaiting Settlement</p>
            <p class="text-2xl font-bold font-display text-amber-600 flex items-center gap-1.5"><DirhamIcon class="w-6 h-6" /> {metrics.pendingSettlements.toLocaleString('en-AE', { minimumFractionDigits: 2 })}</p>
          </div>

          <!-- Account Standing -->
          <div class="rounded-lg border border-slate-200 bg-white p-5 space-y-3 shadow-sm hover:shadow-md transition-shadow">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Account Standing</p>
            <p class="text-2xl font-bold font-display text-emerald-600">{metrics.accountStanding}</p>
          </div>
        </div>
      )}

      <!-- Connection Status Console -->
      <div class="rounded-lg border border-slate-200 bg-white p-6 space-y-4 shadow-sm">
        <div class="space-y-1">
          <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            System Integrations Heartbeat
          </h3>
          <p class="text-3xs text-slate-400 font-semibold uppercase tracking-widest">Live Platform Verification</p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-2">
          <!-- PostgreSQL DB -->
          <div class="rounded border border-slate-200 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-3xs font-semibold uppercase tracking-wider text-slate-500">PostgreSQL DB</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.db.status}</p>
              <p class="text-3xs text-slate-450 font-mono">Latency: {connectionStatuses.db.latency}</p>
            </div>
            <span class={`h-2 w-2 rounded-full mt-1 ${connectionStatuses.db.status === 'ONLINE' ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}></span>
          </div>

          <!-- Clerk Auth -->
          <div class="rounded border border-slate-200 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-3xs font-semibold uppercase tracking-wider text-slate-500">Clerk Auth Provider</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.clerk.status}</p>
              <p class="text-3xs text-slate-450 font-mono">API Service: Active</p>
            </div>
            <span class={`h-2 w-2 rounded-full mt-1 ${connectionStatuses.clerk.status === 'CONFIGURED' ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}></span>
          </div>

          <!-- Resend Service -->
          <div class="rounded border border-slate-200 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-3xs font-semibold uppercase tracking-wider text-slate-500">Resend Mail API</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.resend.status}</p>
              <p class="text-3xs text-slate-455 font-mono">Plan: {connectionStatuses.resend.limit}</p>
            </div>
            <span class={`h-2 w-2 rounded-full mt-1 ${connectionStatuses.resend.status === 'CONFIGURED' ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}></span>
          </div>

          <!-- Vercel hosting -->
          <div class="rounded border border-slate-200 bg-slate-50/50 p-4 flex items-start justify-between">
            <div class="space-y-1">
              <span class="text-3xs font-semibold uppercase tracking-wider text-slate-500">Hosting & Runtime</span>
              <p class="text-sm font-black text-slate-800 mt-1">{connectionStatuses.vercel.status}</p>
              <p class="text-3xs text-slate-450 font-mono">Env: {connectionStatuses.vercel.environment}</p>
            </div>
