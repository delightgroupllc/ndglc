---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import InventoryForm from '../../components/forms/InventoryForm.astro';
import { query } from '../../lib/db';
import { FileClock, Settings, Save, AlertTriangle, TrendingUp, HelpCircle } from '@lucide/astro';

let inventoryItems: any[] = [];
let inventoryLogs: any[] = [];
let dbConnected = true;

try {
  // Load stock levels
  const invRes = await query(
    `SELECT i.*, p.name as product_name, p.sku, p.slug
     FROM inventory i
     JOIN products p ON p.id = i.product_id
     ORDER BY p.name ASC`
  );
  inventoryItems = invRes.rows.map(item => ({
    ...item,
    isLow: item.stock_level <= item.low_stock_threshold
  }));

  // Load logs
  const logsRes = await query(
    `SELECT il.*, p.name as product_name, p.sku, u.name as user_name
     FROM inventory_logs il
     JOIN inventory i ON i.id = il.inventory_id
     JOIN products p ON p.id = i.product_id
     LEFT JOIN users u ON u.id = il.user_id
     ORDER BY il.timestamp DESC
     LIMIT 15`
  );
  inventoryLogs = logsRes.rows;
} catch (err: any) {
  console.warn('Database offline, running mock inventory and log telemetry:', err.message);
  dbConnected = false;

  inventoryItems = [
    { id: 'inv-1', product_name: 'HP-100 High-Pressure Stainless Ball Valve', sku: 'SKU-DTL-VALVE-001', stock_level: 45, warehouse_location: 'Warehouse Alpha', low_stock_threshold: 15 },
    { id: 'inv-2', product_name: 'CPX-500 Heavy-Duty Centrifugal Pump', sku: 'SKU-DTL-PUMP-002', stock_level: 12, warehouse_location: 'Warehouse Beta', low_stock_threshold: 15 },
    { id: 'inv-3', product_name: 'Vortex Cloud-Native Backup Storage Suite', sku: 'SKU-DGS-CLOUD-001', stock_level: 120, warehouse_location: 'Cloud Region East-1', low_stock_threshold: 20 },
    { id: 'inv-4', product_name: 'IronWall Industrial Firewall Appliance v4', sku: 'SKU-DGS-SEC-002', stock_level: 28, warehouse_location: 'Warehouse Delta', low_stock_threshold: 10 }
  ].map(item => ({
    ...item,
    isLow: item.stock_level <= item.low_stock_threshold
  }));

  inventoryLogs = [
    { id: 'log-1', product_name: 'HP-100 High-Pressure Stainless Ball Valve', sku: 'SKU-DTL-VALVE-001', change_amount: 15, previous_stock: 30, new_stock: 45, reason: 'purchase', user_name: 'Alexander Vance', timestamp: new Date().toISOString() },
    { id: 'log-2', product_name: 'CPX-500 Heavy-Duty Centrifugal Pump', sku: 'SKU-DTL-PUMP-002', change_amount: -3, previous_stock: 15, new_stock: 12, reason: 'sales', user_name: 'Automated Checkout', timestamp: new Date(Date.now() - 3600000).toISOString() }
  ];
}
---

<DashboardLayout title="Logistics & Inventory" activeItem="inventory">

  <InventoryForm />

  <!-- Offline Database Warning -->
  {!dbConnected && (
    <div class="mb-8 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 flex gap-3 text-xs text-amber-600 font-medium">
      <AlertTriangle class="h-4.5 w-4.5 shrink-0" />
      <div>
        <span class="font-bold">PostgreSQL Connection Offline</span>: System running in mock telemetry mode.
      </div>
    </div>
  )}

  <div class="space-y-6 mb-8">
    <h3 class="text-sm font-bold font-display text-slate-900">Warehouse Stock Levels</h3>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {inventoryItems.map(item => {
        const isLow = item.isLow;
        
        return (
          <div class={`rounded-xl border p-5 flex flex-col justify-between min-h-[180px] transition-all shadow-sm ${
            isLow 
              ? 'border-rose-400/30 bg-white hover:border-rose-400/50' 
              : 'border-slate-200 bg-white hover:border-slate-300'
          }`}>
            <div>
              <div class="flex items-center justify-between gap-3">
                <span class="text-2xs font-semibold text-slate-500 uppercase tracking-widest">{item.sku}</span>
                {isLow && (
                  <span class="rounded bg-rose-500/10 border border-rose-500/20 px-2 py-0.5 text-2xs font-bold text-rose-600 uppercase tracking-wider animate-pulse">
                    Low Stock Warning
                  </span>
                )}
              </div>
              
              <h4 class="text-sm font-bold text-slate-900 mt-2 line-clamp-1">{item.product_name}</h4>
              
              <div class="grid grid-cols-2 gap-4 mt-4">
                <div>
                  <p class="text-3xs text-slate-500 uppercase tracking-wider">Current Stock</p>
                  <p class={`text-xl font-bold font-display mt-0.5 ${isLow ? 'text-rose-500' : 'text-cyan-500'}`}>
                    {item.stock_level} units
                  </p>
                </div>
                <div>
                  <p class="text-3xs text-slate-500 uppercase tracking-wider">Warehouse location</p>
                  <p class="text-xs font-semibold text-slate-700 mt-1 truncate">{item.warehouse_location}</p>
                </div>
              </div>
            </div>

            <!-- Action toggle button trigger -->
            <div class="pt-4 border-t border-slate-200 mt-4 flex items-center justify-between">
              <span class="text-3xs text-slate-500">Min. Alert: {item.low_stock_threshold}</span>
              <button 
                data-inventory-id={item.id}
                class="open-modal-btn text-2xs font-bold text-cyan-600 hover:text-cyan-500 focus:outline-none"
              >
                Adjust Quantities &rarr;
              </button>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Ledger logs below -->
  <div class="space-y-4">
    <h3 class="text-sm font-bold font-display text-slate-900 flex items-center gap-2">
      <FileClock class="h-5 w-5 text-cyan-500" />
      Inventory Transaction Ledger (Audit Logs)
    </h3>
    
    <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 uppercase text-2xs tracking-wider">
              <th class="px-6 py-4 font-semibold">Logged System</th>
              <th class="px-6 py-4 font-semibold">Ledger Reason</th>
              <th class="px-6 py-4 font-semibold text-center">Change</th>
              <th class="px-6 py-4 font-semibold text-center">Previous Stock</th>
              <th class="px-6 py-4 font-semibold text-center">New Stock</th>
              <th class="px-6 py-4 font-semibold">Authorized By</th>
              <th class="px-6 py-4 font-semibold text-right">Timestamp</th>
            </tr>
          </thead>
          <tbody>
            {inventoryLogs.map(log => (
              <tr class="border-b border-slate-100 hover:bg-slate-50 text-xs transition-colors">
                <td class="px-6 py-4">
                  <div class="font-bold text-slate-900">{log.product_name}</div>
                  <div class="text-2xs text-slate-500 mt-0.5">{log.sku}</div>
                </td>
                <td class="px-6 py-4">
                  <span class={`rounded px-1.5 py-0.5 text-2xs font-semibold uppercase ${
                    log.reason === 'purchase' 
                      ? 'bg-emerald-500/10 text-emerald-600' 
                      : log.reason === 'sales' ? 'bg-amber-500/10 text-amber-600' : 'bg-slate-100 text-slate-600'
                  }`}>
                    {log.reason}
                  </span>
                </td>
                <td class={`px-6 py-4 text-center font-bold ${log.change_amount > 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
                  {log.change_amount > 0 ? `+${log.change_amount}` : log.change_amount}
                </td>
                <td class="px-6 py-4 text-center text-slate-500">{log.previous_stock}</td>
                <td class="px-6 py-4 text-center text-slate-900 font-bold">{log.new_stock}</td>
                <td class="px-6 py-4 text-slate-600">{log.user_name || 'System Auto'}</td>
                <td class="px-6 py-4 text-right text-slate-500">{new Date(log.timestamp).toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.open-modal-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const invId = (e.currentTarget as HTMLElement).getAttribute('data-inventory-id');
        document.dispatchEvent(new CustomEvent('open-inventory-modal', { detail: { inventoryId: invId } }));
      });
    });
  </script>
</DashboardLayout>
