---
import Layout from '../layouts/Layout.astro';
import { query } from '../lib/db';
import { Briefcase, LayoutGrid, Calendar, ArrowRight, Award, Layers } from '@lucide/astro';

let allProjects: any[] = [];
let dbConnected = true;

try {
  const res = await query(`
    SELECT *
    FROM projects
    WHERE status = 'active'
    ORDER BY completion_date DESC NULLS LAST, created_at DESC
  `);
  allProjects = res.rows;
} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}

// Server-side query parameter inspection to determine default selection
const initialDivision = Astro.url.searchParams.get('division')?.toLowerCase() || 'all';
const isValidInitial = ['all', 'dtl', 'dgs'].includes(initialDivision) ? initialDivision : 'all';
---

<Layout title="Project Showcase" description="Explore Delight Group's premium engineering feats, architectural lighting landmarks, and automated greenscape installations.">
  <!-- Mesh Dot Background & Dynamic Color Gradients -->
  <div class="min-h-screen bg-[#fcfdfd] relative overflow-hidden">
    <!-- Ambient blurred background elements matching brand divisions -->
    <div class="absolute top-10 left-10 w-[450px] h-[450px] rounded-full bg-blue-300/10 blur-[130px] pointer-events-none select-none z-0"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] rounded-full bg-amber-250/10 blur-[140px] pointer-events-none select-none z-0"></div>
    <div class="absolute bottom-10 left-1/3 w-[500px] h-[500px] rounded-full bg-emerald-250/10 blur-[150px] pointer-events-none select-none z-0"></div>

    <div class="absolute inset-0 z-0 opacity-[0.25]" style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 32px 32px;"></div>
    
    <div class="relative z-10 pt-20 pb-32">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <!-- Hero Section -->
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-blue-500/10 text-blue-600 uppercase tracking-widest border border-blue-500/5">
            <Briefcase class="w-3.5 h-3.5" />
            Project Archive
          </span>
          <h1 class="text-4xl sm:text-6xl font-extrabold font-display text-slate-900 tracking-tight leading-none">
            Hallmark <span class="bg-gradient-to-r from-blue-650 via-amber-600 to-emerald-600 bg-clip-text text-transparent">Achievements</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-500 font-medium leading-relaxed max-w-xl mx-auto">
            Discover our engineering feats and sustainable installations. Use the interactive filters to explore division-specific contract deployments across the UAE.
          </p>
        </div>

        <!-- Sliding Navigation Filter Tabs (Glassmorphic) -->
        <div class="max-w-md mx-auto mb-16 relative z-20">
          <div class="bg-white/80 backdrop-blur-xl border border-slate-200/60 p-1.5 rounded-2xl shadow-xl shadow-slate-200/5 flex items-center justify-between">
            
            <!-- All Tab -->
            <button 
              id="tab-all"
              data-target="all"
              class={`flex-1 py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-2 select-none cursor-pointer ${isValidInitial === 'all' ? 'bg-gradient-to-r from-blue-600 to-indigo-650 text-white shadow-md shadow-blue-500/15' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50/50'}`}
            >
              <LayoutGrid class="w-3.5 h-3.5 shrink-0" />
              <span>All</span>
            </button>

            <!-- DTL Tab -->
            <button 
              id="tab-dtl"
              data-target="dtl"
              class={`flex-1 py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-2 select-none cursor-pointer ${isValidInitial === 'dtl' ? 'bg-gradient-to-r from-amber-500 to-amber-600 text-white shadow-md shadow-amber-500/15' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50/50'}`}
            >
              <Award class="w-3.5 h-3.5 shrink-0" />
              <span>Lighting</span>
            </button>

            <!-- DGS Tab -->
            <button 
              id="tab-dgs"
              data-target="dgs"
              class={`flex-1 py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-2 select-none cursor-pointer ${isValidInitial === 'dgs' ? 'bg-gradient-to-r from-emerald-550 to-emerald-650 text-white shadow-md shadow-emerald-500/15' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50/50'}`}
            >
              <Layers class="w-3.5 h-3.5 shrink-0" />
              <span>Greenscapes</span>
            </button>

          </div>
        </div>

        <!-- Project Cards Grid -->
        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 transition-all duration-500">
          {allProjects.map((project) => {
            const isDtlProj = project.division === 'dtl';
            const yearStr = project.completion_date ? new Date(project.completion_date).getFullYear() : 'Ongoing';
            
            return (
              <div 
                data-division={project.division}
                class={`project-card group bg-white/80 backdrop-blur-md rounded-2xl border border-slate-200/60 overflow-hidden shadow-xl shadow-slate-200/5 transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-between ${isValidInitial !== 'all' && project.division !== isValidInitial ? 'hidden opacity-0 scale-95' : 'block opacity-100 scale-100'}`}
              >
                <div>
                  <!-- Image Block -->
                  <div class="h-52 bg-slate-100 relative overflow-hidden shrink-0 border-b border-slate-100">
                    {project.featured_image ? (
                      <img 
                        src={project.featured_image} 
                        alt={project.title} 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103" 
                        loading="lazy"
                      />
                    ) : (
                      <div class={`absolute inset-0 bg-gradient-to-br flex items-center justify-center select-none ${isDtlProj ? 'from-amber-500/10 to-amber-600/5' : 'from-emerald-500/10 to-emerald-600/5'}`}>
                        <span class={`font-display font-black text-4xl tracking-widest opacity-25 ${isDtlProj ? 'text-amber-650' : 'text-emerald-700'}`}>
                          {isDtlProj ? 'DTL' : 'DGS'}
                        </span>
                      </div>
                    )}
                    
                    <!-- Division Badge (Left) -->
                    <div class="absolute top-4 left-4 z-10">
                      <span class={`inline-flex items-center px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-wider shadow-sm border ${isDtlProj ? 'bg-amber-50 text-amber-700 border-amber-200/50' : 'bg-emerald-50 text-emerald-700 border-emerald-200/50'}`}>
                        {isDtlProj ? 'Technical Lighting' : 'Greenscapes'}
                      </span>
                    </div>

                    <!-- Year Badge (Right) -->
                    <div class="absolute top-4 right-4 z-10">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-white/95 backdrop-blur text-[9px] font-extrabold text-slate-600 shadow-sm border border-slate-100">
                        <Calendar class="w-3 h-3 text-slate-400" />
                        {yearStr}
                      </span>
                    </div>
                  </div>

                  <!-- Details Area -->
                  <div class="p-8 text-left space-y-3">
                    <span class={`text-[10px] font-black uppercase tracking-widest ${isDtlProj ? 'text-amber-650' : 'text-emerald-700'}`}>
                      {project.client_name || 'Enterprise Deployment'}
                    </span>
                    <h3 class="text-lg font-bold text-slate-900 leading-snug group-hover:text-slate-950 transition-colors">
                      {project.title}
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed font-semibold line-clamp-3">
                      {project.description}
                    </p>
                  </div>
                </div>

                <!-- Glow Hover Border Highlight -->
                <div class={`h-1.5 w-full mt-auto bg-gradient-to-r opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${isDtlProj ? 'from-amber-400 to-amber-500' : 'from-emerald-550 to-emerald-650'}`}></div>
              </div>
            );
          })}
        </div>

        <!-- Empty State Container -->
        <div id="empty-state" class="hidden max-w-md mx-auto text-center py-20 px-6 bg-slate-50/50 border border-slate-200/50 rounded-2xl mt-8">
          <Briefcase class="w-12 h-12 text-slate-300 mx-auto mb-4" />
          <h3 class="text-base font-bold text-slate-800">No projects found</h3>
          <p class="text-xs text-slate-500 mt-1">There are currently no active highlighted projects registered under this category.</p>
        </div>

      </div>
    </div>
  </div>
</Layout>

<script>
  // Client-side Zero-Reload Filtering and Sliding Tab Styling
  const buttons = document.querySelectorAll('[data-target]');
  const cards = document.querySelectorAll('.project-card');
  const emptyState = document.getElementById('empty-state');

  // Shared function to switch tabs and trigger smooth filtering
  function filterDivision(target: string, updateUrl: boolean = true) {
    let visibleCount = 0;

    // 1) Update active tab styles
    buttons.forEach((btn) => {
      const dataVal = btn.getAttribute('data-target');
      const isActive = dataVal === target;

      btn.className = 'flex-1 py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-2 select-none cursor-pointer ';

      if (isActive) {
        if (target === 'all') {
          btn.classList.add('bg-gradient-to-r', 'from-blue-600', 'to-indigo-650', 'text-white', 'shadow-md', 'shadow-blue-500/15');
        } else if (target === 'dtl') {
          btn.classList.add('bg-gradient-to-r', 'from-amber-500', 'to-amber-600', 'text-white', 'shadow-md', 'shadow-amber-500/15');
        } else if (target === 'dgs') {
          btn.classList.add('bg-gradient-to-r', 'from-emerald-550', 'to-emerald-650', 'text-white', 'shadow-md', 'shadow-emerald-500/15');
        }
      } else {
        btn.classList.add('text-slate-500', 'hover:text-slate-800', 'hover:bg-slate-50/50');
      }
    });

    // 2) Filter grid card items smoothly
    cards.forEach((card) => {
      const div = card.getAttribute('data-division');
      const match = target === 'all' || div === target;

      if (match) {
        visibleCount++;
        card.classList.remove('hidden', 'opacity-0', 'scale-95');
        card.classList.add('block');
        // Let browser trigger display then scale up
        setTimeout(() => {
          card.classList.remove('opacity-0', 'scale-95');
          card.classList.add('opacity-100', 'scale-100');
        }, 10);
      } else {
        card.classList.remove('opacity-100', 'scale-100');
        card.classList.add('opacity-0', 'scale-95');
        // Delay hiding item to let fade transitions complete
        setTimeout(() => {
          if (card.classList.contains('opacity-0')) {
            card.classList.remove('block');
            card.classList.add('hidden');
          }
        }, 300);
      }
    });

    // 3) Handle empty state panel
    if (visibleCount === 0) {
      emptyState?.classList.remove('hidden');
      emptyState?.classList.add('block');
    } else {
      emptyState?.classList.remove('block');
      emptyState?.classList.add('hidden');
    }

    // 4) Update browser address bar dynamically without full-page reloads
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (target === 'all') {
        url.searchParams.delete('division');
      } else {
        url.searchParams.set('division', target);
      }
      window.history.replaceState({}, '', url.toString());
    }
  }

  // Bind click handlers to buttons
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target') || 'all';
      filterDivision(target);
    });
  });

  // Watch URL hash / popstate to keep tabs aligned during browser history navigation
  window.addEventListener('popstate', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const div = urlParams.get('division')?.toLowerCase() || 'all';
    filterDivision(div, false);
  });
</script>
