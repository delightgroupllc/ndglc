---
import Layout from '../layouts/Layout.astro';
import { query } from '../lib/db';
import { 
  Briefcase, 
  LayoutGrid, 
  Calendar, 
  ArrowRight, 
  Award, 
  Layers, 
  ShieldCheck, 
  Maximize2, 
  ArrowLeft, 
  X, 
  Grid2X2, 
  Grid3X3, 
  Rows3, 
  List 
} from '@lucide/astro';

let allProjects: any[] = [];
let dbConnected = true;

try {
  const res = await query(`
    SELECT *
    FROM projects
    WHERE status = 'active'
    ORDER BY completion_date DESC NULLS LAST, created_at DESC
  `);
  allProjects = res.rows;
} catch (err: any) {
  console.warn('Database offline:', err.message);
  dbConnected = false;
}

// Server-side query parameter inspection to determine default selection
const initialDivision = Astro.url.searchParams.get('division')?.toLowerCase() || 'all';
const isValidInitial = ['all', 'dtl', 'dgs', 'dv'].includes(initialDivision) ? initialDivision : 'all';
---

<Layout title="Project Showcase" description="Explore Delight Group's premium engineering feats, architectural lighting landmarks, and automated greenscape installations.">
  <!-- Mesh Dot Background & Dynamic Color Gradients -->
  <div class="min-h-screen bg-[#fcfdfd] relative overflow-hidden">
    <!-- Ambient blurred background elements matching brand divisions -->
    <div class="absolute top-10 left-10 w-[450px] h-[450px] rounded-full bg-blue-300/10 blur-[130px] pointer-events-none select-none z-0"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] rounded-full bg-amber-250/10 blur-[140px] pointer-events-none select-none z-0"></div>
    <div class="absolute bottom-10 left-1/3 w-[500px] h-[500px] rounded-full bg-emerald-250/10 blur-[150px] pointer-events-none select-none z-0"></div>
    <div class="absolute top-2/3 right-10 w-[450px] h-[450px] rounded-full bg-violet-400/10 blur-[150px] pointer-events-none select-none z-0"></div>

    <div class="absolute inset-0 z-0 opacity-[0.25]" style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 32px 32px;"></div>
    
    <div class="relative z-10 pt-20 pb-32">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <!-- Hero Section -->
        <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-blue-500/10 text-blue-600 uppercase tracking-widest border border-blue-500/10">
            <Briefcase class="w-3.5 h-3.5" />
            Project Archive
          </span>
          <h1 class="text-4xl sm:text-6xl font-extrabold font-display text-slate-900 tracking-tight leading-none">
            Hallmark <span class="bg-gradient-to-r from-blue-600 via-amber-600 via-emerald-600 to-violet-600 bg-clip-text text-transparent">Achievements</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-500 font-medium leading-relaxed max-w-xl mx-auto">
            Discover our engineering feats and sustainable installations. Use the interactive division filters and layout options to explore contract deployments across the UAE.
          </p>
        </div>

        <!-- Controls Toolbar: Division Tabs & Layout Switcher (3x2, 3x1, 3x3, List) -->
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-10 max-w-7xl mx-auto relative z-20">
          
          <!-- Sliding Navigation Filter Tabs (Glassmorphic) -->
          <div class="w-full md:w-auto">
            <div class="bg-white/90 backdrop-blur-xl border border-slate-200/80 p-1.5 rounded-2xl shadow-lg shadow-slate-200/30 flex items-center justify-between gap-1 w-full md:min-w-[440px]">
              
              <!-- All Tab -->
              <button 
                id="tab-all"
                data-target="all"
                type="button"
                class={`flex-1 py-2.5 px-3 sm:px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-1.5 select-none cursor-pointer ${isValidInitial === 'all' ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/20' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50/50'}`}
              >
                <LayoutGrid class="w-3.5 h-3.5 shrink-0" />
                <span>All</span>
              </button>

              <!-- DTL Tab -->
              <button 
                id="tab-dtl"
                data-target="dtl"
                type="button"
                class={`flex-1 py-2.5 px-3 sm:px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-1.5 select-none cursor-pointer ${isValidInitial === 'dtl' ? 'bg-gradient-to-r from-amber-500 to-amber-600 text-white shadow-md shadow-amber-500/20' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50/50'}`}
              >
                <Award class="w-3.5 h-3.5 shrink-0" />
                <span>Lighting</span>
              </button>

              <!-- DGS Tab -->
              <button 
                id="tab-dgs"
                data-target="dgs"
                type="button"
                class={`flex-1 py-2.5 px-3 sm:px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-1.5 select-none cursor-pointer ${isValidInitial === 'dgs' ? 'bg-gradient-to-r from-emerald-600 to-emerald-700 text-white shadow-md shadow-emerald-600/20' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50/50'}`}
              >
                <Layers class="w-3.5 h-3.5 shrink-0" />
                <span>Greenscapes</span>
              </button>

              <!-- DV Tab -->
              <button 
                id="tab-dv"
                data-target="dv"
                type="button"
                class={`flex-1 py-2.5 px-3 sm:px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-1.5 select-none cursor-pointer ${isValidInitial === 'dv' ? 'bg-gradient-to-r from-violet-600 to-indigo-600 text-white shadow-md shadow-violet-500/20' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50/50'}`}
              >
                <ShieldCheck class="w-3.5 h-3.5 shrink-0" />
                <span>Vision</span>
              </button>

            </div>
          </div>

          <!-- View Layout Switcher (3x2, 3x1, 3x3, List) -->
          <div class="flex items-center gap-2 self-center md:self-auto">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 hidden sm:inline-block mr-1">Layout:</span>
            <div class="bg-white/90 backdrop-blur-xl border border-slate-200/80 p-1 rounded-2xl shadow-lg shadow-slate-200/30 flex items-center gap-1">
              
              <!-- 3x2 Grid (Standard 3 Columns) -->
              <button
                id="layout-btn-3x2"
                data-layout="3x2"
                type="button"
                title="3x2 Grid View (Standard 3 Columns)"
                class="layout-mode-btn py-2 px-3 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer bg-slate-900 text-white shadow-sm"
              >
                <LayoutGrid class="w-3.5 h-3.5" />
                <span class="text-[11px] tracking-wide font-black">3×2</span>
              </button>

              <!-- 3x1 Layout (Single Row 3 Items / Wide Single Column) -->
              <button
                id="layout-btn-3x1"
                data-layout="3x1"
                type="button"
                title="3x1 Wide View"
                class="layout-mode-btn py-2 px-3 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              >
                <Rows3 class="w-3.5 h-3.5" />
                <span class="text-[11px] tracking-wide font-black">3×1</span>
              </button>

              <!-- 3x3 Dense Grid View -->
              <button
                id="layout-btn-3x3"
                data-layout="3x3"
                type="button"
                title="3x3 Dense Grid View"
                class="layout-mode-btn py-2 px-3 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              >
                <Grid3X3 class="w-3.5 h-3.5" />
                <span class="text-[11px] tracking-wide font-black">3×3</span>
              </button>

              <!-- List View -->
              <button
                id="layout-btn-list"
                data-layout="list"
                type="button"
                title="Detailed Horizontal List View"
                class="layout-mode-btn py-2 px-3 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              >
                <List class="w-3.5 h-3.5" />
                <span class="text-[11px] tracking-wide font-black">List</span>
              </button>
            </div>
          </div>

        </div>

        <!-- Project Cards Grid -->
        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 transition-all duration-300">
          {allProjects.map((project) => {
            const isDtlProj = project.division === 'dtl';
            const isDgsProj = project.division === 'dgs';
            const isDvProj = project.division === 'dv';
            const yearStr = project.completion_date ? new Date(project.completion_date).getFullYear() : 'Ongoing';
            const fullDivisionName = isDtlProj ? 'Delight Technical Lighting' : isDgsProj ? 'Delight Greenscapes' : 'Delight Vision';
            
            return (
              <div 
                data-project-id={project.id}
                data-division={project.division}
                data-title={project.title}
                data-client={project.client_name || 'Enterprise Deployment'}
                data-division-name={fullDivisionName}
                data-year={yearStr}
                data-image={project.featured_image || ''}
                data-description={project.description || ''}
                class={`project-card group bg-white/90 backdrop-blur-md rounded-2xl border border-slate-200/80 overflow-hidden shadow-xl shadow-slate-200/5 transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between cursor-pointer ${isValidInitial !== 'all' && project.division !== isValidInitial ? 'hidden opacity-0 scale-95' : 'block opacity-100 scale-100'}`}
              >
                <div class="project-card-inner flex flex-col flex-1">
                  <!-- Image Block -->
                  <div class="project-image-box h-52 bg-slate-100 relative overflow-hidden shrink-0 border-b border-slate-100">
                    {project.featured_image ? (
                      <img 
                        src={project.featured_image} 
                        alt={project.title} 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                        loading="lazy"
                      />
                    ) : (
                      <div class={`absolute inset-0 bg-gradient-to-br flex items-center justify-center select-none ${isDtlProj ? 'from-amber-500/10 to-amber-600/5' : isDgsProj ? 'from-emerald-500/10 to-emerald-600/5' : 'from-violet-500/10 to-indigo-600/5'}`}>
                        <span class={`font-display font-black text-4xl tracking-widest opacity-25 ${isDtlProj ? 'text-amber-600' : isDgsProj ? 'text-emerald-700' : 'text-violet-700'}`}>
                          {isDtlProj ? 'DTL' : isDgsProj ? 'DGS' : 'DV'}
                        </span>
                      </div>
                    )}
                    
                    <!-- Division Badge (Left) -->
                    <div class="absolute top-4 left-4 z-10">
                      <span class={`inline-flex items-center px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-wider shadow-sm border ${
                        isDtlProj ? 'bg-amber-50 text-amber-700 border-amber-200/50' :
                        isDgsProj ? 'bg-emerald-50 text-emerald-700 border-emerald-200/50' :
                        'bg-violet-50 text-violet-700 border-violet-200/50'
                      }`}>
                        {isDtlProj ? 'Technical Lighting' : isDgsProj ? 'Greenscapes' : 'Delight Vision'}
                      </span>
                    </div>

                    <!-- Year Badge (Right) -->
                    <div class="absolute top-4 right-4 z-10">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-white/95 backdrop-blur text-[9px] font-extrabold text-slate-600 shadow-sm border border-slate-100">
                        <Calendar class="w-3 h-3 text-slate-400" />
                        {yearStr}
                      </span>
                    </div>

                    <!-- Fullscreen Hover Action Button -->
                    <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center z-10">
                      <button 
                        type="button"
                        class="px-4 py-2 rounded-xl bg-white/95 text-slate-900 font-bold text-xs uppercase tracking-wider shadow-xl flex items-center gap-2 hover:bg-white hover:scale-105 transition-all"
                        aria-label={`View ${project.title} Fullscreen`}
                      >
                        <Maximize2 class="w-3.5 h-3.5 text-blue-600" />
                        <span>Fullscreen View</span>
                      </button>
                    </div>
                  </div>

                  <!-- Details Area -->
                  <div class="project-details-box p-6 sm:p-7 text-left space-y-3 flex-1 flex flex-col justify-between">
                    <div class="space-y-2">
                      <span class={`text-[10px] font-black uppercase tracking-widest ${
                        isDtlProj ? 'text-amber-600' :
                        isDgsProj ? 'text-emerald-700' :
                        'text-violet-700'
                      }`}>
                        {project.client_name || 'Enterprise Deployment'}
                      </span>
                      <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug group-hover:text-slate-950 transition-colors">
                        {project.title}
                      </h3>
                      <p class="text-xs text-slate-500 leading-relaxed font-medium line-clamp-3">
                        {project.description}
                      </p>
                    </div>

                    <div class="pt-2 flex items-center justify-between border-t border-slate-100/80 text-[11px] font-bold text-slate-400 group-hover:text-blue-600 transition-colors">
                      <span class="flex items-center gap-1.5">
                        <Maximize2 class="w-3 h-3" />
                        <span>Click for Full Details</span>
                      </span>
                      <ArrowRight class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" />
                    </div>
                  </div>
                </div>

                <!-- Glow Hover Border Highlight -->
                <div class={`h-1.5 w-full mt-auto bg-gradient-to-r opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${
                  isDtlProj ? 'from-amber-400 to-amber-500' :
                  isDgsProj ? 'from-emerald-500 to-emerald-600' :
                  'from-violet-500 to-indigo-600'
                }`}></div>
              </div>
            );
          })}
        </div>

        <!-- Empty State Container -->
        <div id="empty-state" class="hidden max-w-md mx-auto text-center py-20 px-6 bg-slate-50/50 border border-slate-200/50 rounded-2xl mt-8">
          <Briefcase class="w-12 h-12 text-slate-300 mx-auto mb-4" />
          <h3 class="text-base font-bold text-slate-800">No projects found</h3>
          <p class="text-xs text-slate-500 mt-1">There are currently no active highlighted projects registered under this category.</p>
        </div>

      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- Fullscreen Project Modal with Dedicated "Go Back" Navigation Header      -->
  <!-- ========================================================================= -->
  <div 
    id="project-fullscreen-modal" 
    class="fixed inset-0 z-[150] bg-slate-950/85 backdrop-blur-xl hidden opacity-0 transition-opacity duration-300 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-project-title"
  >
    <!-- Sticky Top Bar with High-Visibility "Go Back" Button -->
    <header class="sticky top-0 z-30 w-full bg-slate-900/90 backdrop-blur-md border-b border-slate-800/80 px-4 sm:px-8 py-3.5 flex items-center justify-between">
      <!-- High-visibility GO BACK button -->
      <button 
        id="modal-go-back-btn" 
        type="button"
        class="inline-flex items-center gap-2.5 px-4 sm:px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 active:bg-white/25 text-white font-extrabold text-xs uppercase tracking-wider border border-white/15 shadow-lg transition-all duration-200 cursor-pointer group"
      >
        <ArrowLeft class="w-4 h-4 text-white group-hover:-translate-x-1 transition-transform" />
        <span>← Go Back</span>
        <span class="hidden sm:inline-block text-[10px] text-white/50 font-normal ml-1">or press ESC</span>
      </button>

      <div class="flex items-center gap-2">
        <span id="modal-top-division-tag" class="text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30">
          Project View
        </span>
        <button 
          id="modal-close-icon-btn" 
          type="button" 
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
          aria-label="Close project viewer"
        >
          <X class="w-5 h-5" />
        </button>
      </div>
    </header>

    <!-- Modal Content Body -->
    <main class="max-w-6xl mx-auto px-4 sm:px-8 py-8 sm:py-12">
      <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl">
        
        <!-- Large Full-bleed Image Container with expand capability -->
        <div class="relative w-full bg-black aspect-video sm:aspect-[21/9] max-h-[560px] overflow-hidden flex items-center justify-center">
          <img 
            id="modal-project-image" 
            src="" 
            alt="Project view" 
            class="w-full h-full object-contain sm:object-cover transition-transform duration-500" 
          />
          <div id="modal-image-placeholder" class="hidden absolute inset-0 bg-gradient-to-br from-slate-800 to-slate-950 flex flex-col items-center justify-center text-center p-6">
            <Briefcase class="w-16 h-16 text-slate-600 mb-3" />
            <span class="text-slate-400 font-bold uppercase tracking-widest text-xs">Delight Group Landmark Project</span>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent pointer-events-none"></div>
        </div>

        <!-- Meta Details and Description -->
        <div class="p-6 sm:p-10 space-y-6">
          
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-6">
            <div class="space-y-1">
              <span id="modal-project-client" class="text-xs font-black uppercase tracking-widest text-blue-400">
                Enterprise Client
              </span>
              <h2 id="modal-project-title" class="text-2xl sm:text-4xl font-black font-display text-white tracking-tight">
                Project Title
              </h2>
            </div>

            <div class="flex items-center gap-3">
              <span id="modal-project-division-badge" class="px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-slate-800 text-slate-200 border border-slate-700">
                Division
              </span>
              <span id="modal-project-year" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-extrabold bg-slate-800/80 text-slate-300 border border-slate-700">
                <Calendar class="w-3.5 h-3.5 text-slate-400" />
                <span id="modal-project-year-val">2025</span>
              </span>
            </div>
          </div>

          <!-- Description Section -->
          <div class="space-y-3">
            <h4 class="text-xs font-black uppercase tracking-widest text-slate-400">About this Project</h4>
            <p id="modal-project-description" class="text-slate-300 text-sm sm:text-base leading-relaxed whitespace-pre-line font-normal">
              Project description narrative goes here.
            </p>
          </div>

          <!-- Bottom Actions inside Fullscreen view -->
          <div class="pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
            <button 
              id="modal-bottom-goback-btn" 
              type="button" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer border border-slate-700"
            >
              <ArrowLeft class="w-4 h-4" />
              <span>Go Back to Grid</span>
            </button>

            <a 
              href="/contact" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-blue-600/30 transition-all cursor-pointer"
            >
              <span>Consult on Similar Project</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>

        </div>

      </div>
    </main>
  </div>
</Layout>

<script>
  // Division Filtering
  const buttons = document.querySelectorAll('[data-target]');
  const cards = document.querySelectorAll('.project-card');
  const emptyState = document.getElementById('empty-state');
  const projectsGrid = document.getElementById('projects-grid');
  const layoutBtns = document.querySelectorAll('.layout-mode-btn');

  // Shared function to switch tabs and trigger smooth filtering
  function filterDivision(target: string, updateUrl: boolean = true) {
    let visibleCount = 0;

    // 1) Update active tab styles
    buttons.forEach((btn) => {
      const dataVal = btn.getAttribute('data-target');
      const isActive = dataVal === target;

      btn.className = 'flex-1 py-2.5 px-3 sm:px-4 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-1.5 select-none cursor-pointer ';

      if (isActive) {
        if (target === 'all') {
          btn.classList.add('bg-gradient-to-r', 'from-blue-600', 'to-indigo-600', 'text-white', 'shadow-md', 'shadow-blue-500/20');
        } else if (target === 'dtl') {
          btn.classList.add('bg-gradient-to-r', 'from-amber-500', 'to-amber-600', 'text-white', 'shadow-md', 'shadow-amber-500/20');
        } else if (target === 'dgs') {
          btn.classList.add('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md', 'shadow-emerald-600/20');
        } else if (target === 'dv') {
          btn.classList.add('bg-gradient-to-r', 'from-violet-600', 'to-indigo-600', 'text-white', 'shadow-md', 'shadow-violet-500/20');
        }
      } else {
        btn.classList.add('text-slate-500', 'hover:text-slate-800', 'hover:bg-slate-50/50');
      }
    });

    // 2) Filter grid card items smoothly
    cards.forEach((card) => {
      const div = card.getAttribute('data-division');
      const match = target === 'all' || div === target;

      if (match) {
        visibleCount++;
        card.classList.remove('hidden', 'opacity-0', 'scale-95');
        card.classList.add('block');
        setTimeout(() => {
          card.classList.remove('opacity-0', 'scale-95');
          card.classList.add('opacity-100', 'scale-100');
        }, 10);
      } else {
        card.classList.remove('opacity-100', 'scale-100');
        card.classList.add('opacity-0', 'scale-95');
        setTimeout(() => {
          if (card.classList.contains('opacity-0')) {
            card.classList.remove('block');
            card.classList.add('hidden');
          }
        }, 300);
      }
    });

    // 3) Handle empty state panel
    if (visibleCount === 0) {
      emptyState?.classList.remove('hidden');
      emptyState?.classList.add('block');
    } else {
      emptyState?.classList.remove('block');
      emptyState?.classList.add('hidden');
    }

    // 4) Update browser address bar dynamically without full-page reloads
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (target === 'all') {
        url.searchParams.delete('division');
      } else {
        url.searchParams.set('division', target);
      }
      window.history.replaceState({}, '', url.toString());
    }
  }

  // Bind click handlers to division buttons
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target') || 'all';
      filterDivision(target);
    });
  });

  // =========================================================================
  // Layout Switcher Logic (3x2, 3x1, 3x3, list)
  // =========================================================================
  function applyLayout(layout: string, saveToStorage: boolean = true) {
    if (!projectsGrid) return;

    // Reset grid classes
    projectsGrid.className = 'transition-all duration-300 ';

    // Reset inner card structures
    cards.forEach((card) => {
      const inner = card.querySelector('.project-card-inner');
      const imgBox = card.querySelector('.project-image-box');
      const detailsBox = card.querySelector('.project-details-box');

      if (layout === 'list') {
        // Horizontal list card
        inner?.classList.remove('flex-col');
        inner?.classList.add('flex-col', 'md:flex-row');
        if (imgBox) {
          imgBox.className = 'project-image-box h-56 md:h-auto md:w-80 shrink-0 bg-slate-100 relative overflow-hidden border-b md:border-b-0 md:border-r border-slate-100';
        }
      } else {
        // Standard vertical card
        inner?.classList.remove('md:flex-row');
        inner?.classList.add('flex-col');
        if (imgBox) {
          const hClass = layout === '3x3' ? 'h-44' : layout === '3x1' ? 'h-72 sm:h-80' : 'h-52';
          imgBox.className = `project-image-box ${hClass} bg-slate-100 relative overflow-hidden shrink-0 border-b border-slate-100`;
        }
      }
    });

    if (layout === '3x2') {
      // Standard 3 columns grid
      projectsGrid.classList.add('grid', 'grid-cols-1', 'md:grid-cols-2', 'lg:grid-cols-3', 'gap-8');
    } else if (layout === '3x1') {
      // 1-column wide showcase view (3x1 stack)
      projectsGrid.classList.add('grid', 'grid-cols-1', 'max-w-4xl', 'mx-auto', 'gap-10');
    } else if (layout === '3x3') {
      // Dense 3-columns grid
      projectsGrid.classList.add('grid', 'grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3', 'gap-5');
    } else if (layout === 'list') {
      // Horizontal list layout
      projectsGrid.classList.add('grid', 'grid-cols-1', 'max-w-5xl', 'mx-auto', 'gap-6');
    }

    // Update active layout button styling
    layoutBtns.forEach((btn) => {
      const btnLayout = btn.getAttribute('data-layout');
      if (btnLayout === layout) {
        btn.className = 'layout-mode-btn py-2 px-3 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer bg-slate-900 text-white shadow-sm';
      } else {
        btn.className = 'layout-mode-btn py-2 px-3 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-100';
      }
    });

    if (saveToStorage) {
      try {
        localStorage.setItem('projects_layout_mode', layout);
      } catch (e) {}
    }
  }

  layoutBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-layout') || '3x2';
      applyLayout(mode);
    });
  });

  // Restore saved layout or default to 3x2
  try {
    const savedLayout = localStorage.getItem('projects_layout_mode');
    if (savedLayout && ['3x2', '3x1', '3x3', 'list'].includes(savedLayout)) {
      applyLayout(savedLayout, false);
    }
  } catch (e) {}

  // =========================================================================
  // Fullscreen Project Lightbox Viewer with "Go Back" Navigation
  // =========================================================================
  const modal = document.getElementById('project-fullscreen-modal');
  const modalGoBackBtn = document.getElementById('modal-go-back-btn');
  const modalCloseIconBtn = document.getElementById('modal-close-icon-btn');
  const modalBottomGoBackBtn = document.getElementById('modal-bottom-goback-btn');
  const modalImg = document.getElementById('modal-project-image') as HTMLImageElement | null;
  const modalPlaceholder = document.getElementById('modal-image-placeholder');
  const modalTitle = document.getElementById('modal-project-title');
  const modalClient = document.getElementById('modal-project-client');
  const modalYear = document.getElementById('modal-project-year-val');
  const modalDesc = document.getElementById('modal-project-description');
  const modalDivBadge = document.getElementById('modal-project-division-badge');
  const modalTopDivTag = document.getElementById('modal-top-division-tag');

  function openProjectFullscreen(card: Element) {
    if (!modal) return;

    const title = card.getAttribute('data-title') || '';
    const client = card.getAttribute('data-client') || '';
    const divisionName = card.getAttribute('data-division-name') || '';
    const division = card.getAttribute('data-division') || '';
    const year = card.getAttribute('data-year') || '';
    const image = card.getAttribute('data-image') || '';
    const description = card.getAttribute('data-description') || '';
    const projId = card.getAttribute('data-project-id') || '';

    if (modalTitle) modalTitle.textContent = title;
    if (modalClient) modalClient.textContent = client;
    if (modalYear) modalYear.textContent = year;
    if (modalDesc) modalDesc.textContent = description || 'Detailed specification and execution details for this installation are available upon request.';
    if (modalDivBadge) modalDivBadge.textContent = divisionName;
    if (modalTopDivTag) modalTopDivTag.textContent = divisionName;

    if (modalImg && modalPlaceholder) {
      if (image) {
        modalImg.src = image;
        modalImg.alt = title;
        modalImg.classList.remove('hidden');
        modalPlaceholder.classList.add('hidden');
      } else {
        modalImg.classList.add('hidden');
        modalPlaceholder.classList.remove('hidden');
      }
    }

    // Division accent colors for badge
    if (modalDivBadge) {
      if (division === 'dtl') {
        modalDivBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30';
      } else if (division === 'dgs') {
        modalDivBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
      } else if (division === 'dv') {
        modalDivBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-violet-500/20 text-violet-300 border border-violet-500/30';
      } else {
        modalDivBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-blue-500/20 text-blue-300 border border-blue-500/30';
      }
    }

    // Open modal
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
    }, 10);

    // Update URL hash for clean deep linking & browser back button support
    if (projId) {
      const url = new URL(window.location.href);
      url.hash = `project-${projId}`;
      window.history.pushState({ modalOpen: true, projId }, '', url.toString());
    }
  }

  function closeProjectFullscreen(shouldUpdateHistory: boolean = true) {
    if (!modal) return;
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);

    if (shouldUpdateHistory && window.location.hash.startsWith('#project-')) {
      const url = new URL(window.location.href);
      url.hash = '';
      window.history.replaceState({}, '', url.toString());
    }
  }

  // Attach card click triggers to open fullscreen modal
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // Don't trigger if user clicked an external link if present
      const target = e.target as HTMLElement;
      if (target.closest('a') && !target.closest('.project-card')) return;
      openProjectFullscreen(card);
    });
  });

  // Dedicated "Go Back" button handlers
  modalGoBackBtn?.addEventListener('click', () => closeProjectFullscreen());
  modalBottomGoBackBtn?.addEventListener('click', () => closeProjectFullscreen());
  modalCloseIconBtn?.addEventListener('click', () => closeProjectFullscreen());

  // Close on ESC key press
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeProjectFullscreen();
    }
  });

  // Watch URL hash / popstate to handle browser Back button smoothly
  window.addEventListener('popstate', (e) => {
    // If modal is open and user pressed back
    if (modal && !modal.classList.contains('hidden')) {
      closeProjectFullscreen(false);
    }

    // Sync division filter
    const urlParams = new URLSearchParams(window.location.search);
    const div = urlParams.get('division')?.toLowerCase() || 'all';
    filterDivision(div, false);
  });

  // Initial synchronization with current URL search params and hash on mount
  const initialParams = new URLSearchParams(window.location.search);
  const initialDiv = initialParams.get('division')?.toLowerCase() || 'all';
  if (['all', 'dtl', 'dgs', 'dv'].includes(initialDiv)) {
    filterDivision(initialDiv, false);
  }

  // Check if opened with hash #project-[id]
  if (window.location.hash.startsWith('#project-')) {
    const targetId = window.location.hash.replace('#project-', '');
    const matchedCard = document.querySelector(`.project-card[data-project-id="${targetId}"]`);
    if (matchedCard) {
      openProjectFullscreen(matchedCard);
    }
  }
</script>

