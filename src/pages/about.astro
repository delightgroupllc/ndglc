---
import Layout from '../layouts/Layout.astro';
import { Mail, Phone, MapPin, ShieldCheck, Heart, Scale, Truck, ArrowRight, Sparkles } from 'lucide-astro';
---

<Layout title="Our Story" description="Redefining the supply experience in the UAE. Greetings from Delight Group LLC.">
  <!-- Warm Sand Editorial Background canvas -->
  <div class="min-h-screen bg-[#fbfaf7] relative overflow-hidden">
    <!-- Subtle architectural guidelines dot grid pattern -->
    <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#000000 1.5px, transparent 1.5px); background-size: 32px 32px;"></div>
    
    <!-- Floating background leaf & light sparkles pattern (Subtle parallax) -->
    <div class="absolute top-24 left-[8%] z-0 w-8 h-8 opacity-[0.1] pointer-events-none select-none parallax-leaf" data-speed="0.06" data-rotation="15">
      <img src="/leaf-left.svg" alt="" class="w-full h-auto" />
    </div>
    <div class="absolute top-[800px] right-[10%] z-0 w-5 h-5 opacity-[0.12] pointer-events-none select-none text-amber-500/70 parallax-leaf" data-speed="-0.05" data-rotation="-25">
      <svg viewBox="0 0 24 24" fill="currentColor" class="w-full h-auto"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2z"/></svg>
    </div>
    <div class="absolute top-[1600px] left-[15%] z-0 w-7 h-7 opacity-[0.09] pointer-events-none select-none parallax-leaf" data-speed="0.04" data-rotation="40">
      <img src="/leaf-right.svg" alt="" class="w-full h-auto" />
    </div>
    <div class="absolute top-[2400px] right-[12%] z-0 w-5 h-5 opacity-[0.11] pointer-events-none select-none text-amber-500/80 parallax-leaf" data-speed="-0.07" data-rotation="30">
      <svg viewBox="0 0 24 24" fill="currentColor" class="w-full h-auto"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2z"/></svg>
    </div>

    <div class="relative z-10">
      
      <!-- Section 1: Our Story (Top Header) - Base Canvas -->
      <section class="py-16 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <!-- Text details -->
          <div class="lg:col-span-8 space-y-4 text-left">
            <span class="text-[9px] font-black uppercase tracking-[0.25em] text-[#a34e36] block">
              Greetings from Delight Group LLC
            </span>
            <h1 class="text-4xl sm:text-6xl font-serif text-[#0f2d1d] font-semibold leading-tight tracking-tight">
              Our Story
            </h1>
            <p class="text-slate-600 font-semibold text-sm sm:text-base leading-relaxed max-w-2xl">
              A UAE-based trading company headquartered in Sharjah. We are the parent organization of two specialist supply divisions — Delight Technical Lighting and Delight Greenscapes.
            </p>
          </div>
          <!-- Logo block -->
          <div class="lg:col-span-4 flex justify-start lg:justify-end">
            <div class="w-full max-w-[240px] aspect-square rounded-2xl bg-white border border-slate-200/60 shadow-sm flex items-center justify-center p-6 transition-transform duration-500 hover:scale-105">
              <img 
                src="/dgllclogolarge.png" 
                alt="Delight Group LLC corporate logo" 
                class="w-full h-auto max-h-[80%] object-contain"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Redefining supply experience in the UAE - Alabaster Background -->
      <section class="bg-[#f7f5ef] border-y border-slate-200/50 py-16 sm:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          <div class="lg:col-span-5 text-left">
            <h2 class="text-3xl sm:text-4xl font-serif text-[#0f2d1d] font-semibold leading-tight italic">
              Redefining the supply experience in the UAE.
            </h2>
            <div class="w-12 h-[1px] bg-[#a34e36] mt-6"></div>
          </div>
          <div class="lg:col-span-7 text-slate-550 font-semibold text-xs sm:text-sm leading-relaxed text-left space-y-6">
            <p>
              We are not engineers or contractors. We are passionate resellers who believe great products — beautiful lighting and thriving plants — should be straightforward to source.
            </p>
            <p>
              We work with homeowners, interior designers, fitout contractors, hotel developers, and facility managers who want a dependable supply partner they can count on. As a new company entering the UAE market, our commitment is simple: honest pricing, genuine products, and service that makes you want to come back.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Our Specialist Divisions - Rich Warm Linen Background -->
      <section class="bg-[#f5f3eb] border-b border-slate-200/50 py-20 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
          <!-- Main header -->
          <div class="text-center space-y-2 max-w-2xl mx-auto">
            <span class="text-[9px] font-black uppercase tracking-[0.2em] text-[#a34e36] block">
              Our Specialist Divisions
            </span>
            <h2 class="text-3xl sm:text-4xl font-serif text-[#0f2d1d] font-semibold tracking-tight">
              Curated supply for every space.
            </h2>
          </div>

          <div class="space-y-12">
            
            <!-- Division Row 1: Delight Technical Lighting -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center py-6 border-b border-slate-200/40 pb-12">
              <!-- Left: Logo showing standardized white box styling -->
              <div class="lg:col-span-4 flex justify-start lg:justify-center">
                <div class="w-full max-w-[240px] aspect-square rounded-2xl bg-white border border-slate-200/60 shadow-sm flex items-center justify-center p-6 transition-transform duration-500 hover:scale-105">
                  <img 
                    src="/dtllogo.jpg" 
                    alt="Delight Technical Lighting Division Logo" 
                    class="w-full h-auto max-h-[80%] object-contain"
                  />
                </div>
              </div>
              <!-- Right: details -->
              <div class="lg:col-span-8 text-left space-y-6">
                <div class="flex items-start gap-4">
                  <span class="text-4xl font-serif text-slate-300 font-extrabold leading-none">01</span>
                  <div>
                    <h3 class="text-2xl font-serif text-[#7f2d1b] font-medium leading-none">Delight Technical Lighting</h3>
                  </div>
                </div>
                <p class="text-slate-555 font-semibold text-xs sm:text-sm leading-relaxed">
                  We supply premium indoor and outdoor lighting fixtures from trusted global brands to homes, offices, hotels, retail spaces, and commercial developments across the UAE. From pendant lights and downlights to architectural outdoor fixtures — if it illuminates a space, we carry it.
                </p>
                <!-- Bullets grid -->
                <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-[10px] font-black uppercase tracking-wider text-slate-800">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#7f2d1b]"></span>
                    <span>Indoor Lighting Fixtures</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#7f2d1b]"></span>
                    <span>Outdoor & Facade Lighting</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#7f2d1b]"></span>
                    <span>Decorative & Statement</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#7f2d1b]"></span>
                    <span>Bulk B2B Trade Supply</span>
                  </div>
                </div>
                <div class="pt-2">
                  <a 
                    href="/delighttechnicallighting" 
                    class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-[#7f2d1b] hover:text-amber-800 transition-colors border-b border-[#7f2d1b]/20 hover:border-[#7f2d1b]/85 pb-0.5"
                  >
                    <span>Explore DTL</span>
                    <ArrowRight class="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>
            </div>

            <!-- Division Row 2: Delight Greenscapes -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center py-6">
              <!-- Left: Logo showing standardized white box styling -->
              <div class="lg:col-span-4 flex justify-start lg:justify-center">
                <div class="w-full max-w-[240px] aspect-square rounded-2xl bg-white border border-slate-200/60 shadow-sm flex items-center justify-center p-6 transition-transform duration-500 hover:scale-105">
                  <img 
                    src="/dgslogo.jpg" 
                    alt="Delight Greenscapes Division Logo" 
                    class="w-full h-auto max-h-[80%] object-contain"
                  />
                </div>
              </div>
              <!-- Right details -->
              <div class="lg:col-span-8 text-left space-y-6">
                <div class="flex items-start gap-4">
                  <span class="text-4xl font-serif text-slate-300 font-extrabold leading-none">02</span>
                  <div>
                    <h3 class="text-2xl font-serif text-[#0f2d1d] font-medium leading-none">Delight Greenscapes</h3>
                  </div>
                </div>
                <p class="text-slate-555 font-semibold text-xs sm:text-sm leading-relaxed">
                  We supply curated indoor and outdoor plants, decorative pots, and planters to residences, offices, hotels, and commercial developments. Whether you need a single statement palm for your living room or bulk greenery for a hotel lobby fitout, Greenscapes is your UAE source.
                </p>
                <!-- Bullets grid -->
                <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-[10px] font-black uppercase tracking-wider text-slate-800">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0f2d1d]"></span>
                    <span>Indoor Collections</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0f2d1d]"></span>
                    <span>Outdoor & Garden</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0f2d1d]"></span>
                    <span>Biophilic Supply</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0f2d1d]"></span>
                    <span>Decorative Planters</span>
                  </div>
                </div>
                <div class="pt-2">
                  <a 
                    href="/delightgreenscapes" 
                    class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-[#0f2d1d] hover:text-emerald-800 transition-colors border-b border-[#0f2d1d]/20 hover:border-[#0f2d1d]/85 pb-0.5"
                  >
                    <span>Explore Greenscapes</span>
                    <ArrowRight class="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Section 4: Vision, Mission & Values - Base Canvas -->
      <section class="py-20 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <!-- Left: Vision and Mission -->
          <div class="lg:col-span-6 text-left space-y-12">
            <!-- Vision -->
            <div class="space-y-4">
              <span class="text-[9px] font-black uppercase tracking-[0.2em] text-[#a34e36] block">Our Vision</span>
              <h3 class="text-2xl sm:text-3xl font-serif text-[#0f2d1d] leading-snug italic font-medium">
                To become the UAE's most trusted specialist supplier of premium lighting and plants &mdash; valued for quality, transparency, and dependable service.
              </h3>
            </div>
            
            <!-- Mission -->
            <div class="space-y-3">
              <span class="text-[9px] font-black uppercase tracking-[0.2em] text-[#a34e36] block">Our Mission</span>
              <p class="text-slate-550 font-semibold text-xs sm:text-sm leading-relaxed max-w-xl">
                Make beautiful, high-quality products accessible to every client &mdash; from a homeowner redecorating a room to a developer fitting out an entire building.
              </p>
            </div>
          </div>

          <!-- Right: Values (Solid Dark Card) -->
          <div class="lg:col-span-6 bg-[#031d0c] rounded-[24px] p-8 sm:p-10 border border-emerald-950/20 text-white text-left space-y-8 shadow-xl">
            <div class="space-y-1">
              <span class="text-[9px] font-black uppercase tracking-[0.2em] text-emerald-400 block">Operating Principles</span>
              <h3 class="text-2xl font-serif text-white font-medium">Our Core Values</h3>
            </div>

            <div class="space-y-6">
              <!-- Value 1 -->
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 rounded-lg bg-emerald-950/50 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
                  <ShieldCheck class="w-4 h-4" />
                </div>
                <div class="space-y-1">
                  <h4 class="text-xs sm:text-sm font-extrabold text-slate-100 uppercase tracking-wider">Honest about what we are</h4>
                  <p class="text-[11px] sm:text-xs text-slate-350 leading-relaxed font-semibold">Resellers, not engineers. We're clear about what we do best, sourcing and delivering exceptional products.</p>
                </div>
              </div>
              
              <!-- Value 2 -->
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 rounded-lg bg-emerald-950/50 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
                  <Heart class="w-4 h-4" />
                </div>
                <div class="space-y-1">
                  <h4 class="text-xs sm:text-sm font-extrabold text-slate-100 uppercase tracking-wider">Quality products, no compromise</h4>
                  <p class="text-[11px] sm:text-xs text-slate-355 leading-relaxed font-semibold">If we wouldn't put it in our own homes, we won't supply it to yours.</p>
                </div>
              </div>

              <!-- Value 3 -->
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 rounded-lg bg-emerald-950/50 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
                  <Scale class="w-4 h-4" />
                </div>
                <div class="space-y-1">
                  <h4 class="text-xs sm:text-sm font-extrabold text-slate-100 uppercase tracking-wider">Straightforward pricing</h4>
                  <p class="text-[11px] sm:text-xs text-slate-355 leading-relaxed font-semibold">Transparent B2B and B2C structures to build dependable long-term relationships.</p>
                </div>
              </div>

              <!-- Value 4 -->
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 rounded-lg bg-emerald-950/50 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
                  <Truck class="w-4 h-4" />
                </div>
                <div class="space-y-1">
                  <h4 class="text-xs sm:text-sm font-extrabold text-slate-100 uppercase tracking-wider">UAE-wide delivery commitment</h4>
                  <p class="text-[11px] sm:text-xs text-slate-355 leading-relaxed font-semibold">Reliable logistics infrastructure ensuring your products arrive safely and on schedule.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Client Testimonials - Alabaster Background -->
      <section class="bg-[#f7f5ef] border-y border-slate-200/50 py-20 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
          <!-- Section Header -->
          <div class="text-left space-y-2 max-w-3xl">
            <span class="text-[9px] font-black uppercase tracking-[0.2em] text-[#a34e36] block">
              Client Testimonials
            </span>
            <h2 class="text-3xl sm:text-4xl font-serif text-[#0f2d1d] font-semibold tracking-tight">
              Trusted by the region's leading creators.
            </h2>
          </div>

          <!-- Grid of 3 testimonials with elegant dividers -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 text-left">
            
            <!-- Testimonial 1 -->
            <div class="space-y-4 border-l border-[#7f2d1b]/40 pl-6">
              <span class="text-xs font-black uppercase tracking-wider text-[#7f2d1b] block">Delight Lighting Client</span>
              <p class="text-slate-650 font-semibold text-xs sm:text-sm leading-relaxed italic">
                "Delight Technical Lighting has completely transformed our hotel projects. Their luminaire supply capacity and swift response times are unmatched in the UAE."
              </p>
              <div class="pt-2">
                <strong class="text-xs font-extrabold text-slate-800 block">Lead Architect</strong>
                <span class="text-[10px] text-slate-400 block font-bold uppercase tracking-wider">Al Habtoor Group &bull; Dubai</span>
              </div>
            </div>

            <!-- Testimonial 2 -->
            <div class="space-y-4 border-l border-[#0f2d1d]/40 pl-6">
              <span class="text-xs font-black uppercase tracking-wider text-[#0f2d1d] block">Delight Greenscapes Client</span>
              <p class="text-slate-650 font-semibold text-xs sm:text-sm leading-relaxed italic">
                "The potted monsteras and custom office plants supplied by Delight Greenscapes brought our fitout workspaces to life. Genuinely thriving plants of high caliber."
              </p>
              <div class="pt-2">
                <strong class="text-xs font-extrabold text-slate-800 block">Interior Design Director</strong>
                <span class="text-[10px] text-slate-400 block font-bold uppercase tracking-wider">Emaar Properties &bull; Dubai</span>
              </div>
            </div>

            <!-- Testimonial 3 -->
            <div class="space-y-4 border-l border-slate-350 pl-6">
              <span class="text-xs font-black uppercase tracking-wider text-slate-700 block">Corporate Partner</span>
              <p class="text-slate-650 font-semibold text-xs sm:text-sm leading-relaxed italic">
                "Finding a supply partner that delivers both high-end light fixtures and curated foliage under straightforward pricing has completely streamlined our procurement."
              </p>
              <div class="pt-2">
                <strong class="text-xs font-extrabold text-slate-800 block">Procurement Manager</strong>
                <span class="text-[10px] text-slate-400 block font-bold uppercase tracking-wider">Sobha Realty &bull; Dubai</span>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Section 6: Leadership Message - Base Canvas -->
      <section class="py-20 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <!-- Photo -->
          <div class="lg:col-span-5">
            <div class="w-full aspect-square max-w-[280px] mx-auto rounded-2xl overflow-hidden relative group shadow-sm">
              <img 
                src="/about-hero.png" 
                alt="Delight Group Director leadership workspace" 
                class="w-full h-full object-cover filter grayscale contrast-125 transition-transform duration-750 group-hover:scale-105"
              />
            </div>
          </div>
          
          <!-- Quote Details -->
          <div class="lg:col-span-7 text-left space-y-6">
            <span class="text-[9px] font-black uppercase tracking-[0.2em] text-[#a34e36] block">Leadership Message</span>
            
            <h3 class="text-2xl sm:text-3xl font-serif text-[#0f2d1d] font-medium leading-snug italic">
              "Our goal isn't just to sell products, but to curate environments where people feel truly at home."
            </h3>
            
            <div class="space-y-4 text-slate-550 font-semibold text-xs sm:text-sm leading-relaxed">
              <p>
                Delight Group LLC was founded on a simple belief: that premium light elements and green flora are key to crafting inspiring environments. We want to remove the complexity from sourcing high-quality architectural components.
              </p>
              <p>
                Every product in our catalog is hand-selected. Every client interaction is backed by the personal touch of a small business, backed by the operational safety of a trusted brand. We are proud to contribute to shaping the landscapes of the UAE, one space at a time.
              </p>
            </div>

            <div class="pt-2">
              <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block">Founder & CEO</span>
              <strong class="text-sm font-extrabold text-slate-800 block mt-0.5">DELIGHT GROUP LLC</strong>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style is:global>
  /* Floating Parallax Leaves */
  .parallax-leaf {
    will-change: transform;
    transition: transform 0.1s cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>

<script>
  // Dynamic Viewport-Relative Parallax for background leaves and sparkles
  const leaves = document.querySelectorAll('.parallax-leaf');
  let ticked = false;

  function updateLeafParallax() {
    const scrolled = window.pageYOffset;
    const viewportHeight = window.innerHeight;

    leaves.forEach(leaf => {
      const el = leaf as HTMLElement;
      const rect = el.getBoundingClientRect();
      const elementTop = rect.top + scrolled;

      const speed = parseFloat(leaf.getAttribute('data-speed') || '0.08');
      const baseRotation = parseFloat(leaf.getAttribute('data-rotation') || '0');

      const relativeScroll = scrolled + (viewportHeight / 2) - elementTop;
      const yOffset = relativeScroll * speed;
      const rotation = baseRotation + (relativeScroll * speed * 0.08);

      el.style.transform = `translate3d(0, ${yOffset}px, 0) rotate(${rotation}deg)`;
    });
    ticked = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticked) {
      window.requestAnimationFrame(updateLeafParallax);
      ticked = true;
    }
  }, { passive: true });

  updateLeafParallax();
</script>
